            job_executions_retry_config_output?: str  # <p>The configuration that determines how many retries are allowed for each failure type
            for a job.</p>

            destination_package_versions_output?: [str]  # <p>The package version Amazon Resource Names (ARNs) that are installed on the device when the job
            successfully completes. The package version must be in either the Published or
