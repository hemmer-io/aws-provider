            details_output?: str  # 

            status_output?: str  # <p>The status of the user profile.</p>

            domain_id_output?: str  # <p>the identifier of the Amazon DataZone domain of which you want to get the user profile.</p>

            id_output?: str  # <p>The identifier of the user profile.</p>




        schema Time_series_data_point:
            """
