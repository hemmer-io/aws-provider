            event_scope_code_output?: str  # <p>This parameter specifies if the Health event is a public Amazon Web Services service event or an account-specific event.</p>
         <ul>
            <li>
               <p>If the <code>eventScopeCode</code> value is <code>PUBLIC</code>, then the
