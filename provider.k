            description: str  # <p>Description of the profile object type.</p>

            fields: {str: str}?  # <p>A map of the name and ObjectType field.</p>

            keys: {str: str}?  # <p>A list of unique keys that can be used to map data to the profile.</p>

            template_id: str?  # <p>A unique identifier for the object template. For some attributes in the request, the
