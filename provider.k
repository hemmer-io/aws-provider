        schema Bot:
            """
            Bot resource
            """

            data_privacy: str  # <p>Provides information on additional privacy protections Amazon Lex should
         use with the bot's data.</p>

            bot_tags: {str: str}?  # <p>A list of tags to add to the bot. You can only add tags when you
         create a bot. You can't use the <code>UpdateBot</code> operation to
         update tags. To update tags, use the <code>TagResource</code>
         operation.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of an IAM role that has permission to
         access the bot.</p>

            description: str?  # <p>A description of the bot. It appears in lists to help you identify a
         particular bot.</p>

            bot_type: str?  # <p>The type of a bot to create.</p>

            idle_session_ttl_in_seconds: int  # <p>The time, in seconds, that Amazon Lex should keep information about a
         user's conversation with the bot. </p>
         <p>A user interaction remains active for the amount of time specified.
         If no conversation occurs during this time, the session expires and
         Amazon Lex deletes any data provided before the timeout.</p>
         <p>You can specify between 60 (1 minute) and 86,400 (24 hours)
         seconds.</p>

            error_log_settings: str?  # <p>Specifies the configuration for error logging during bot creation.</p>

            test_bot_alias_tags: {str: str}?  # <p>A list of tags to add to the test alias for a bot. You can only add
         tags when you create a bot. You can't use the <code>UpdateAlias</code>
         operation to update tags. To update tags on the test alias, use the
            <code>TagResource</code> operation.</p>

            bot_name: str  # <p>The name of the bot. The bot name must be unique in the account that
         creates the bot.</p>

            bot_members: [str]?  # <p>The list of bot members in a network to be created.</p>



            # Outputs

            bot_id_output?: str  # <p>The unique identifier of the bot.</p>

            bot_name_output?: str  # <p>The name of the bot.</p>

            description_output?: str  # <p>The description of the bot. </p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of an IAM role that has permission to
         access the bot.</p>

            data_privacy_output?: str  # <p>Settings for managing data privacy of the bot and its conversations
         with users.</p>

            idle_session_ttl_in_seconds_output?: int  # <p>The maximum time in seconds that Amazon Lex retains the data gathered in
         a conversation.</p>

            bot_status_output?: str  # <p>The current status of the bot. When the status is
            <code>Available</code> the bot is ready to be used in conversations
         with users.</p>

            last_updated_date_time_output?: str  # <p>A timestamp of the date and time that the bot was last
         updated.</p>

            bot_type_output?: str  # <p>The type of the bot that was described.</p>

            bot_members_output?: [str]  # <p>The list of bots in the network that was described.</p>

            error_log_settings_output?: str  # <p>Contains the configuration for error logging that specifies where and how bot errors are recorded, including destinations like CloudWatch Logs.</p>

            creation_date_time_output?: str  # <p>A timestamp of the date and time that the bot was created.</p>

            failure_reasons_output?: [str]  # <p>If the <code>botStatus</code> is <code>Failed</code>, this contains
         a list of reasons that the bot couldn't be built.</p>




