            job_id_output?: str  # <p>The ID of the job run.</p>

            created_by_output?: str  # <p>The user who created the job run.</p>

            id_output?: str  # <p>The ID of the job run.</p>

            error_output?: str  # <p>The error generated if the action is not completed successfully.</p>

            end_time_output?: str  # <p>The timestamp of when the job run ended.</p>




