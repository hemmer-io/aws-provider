            repository_name: str  # <p>The name of the repository to receive the policy.</p>

            registry_id: str?  # <p>The Amazon Web Services account ID associated with the registry that contains the repository. If you
            do  not specify a registry, the default registry is assumed.</p>



            # Outputs

            lifecycle_policy_text_output?: str  # <p>The JSON lifecycle policy text.</p>

            registry_id_output?: str  # <p>The registry ID associated with the request.</p>

            repository_name_output?: str  # <p>The repository name associated with the request.</p>

            last_evaluated_at_output?: str  # <p>The time stamp of the last time that the lifecycle policy was run.</p>




