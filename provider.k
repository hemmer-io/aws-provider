            workflow_arn_output?: str  # <p>The ARN (Amazon Resource Name) that Entity Resolution generated for the <code>IdMappingWorkflow</code> .</p>

            workflow_name_output?: str  # <p>The name of the workflow.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the IAM role. Entity Resolution assumes this role to access Amazon Web Services resources on your behalf.</p>

            updated_at_output?: str  # <p>The timestamp of when the workflow was last updated.</p>

            created_at_output?: str  # <p>The timestamp of when the workflow was created.</p>

            description_output?: str  # <p>A description of the workflow.</p>

            input_source_config_output?: [str]  # <p>A list of <code>InputSource</code> objects, which have the fields <code>InputSourceARN</code> and <code>SchemaName</code>.</p>

            id_mapping_techniques_output?: str  # <p>An object which defines the ID mapping technique and any additional configurations.</p>

            tags_output?: {str: str}  # <p>The tags used to organize, track, or control access for this resource.</p>

            incremental_run_config_output?: str  # <p> The incremental run configuration for the ID mapping workflow.</p>





