        schema App:
            """
            App resource
            """

            space_name: str?  # <p>The name of the space. If this value is not set, then <code>UserProfileName</code> must be set.</p>

            resource_spec: str?  # <p>The instance type and the Amazon Resource Name (ARN) of the SageMaker AI image created on the instance.</p> <note> <p>The value of <code>InstanceType</code> passed as part of the <code>ResourceSpec</code> in the <code>CreateApp</code> call overrides the value passed as part of the <code>ResourceSpec</code> configured for the user profile or the domain. If <code>InstanceType</code> is not specified in any of those three <code>ResourceSpec</code> values for a <code>KernelGateway</code> app, the <code>CreateApp</code> call fails with a request validation error.</p> </note>

            domain_id: str  # <p>The domain ID.</p>

            app_type: str  # <p>The type of app.</p>

            app_name: str  # <p>The name of the app.</p>

            recovery_mode: bool?  # <p> Indicates whether the application is launched in recovery mode. </p>

            user_profile_name: str?  # <p>The user profile name. If this value is not set, then <code>SpaceName</code> must be set.</p>

            tags: [str]?  # <p>Each tag consists of a key and an optional value. Tag keys must be unique per resource.</p>



            # Outputs

            built_in_lifecycle_config_arn_output?: str  # <p>The lifecycle configuration that runs before the default lifecycle configuration</p>

            domain_id_output?: str  # <p>The domain ID.</p>

            space_name_output?: str  # <p>The name of the space. If this value is not set, then <code>UserProfileName</code> must be set.</p>

            last_health_check_timestamp_output?: str  # <p>The timestamp of the last health check.</p>

            recovery_mode_output?: bool  # <p> Indicates whether the application is launched in recovery mode. </p>

            app_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the app.</p>

            app_type_output?: str  # <p>The type of app.</p>

            failure_reason_output?: str  # <p>The failure reason.</p>

            app_name_output?: str  # <p>The name of the app.</p>

            creation_time_output?: str  # <p>The creation time of the application.</p> <note> <p>After an application has been shut down for 24 hours, SageMaker AI deletes all metadata for the application. To be considered an update and retain application metadata, applications must be restarted within 24 hours after the previous application has been shut down. After this time window, creation of an application is considered a new application rather than an update of the previous application.</p> </note>

            user_profile_name_output?: str  # <p>The user profile name.</p>

            resource_spec_output?: str  # <p>The instance type and the Amazon Resource Name (ARN) of the SageMaker AI image created on the instance.</p>

            effective_trusted_identity_propagation_status_output?: str  # <p>The effective status of Trusted Identity Propagation (TIP) for this application. When enabled, user identities from IAM Identity Center are being propagated through the application to TIP enabled Amazon Web Services services. When disabled, standard IAM role-based access is used. </p>

            last_user_activity_timestamp_output?: str  # <p>The timestamp of the last user's activity. <code>LastUserActivityTimestamp</code> is also updated when SageMaker AI performs health checks without user activity. As a result, this value is set to the same value as <code>LastHealthCheckTimestamp</code>.</p>

            status_output?: str  # <p>The status.</p>




        schema Domain:
            """
            Domain resource
            """

            kms_key_id: str?  # <p>SageMaker AI uses Amazon Web Services KMS to encrypt EFS and EBS volumes attached to the domain with an Amazon Web Services managed key by default. For more control, specify a customer managed key.</p>

            auth_mode: str  # <p>The mode of authentication that members use to access the domain.</p>

            default_user_settings: str  # <p>The default settings to use to create a user profile when <code>UserSettings</code> isn't specified in the call to the <code>CreateUserProfile</code> API.</p> <p> <code>SecurityGroups</code> is aggregated when specified in both calls. For all other settings in <code>UserSettings</code>, the values specified in <code>CreateUserProfile</code> take precedence over those specified in <code>CreateDomain</code>.</p>

            app_security_group_management: str?  # <p>The entity that creates and manages the required security groups for inter-app communication in <code>VPCOnly</code> mode. Required when <code>CreateDomain.AppNetworkAccessType</code> is <code>VPCOnly</code> and <code>DomainSettings.RStudioServerProDomainSettings.DomainExecutionRoleArn</code> is provided. If setting up the domain for use with RStudio, this value must be set to <code>Service</code>.</p>

            default_space_settings: str?  # <p>The default settings for shared spaces that users create in the domain.</p>

            domain_name: str  # <p>A name for the domain.</p>

            tags: [str]?  # <p>Tags to associated with the Domain. Each tag consists of a key and an optional value. Tag keys must be unique per resource. Tags are searchable using the <code>Search</code> API.</p> <p>Tags that you specify for the Domain are also added to all Apps that the Domain launches.</p>

            domain_settings: str?  # <p>A collection of <code>Domain</code> settings.</p>

            vpc_id: str?  # <p>The ID of the Amazon Virtual Private Cloud (VPC) that the domain uses for communication.</p> <p>The field is optional when the <code>AppNetworkAccessType</code> parameter is set to <code>PublicInternetOnly</code> for domains created from Amazon SageMaker Unified Studio.</p>

            home_efs_file_system_kms_key_id: str?  # <p>Use <code>KmsKeyId</code>.</p>

            tag_propagation: str?  # <p>Indicates whether custom tag propagation is supported for the domain. Defaults to <code>DISABLED</code>.</p>

            subnet_ids: [str]?  # <p>The VPC subnets that the domain uses for communication.</p> <p>The field is optional when the <code>AppNetworkAccessType</code> parameter is set to <code>PublicInternetOnly</code> for domains created from Amazon SageMaker Unified Studio.</p>

            app_network_access_type: str?  # <p>Specifies the VPC used for non-EFS traffic. The default value is <code>PublicInternetOnly</code>.</p> <ul> <li> <p> <code>PublicInternetOnly</code> - Non-EFS traffic is through a VPC managed by Amazon SageMaker AI, which allows direct internet access</p> </li> <li> <p> <code>VpcOnly</code> - All traffic is through the specified VPC and subnets</p> </li> </ul>



            # Outputs

            app_network_access_type_output?: str  # <p>Specifies the VPC used for non-EFS traffic. The default value is <code>PublicInternetOnly</code>.</p> <ul> <li> <p> <code>PublicInternetOnly</code> - Non-EFS traffic is through a VPC managed by Amazon SageMaker AI, which allows direct internet access</p> </li> <li> <p> <code>VpcOnly</code> - All traffic is through the specified VPC and subnets</p> </li> </ul>

            app_security_group_management_output?: str  # <p>The entity that creates and manages the required security groups for inter-app communication in <code>VPCOnly</code> mode. Required when <code>CreateDomain.AppNetworkAccessType</code> is <code>VPCOnly</code> and <code>DomainSettings.RStudioServerProDomainSettings.DomainExecutionRoleArn</code> is provided.</p>

            vpc_id_output?: str  # <p>The ID of the Amazon Virtual Private Cloud (VPC) that the domain uses for communication.</p>

            subnet_ids_output?: [str]  # <p>The VPC subnets that the domain uses for communication.</p>

            url_output?: str  # <p>The domain's URL.</p>

            single_sign_on_managed_application_instance_id_output?: str  # <p>The IAM Identity Center managed application instance ID.</p>

            default_user_settings_output?: str  # <p>Settings which are applied to UserProfiles in this domain if settings are not explicitly specified in a given UserProfile. </p>

            domain_settings_output?: str  # <p>A collection of <code>Domain</code> settings.</p>

            last_modified_time_output?: str  # <p>The last modified time.</p>

            tag_propagation_output?: str  # <p>Indicates whether custom tag propagation is supported for the domain.</p>

            auth_mode_output?: str  # <p>The domain's authentication mode.</p>

            failure_reason_output?: str  # <p>The failure reason.</p>

            home_efs_file_system_kms_key_id_output?: str  # <p>Use <code>KmsKeyId</code>.</p>

            creation_time_output?: str  # <p>The creation time.</p>

            default_space_settings_output?: str  # <p>The default settings for shared spaces that users create in the domain.</p>

            single_sign_on_application_arn_output?: str  # <p>The ARN of the application managed by SageMaker AI in IAM Identity Center. This value is only returned for domains created after October 1, 2023.</p>

            domain_name_output?: str  # <p>The domain name.</p>

            kms_key_id_output?: str  # <p>The Amazon Web Services KMS customer managed key used to encrypt the EFS volume attached to the domain.</p>

            domain_arn_output?: str  # <p>The domain's Amazon Resource Name (ARN).</p>

            status_output?: str  # <p>The status.</p>

            domain_id_output?: str  # <p>The domain ID.</p>

            home_efs_file_system_id_output?: str  # <p>The ID of the Amazon Elastic File System managed by this Domain.</p>

            security_group_id_for_domain_boundary_output?: str  # <p>The ID of the security group that authorizes traffic between the <code>RSessionGateway</code> apps and the <code>RStudioServerPro</code> app.</p>




