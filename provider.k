            capacity_assignment_configuration_output?: str  # <p>The requested capacity assignment configuration for the specified capacity
            reservation.</p>




        schema Notebook:
            """
            Notebook resource
            """

            work_group: str  # <p>The name of the Spark enabled workgroup in which the notebook will be created.</p>

