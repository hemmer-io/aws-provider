            tags: [str]?  # <p>The key-value pair to use when tagging the resource.</p>

            host_arn: str?  # <p>The Amazon Resource Name (ARN) of the host associated with the connection to be created.</p>

            provider_type: str?  # <p>The name of the external provider where your third-party code repository is
