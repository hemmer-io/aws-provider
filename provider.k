            domain_id_output?: str  # <p>The ID of the Amazon DataZone domain that houses the asset data point that you want to get.</p>

            form_name_output?: str  # <p>The name of the time series form that houses the data point that you want to get.</p>

            entity_id_output?: str  # <p>The ID of the asset for which you want to get the data point.</p>




