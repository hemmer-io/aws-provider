            query_string_output?: str  # <p>The openCypher query string.</p>

            query_id_output?: str  # <p>The unique ID of the query for which status is being returned.</p>




        schema Sparql_statistics:
            """
            SparqlStatistics resource
            """



            # Outputs

            status_output?: str  # <p>The HTTP return code of the request. If the request succeeded, the code is 200. See <a href="https://docs.aws.amazon.com/neptune/latest/userguide/neptune-dfe-statistics.html#neptune-dfe-statistics-errors">Common error codes for DFE statistics request</a> for a list of common errors.</p> <p>When invoking this operation in a Neptune cluster that has IAM authentication enabled, the IAM user or role making the request must have a policy attached that allows the <a href="https://docs.aws.amazon.com/neptune/latest/userguide/iam-dp-actions.html#getstatisticsstatus">neptune-db:GetStatisticsStatus</a> IAM action in that cluster.</p>

            payload_output?: str  # <p>Statistics for RDF data.</p>




        schema Propertygraph_statistics:
            """
            PropertygraphStatistics resource
            """



            # Outputs

            status_output?: str  # <p>The HTTP return code of the request. If the request succeeded, the code is 200. See <a href="https://docs.aws.amazon.com/neptune/latest/userguide/neptune-dfe-statistics.html#neptune-dfe-statistics-errors">Common error codes for DFE statistics request</a> for a list of common errors.</p>

            payload_output?: str  # <p>Statistics for property-graph data.</p>




        schema Ml_model_transform_job:
            """
            MLModelTransformJob resource
            """



            # Outputs

            models_output?: [str]  # <p>A list of the configuration information for the models being used.</p>

            remote_model_transform_job_output?: str  # <p>The remote model transform job.</p>

            id_output?: str  # <p>The unique identifier of the model-transform job to be retrieved.</p>

            status_output?: str  # <p>The status of the model-transform job.</p>

            base_processing_job_output?: str  # <p>The base data processing job.</p>




        schema Ml_model_training_job:
            """
            MLModelTrainingJob resource
            """



