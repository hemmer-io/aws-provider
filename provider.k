            report_name: str?  # <p>A unique name that helps you to identify the predictive inbox placement test when you retrieve the
            results.</p>

            tags: [str]?  # <p>An array of objects that define the tags (keys and values) that you want to associate
            with the predictive inbox placement test.</p>

