            resource_arn: str  # <p>The Amazon Resource Name (ARN) of the target table for which to create integration table properties. Currently, this API only supports creating 
      integration table properties for target tables, and the provided ARN should be the ARN of the target table in the Glue Data Catalog. Support for 
      creating integration table properties for source connections (using the connection ARN) is not yet implemented and will be added in a future release.
    </p>

            source_table_config: str?  # <p>A structure for the source table configuration. See the <code>SourceTableConfig</code> structure to see list of supported source properties.</p>

            table_name: str  # <p>The name of the table to be replicated.</p>

            target_table_config: str?  # <p>A structure for the target table configuration.</p>



