    # Cloudhsm Service
    schema CloudhsmService:
        """
        Service for cloudhsm resources.
        """


        schema Hapg:
            """
            Hapg resource
            """

            label: str  # <p>The label of the new high-availability partition group.</p>



            # Outputs

            partition_serial_list_output?: [str]  # <p>The list of partition serial numbers that belong to the high-availability partition
      group.</p>

            hsms_pending_deletion_output?: [str]  # <p></p>

            hapg_serial_output?: str  # <p>The serial number of the high-availability partition group.</p>

            hsms_pending_registration_output?: [str]  # <p></p>

            hapg_arn_output?: str  # <p>The ARN of the high-availability partition group.</p>

            state_output?: str  # <p>The state of the high-availability partition group.</p>

            label_output?: str  # <p>The label for the high-availability partition group.</p>

            hsms_last_action_failed_output?: [str]  # <p></p>

            last_modified_timestamp_output?: str  # <p>The date and time the high-availability partition group was last modified.</p>




        schema Config:
            """
            Config resource
            """



            # Outputs

            config_type_output?: str  # <p>The type of credentials.</p>

            config_file_output?: str  # <p>The chrystoki.conf configuration file.</p>

            config_cred_output?: str  # <p>The certificate file containing the server.pem files of the HSMs.</p>




        schema Hsm:
            """
            Hsm resource
            """

            iam_role_arn: str  # <p>The ARN of an IAM role to enable the AWS CloudHSM service to allocate an ENI on your
      behalf.</p>

            subscription_type: str  # 

            subnet_id: str  # <p>The identifier of the subnet in your VPC in which to place the HSM.</p>

            ssh_key: str  # <p>The SSH public key to install on the HSM.</p>

            eni_ip: str?  # <p>The IP address to assign to the HSM's ENI.</p>
         <p>If an IP address is not specified, an IP address will be randomly chosen from the CIDR
      range of the subnet.</p>

            client_token: str?  # <p>A user-defined token to ensure idempotence. Subsequent calls to this operation with the
      same token will be ignored.</p>

            external_id: str?  # <p>The external ID from <code>IamRoleArn</code>, if present.</p>

            syslog_ip: str?  # <p>The IP address for the syslog monitoring server. The AWS CloudHSM service only supports one
      syslog monitoring server.</p>



            # Outputs

            status_details_output?: str  # <p>Contains additional information about the status of the HSM.</p>

            eni_ip_output?: str  # <p>The IP address assigned to the HSM's ENI.</p>

            server_cert_uri_output?: str  # <p>The URI of the certificate server.</p>

            status_output?: str  # <p>The status of the HSM.</p>

            subscription_end_date_output?: str  # <p>The subscription end date.</p>

            subnet_id_output?: str  # <p>The identifier of the subnet that the HSM is in.</p>

            subscription_type_output?: str  # 

            iam_role_arn_output?: str  # <p>The ARN of the IAM role assigned to the HSM.</p>

            serial_number_output?: str  # <p>The serial number of the HSM.</p>

            ssh_key_last_updated_output?: str  # <p>The date and time that the SSH key was last updated.</p>

            eni_id_output?: str  # <p>The identifier of the elastic network interface (ENI) attached to the HSM.</p>

            hsm_type_output?: str  # <p>The HSM model type.</p>

            software_version_output?: str  # <p>The HSM software version.</p>

            hsm_arn_output?: str  # <p>The ARN of the HSM.</p>

            vendor_name_output?: str  # <p>The name of the HSM vendor.</p>

            vpc_id_output?: str  # <p>The identifier of the VPC that the HSM is in.</p>

            ssh_public_key_output?: str  # <p>The public SSH key.</p>

            availability_zone_output?: str  # <p>The Availability Zone that the HSM is in.</p>

            partitions_output?: [str]  # <p>The list of partitions on the HSM.</p>

            subscription_start_date_output?: str  # <p>The subscription start date.</p>

            server_cert_last_updated_output?: str  # <p>The date and time that the server certificate was last updated.</p>




        schema Luna_client:
            """
            LunaClient resource
            """

            label: str?  # <p>The label for the client.</p>

            certificate: str  # <p>The contents of a Base64-Encoded X.509 v3 certificate to be installed on the HSMs used
      by this client.</p>



            # Outputs

            certificate_output?: str  # <p>The certificate installed on the HSMs used by this client.</p>

            label_output?: str  # <p>The label of the client.</p>

            certificate_fingerprint_output?: str  # <p>The certificate fingerprint.</p>

            client_arn_output?: str  # <p>The ARN of the client.</p>

            last_modified_timestamp_output?: str  # <p>The date and time the client was last modified.</p>




        schema Backups:
            """
            Backups resource
            """



            # Outputs

            backups_output?: [str]  # <p>A list of backups.</p>

            next_token_output?: str  # <p>An opaque string that indicates that the response contains only a subset of backups.
      Use this value in a subsequent <code>DescribeBackups</code> request to get more
      backups.</p>




        schema Resource_policy:
            """
            ResourcePolicy resource
            """

            policy: str?  # <p>The policy you want to associate with a resource. </p>
         <p>For an example policy, see <a href="https://docs.aws.amazon.com/cloudhsm/latest/userguide/sharing.html"> Working with shared backups</a> in the CloudHSM User Guide</p>

            resource_arn: str?  # <p>Amazon Resource Name (ARN) of the resource to which you want to attach a policy. </p>



            # Outputs

            policy_output?: str  # <p>The policy attached to a resource.</p>




        schema Hsm:
            """
            Hsm resource
            """

            ip_address: str?  # <p>The HSM's IP address. If you specify an IP address, use an available address from the
      subnet that maps to the Availability Zone where you are creating the HSM. If you don't specify
      an IP address, one is chosen for you from that subnet.</p>

            availability_zone: str  # <p>The Availability Zone where you are creating the HSM. To find the cluster's
      Availability Zones, use <a>DescribeClusters</a>.</p>

            cluster_id: str  # <p>The identifier (ID) of the HSM's cluster. To find the cluster ID, use <a>DescribeClusters</a>.</p>




        schema Backup:
            """
            Backup resource
            """




        schema Clusters:
            """
            Clusters resource
            """



            # Outputs

            next_token_output?: str  # <p>An opaque string that indicates that the response contains only a subset of clusters.
      Use this value in a subsequent <code>DescribeClusters</code> request to get more
      clusters.</p>

            clusters_output?: [str]  # <p>A list of clusters.</p>




        schema Cluster:
            """
            Cluster resource
            """

            hsm_type: str  # <p>The type of HSM to use in the cluster. The allowed values are
      <code>hsm1.medium</code> and <code>hsm2m.medium</code>.</p>

            backup_retention_policy: str?  # <p>A policy that defines how the service retains backups.</p>

            source_backup_id: str?  # <p>The identifier (ID) or the Amazon Resource Name (ARN) of the cluster backup to restore. Use this value to restore the
      cluster from a backup instead of creating a new cluster. To find the backup ID or ARN, use <a>DescribeBackups</a>. <i>If using a backup in another account, the full ARN must be supplied.</i>
         </p>

            subnet_ids: [str]  # <p>The identifiers (IDs) of the subnets where you are creating the cluster. You must
      specify at least one subnet. If you specify multiple subnets, they must meet the following
      criteria:</p>
         <ul>
            <li>
               <p>All subnets must be in the same virtual private cloud (VPC).</p>
            </li>
            <li>
               <p>You can specify only one subnet per Availability Zone.</p>
            </li>
         </ul>

            mode: str?  # <p>The mode to use in the cluster. The allowed values are
      <code>FIPS</code> and <code>NON_FIPS</code>.</p>

            tag_list: [str]?  # <p>Tags to apply to the CloudHSM cluster during creation.</p>

            network_type: str?  # <p>The NetworkType to create a cluster with. The allowed values are
          <code>IPV4</code> and <code>DUALSTACK</code>.
      </p>





    # Iottwinmaker Service
