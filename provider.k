            request_reason_output?: str  # <p>The reason for the subscription request.</p>

            updated_by_output?: str  # <p>The Amazon DataZone user who updated the subscription request.</p>

            created_at_output?: str  # <p>The timestamp of when the specified subscription request was created.</p>

            subscribed_listings_output?: [str]  # <p>The subscribed listings in the subscription request.</p>

            created_by_output?: str  # <p>The Amazon DataZone user who created the subscription request.</p>

            subscribed_principals_output?: [str]  # <p>The subscribed principals in the subscription request.</p>

            existing_subscription_id_output?: str  # <p>The ID of the existing subscription.</p>




        schema Environment_action:
