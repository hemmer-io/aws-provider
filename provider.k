    # Finspace Service
    schema FinspaceService:
        """
        Service for finspace resources.
        """


        schema Kx_database:
            """
            KxDatabase resource
            """

            environment_id: str  # <p>A unique identifier for the kdb environment.</p>

            database_name: str  # <p>The name of the kdb database.</p>

            client_token: str  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            tags: {str: str}?  # <p>A list of key-value pairs to label the kdb database. You can add up to 50 tags to your kdb database</p>

            description: str?  # <p>A description of the database.</p>



            # Outputs

            last_modified_timestamp_output?: str  # <p>The last time that the database was modified. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            created_timestamp_output?: str  # <p>The timestamp at which the database is created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            num_bytes_output?: int  # <p>The total number of bytes in the database.</p>

            environment_id_output?: str  # <p>A unique identifier for the kdb environment.</p>

            last_completed_changeset_id_output?: str  # <p>A unique identifier for the changeset.</p>

            num_changesets_output?: int  # <p>The total number of changesets in the database.</p>

            database_arn_output?: str  # <p>The ARN identifier of the database.</p>

            database_name_output?: str  # <p>The name of the kdb database for which the information is retrieved.</p>

            description_output?: str  # <p>A description of the database.</p>

            num_files_output?: int  # <p>The total number of files in the database.</p>




        schema Kx_changeset:
            """
            KxChangeset resource
            """

            database_name: str  # <p>The name of the kdb database.</p>

            change_requests: [str]  # <p>A list of change request objects that are run in order. A change request object consists of <code>changeType</code> , <code>s3Path</code>, and <code>dbPath</code>. 
      A changeType can have the following values: </p>
         <ul>
            <li>
               <p>PUT – Adds or updates files in a database.</p>
            </li>
            <li>
               <p>DELETE – Deletes files in a database.</p>
            </li>
         </ul>
         <p>All the change requests require a mandatory <code>dbPath</code> attribute that defines the
         path within the database directory. All database paths must start with a leading / and end
         with a trailing /. The <code>s3Path</code> attribute defines the s3 source file path and is
         required for a PUT change type. The <code>s3path</code> must end with a trailing / if it is
         a directory and must end without a trailing / if it is a file. </p>
         <p>Here are few examples of how you can use the change request object:</p>
         <ol>
            <li>
               <p>This request adds a single sym file at database root location.   </p>
               <p>
                  <code>{ "changeType": "PUT", "s3Path":"s3://bucket/db/sym",
               "dbPath":"/"}</code>
               </p>
            </li>
            <li>
               <p>This request adds files in the given <code>s3Path</code> under the 2020.01.02
               partition of the database.</p>
               <p>
                  <code>{ "changeType": "PUT", "s3Path":"s3://bucket/db/2020.01.02/",
               "dbPath":"/2020.01.02/"}</code>
               </p>
            </li>
            <li>
               <p>This request adds files in the given <code>s3Path</code> under the
                  <i>taq</i> table partition of the database.</p>
               <p>
                  <code>[ { "changeType": "PUT", "s3Path":"s3://bucket/db/2020.01.02/taq/",
                  "dbPath":"/2020.01.02/taq/"}]</code>
               </p>
            </li>
            <li>
               <p>This request deletes the 2020.01.02 partition of the database.</p>
               <p>
                  <code>[{ "changeType": "DELETE", "dbPath": "/2020.01.02/"} ]</code>
               </p>
            </li>
            <li>
               <p>The <i>DELETE</i> request allows you to delete the existing files under the
               2020.01.02 partition of the database, and the <i>PUT</i> request adds a
               new taq table under it.</p>
               <p>
                  <code>[ {"changeType": "DELETE", "dbPath":"/2020.01.02/"}, {"changeType": "PUT",
                  "s3Path":"s3://bucket/db/2020.01.02/taq/",
               "dbPath":"/2020.01.02/taq/"}]</code>
               </p>
            </li>
         </ol>

            client_token: str  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            environment_id: str  # <p>A unique identifier of the kdb environment.</p>



            # Outputs

            environment_id_output?: str  # <p>A unique identifier for the kdb environment.</p>

            status_output?: str  # <p>Status of the changeset creation process.</p>
         <ul>
            <li>
               <p>Pending – Changeset creation is pending.</p>
            </li>
            <li>
               <p>Processing – Changeset creation is running.</p>
            </li>
            <li>
               <p>Failed – Changeset creation has failed.</p>
            </li>
            <li>
               <p>Complete – Changeset creation has succeeded.</p>
            </li>
         </ul>

            change_requests_output?: [str]  # <p>A list of change request objects that are run in order.</p>

            created_timestamp_output?: str  # <p>The timestamp at which the changeset was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            active_from_timestamp_output?: str  # <p>Beginning time from which the changeset is active. The value is determined as epoch time in
      milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as
      1635768000000.</p>

            last_modified_timestamp_output?: str  # <p>The timestamp at which the changeset was updated in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            changeset_id_output?: str  # <p>A unique identifier for the changeset.</p>

            error_info_output?: str  # <p>Provides details in the event of a failed flow, including the error type and the related error message.</p>

            database_name_output?: str  # <p>The name of the kdb database.</p>




        schema Kx_connection_string:
            """
            KxConnectionString resource
            """



            # Outputs

            signed_connection_string_output?: str  # <p>The signed connection string that you can use to connect to clusters.</p>




        schema Kx_cluster_code_configuration:
            """
            KxClusterCodeConfiguration resource
            """

            command_line_arguments: [str]?  # <p>Specifies the key-value pairs to make them available inside the cluster.</p>
         <p>You cannot update this parameter for a <code>NO_RESTART</code> deployment.</p>

            deployment_configuration: str?  # <p>
         The configuration that allows you to choose how you want to update the code on a cluster.
      </p>

            code: str  # 

            initialization_script: str?  # <p>Specifies a Q program that will be run at launch of a cluster. It is a relative path within
         <i>.zip</i> file that contains the custom code, which will be loaded on
         the cluster. It must include the file name itself. For example,
         <code>somedir/init.q</code>.</p>
         <p>You cannot update this parameter for a <code>NO_RESTART</code> deployment.</p>

            cluster_name: str  # <p>The name of the cluster.</p>

            environment_id: str  # <p>
         A unique identifier of the kdb environment.
      </p>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>




        schema Kx_dataview:
            """
            KxDataview resource
            """

            az_mode: str  # <p>The number of availability zones you want to assign per volume. Currently, FinSpace only supports <code>SINGLE</code> for volumes. This places dataview in a single AZ.</p>

            read_write: bool?  # <p>
         The option to specify whether you want to make the dataview writable to perform database maintenance. The following are some considerations related to writable dataviews.  </p>
         <ul>
            <li>
               <p>You cannot create partial writable dataviews. When you create writeable dataviews you must
               provide the entire database path.</p>
            </li>
            <li>
               <p>You cannot perform updates on a writeable dataview. Hence, <code>autoUpdate</code> must be set
            as <b>False</b> if <code>readWrite</code> is <b>True</b> for a dataview.</p>
            </li>
            <li>
               <p>You must also use a unique volume for creating a writeable dataview. So, if you choose a
               volume that is already in use by another dataview, the dataview creation
               fails.</p>
            </li>
            <li>
               <p>Once you create a dataview as writeable, you cannot change it to read-only. So, you cannot
               update the <code>readWrite</code> parameter later.</p>
            </li>
         </ul>

            environment_id: str  # <p>A unique identifier for the kdb environment, where you want to create the dataview. </p>

            database_name: str  # <p>
The name of the database where you want to create a dataview.
</p>

            dataview_name: str  # <p>A unique identifier for the dataview.</p>

            description: str?  # <p>A description of the dataview.</p>

            tags: {str: str}?  # <p>
A list of key-value pairs to label the dataview. You can add up to 50 tags to a dataview.
</p>

            availability_zone_id: str?  # <p>
         The identifier of the availability zones.
      </p>

            segment_configurations: [str]?  # <p>
   The configuration that contains the database path of the data that you want to place on each selected volume. Each segment must have a unique database path for each volume. If you do not explicitly specify any database path for a volume, they are accessible from the cluster through the default S3/object store segment. </p>

            client_token: str  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            changeset_id: str?  # <p>
A unique identifier of the changeset that you want to use to ingest data. </p>

            auto_update: bool?  # <p>The option to specify whether you want to apply all the future additions and corrections automatically to the dataview, when you ingest new changesets. The default value is false.</p>



            # Outputs

            az_mode_output?: str  # <p>The number of availability zones you want to assign per volume. Currently, FinSpace only supports <code>SINGLE</code> for volumes. This places dataview in a single AZ.</p>

            description_output?: str  # <p>A description of the dataview.</p>

            status_output?: str  # <p>
      The status of dataview creation.</p>
         <ul>
            <li>
               <p>
                  <code>CREATING</code> – The dataview creation is in progress.</p>
            </li>
            <li>
               <p>
                  <code>UPDATING</code> – The dataview is in the process of being updated.</p>
            </li>
            <li>
               <p>
                  <code>ACTIVE</code> – The dataview is active.</p>
            </li>
         </ul>

            status_reason_output?: str  # <p>
The error message when a failed state occurs. 
</p>

            active_versions_output?: [str]  # <p>
   The current active changeset versions of the database on the given dataview. 
   
</p>

            read_write_output?: bool  # <p>Returns True if the dataview is created as writeable and False otherwise. </p>

            last_modified_timestamp_output?: str  # <p>
   The last time that the dataview was updated in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.
</p>

            dataview_name_output?: str  # <p>A unique identifier for the dataview.</p>

            database_name_output?: str  # <p>
The name of the database where you created the dataview.</p>

            created_timestamp_output?: str  # <p>The timestamp at which the dataview was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            segment_configurations_output?: [str]  # <p>
      The configuration that contains the database path of the data that you want to place on each selected volume. Each segment must have a unique database path for each volume. If you do not explicitly specify any database path for a volume, they are accessible from the cluster through the default S3/object store segment. </p>

            changeset_id_output?: str  # <p>
A unique identifier of the changeset that you want to use to ingest data. </p>

            auto_update_output?: bool  # <p>The option to specify whether you want to apply all the future additions and corrections automatically to the dataview when new changesets are ingested. The default value is false.</p>

            availability_zone_id_output?: str  # <p>
         The identifier of the availability zones.
      </p>

            environment_id_output?: str  # <p>A unique identifier for the kdb environment, from where you want to retrieve the dataview details.</p>




        schema Kx_environment:
