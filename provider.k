            display_name_output?: str  # <p>The human-readable name of the retrieved chat response configuration, making it easier to identify among multiple configurations.</p>

            chat_response_configuration_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the retrieved chat response configuration, which uniquely identifies the resource across all Amazon Web Services services. </p>

            in_use_configuration_output?: str  # <p>The currently active configuration settings that are being used to generate responses in the Amazon Q Business application.</p>

