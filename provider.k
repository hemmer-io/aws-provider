         <ul>
            <li>
               <p>
                  <code>ACTIVE</code>
               </p>
            </li>
            <li>
               <p>
                  <code>CREATE_PENDING</code>, <code>CREATE_IN_PROGRESS</code>,
                        <code>CREATE_FAILED</code>
               </p>
            </li>
            <li>
               <p>
                  <code>CREATE_STOPPING</code>, <code>CREATE_STOPPED</code>
               </p>
            </li>
            <li>
               <p>
                  <code>DELETE_PENDING</code>, <code>DELETE_IN_PROGRESS</code>,
                        <code>DELETE_FAILED</code>
               </p>
            </li>
         </ul>

            explainability_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the Explainability.</p>

            data_source_output?: str  # 

            start_date_time_output?: str  # <p>If <code>TimePointGranularity</code> is set to <code>SPECIFIC</code>, the first time
            point in the Explainability.</p>





