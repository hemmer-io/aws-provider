    # Personalize Service
    schema PersonalizeService:
        """
        Service for personalize resources.
        """


        schema Schema:
            """
            Schema resource
            """

            schema: str  # <p>A schema in Avro JSON format.</p>

            name: str  # <p>The name for the schema.</p>

            domain: str?  # <p>The domain for the schema. If you are creating a schema for a dataset in a Domain dataset group, specify
    the domain you chose when you created the Domain dataset group.</p>



            # Outputs

            schema_output?: str  # <p>The requested schema.</p>




        schema Solution_version:
            """
            SolutionVersion resource
            """

            name: str?  # <p>The name of the solution version.</p>

            solution_arn: str  # <p>The Amazon Resource Name (ARN) of the solution containing the training configuration
      information.</p>

            training_mode: str?  # <p>The scope of training to be performed when creating the solution version. 
      The default is <code>FULL</code>. This creates a completely new model based on the entirety 
      of the training data from the datasets in your dataset group.
    </p>
         <p>If you use
      <a href="https://docs.aws.amazon.com/personalize/latest/dg/native-recipe-new-item-USER_PERSONALIZATION.html">User-Personalization</a>,
      you can specify a training mode of <code>UPDATE</code>. This updates the model to consider new items for recommendations. It is not a full
        retraining. You should still complete a full retraining weekly.
        If you specify <code>UPDATE</code>, Amazon Personalize will stop automatic updates for the solution version. To resume updates, create a new solution with training mode set to <code>FULL</code>
        and deploy it in a campaign. 
        For more information about automatic updates, see 
        <a href="https://docs.aws.amazon.com/personalize/latest/dg/use-case-recipe-features.html#maintaining-with-automatic-updates">Automatic updates</a>.
      </p>
         <p>The <code>UPDATE</code> option can only be used when you already have an active solution
        version created from the input solution using the <code>FULL</code> option and the input
        solution was trained with the 
        <a href="https://docs.aws.amazon.com/personalize/latest/dg/native-recipe-new-item-USER_PERSONALIZATION.html">User-Personalization</a>
        recipe or the legacy
        <a href="https://docs.aws.amazon.com/personalize/latest/dg/native-recipe-hrnn-coldstart.html">HRNN-Coldstart</a> recipe.</p>

            tags: [str]?  # <p>A list of <a href="https://docs.aws.amazon.com/personalize/latest/dg/tagging-resources.html">tags</a> to apply to the solution version.</p>



            # Outputs

            solution_version_output?: str  # <p>The solution version.</p>




        schema Recipe:
            """
            Recipe resource
            """



            # Outputs

            recipe_output?: str  # <p>An object that describes the recipe.</p>




        schema Batch_segment_job:
            """
            BatchSegmentJob resource
            """

            job_output: str  # <p>The Amazon S3 path for the bucket where the job's output will be stored.</p>

            role_arn: str  # <p>The ARN of the Amazon Identity and Access Management role that has permissions to read and write to your input and output
      Amazon S3 buckets respectively.</p>

            job_input: str  # <p>The Amazon S3 path for the input data used to generate the batch segment job.</p>

            job_name: str  # <p>The name of the batch segment job to create.</p>

            tags: [str]?  # <p>A list of <a href="https://docs.aws.amazon.com/personalize/latest/dg/tagging-resources.html">tags</a> to apply to the batch segment job.</p>

            solution_version_arn: str  # <p>The Amazon Resource Name (ARN) of the solution version you want the batch segment job to use to generate
      batch segments.</p>

            filter_arn: str?  # <p>The ARN of the filter to apply to the batch segment job. For more information on using
      filters, see <a href="https://docs.aws.amazon.com/personalize/latest/dg/filter-batch.html">Filtering batch recommendations</a>.</p>

            num_results: int?  # <p>The number of predicted users generated by the batch segment job for each line of input data. The maximum number of users per segment is 5 million.</p>



            # Outputs

            batch_segment_job_output?: str  # <p>Information on the specified batch segment job.</p>




        schema Dataset_export_job:
            """
            DatasetExportJob resource
            """

            job_name: str  # <p>The name for the dataset export job.</p>

            ingestion_mode: str?  # <p>The data to export, based on how you imported the data. You can choose
      to export only <code>BULK</code> data that you imported using a dataset
      import job, only <code>PUT</code> data that you imported incrementally
      (using the console, PutEvents, PutUsers and PutItems operations), or
        <code>ALL</code> for both types. The default value is <code>PUT</code>.
    </p>

            tags: [str]?  # <p>A list of <a href="https://docs.aws.amazon.com/personalize/latest/dg/tagging-resources.html">tags</a> to apply to the dataset export job.</p>

            job_output: str  # <p>The path to the Amazon S3 bucket where the job's output is stored.</p>

            dataset_arn: str  # <p>The Amazon Resource Name (ARN) of the dataset that contains the data
      to export.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of the IAM service role that has
      permissions to add data to your output Amazon S3 bucket.</p>



            # Outputs

            dataset_export_job_output?: str  # <p>Information about the dataset export job, including the status.</p>
         <p>The status is one of the following values:</p>
         <ul>
            <li>
               <p>CREATE PENDING</p>
            </li>
            <li>
               <p>CREATE IN_PROGRESS</p>
            </li>
            <li>
               <p>ACTIVE</p>
            </li>
            <li>
               <p>CREATE FAILED</p>
            </li>
         </ul>




        schema Batch_inference_job:
            """
            BatchInferenceJob resource
            """

            job_name: str  # <p>The name of the batch inference job to create.</p>

            role_arn: str  # <p>The ARN of the Amazon Identity and Access Management role that has permissions to read and write to your input and output
      Amazon S3 buckets respectively.</p>

            job_output: str  # <p>The path to the Amazon S3 bucket where the job's output will be stored.</p>

            batch_inference_job_mode: str?  # <p>The mode of the batch inference job. To generate descriptive themes for groups of similar items, set the
      job mode to <code>THEME_GENERATION</code>. If you don't want to generate themes, use the default <code>BATCH_INFERENCE</code>.</p>
         <p>
      When you get batch recommendations with themes, you will incur additional costs. For more information, see <a href="https://aws.amazon.com/personalize/pricing/">Amazon Personalize pricing</a>.
    </p>

            filter_arn: str?  # <p>The ARN of the filter to apply to the batch inference job. For more information on using
      filters, see
      <a href="https://docs.aws.amazon.com/personalize/latest/dg/filter-batch.html">Filtering batch recommendations</a>.</p>

            tags: [str]?  # <p>A list of <a href="https://docs.aws.amazon.com/personalize/latest/dg/tagging-resources.html">tags</a> to apply to the batch inference job.</p>

            num_results: int?  # <p>The number of recommendations to retrieve.</p>

            solution_version_arn: str  # <p>The Amazon Resource Name (ARN) of the solution version that will be used to generate the
      batch inference recommendations.</p>

            batch_inference_job_config: str?  # <p>The configuration details of a batch inference job.</p>

            theme_generation_config: str?  # <p>For theme generation jobs, specify the name of the column in your Items
      dataset that contains each item's name.</p>

            job_input: str  # <p>The Amazon S3 path that leads to the input file to base your recommendations on. The input
      material must be in JSON format.</p>



            # Outputs

            batch_inference_job_output?: str  # <p>Information on the specified batch inference job.</p>




        schema Event_tracker:
            """
