            is_long_term_pricing_auto_renew: bool?  # <p>Specifies whether the current long-term pricing type for the device should be
      renewed.</p>




        schema Return_shipping_label:
            """
            ReturnShippingLabel resource
            """

            job_id: str  # <p>The ID for a job that you want to create the return shipping label for; for example,
        <code>JID123e4567-e89b-12d3-a456-426655440000</code>.</p>

            shipping_option: str?  # <p>The shipping speed for a particular job. This speed doesn't dictate how soon the device
      is returned to Amazon Web Services. This speed represents how quickly it moves to its
      destination while in transit. Regional shipping speeds are as follows:</p>



            # Outputs

            expiration_date_output?: str  # <p>The expiration date of the current return shipping label.</p>

            return_shipping_label_uri_output?: str  # <p>The pre-signed Amazon S3 URI used to download the return shipping label.</p>

            status_output?: str  # <p>The status information of the task on a Snow device that is being returned to Amazon Web Services.</p>




        schema Job:
            """
            Job resource
            """

            long_term_pricing_id: int?  # <p>The ID of the long-term pricing type for the device.</p>

            kms_key_arn: str?  # <p>The <code>KmsKeyARN</code> that you want to associate with this job.
        <code>KmsKeyARN</code>s are created using the <a href="https://docs.aws.amazon.com/kms/latest/APIReference/API_CreateKey.html">CreateKey</a>
      Key Management Service (KMS) API action.</p>

            snowball_type: str?  # <p>The type of Snow Family devices to use for this job.
      </p>
         <note>
            <p>For cluster jobs, Amazon Web Services Snow Family currently supports only the
          <code>EDGE</code> device type.</p>
         </note>
         <p>The type of Amazon Web Services Snow device to use for this job. Currently, the only
      supported device type for cluster jobs is <code>EDGE</code>.</p>
         <p>For more information, see <a href="https://docs.aws.amazon.com/snowball/latest/developer-guide/device-differences.html">Snowball Edge Device
        Options</a> in the Snowball Edge Developer Guide.</p>
         <p>For more information, see
      "https://docs.aws.amazon.com/snowball/latest/snowcone-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i> or
      "https://docs.aws.amazon.com/snowball/latest/developer-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i>.</p>

            snowball_capacity_preference: str?  # <p>If your job is being created in one of the US regions, you have the option of
      specifying what size Snow device you'd like for this job. In all other regions, Snowballs come
      with 80 TB in storage capacity.</p>
         <p>For more information, see
      "https://docs.aws.amazon.com/snowball/latest/snowcone-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i> or
      "https://docs.aws.amazon.com/snowball/latest/developer-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i>.</p>

            address_id: str?  # <p>The ID for the address that you want the Snow device shipped to.</p>

            description: str?  # <p>Defines an optional description of this specific job, for example <code>Important
        Photos 2016-08-11</code>.</p>

            cluster_id: str?  # <p>The ID of a cluster. If you're creating a job for a node in a cluster, you need to
      provide only this <code>clusterId</code> value. The other job attributes are inherited from
      the cluster.</p>

            notification: str?  # <p>Defines the Amazon Simple Notification Service (Amazon SNS) notification settings for
      this job.</p>

            tax_documents: str?  # <p>The tax documents required in your Amazon Web Services Region.</p>

            remote_management: str?  # <p>Allows you to securely operate and manage Snowcone devices remotely from outside of your
      internal network. When set to <code>INSTALLED_AUTOSTART</code>, remote management will
      automatically be available when the device arrives at your location. Otherwise, you need to
      use the Snowball Edge client to manage the device. When set to <code>NOT_INSTALLED</code>, remote management will not be available on the device. </p>

            role_arn: str?  # <p>The <code>RoleARN</code> that you want to associate with this job.
      <code>RoleArn</code>s are created using the <a href="https://docs.aws.amazon.com/IAM/latest/APIReference/API_CreateRole.html">CreateRole</a>
      Identity and Access Management (IAM) API action.</p>

            impact_level: str?  # <p>The highest impact level of data that will be stored or processed on the device, provided at job creation.</p>

            job_type: str?  # <p>Defines the type of job that you're creating.
      </p>

            pickup_details: str?  # <p>Information identifying the person picking up the device.</p>

            forwarding_address_id: str?  # <p>The forwarding address ID for a job. This field is not supported in most
      Regions.</p>

            on_device_service_configuration: str?  # <p>Specifies the service or services on the Snow Family device that your transferred data
      will be exported from or imported into. Amazon Web Services Snow Family supports Amazon S3 and NFS (Network File
      System) and the Amazon Web Services Storage Gateway service Tape Gateway type.</p>

            device_configuration: str?  # <p>Defines the device configuration for an Snowball Edge job.</p>
         <p>For more information, see
      "https://docs.aws.amazon.com/snowball/latest/snowcone-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i> or
      "https://docs.aws.amazon.com/snowball/latest/developer-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i>.</p>

            resources: str?  # <p>Defines the Amazon S3 buckets associated with this job.</p>
         <p>With <code>IMPORT</code> jobs, you specify the bucket or buckets that your transferred
      data will be imported into.</p>
         <p>With <code>EXPORT</code> jobs, you specify the bucket or buckets that your transferred
      data will be exported from. Optionally, you can also specify a <code>KeyRange</code> value. If
      you choose to export a range, you define the length of the range by providing either an
      inclusive <code>BeginMarker</code> value, an inclusive <code>EndMarker</code> value, or both.
      Ranges are UTF-8 binary sorted.</p>

            shipping_option: str?  # <p>The shipping speed for this job. This speed doesn't dictate how soon you'll get the
      Snow device, rather it represents how quickly the Snow device moves to its destination while
      in transit. Regional shipping speeds are as follows:</p>
         <ul>
            <li>
               <p>In Australia, you have access to express shipping. Typically, Snow devices shipped
          express are delivered in about a day.</p>
            </li>
            <li>
               <p>In the European Union (EU), you have access to express shipping. Typically, Snow
          devices shipped express are delivered in about a day. In addition, most countries in the
          EU have access to standard shipping, which typically takes less than a week, one
          way.</p>
            </li>
            <li>
               <p>In India, Snow devices are delivered in one to seven days.</p>
            </li>
            <li>
               <p>In the US, you have access to one-day shipping and two-day shipping.</p>
            </li>
         </ul>



            # Outputs

            job_metadata_output?: str  # <p>Information about a specific job, including shipping information, job status, and other
      important metadata.</p>

            sub_job_metadata_output?: [str]  # <p>Information about a specific job part (in the case of an export job), including
      shipping information, job status, and other important metadata.</p>




        schema Job_unlock_code:
            """
            JobUnlockCode resource
            """



            # Outputs

            unlock_code_output?: str  # <p>The <code>UnlockCode</code> value for the specified job. The <code>UnlockCode</code>
      value can be accessed for up to 360 days after the job has been created.</p>




        schema Snowball_usage:
            """
            SnowballUsage resource
            """



            # Outputs

            snowballs_in_use_output?: int  # <p>The number of Snow devices that this account is currently using.</p>

            snowball_limit_output?: int  # <p>The service limit for number of Snow devices this account can have at once. The default
      service limit is 1 (one).</p>




        schema Address:
            """
            Address resource
            """

            address: str  # <p>The address that you want the Snow device shipped to.</p>



            # Outputs

            address_output?: str  # <p>The address that you want the Snow device(s) associated with a specific job to be
      shipped to.</p>




        schema Cluster:
            """
            Cluster resource
            """

            tax_documents: str?  # <p>The tax documents required in your Amazon Web Services Region.</p>

            initial_cluster_size: int?  # <p>If provided, each job will be automatically created and associated with the new cluster. If not provided, will be treated as 0.</p>

            force_create_jobs: bool?  # <p>Force to create cluster when user attempts to overprovision or underprovision a cluster. A cluster is overprovisioned or underprovisioned if the initial size of the cluster is more (overprovisioned) or less (underprovisioned) than what 
      needed to meet capacity requirement specified with <code>OnDeviceServiceConfiguration</code>.</p>

            description: str?  # <p>An optional description of this specific cluster, for example <code>Environmental Data
        Cluster-01</code>.</p>

            snowball_capacity_preference: str?  # <p>If your job is being created in one of the US regions, you have the option of
      specifying what size Snow device you'd like for this job. In all other regions, Snowballs come
      with 80 TB in storage capacity.</p>
         <p>For more information, see
      "https://docs.aws.amazon.com/snowball/latest/snowcone-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i> or
      "https://docs.aws.amazon.com/snowball/latest/developer-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i>.</p>

            job_type: str  # <p>The type of job for this cluster. Currently, the only job type supported for clusters
      is <code>LOCAL_USE</code>.</p>
         <p>For more information, see
      "https://docs.aws.amazon.com/snowball/latest/snowcone-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i> or
      "https://docs.aws.amazon.com/snowball/latest/developer-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i>.</p>

            forwarding_address_id: str?  # <p>The forwarding address ID for a cluster. This field is not supported in most
      regions.</p>

            notification: str?  # <p>The Amazon Simple Notification Service (Amazon SNS) notification settings for this
      cluster.</p>

            role_arn: str?  # <p>The <code>RoleARN</code> that you want to associate with this cluster.
        <code>RoleArn</code> values are created by using the <a href="https://docs.aws.amazon.com/IAM/latest/APIReference/API_CreateRole.html">CreateRole</a> API action in Identity and Access Management (IAM).</p>

            kms_key_arn: str?  # <p>The <code>KmsKeyARN</code> value that you want to associate with this cluster.
        <code>KmsKeyARN</code> values are created by using the <a href="https://docs.aws.amazon.com/kms/latest/APIReference/API_CreateKey.html">CreateKey</a> API action in Key Management Service (KMS). </p>

            resources: str?  # <p>The resources associated with the cluster job. These resources include Amazon S3
      buckets and optional Lambda functions written in the Python language.
    </p>

            shipping_option: str  # <p>The shipping speed for each node in this cluster. This speed doesn't dictate how soon
      you'll get each Snowball Edge device, rather it represents how quickly each device moves to
      its destination while in transit. Regional shipping speeds are as follows: </p>
         <ul>
            <li>
               <p>In Australia, you have access to express shipping. Typically, Snow devices shipped
          express are delivered in about a day.</p>
            </li>
            <li>
               <p>In the European Union (EU), you have access to express shipping. Typically, Snow
          devices shipped express are delivered in about a day. In addition, most countries in the
          EU have access to standard shipping, which typically takes less than a week, one
          way.</p>
            </li>
            <li>
               <p>In India, Snow devices are delivered in one to seven days.</p>
            </li>
            <li>
               <p>In the United States of America (US), you have access to one-day shipping and
          two-day shipping.</p>
            </li>
         </ul>
         <ul>
            <li>
               <p>In Australia, you have access to express shipping. Typically, devices shipped
          express are delivered in about a day.</p>
            </li>
            <li>
               <p>In the European Union (EU), you have access to express shipping. Typically, Snow
          devices shipped express are delivered in about a day. In addition, most countries in the
          EU have access to standard shipping, which typically takes less than a week, one
          way.</p>
            </li>
            <li>
               <p>In India, Snow devices are delivered in one to seven days.</p>
            </li>
            <li>
               <p>In the US, you have access to one-day shipping and two-day shipping.</p>
            </li>
         </ul>

            long_term_pricing_ids: int?  # <p>Lists long-term pricing id that will be used to associate with jobs automatically created for the new cluster.</p>

            address_id: str  # <p>The ID for the address that you want the cluster shipped to.</p>

            on_device_service_configuration: str?  # <p>Specifies the service or services on the Snow Family device that your transferred data
      will be exported from or imported into. Amazon Web Services Snow Family device clusters support Amazon S3 and NFS
      (Network File System).</p>

            snowball_type: str  # <p>The type of Snow Family devices to use for this cluster. </p>
         <note>
            <p>For cluster jobs, Amazon Web Services Snow Family currently supports only the
          <code>EDGE</code> device type.</p>
         </note>
         <p>For more information, see
      "https://docs.aws.amazon.com/snowball/latest/snowcone-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i> or
      "https://docs.aws.amazon.com/snowball/latest/developer-guide/snow-device-types.html" (Snow
      Family Devices and Capacity) in the <i>Snowcone User Guide</i>.</p>

            remote_management: str?  # <p>Allows you to securely operate and manage Snow devices in a cluster remotely from outside
      of your internal network. When set to <code>INSTALLED_AUTOSTART</code>, remote management will
      automatically be available when the device arrives at your location. Otherwise, you need to
      use the Snowball Client to manage the device.</p>



            # Outputs

            cluster_metadata_output?: str  # <p>Information about a specific cluster, including shipping information, cluster status,
      and other important metadata.</p>





    # Quicksight Service
    schema QuicksightService:
        """
        Service for quicksight resources.
        """


        schema Action_connector:
            """
            ActionConnector resource
            """

            tags: [str]?  # <p>A list of tags to apply to the action connector for resource management and organization.</p>

            action_connector_id: str  # <p>A unique identifier for the action connector. This ID must be unique within the Amazon Web Services account. The <code>ActionConnectorId</code> must not
	          start with the prefix <code>quicksuite-</code>
         </p>

            name: str  # <p>A descriptive name for the action connector.</p>

            authentication_config: str  # <p>The authentication configuration for connecting to the external service. This includes the authentication type, base URL, and authentication metadata such as client credentials or API keys.</p>

            type: str  # <p>The type of action connector.</p>

            permissions: [str]?  # <p>The permissions configuration that defines which users, groups, or namespaces can access this action connector and what operations they can perform.</p>

            vpc_connection_arn: str?  # <p>The ARN of the VPC connection to use for secure connectivity to the external service.</p>

            description: str?  # <p>An optional description of the action connector.</p>

            aws_account_id: str  # <p>The Amazon Web Services account ID associated with the action connector.</p>



            # Outputs

            status_output?: int  # <p>The HTTP status code of the request.</p>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>

            action_connector_output?: str  # <p>The detailed information about the action connector, including its configuration and current state.</p>




        schema Role_custom_permission:
            """
            RoleCustomPermission resource
            """

            namespace: str  # <p>The namespace that contains the role that you want to update.</p>

            custom_permissions_name: str  # <p>The name of the custom permission that you want to update the role with.</p>

            role: str  # <p>The name of role tht you want to update.</p>

            aws_account_id: str  # <p>The ID for the Amazon Web Services account that you want to create a group in. The Amazon Web Services account ID that you provide must be the same Amazon Web Services account that contains your Amazon Quick Sight account.</p>



            # Outputs

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>

            status_output?: int  # <p>The HTTP status of the request.</p>

            custom_permissions_name_output?: str  # <p>The name of the custom permission that is described.</p>




        schema Dashboard_snapshot_job:
            """
            DashboardSnapshotJob resource
            """



            # Outputs

            snapshot_job_id_output?: str  # <p>The ID of the job to be described. The job ID is set when you start a new job with a <code>StartDashboardSnapshotJob</code> API call.</p>

            request_id_output?: str  # <p>
            The Amazon Web Services request ID for this operation.
        </p>

            aws_account_id_output?: str  # <p>
            The ID of the Amazon Web Services account that the dashboard snapshot job is executed in.
        </p>

            arn_output?: str  # <p>The Amazon Resource Name (ARN) for the snapshot job. The job ARN is generated when you start a new job with a <code>StartDashboardSnapshotJob</code> API call.</p>

            job_status_output?: str  # <p>Indicates the status of a job. The status updates as the job executes. This shows one of the following values.</p>
         <ul>
            <li>
               <p>
                  <code>COMPLETED</code> - The job was completed successfully.</p>
            </li>
            <li>
               <p>
                  <code>FAILED</code> - The job failed to execute.</p>
            </li>
            <li>
               <p>
                  <code>QUEUED</code> - The job is queued and hasn't started yet.</p>
            </li>
            <li>
               <p>
                  <code>RUNNING</code> - The job is still running.</p>
            </li>
         </ul>

            dashboard_id_output?: str  # <p>The ID of the dashboard that you have started a snapshot job for.</p>

            snapshot_configuration_output?: str  # <p>The snapshot configuration of the job. This information is provided when you make a <code>StartDashboardSnapshotJob</code> API call.</p>

            user_configuration_output?: str  # <p>The user configuration for the snapshot job. This information is provided when you make a <code>StartDashboardSnapshotJob</code> API call.</p>

            created_time_output?: str  # <p>
            The time that the snapshot job was created.
        </p>

            last_updated_time_output?: str  # <p>
            The time that the snapshot job status was last updated.
        </p>

            status_output?: int  # <p>The HTTP status of the request</p>




        schema Application_with_token_exchange_grant:
            """
            ApplicationWithTokenExchangeGrant resource
            """

            aws_account_id: str  # <p>The ID of the Amazon Web Services account to be updated with a token exchange grant.</p>

            namespace: str  # <p>The namespace of the QuickSight application.</p>




        schema Folder_membership:
            """
            FolderMembership resource
            """

            folder_id: str  # <p>The ID of the folder.</p>

            aws_account_id: str  # <p>The ID for the Amazon Web Services account that contains the folder.</p>

            member_type: str  # <p>The member type of the asset that you want to add to a folder.</p>

            member_id: str  # <p>The ID of the asset that you want to add to the folder.</p>




        schema Topic_refresh:
            """
            TopicRefresh resource
            """



            # Outputs

            status_output?: int  # <p>The HTTP status of the request.</p>

            refresh_details_output?: str  # <p>Details of the refresh, which is performed when the topic is created or updated.</p>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>




        schema Account_customization:
            """
            AccountCustomization resource
            """

            namespace: str?  # <p>The Quick Sight namespace that you want to add customizations to.</p>

            aws_account_id: str  # <p>The ID for the Amazon Web Services account that you want to customize Quick Sight for.</p>

            account_customization: str  # <p>The Quick Sight customizations you're adding. You can add
            these to an Amazon Web Services account and a QuickSight namespace. </p>
         <p>For example, you can add a default theme by setting <code>AccountCustomization</code>
            to the midnight theme: <code>"AccountCustomization": { "DefaultTheme":
                "arn:aws:quicksight::aws:theme/MIDNIGHT" }</code>. Or, you can add a custom theme by
            specifying <code>"AccountCustomization": { "DefaultTheme":
                "arn:aws:quicksight:us-west-2:111122223333:theme/bdb844d0-0fe9-4d9d-b520-0fe602d93639"
                }</code>. </p>

            tags: [str]?  # <p>A list of the tags that you want to attach to this resource.</p>



            # Outputs

            aws_account_id_output?: str  # <p>The ID for the Amazon Web Services account that you're describing.</p>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>

            namespace_output?: str  # <p>The Quick Sight namespace that you're describing. </p>

            account_customization_output?: str  # <p>The Quick Sight customizations that exist. </p>

            status_output?: int  # <p>The HTTP status of the request.</p>

            arn_output?: str  # <p>The Amazon Resource Name (ARN) of the customization that's associated with this Amazon Web Services account.</p>




        schema Vpc_connection:
            """
            VPCConnection resource
            """

            dns_resolvers: [str]?  # <p>A list of IP addresses of DNS resolver endpoints for the VPC connection.</p>

            role_arn: str  # <p>The IAM role to associate with the VPC connection.</p>

            tags: [str]?  # <p>A map of the key-value pairs for the resource tag or tags assigned to the VPC
			connection.</p>

            aws_account_id: str  # <p>The Amazon Web Services account ID of the account where you want to create a new VPC
			connection.</p>

            name: str  # <p>The display name for the VPC connection.</p>

            vpc_connection_id: str  # <p>The ID of the VPC connection that
			you're creating. This ID is a unique identifier for each Amazon Web Services Region in an
				Amazon Web Services account.</p>

            security_group_ids: [str]  # <p>A list of security group IDs for the VPC connection.</p>

            subnet_ids: [str]  # <p>A list of subnet IDs for the VPC connection.</p>



            # Outputs

            vpc_connection_output?: str  # <p>A response object that provides information for the specified VPC connection.</p>

            status_output?: int  # <p>The HTTP status of the request.</p>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>




        schema Data_source_permissions:
            """
            DataSourcePermissions resource
            """

            grant_permissions: [str]?  # <p>A list of resource permissions that you want to grant on the data source.</p>

            data_source_id: str  # <p>The ID of the data source. This ID is unique per Amazon Web Services Region for each
				Amazon Web Services account. </p>

            revoke_permissions: [str]?  # <p>A list of resource permissions that you want to revoke on the data source.</p>

            aws_account_id: str  # <p>The Amazon Web Services account ID.</p>



            # Outputs

            data_source_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the data source.</p>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>

            data_source_id_output?: str  # <p>The ID of the data source. This ID is unique per Amazon Web Services Region for each
				Amazon Web Services account.</p>

            status_output?: int  # <p>The HTTP status of the request.</p>

            permissions_output?: [str]  # <p>A list of resource permissions on the data source.</p>




        schema Analysis_permissions:
            """
            AnalysisPermissions resource
            """

            aws_account_id: str  # <p>The ID of the Amazon Web Services account that contains the analysis whose permissions you're
            updating. You must be using the Amazon Web Services account that the analysis is in.</p>

            grant_permissions: [str]?  # <p>A structure that describes the permissions to add and the principal to add them
            to.</p>

            revoke_permissions: [str]?  # <p>A structure that describes the permissions to remove and the principal to remove them
            from.</p>

            analysis_id: str  # <p>The ID of the analysis whose permissions you're updating. The ID is part of the
            analysis URL.</p>



            # Outputs

            status_output?: int  # <p>The HTTP status of the request.</p>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>

            analysis_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the analysis whose permissions you're
            describing.</p>

            analysis_id_output?: str  # <p>The ID of the analysis whose permissions you're describing.</p>

            permissions_output?: [str]  # <p>A structure that describes the principals and the resource-level permissions on an
            analysis.</p>




        schema Brand_assignment:
            """
            BrandAssignment resource
            """

            aws_account_id: str  # <p>The ID of the Amazon Web Services account that owns the brand assignment.</p>

            brand_arn: str  # <p>The Amazon Resource Name (ARN) of the brand.</p>



            # Outputs

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>

            brand_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the brand.</p>




        schema Dashboard:
            """
            Dashboard resource
            """

            definition: str?  # <p>The definition of a dashboard.</p>
         <p>A definition is the data model of all features in a Dashboard, Template, or Analysis.</p>
         <p>Either a <code>SourceEntity</code> or a <code>Definition</code> must be provided in
            order for the request to be valid.</p>

            source_entity: str?  # <p>The entity that you are using as a source when you create the dashboard. In
                <code>SourceEntity</code>, you specify the type of object you're using as source.
            You can only create a dashboard from a template, so you use a
                <code>SourceTemplate</code> entity. If you need to create a dashboard from an
            analysis, first convert the analysis to a template by using the <code>
               <a href="https://docs.aws.amazon.com/quicksight/latest/APIReference/API_CreateTemplate.html">CreateTemplate</a>
            </code> API operation. For <code>SourceTemplate</code>,
            specify the Amazon Resource Name (ARN) of the source template. The
                <code>SourceTemplate</code>ARN can contain any Amazon Web Services account and any
                Amazon Quick Sight-supported Amazon Web Services Region. </p>
         <p>Use the <code>DataSetReferences</code> entity within <code>SourceTemplate</code> to
            list the replacement datasets for the placeholders listed in the original. The schema in
            each dataset must match its placeholder. </p>
         <p>Either a <code>SourceEntity</code> or a <code>Definition</code> must be provided in
            order for the request to be valid.</p>

            tags: [str]?  # <p>Contains a map of the key-value pairs for the resource tag or tags assigned to the
            dashboard.</p>

            dashboard_id: str  # <p>The ID for the dashboard, also added to the IAM policy.</p>

            folder_arns: [str]?  # <p>When you create the dashboard, Amazon Quick Sight adds the dashboard to these
            folders.</p>

            link_entities: [str]?  # <p>A list of analysis Amazon Resource Names (ARNs) to be linked to the dashboard.</p>

            link_sharing_configuration: str?  # <p>A structure that contains the permissions of a shareable link to the dashboard.</p>

            version_description: str?  # <p>A description for the first version of the dashboard being created.</p>

            theme_arn: str?  # <p>The Amazon Resource Name (ARN) of the theme that is being used for this dashboard. If
            you add a value for this field, it overrides the value that is used in the source
            entity. The theme ARN must exist in the same Amazon Web Services account where you create
            the dashboard.</p>

            validation_strategy: str?  # <p>The option to relax the validation needed to create a dashboard with definition
            objects. This option skips the validation step for specific errors.</p>

            dashboard_publish_options: str?  # <p>Options for publishing the dashboard when you create it:</p>
         <ul>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>AdHocFilteringOption</code> - This
                    status can be either <code>ENABLED</code> or <code>DISABLED</code>. When this is
                    set to <code>DISABLED</code>, Amazon Quick Sight disables the left filter pane on
                    the published dashboard, which can be used for ad hoc (one-time) filtering. This
                    option is <code>ENABLED</code> by default. </p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>ExportToCSVOption</code> - This
                    status can be either <code>ENABLED</code> or <code>DISABLED</code>. The visual
                    option to export data to .CSV format isn't enabled when this is set to
                        <code>DISABLED</code>. This option is <code>ENABLED</code> by default.
                </p>
            </li>
            <li>
               <p>
                  <code>VisibilityState</code> for <code>SheetControlsOption</code> - This
                    visibility state can be either <code>COLLAPSED</code> or <code>EXPANDED</code>.
                    This option is <code>COLLAPSED</code> by default. </p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>QuickSuiteActionsOption</code> -
                    This status can be either <code>ENABLED</code> or <code>DISABLED</code>.
                    Features related to Actions in Amazon Quick Suite on dashboards are disabled
                    when this is set to <code>DISABLED</code>. This option is <code>DISABLED</code>
                    by default.</p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>ExecutiveSummaryOption</code> - This
                    status can be either <code>ENABLED</code> or <code>DISABLED</code>. The option
                    to build an executive summary is disabled when this is set to
                        <code>DISABLED</code>. This option is <code>ENABLED</code> by
                    default.</p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>DataStoriesSharingOption</code> -
                    This status can be either <code>ENABLED</code> or <code>DISABLED</code>. The
                    option to share a data story is disabled when this is set to
                        <code>DISABLED</code>. This option is <code>ENABLED</code> by
                    default.</p>
            </li>
         </ul>

            aws_account_id: str  # <p>The ID of the Amazon Web Services account where you want to create the
            dashboard.</p>

            name: str  # <p>The display name of the dashboard.</p>

            permissions: [str]?  # <p>A structure that contains the permissions of the dashboard. You can use this structure
            for granting permissions by providing a list of IAM action information
            for each principal ARN. </p>
         <p>To specify no permissions, omit the permissions list.</p>

            parameters: str?  # <p>The parameters for the creation of the dashboard, which you want to use to override
            the default settings. A dashboard can have any type of parameters, and some parameters
            might accept multiple values. </p>



            # Outputs

            status_output?: int  # <p>The HTTP status of this request.</p>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>

            dashboard_output?: str  # <p>Information about the dashboard.</p>




        schema Dashboard_definition:
            """
            DashboardDefinition resource
            """



            # Outputs

            errors_output?: [str]  # <p>Errors associated with this dashboard version.</p>

            dashboard_id_output?: str  # <p>The ID of the dashboard described.</p>

            definition_output?: str  # <p>The definition of a dashboard.</p>
         <p>A definition is the data model of all features in a Dashboard, Template, or Analysis.</p>

            dashboard_publish_options_output?: str  # <p>Options for publishing the dashboard:</p>
         <ul>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>AdHocFilteringOption</code> - This
                    status can be either <code>ENABLED</code> or <code>DISABLED</code>. When this is
                    set to <code>DISABLED</code>, Amazon Quick Sight disables the left filter pane on
                    the published dashboard, which can be used for ad hoc (one-time) filtering. This
                    option is <code>ENABLED</code> by default. </p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>ExportToCSVOption</code> - This
                    status can be either <code>ENABLED</code> or <code>DISABLED</code>. The visual
                    option to export data to .CSV format isn't enabled when this is set to
                        <code>DISABLED</code>. This option is <code>ENABLED</code> by default.
                </p>
            </li>
            <li>
               <p>
                  <code>VisibilityState</code> for <code>SheetControlsOption</code> - This
                    visibility state can be either <code>COLLAPSED</code> or <code>EXPANDED</code>.
                    This option is <code>COLLAPSED</code> by default. </p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>QuickSuiteActionsOption</code> -
                    This status can be either <code>ENABLED</code> or <code>DISABLED</code>.
                    Features related to Actions in Amazon Quick Suite on dashboards are disabled
                    when this is set to <code>DISABLED</code>. This option is <code>DISABLED</code>
                    by default.</p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>ExecutiveSummaryOption</code> - This
                    status can be either <code>ENABLED</code> or <code>DISABLED</code>. The option
                    to build an executive summary is disabled when this is set to
                        <code>DISABLED</code>. This option is <code>ENABLED</code> by
                    default.</p>
            </li>
            <li>
               <p>
                  <code>AvailabilityStatus</code> for <code>DataStoriesSharingOption</code> -
                    This status can be either <code>ENABLED</code> or <code>DISABLED</code>. The
                    option to share a data story is disabled when this is set to
                        <code>DISABLED</code>. This option is <code>ENABLED</code> by
                    default.</p>
            </li>
         </ul>

            status_output?: int  # <p>The HTTP status of the request.</p>

            theme_arn_output?: str  # <p>The ARN of the theme of the dashboard.</p>

            name_output?: str  # <p>The display name of the dashboard.</p>

            resource_status_output?: str  # <p>Status associated with the dashboard version.</p>
         <ul>
            <li>
               <p>
                  <code>CREATION_IN_PROGRESS</code>
               </p>
            </li>
            <li>
               <p>
                  <code>CREATION_SUCCESSFUL</code>
               </p>
            </li>
            <li>
               <p>
                  <code>CREATION_FAILED</code>
               </p>
            </li>
            <li>
               <p>
                  <code>UPDATE_IN_PROGRESS</code>
               </p>
            </li>
            <li>
               <p>
                  <code>UPDATE_SUCCESSFUL</code>
               </p>
            </li>
            <li>
               <p>
                  <code>UPDATE_FAILED</code>
               </p>
            </li>
            <li>
               <p>
                  <code>DELETED</code>
               </p>
            </li>
         </ul>

            request_id_output?: str  # <p>The Amazon Web Services request ID for this operation.</p>




