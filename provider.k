            request_parameters: {str: str}?  # <p>A key-value map defining required or optional method request parameters that can be accepted by API Gateway. A key defines a method request parameter name matching the pattern of  <code>method.request.{location}.{name}</code>, where <code>location</code> is <code>querystring</code>, <code>path</code>, or <code>header</code> and <code>name</code> is a valid and unique parameter name. The value associated with the key is a Boolean flag indicating whether the parameter is required (<code>true</code>) or optional (<code>false</code>).  The method request parameter names defined here are available in Integration to be mapped to integration request parameters or body-mapping templates.</p>

            authorization_scopes: str?  # <p>A list of authorization scopes configured on the method. The scopes are used with a <code>COGNITO_USER_POOLS</code> authorizer to authorize the method invocation. The authorization works by matching the method scopes against the scopes parsed from the access token in the incoming request. The method invocation is authorized if any method scopes matches a claimed scope in the access token. Otherwise, the invocation is not authorized. When the method scope is configured, the client must provide an access token instead of an identity token for authorization purposes.</p>

            operation_name: str?  # <p>A human-friendly operation identifier for the method. For example, you can assign the <code>operationName</code> of <code>ListPets</code> for the <code>GET /pets</code> method in the <code>PetStore</code> example.</p>

            request_models: str?  # <p>Specifies the Model resources used for the request's content type. Request models are represented as a key/value map, with a content type as the key and a Model name as the value.</p>

            request_validator_id: str?  # <p>The identifier of a RequestValidator for validating the method request.</p>

            authorization_type: str  # <p>The method's authorization type. Valid values are <code>NONE</code> for open access, <code>AWS_IAM</code> for using AWS IAM permissions, <code>CUSTOM</code> for using a custom authorizer, or <code>COGNITO_USER_POOLS</code> for using a Cognito user pool.</p>

            rest_api_id: str  # <p>The string identifier of the associated RestApi.</p>



            # Outputs

            method_integration_output?: str  # <p>Gets the method's integration responsible for passing the client-submitted request to the back end and performing necessary transformations to make the request compliant with the back end.</p>

            authorization_scopes_output?: str  # <p>A list of authorization scopes configured on the method. The scopes are used with a <code>COGNITO_USER_POOLS</code> authorizer to authorize the method invocation. The authorization works by matching the method scopes against the scopes parsed from the access token in the incoming request. The method invocation is authorized if any method scopes matches a claimed scope in the access token. Otherwise, the invocation is not authorized. When the method scope is configured, the client must provide an access token instead of an identity token for authorization purposes.</p>

            api_key_required_output?: bool  # <p>A boolean flag specifying whether a valid ApiKey is required to invoke this method.</p>

            http_method_output?: str  # <p>The method's HTTP verb.</p>

            authorizer_id_output?: str  # <p>The identifier of an Authorizer to use on this method. The <code>authorizationType</code> must be <code>CUSTOM</code>.</p>

            authorization_type_output?: str  # <p>The method's authorization type. Valid values are <code>NONE</code> for open access, <code>AWS_IAM</code> for using AWS IAM permissions, <code>CUSTOM</code> for using a custom authorizer, or <code>COGNITO_USER_POOLS</code> for using a Cognito user pool.</p>

            operation_name_output?: str  # <p>A human-friendly operation identifier for the method. For example, you can assign the <code>operationName</code> of <code>ListPets</code> for the <code>GET /pets</code> method in the <code>PetStore</code> example.</p>

            request_validator_id_output?: str  # <p>The identifier of a RequestValidator for request validation.</p>

            request_parameters_output?: {str: str}  # <p>A key-value map defining required or optional method request parameters that can be accepted by API Gateway. A key is a method request parameter name matching the pattern of  <code>method.request.{location}.{name}</code>, where <code>location</code> is <code>querystring</code>, <code>path</code>, or <code>header</code> and <code>name</code> is a valid and unique parameter name. The value associated with the key is a Boolean flag indicating whether the parameter is required (<code>true</code>) or optional (<code>false</code>).  The method request parameter names defined here are available in Integration to be mapped to integration request parameters or templates.</p>

            request_models_output?: str  # <p>A key-value map specifying data schemas, represented by Model resources, (as the mapped value) of the request payloads of given content types (as the mapping key).</p>

            method_responses_output?: {str: str}  # <p>Gets a method response associated with a given HTTP status code. </p>





    # Lookoutequipment Service
    schema LookoutequipmentService:
        """
        Service for lookoutequipment resources.
        """


        schema Data_ingestion_job:
            """
            DataIngestionJob resource
            """



            # Outputs

            source_dataset_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the source dataset from which the data used for the
         data ingestion job was imported from.</p>

            ingested_data_size_output?: int  # <p> Indicates the size of the ingested dataset. </p>

            ingestion_input_configuration_output?: str  # <p>Specifies the S3 location configuration for the data input for the data ingestion job.
      </p>

            created_at_output?: str  # <p>The time at which the data ingestion job was created. </p>

            dataset_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the dataset being used in the data ingestion job.
      </p>

            data_quality_summary_output?: str  # <p> Gives statistics about a completed ingestion job. These statistics primarily relate to
         quantifying incorrect data such as MissingCompleteSensorData, MissingSensorData,
         UnsupportedDateFormats, InsufficientSensorData, and DuplicateTimeStamps. </p>

            failed_reason_output?: str  # <p>Specifies the reason for failure when a data ingestion job has failed. </p>

            status_detail_output?: str  # <p> Provides details about status of the ingestion job that is currently in progress.
      </p>

            data_start_time_output?: str  # <p> Indicates the earliest timestamp corresponding to data that was successfully ingested
         during this specific ingestion job. </p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of an IAM role with permission to access the data source
         being ingested. </p>

            job_id_output?: str  # <p>Indicates the job ID of the data ingestion job. </p>

            status_output?: str  # <p>Indicates the status of the <code>DataIngestionJob</code> operation. </p>

            ingested_files_summary_output?: str  # 

            data_end_time_output?: str  # <p> Indicates the latest timestamp corresponding to data that was successfully ingested
         during this specific ingestion job. </p>




        schema Inference_scheduler:
            """
            InferenceScheduler resource
            """

            inference_scheduler_name: str  # <p>The name of the inference scheduler being created. </p>

            data_input_configuration: str  # <p>Specifies configuration information for the input data for the inference scheduler,
         including delimiter, format, and dataset location. </p>

            data_output_configuration: str  # <p>Specifies configuration information for the output results for the inference scheduler,
         including the S3 location for the output. </p>

            server_side_kms_key_id: str?  # <p>Provides the identifier of the KMS key used to encrypt inference scheduler data by
         Amazon Lookout for Equipment. </p>

            data_delay_offset_in_minutes: int?  # <p>The interval (in minutes) of planned delay at the start of each inference segment. For
         example, if inference is set to run every ten minutes, the delay is set to five minutes and
         the time is 09:08. The inference scheduler will wake up at the configured interval (which,
         without a delay configured, would be 09:10) plus the additional five minute delay time (so
         09:15) to check your Amazon S3 bucket. The delay provides a buffer for you to upload data at the
         same frequency, so that you don't have to stop and restart the scheduler when uploading new
         data.</p>
         <p>For more information, see <a href="https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/understanding-inference-process.html">Understanding
            the inference process</a>.</p>

            data_upload_frequency: str  # <p> How often data is uploaded to the source Amazon S3 bucket for the input data. The value
         chosen is the length of time between data uploads. For instance, if you select 5 minutes,
         Amazon Lookout for Equipment will upload the real-time data to the source bucket once every 5 minutes. This
         frequency also determines how often Amazon Lookout for Equipment runs inference on your data.</p>
         <p>For more information, see <a href="https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/understanding-inference-process.html">Understanding
            the inference process</a>.</p>

            client_token: str  # <p> A unique identifier for the request. If you do not set the client request token, Amazon
         Lookout for Equipment generates one. </p>

            model_name: str  # <p>The name of the previously trained machine learning model being used to create the
         inference scheduler. </p>

            tags: [str]?  # <p>Any tags associated with the inference scheduler. </p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of a role with permission to access the data source being
         used for the inference. </p>



            # Outputs

            server_side_kms_key_id_output?: str  # <p>Provides the identifier of the KMS key used to encrypt inference scheduler data by
         Amazon Lookout for Equipment. </p>

            data_delay_offset_in_minutes_output?: int  # <p> A period of time (in minutes) by which inference on the data is delayed after the data
         starts. For instance, if you select an offset delay time of five minutes, inference will
         not begin on the data until the first data measurement after the five minute mark. For
         example, if five minutes is selected, the inference scheduler will wake up at the
         configured frequency with the additional five minute delay time to check the customer S3
         bucket. The customer can upload data at the same frequency and they don't need to stop and
         restart the scheduler when uploading new data.</p>

            model_name_output?: str  # <p>The name of the machine learning model of the inference scheduler being described.
      </p>

            updated_at_output?: str  # <p>Specifies the time at which the inference scheduler was last updated, if it was. </p>

            latest_inference_result_output?: str  # <p>Indicates whether the latest execution for the inference scheduler was Anomalous
         (anomalous events found) or Normal (no anomalous events found).</p>

            inference_scheduler_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the inference scheduler being described. </p>

            data_output_configuration_output?: str  # <p> Specifies information for the output results for the inference scheduler, including
         the output S3 location. </p>

            status_output?: str  # <p>Indicates the status of the inference scheduler. </p>

            created_at_output?: str  # <p>Specifies the time at which the inference scheduler was created. </p>

            data_upload_frequency_output?: str  # <p>Specifies how often data is uploaded to the source S3 bucket for the input data. This
         value is the length of time between data uploads. For instance, if you select 5 minutes,
         Amazon Lookout for Equipment will upload the real-time data to the source bucket once every 5 minutes. This
         frequency also determines how often Amazon Lookout for Equipment starts a scheduled inference on your data. In
         this example, it starts once every 5 minutes. </p>

            data_input_configuration_output?: str  # <p> Specifies configuration information for the input data for the inference scheduler,
         including delimiter, format, and dataset location. </p>

            role_arn_output?: str  # <p> The Amazon Resource Name (ARN) of a role with permission to access the data source for
         the inference scheduler being described. </p>

            model_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the machine learning model of the inference scheduler
         being described. </p>

            inference_scheduler_name_output?: str  # <p>The name of the inference scheduler being described. </p>




        schema Model_version:
            """
            ModelVersion resource
            """



            # Outputs

            model_metrics_output?: str  # <p>Shows an aggregated summary, in JSON format, of the model's performance within the
         evaluation time range. These metrics are created when evaluating the model.</p>

            prior_model_metrics_output?: str  # <p>If the model version was retrained, this field shows a summary of the performance of the
         prior model on the new training range. You can use the information in this JSON-formatted
         object to compare the new model version and the prior model version.</p>

            training_data_end_time_output?: str  # <p>The date on which the training data finished being gathered. If you imported the
         version, this is the date that the training data in the source version finished being
         gathered.</p>

            schema_output?: str  # <p>The schema of the data used to train the model version.</p>

            retraining_available_data_in_days_output?: int  # <p>Indicates the number of days of data used in the most recent scheduled retraining run.
      </p>

            evaluation_data_start_time_output?: str  # <p>The date on which the data in the evaluation set began being gathered. If you imported
         the version, this is the date that the evaluation set data in the source version began
         being gathered.</p>

            labels_input_configuration_output?: str  # 

            training_execution_start_time_output?: str  # <p>The time when the training of the version began.</p>

            dataset_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the dataset used to train the model version.</p>

            last_updated_time_output?: str  # <p>Indicates the last time the machine learning model version was updated.</p>

            status_output?: str  # <p>The current status of the model version.</p>

            training_data_start_time_output?: str  # <p>The date on which the training data began being gathered. If you imported the version,
         this is the date that the training data in the source version began being gathered.</p>

            data_pre_processing_configuration_output?: str  # 

            training_execution_end_time_output?: str  # <p>The time when the training of the version completed.</p>

            model_version_output?: int  # <p>The version of the machine learning model.</p>

            model_name_output?: str  # <p>The name of the machine learning model that this version belongs to.</p>

            failed_reason_output?: str  # <p>The failure message if the training of the model version failed.</p>

            evaluation_data_end_time_output?: str  # <p>The date on which the data in the evaluation set began being gathered. If you imported
         the version, this is the date that the evaluation set data in the source version finished
         being gathered.</p>

            import_job_start_time_output?: str  # <p>The date and time when the import job began. This field appears if the model version was
         imported.</p>

            imported_data_size_in_bytes_output?: int  # <p>The size in bytes of the imported data. This field appears if the model version was
         imported.</p>

            auto_promotion_result_reason_output?: str  # <p>Indicates the reason for the <code>AutoPromotionResult</code>. For example, a model
         might not be promoted if its performance was worse than the active version, if there was an
         error during training, or if the retraining scheduler was using <code>MANUAL</code> promote
         mode. The model will be promoted in <code>MANAGED</code> promote mode if the performance is
         better than the previous model. </p>

            model_version_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the model version.</p>

            off_condition_output?: str  # <p>Indicates that the asset associated with this sensor has been shut off. As long as this
         condition is met, Lookout for Equipment will not use data from this asset for training,
         evaluation, or inference.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the role that was used to train the model
         version.</p>

            server_side_kms_key_id_output?: str  # <p>The identifier of the KMS key key used to encrypt model version data by
         Amazon Lookout for Equipment.</p>

            source_model_version_arn_output?: str  # <p>If model version was imported, then this field is the arn of the source model
         version.</p>

            import_job_end_time_output?: str  # <p>The date and time when the import job completed. This field appears if the model version
         was imported.</p>

            created_at_output?: str  # <p>Indicates the time and date at which the machine learning model version was
         created.</p>

            model_diagnostics_output_configuration_output?: str  # <p>The Amazon S3 location where Amazon Lookout for Equipment saves the pointwise model diagnostics for the model version.</p>

            auto_promotion_result_output?: str  # <p>Indicates whether the model version was promoted to be the active version after
         retraining or if there was an error with or cancellation of the retraining. </p>

            model_quality_output?: str  # <p>Provides a quality assessment for a model that uses labels. If Lookout for Equipment determines that the
         model quality is poor based on training metrics, the value is
         <code>POOR_QUALITY_DETECTED</code>. Otherwise, the value is
         <code>QUALITY_THRESHOLD_MET</code>.</p>
         <p>If the model is unlabeled, the model quality can't
         be assessed and the value of <code>ModelQuality</code> is
         <code>CANNOT_DETERMINE_QUALITY</code>. In this situation, you can get a model quality
         assessment by adding labels to the input dataset and retraining the model.</p>
         <p>For information about using labels with your models, see <a href="https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/understanding-labeling.html">Understanding labeling</a>.</p>
         <p>For information about improving the quality of a model, see <a href="https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/best-practices.html">Best practices with
         Amazon Lookout for Equipment</a>.</p>

            model_diagnostics_results_object_output?: str  # <p>The Amazon S3 output prefix for where Lookout for Equipment saves the pointwise model diagnostics for the model version.</p>

            model_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the parent machine learning model that this version
         belong to.</p>

            source_type_output?: str  # <p>Indicates whether this model version was created by training or by importing.</p>

            dataset_name_output?: str  # <p>The name of the dataset used to train the model version.</p>




        schema Active_model_version:
            """
            ActiveModelVersion resource
            """

            model_version: int  # <p>The version of the machine learning model for which the active model version is being
         set.</p>

            model_name: str  # <p>The name of the machine learning model for which the active model version is being
         set.</p>




        schema Label:
            """
            Label resource
            """

            end_time: str  # <p> The end time of the labeled event. </p>

            rating: str  # <p> Indicates whether a labeled event represents an anomaly. </p>

            notes: str?  # <p> Metadata providing additional information about the label. </p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data.</p>

            label_group_name: str  # <p> The name of a group of labels. </p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data. </p>

            start_time: str  # <p> The start time of the labeled event. </p>

            client_token: str  # <p> A unique identifier for the request to create a label. If you do not set the client
         request token, Lookout for Equipment generates one. </p>

            fault_code: str?  # <p> Provides additional information about the label. The fault code must be defined in the
         FaultCodes attribute of the label group.</p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data. </p>

            equipment: str?  # <p> Indicates that a label pertains to a particular piece of equipment. </p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data.</p>



            # Outputs

            label_group_name_output?: str  # <p> The name of the requested label group. </p>

            equipment_output?: str  # <p> Indicates that a label pertains to a particular piece of equipment. </p>

            notes_output?: str  # <p>Metadata providing additional information about the label.</p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data.</p>

            fault_code_output?: str  # <p> Indicates the type of anomaly associated with the label. </p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data.</p>

            label_id_output?: str  # <p> The ID of the requested label. </p>

            label_group_arn_output?: str  # <p> The Amazon Resource Name (ARN) of the requested label group. </p>

            end_time_output?: str  # <p> The end time of the requested label. </p>

            rating_output?: str  # <p> Indicates whether a labeled event represents an anomaly. </p>

            created_at_output?: str  # <p> The time at which the label was created. </p>

            start_time_output?: str  # <p> The start time of the requested label. </p>




        schema Model:
            """
            Model resource
            """

            off_condition: str?  # <p>Indicates that the asset associated with this sensor has been shut off. As long as this
         condition is met, Lookout for Equipment will not use data from this asset for training,
         evaluation, or inference.</p>

            evaluation_data_start_time: str?  # <p>Indicates the time reference in the dataset that should be used to begin the subset of
         evaluation data for the machine learning model. </p>

            tags: [str]?  # <p> Any tags associated with the machine learning model being created. </p>

            training_data_end_time: str?  # <p>Indicates the time reference in the dataset that should be used to end the subset of
         training data for the machine learning model. </p>

            labels_input_configuration: str?  # <p>The input configuration for the labels being used for the machine learning model that's
         being created. </p>

            training_data_start_time: str?  # <p>Indicates the time reference in the dataset that should be used to begin the subset of
         training data for the machine learning model. </p>

            client_token: str  # <p>A unique identifier for the request. If you do not set the client request token, Amazon
         Lookout for Equipment generates one. </p>

            model_diagnostics_output_configuration: str?  # <p>The Amazon S3 location where you want Amazon Lookout for Equipment to save the pointwise model diagnostics.
        
         
      You must also specify the <code>RoleArn</code> request parameter.</p>

            model_name: str  # <p>The name for the machine learning model to be created.</p>

            dataset_schema: str?  # <p>The data schema for the machine learning model being created. </p>

            server_side_kms_key_id: str?  # <p>Provides the identifier of the KMS key used to encrypt model data by Amazon Lookout
         for Equipment. </p>

            data_pre_processing_configuration: str?  # <p>The configuration is the <code>TargetSamplingRate</code>, which is the sampling rate of
         the data after post processing by Amazon Lookout for Equipment. For example, if you provide data that has been
         collected at a 1 second level and you want the system to resample the data at a 1 minute
         rate before training, the <code>TargetSamplingRate</code> is 1 minute.</p>
         <p>When providing a value for the <code>TargetSamplingRate</code>, you must attach the
         prefix "PT" to the rate you want. The value for a 1 second rate is therefore
            <i>PT1S</i>, the value for a 15 minute rate is <i>PT15M</i>,
         and the value for a 1 hour rate is <i>PT1H</i>
         </p>

            dataset_name: str  # <p>The name of the dataset for the machine learning model being created. </p>

            evaluation_data_end_time: str?  # <p> Indicates the time reference in the dataset that should be used to end the subset of
         evaluation data for the machine learning model. </p>

            role_arn: str?  # <p> The Amazon Resource Name (ARN) of a role with permission to access the data source
         being used to create the machine learning model. </p>



            # Outputs

            dataset_arn_output?: str  # <p>The Amazon Resouce Name (ARN) of the dataset used to create the machine learning model
         being described. </p>

            dataset_name_output?: str  # <p>The name of the dataset being used by the machine learning being described. </p>

            previous_active_model_version_output?: int  # <p>The model version that was set as the active model version prior to the current active
         model version.</p>

            latest_scheduled_retraining_start_time_output?: str  # <p>Indicates the start time of the most recent scheduled retraining run. </p>

            model_name_output?: str  # <p>The name of the machine learning model being described. </p>

            created_at_output?: str  # <p>Indicates the time and date at which the machine learning model was created. </p>

            prior_model_metrics_output?: str  # <p>If the model version was retrained, this field shows a summary of the performance of the
         prior model on the new training range. You can use the information in this JSON-formatted
         object to compare the new model version and the prior model version.</p>

            data_pre_processing_configuration_output?: str  # <p>The configuration is the <code>TargetSamplingRate</code>, which is the sampling rate of
         the data after post processing by Amazon Lookout for Equipment. For example, if you provide data that has been
         collected at a 1 second level and you want the system to resample the data at a 1 minute
         rate before training, the <code>TargetSamplingRate</code> is 1 minute.</p>
         <p>When providing a value for the <code>TargetSamplingRate</code>, you must attach the
         prefix "PT" to the rate you want. The value for a 1 second rate is therefore
            <i>PT1S</i>, the value for a 15 minute rate is <i>PT15M</i>,
         and the value for a 1 hour rate is <i>PT1H</i>
         </p>

            retraining_scheduler_status_output?: str  # <p>Indicates the status of the retraining scheduler. </p>

            accumulated_inference_data_start_time_output?: str  # <p>Indicates the start time of the inference data that has been accumulated. </p>

            training_data_start_time_output?: str  # <p> Indicates the time reference in the dataset that was used to begin the subset of
         training data for the machine learning model. </p>

            off_condition_output?: str  # <p>Indicates that the asset associated with this sensor has been shut off. As long as this
         condition is met, Lookout for Equipment will not use data from this asset for training, evaluation, or
         inference.</p>

            model_quality_output?: str  # <p>Provides a quality assessment for a model that uses labels. If Lookout for Equipment determines that the
         model quality is poor based on training metrics, the value is
         <code>POOR_QUALITY_DETECTED</code>. Otherwise, the value is
         <code>QUALITY_THRESHOLD_MET</code>.</p>
         <p>If the model is unlabeled, the model quality can't
         be assessed and the value of <code>ModelQuality</code> is
         <code>CANNOT_DETERMINE_QUALITY</code>. In this situation, you can get a model quality
         assessment by adding labels to the input dataset and retraining the model.</p>
         <p>For information about using labels with your models, see <a href="https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/understanding-labeling.html">Understanding labeling</a>.</p>
         <p>For information about improving the quality of a model, see <a href="https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/best-practices.html">Best practices with
         Amazon Lookout for Equipment</a>.</p>

            training_data_end_time_output?: str  # <p> Indicates the time reference in the dataset that was used to end the subset of training
         data for the machine learning model. </p>

            previous_active_model_version_arn_output?: str  # <p>The ARN of the model version that was set as the active model version prior to the
         current active model version.</p>

            latest_scheduled_retraining_status_output?: str  # <p>Indicates the status of the most recent scheduled retraining run. </p>

            labels_input_configuration_output?: str  # <p>Specifies configuration information about the labels input, including its S3 location.
      </p>

            training_execution_end_time_output?: str  # <p>Indicates the time at which the training of the machine learning model was completed.
      </p>

            active_model_version_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the model version used by the inference scheduler when
         running a scheduled inference execution.</p>

            latest_scheduled_retraining_failed_reason_output?: str  # <p>If the model version was generated by retraining and the training failed, this indicates
         the reason for that failure. </p>

            import_job_end_time_output?: str  # <p>The date and time when the import job was completed. This field appears if the active
         model version was imported.</p>

            schema_output?: str  # <p>A JSON description of the data that is in each time series dataset, including names,
         column names, and data types. </p>

            latest_scheduled_retraining_model_version_output?: int  # <p>Indicates the most recent model version that was generated by retraining. </p>

            latest_scheduled_retraining_available_data_in_days_output?: int  # <p>Indicates the number of days of data used in the most recent scheduled retraining run.
      </p>

            accumulated_inference_data_end_time_output?: str  # <p>Indicates the end time of the inference data that has been accumulated. </p>

            evaluation_data_start_time_output?: str  # <p> Indicates the time reference in the dataset that was used to begin the subset of
         evaluation data for the machine learning model. </p>

            failed_reason_output?: str  # <p>If the training of the machine learning model failed, this indicates the reason for that
         failure. </p>

            server_side_kms_key_id_output?: str  # <p>Provides the identifier of the KMS key used to encrypt model data by Amazon Lookout
         for Equipment. </p>

            training_execution_start_time_output?: str  # <p>Indicates the time at which the training of the machine learning model began. </p>

            status_output?: str  # <p>Specifies the current status of the model being described. Status describes the status
         of the most recent action of the model. </p>

            model_metrics_output?: str  # <p>The Model Metrics show an aggregated summary of the model's performance within the
         evaluation time range. This is the JSON content of the metrics created when evaluating the
         model. </p>

            next_scheduled_retraining_start_date_output?: str  # <p>Indicates the date and time that the next scheduled retraining run will start on. Lookout for Equipment
         truncates the time you provide to the nearest UTC day.</p>

            import_job_start_time_output?: str  # <p>The date and time when the import job was started. This field appears if the active
         model version was imported.</p>

            role_arn_output?: str  # <p> The Amazon Resource Name (ARN) of a role with permission to access the data source for
         the machine learning model being described. </p>

            active_model_version_output?: int  # <p>The name of the model version used by the inference schedular when running a scheduled
         inference execution.</p>

            evaluation_data_end_time_output?: str  # <p> Indicates the time reference in the dataset that was used to end the subset of
         evaluation data for the machine learning model. </p>

            model_version_activated_at_output?: str  # <p>The date the active model version was activated.</p>

            last_updated_time_output?: str  # <p>Indicates the last time the machine learning model was updated. The type of update is
         not specified. </p>

            model_diagnostics_output_configuration_output?: str  # <p>Configuration information for the model's pointwise model diagnostics.</p>

            previous_model_version_activated_at_output?: str  # <p>The date and time when the previous active model version was activated.</p>

            source_model_version_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the source model version. This field appears if the
         active model version was imported.</p>

            model_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the machine learning model being described. </p>




        schema Dataset:
            """
            Dataset resource
            """

            server_side_kms_key_id: str?  # <p>Provides the identifier of the KMS key used to encrypt dataset data by Amazon Lookout
         for Equipment. </p>

