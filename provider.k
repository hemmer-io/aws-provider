            farm_id: str  # <p>The unique identifier of the farm that contains the queue and limit to associate.</p>



            # Outputs

            status_output?: str  # <p>The current status of the limit.</p>

            queue_id_output?: str  # <p>The unique identifier of the queue associated with the limit.</p>

            created_at_output?: str  # <p>The Unix timestamp of the date and time that the association was created.</p>

            updated_by_output?: str  # <p>The user identifier of the person that last updated the association.</p>

            limit_id_output?: str  # <p>The unique identifier of the limit associated with the queue.</p>

            updated_at_output?: str  # <p>The Unix timestamp of the date and time that the association was last updated.</p>

            created_by_output?: str  # <p>The user identifier of the person that created the association.</p>





    # Workmailmessageflow Service
    schema WorkmailmessageflowService:
        """
        Service for workmailmessageflow resources.
        """


        schema Raw_message_content:
            """
            RawMessageContent resource
            """

            message_id: str  # <p>The identifier of the email message being updated.</p>

            content: str  # <p>Describes the raw message content of the updated email message.</p>



            # Outputs

            message_content_output?: str  # <p>The raw content of the email message, in MIME format.</p>





    # Mwaa Service
    schema MwaaService:
        """
        Service for mwaa resources.
        """


        schema Web_login_token:
            """
            WebLoginToken resource
            """

            name: str  # <p>The name of the Amazon MWAA environment. For example, <code>MyMWAAEnvironment</code>.</p>




        schema Cli_token:
            """
            CliToken resource
            """

            name: str  # <p>The name of the Amazon MWAA environment. For example, <code>MyMWAAEnvironment</code>.</p>




        schema Environment:
            """
            Environment resource
            """

            max_webservers: int?  # <p>
            The maximum number of web servers that you want to run in your environment.
            Amazon MWAA scales the number of Apache Airflow web servers up to the number you specify for <code>MaxWebservers</code>
            when you interact with your Apache Airflow environment using Apache Airflow REST API, or
            the Apache Airflow CLI. For example, in scenarios where your workload requires network calls to the Apache Airflow REST API with a high transaction-per-second (TPS)
            rate, Amazon MWAA will increase the number of web servers up to the number set in <code>MaxWebserers</code>. As TPS rates decrease
            Amazon MWAA disposes of the additional web servers, and scales down to the number set in <code>MinxWebserers</code>.
        </p>
         <p>Valid values: For environments larger than mw1.micro, accepts values from
                <code>2</code> to <code>5</code>. Defaults to <code>2</code> for all environment
            sizes except mw1.micro, which defaults to <code>1</code>.</p>

            source_bucket_arn: str  # <p>The Amazon Resource Name (ARN) of the Amazon S3 bucket where your DAG code and supporting files are stored. For example, <code>arn:aws:s3:::my-airflow-bucket-unique-name</code>. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/mwaa-s3-bucket.html">Create an Amazon S3 bucket for Amazon MWAA</a>.</p>

            environment_class: str?  # <p>The environment class type. Valid values: <code>mw1.micro</code>, <code>mw1.small</code>, <code>mw1.medium</code>, <code>mw1.large</code>, <code>mw1.xlarge</code>, and <code>mw1.2xlarge</code>. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/environment-class.html">Amazon MWAA environment class</a>.</p>

            name: str  # <p>The name of the Amazon MWAA environment. For example, <code>MyMWAAEnvironment</code>.</p>

            kms_key: str?  # <p>The Amazon Web Services Key Management Service (KMS) key to encrypt the data in your environment. You can use an Amazon Web Services owned CMK, or a Customer managed CMK (advanced). For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/create-environment.html">Create an Amazon MWAA environment</a>.</p>

            requirements_s3_object_version: str?  # <p>The version of the <code>requirements.txt</code> file on your Amazon S3 bucket. You must specify a version each time a requirements.txt file is updated. For more information, see <a href="https://docs.aws.amazon.com/AmazonS3/latest/userguide/versioning-workflows.html">How S3 Versioning works</a>.</p>

            startup_script_s3_path: str?  # <p>The relative path to the startup shell script in your Amazon S3 bucket. For example, <code>s3://mwaa-environment/startup.sh</code>.</p>
         <p>
            Amazon MWAA runs the script as your environment starts, and before running the Apache Airflow process.
            You can use this script to install dependencies, modify Apache Airflow configuration options, and set environment variables. For more information, see
            <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/using-startup-script.html">Using a startup script</a>.
        </p>

            max_workers: int?  # <p>The maximum number of workers that you want to run in your environment. MWAA scales the number of Apache Airflow workers up to the number you specify in the <code>MaxWorkers</code> field. For example, <code>20</code>. When there are no more tasks running, and no more in the queue, MWAA disposes of the extra workers leaving the one worker that is included with your environment, or the number you specify in <code>MinWorkers</code>.</p>

            min_webservers: int?  # <p>
            The minimum number of web servers that you want to run in your environment.
            Amazon MWAA scales the number of Apache Airflow web servers up to the number you specify for <code>MaxWebservers</code>
            when you interact with your Apache Airflow environment using Apache Airflow REST API, or
            the Apache Airflow CLI. As the transaction-per-second rate, and the network load, decrease,
            Amazon MWAA disposes of the additional web servers, and scales down to the number set in <code>MinxWebserers</code>.
        </p>
         <p>Valid values: For environments larger than mw1.micro, accepts values from
                <code>2</code> to <code>5</code>. Defaults to <code>2</code> for all environment
            sizes except mw1.micro, which defaults to <code>1</code>.</p>

            execution_role_arn: str  # <p>The Amazon Resource Name (ARN) of the execution role for your environment. An execution role is an Amazon Web Services Identity and Access Management (IAM) role that grants MWAA permission to access Amazon Web Services services and resources used by your environment. For example, <code>arn:aws:iam::123456789:role/my-execution-role</code>. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/mwaa-create-role.html">Amazon MWAA Execution role</a>.</p>

            min_workers: int?  # <p>The minimum number of workers that you want to run in your environment. MWAA scales the number of Apache Airflow workers up to the number you specify in the <code>MaxWorkers</code> field. When there are no more tasks running, and no more in the queue, MWAA disposes of the extra workers leaving the worker count you specify in the <code>MinWorkers</code> field. For example, <code>2</code>.</p>

            tags: {str: str}?  # <p>The key-value tag pairs you want to associate to your environment. For example, <code>"Environment": "Staging"</code>. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services resources</a>.</p>

            plugins_s3_object_version: str?  # <p>The version of the plugins.zip file on your Amazon S3 bucket. You must specify a version each time a plugins.zip file is updated. For more information, see <a href="https://docs.aws.amazon.com/AmazonS3/latest/userguide/versioning-workflows.html">How S3 Versioning works</a>.</p>

            dag_s3_path: str  # <p>The relative path to the DAGs folder on your Amazon S3 bucket. For example, <code>dags</code>. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/configuring-dag-folder.html">Adding or updating DAGs</a>.</p>

            airflow_configuration_options: {str: str}?  # <p>A list of key-value pairs containing the Apache Airflow configuration options you want to attach to your environment. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/configuring-env-variables.html">Apache Airflow configuration options</a>.</p>

            endpoint_management: str?  # <p>Defines whether the VPC endpoints configured for the environment are created, and managed, by the customer or by Amazon MWAA. If set to <code>SERVICE</code>, Amazon MWAA will create and manage the required VPC endpoints in
        your VPC. If set to <code>CUSTOMER</code>, you must create, and manage, the VPC endpoints for your VPC. If you choose to create an environment in a shared VPC, you must set this value to <code>CUSTOMER</code>.
        In a shared VPC deployment, the environment will remain in <code>PENDING</code> status until you create the VPC endpoints. If you do not take action to
            create the endpoints within 72 hours, the status will change to <code>CREATE_FAILED</code>. You can delete the failed environment and create a new one.</p>

            airflow_version: str?  # <p>The Apache Airflow version for your environment. If no value is specified, it defaults to the latest version.
            For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/airflow-versions.html">Apache Airflow versions on Amazon Managed Workflows for Apache Airflow (Amazon MWAA)</a>.</p>
         <p>Valid values: <code>1.10.12</code>, <code>2.0.2</code>, <code>2.2.2</code>,
                <code>2.4.3</code>, <code>2.5.1</code>, <code>2.6.3</code>, <code>2.7.2</code>,
            <code>2.8.1</code>, <code>2.9.2</code>, <code>2.10.1</code>, and <code>2.10.3</code>.</p>

            logging_configuration: str?  # <p>Defines the Apache Airflow logs to send to CloudWatch Logs.</p>

            plugins_s3_path: str?  # <p>The relative path to the <code>plugins.zip</code> file on your Amazon S3 bucket. For example, <code>plugins.zip</code>. If specified, then the <code>plugins.zip</code> version is required. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/configuring-dag-import-plugins.html">Installing custom plugins</a>.</p>

            requirements_s3_path: str?  # <p>The relative path to the <code>requirements.txt</code> file on your Amazon S3 bucket. For example, <code>requirements.txt</code>. If specified, then a version is required. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/working-dags-dependencies.html">Installing Python dependencies</a>.</p>

            startup_script_s3_object_version: str?  # <p>The version of the startup shell script in your Amazon S3 bucket. You must specify the <a href="https://docs.aws.amazon.com/AmazonS3/latest/userguide/versioning-workflows.html">version ID</a> that Amazon S3 assigns to the file
            every time you update the script.
        </p>
         <p>
            Version IDs are Unicode, UTF-8 encoded, URL-ready, opaque strings that are no more than 1,024 bytes long. The following is an example:
        </p>
         <p>
            <code>3sL4kqtJlcpXroDTDmJ+rmSpXd3dIbrHY+MTRCxf3vjVBH40Nr8X8gdRQBpUMLUo</code>
         </p>
         <p>
            For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/using-startup-script.html">Using a startup script</a>.
        </p>

            network_configuration: str  # <p>The VPC networking components used to secure and enable network traffic between the Amazon Web Services resources for your environment. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/networking-about.html">About networking on Amazon MWAA</a>.</p>

            weekly_maintenance_window_start: str?  # <p>The day and time of the week in Coordinated Universal Time (UTC) 24-hour standard time to start weekly maintenance updates of your environment in the following format: <code>DAY:HH:MM</code>. For example: <code>TUE:03:30</code>. You can specify a start time in 30 minute increments only.</p>

            webserver_access_mode: str?  # <p>Defines the access mode for the Apache Airflow <i>web server</i>. For more information, see <a href="https://docs.aws.amazon.com/mwaa/latest/userguide/configuring-networking.html">Apache Airflow access modes</a>.</p>

            schedulers: int?  # <p>The number of Apache Airflow schedulers to run in your environment. Valid values:</p>
         <ul>
            <li>
               <p>v2 - For environments larger than mw1.micro, accepts values from
                        <code>2</code> to <code>5</code>. Defaults to <code>2</code> for all
                    environment sizes except mw1.micro, which defaults to <code>1</code>.</p>
            </li>
            <li>
               <p>v1 - Accepts <code>1</code>.</p>
            </li>
         </ul>



            # Outputs

            environment_output?: str  # <p>An object containing all available details about the environment.</p>





    # Chime_sdk_messaging Service
    schema Chime_sdk_messagingService:
        """
        Service for chime_sdk_messaging resources.
        """


        schema Channel:
            """
            Channel resource
            """

            name: str  # <p>The name of the channel.</p>

            client_request_token: str  # <p>The client token for the request. An <code>Idempotency</code> token.</p>

            metadata: str?  # <p>The metadata of the creation request. Limited to 1KB and UTF-8.</p>

            channel_id: str?  # <p>An ID for the channel being created. If you do not specify an ID, a UUID will be created for the channel.</p>

            app_instance_arn: str  # <p>The ARN of the channel request.</p>

            chime_bearer: str  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> that makes the API call.</p>

            tags: [str]?  # <p>The tags for the creation request.</p>

            member_arns: [str]?  # <p>The ARNs of the channel members in the request.</p>

            mode: str?  # <p>The channel mode: <code>UNRESTRICTED</code> or <code>RESTRICTED</code>. Administrators,
         moderators, and channel members can add themselves and other members to unrestricted
         channels. Only administrators and moderators can add members to restricted channels.</p>

            privacy: str?  # <p>The channel's privacy level: <code>PUBLIC</code> or <code>PRIVATE</code>. Private
         channels aren't discoverable by users outside the channel. Public channels are discoverable
         by anyone in the <code>AppInstance</code>.</p>

            moderator_arns: [str]?  # <p>The ARNs of the channel moderators in the request.</p>

            elastic_channel_configuration: str?  # <p>The attributes required to configure and create an elastic channel. An elastic channel can support a maximum of 1-million users, excluding moderators.</p>

            expiration_settings: str?  # <p>Settings that control the interval after which the channel is automatically deleted.</p>



            # Outputs

            channel_output?: str  # <p>The channel details.</p>




        schema Channel_moderated_by_app_instance_user:
            """
            ChannelModeratedByAppInstanceUser resource
            """



            # Outputs

            channel_output?: str  # <p>The moderated channel.</p>




        schema Channel_read_marker:
            """
            ChannelReadMarker resource
            """

            chime_bearer: str  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> 
         that makes the API call.</p>

            channel_arn: str  # <p>The ARN of the channel.</p>




        schema Channel_message:
            """
            ChannelMessage resource
            """

            content_type: str?  # <p>The content type of the channel message.</p>

            message_id: str  # <p>The ID string of the message being updated.</p>

            sub_channel_id: str?  # <p>The ID of the SubChannel in the request.</p>
         <note>
            <p>Only required when updating messages in a SubChannel that the user belongs to.</p>
         </note>

            metadata: str?  # <p>The metadata of the message being updated.</p>

            channel_arn: str  # <p>The ARN of the channel.</p>

            content: str  # <p>The content of the channel message. </p>

            chime_bearer: str  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> 
         that makes the API call.</p>



            # Outputs

            channel_message_output?: str  # <p>The details of and content in the message.</p>




        schema Messaging_streaming_configurations:
            """
            MessagingStreamingConfigurations resource
            """

            app_instance_arn: str  # <p>The ARN of the streaming configuration.</p>

            streaming_configurations: [str]  # <p>The streaming configurations.</p>



            # Outputs

            streaming_configurations_output?: [str]  # <p>The streaming settings.</p>




        schema Channel_expiration_settings:
            """
            ChannelExpirationSettings resource
            """

            chime_bearer: str?  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> that makes the API call.</p>

            channel_arn: str  # <p>The ARN of the channel.</p>

            expiration_settings: str?  # <p>Settings that control the interval after which a channel is deleted.</p>




        schema Channel_message_status:
            """
            ChannelMessageStatus resource
            """



            # Outputs

            status_output?: str  # <p>The message status and details.</p>




        schema Channel_membership_preferences:
            """
            ChannelMembershipPreferences resource
            """

            chime_bearer: str  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> that makes the API call.</p>

            preferences: str  # <p>The channel membership preferences of an <code>AppInstanceUser</code> .</p>

            member_arn: str  # <p>The ARN of the member setting the preferences.</p>

            channel_arn: str  # <p>The ARN of the channel.</p>



            # Outputs

            member_output?: str  # <p>The details of a user.</p>

            preferences_output?: str  # <p>The channel membership preferences for an <code>AppInstanceUser</code> .</p>

            channel_arn_output?: str  # <p>The ARN of the channel.</p>




        schema Channel_flow:
            """
            ChannelFlow resource
            """

            processors: [str]  # <p>Information about the processor Lambda functions.</p>

            app_instance_arn: str  # <p>The ARN of the channel flow request.</p>

            tags: [str]?  # <p>The tags for the creation request.</p>

            client_request_token: str  # <p>The client token for the request. An Idempotency token.</p>

            name: str  # <p>The name of the channel flow.</p>



            # Outputs

            channel_flow_output?: str  # <p>The channel flow details.</p>




        schema Channel_membership_for_app_instance_user:
            """
            ChannelMembershipForAppInstanceUser resource
            """



            # Outputs

            channel_membership_output?: str  # <p>The channel to which a user belongs.</p>




        schema Channel_ban:
            """
            ChannelBan resource
            """

            chime_bearer: str  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> that makes the API call.</p>

            channel_arn: str  # <p>The ARN of the ban request.</p>

            member_arn: str  # <p>The <code>AppInstanceUserArn</code> of the member being banned.</p>



            # Outputs

            channel_ban_output?: str  # <p>The details of the ban.</p>




        schema Channel_moderator:
            """
            ChannelModerator resource
            """

            chime_bearer: str  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> 
         that makes the API call.</p>

            channel_moderator_arn: str  # <p>The <code>AppInstanceUserArn</code> of the moderator.</p>

            channel_arn: str  # <p>The ARN of the channel.</p>



            # Outputs

            channel_moderator_output?: str  # <p>The details of the channel moderator.</p>




        schema Messaging_session_endpoint:
            """
            MessagingSessionEndpoint resource
            """



            # Outputs

            endpoint_output?: str  # <p>The endpoint returned in the response.</p>




        schema Channel_membership:
            """
            ChannelMembership resource
            """

            chime_bearer: str  # <p>The ARN of the <code>AppInstanceUser</code> or <code>AppInstanceBot</code> 
         that makes the API call.</p>

            member_arn: str  # <p>The <code>AppInstanceUserArn</code> of the member you want to add to the channel.</p>

            sub_channel_id: str?  # <p>The ID of the SubChannel in the request.</p>
         <note>
            <p>Only required when creating membership in a SubChannel for a moderator in an elastic channel.</p>
         </note>

            channel_arn: str  # <p>The ARN of the channel to which you're adding users.</p>

            type: str  # <p>The membership type of a user, <code>DEFAULT</code> or <code>HIDDEN</code>. Default
         members are always returned as part of <code>ListChannelMemberships</code>. Hidden members
         are only returned if the type filter in <code>ListChannelMemberships</code> equals
            <code>HIDDEN</code>. Otherwise hidden members are not returned. This is only supported
         by moderators.</p>



            # Outputs

            channel_membership_output?: str  # <p>The details of the membership.</p>





    # Pipes Service
    schema PipesService:
        """
        Service for pipes resources.
        """



    # Polly Service
    schema PollyService:
        """
        Service for polly resources.
        """


        schema Lexicon:
            """
            Lexicon resource
            """

            name: str  # <p>Name of the lexicon. The name must follow the regular express
      format [0-9A-Za-z]{1,20}. That is, the name is a case-sensitive
      alphanumeric string up to 20 characters long. </p>

            content: str  # <p>Content of the PLS lexicon as string data.</p>



            # Outputs

            lexicon_attributes_output?: str  # <p>Metadata of the lexicon, including phonetic alphabetic used,
      language code, lexicon ARN, number of lexemes defined in the lexicon, and
      size of lexicon in bytes.</p>

            lexicon_output?: str  # <p>Lexicon object that provides name and the string content of the
      lexicon. </p>




        schema Speech_synthesis_task:
            """
            SpeechSynthesisTask resource
            """



            # Outputs

            synthesis_task_output?: str  # <p>SynthesisTask object that provides information from the requested
      task, including output format, creation time, task status, and so
      on.</p>




        schema Voices:
            """
            Voices resource
            """



            # Outputs

            next_token_output?: str  # <p>The pagination token to use in the next request to continue the
      listing of voices. <code>NextToken</code> is returned only if the response
      is truncated.</p>

            voices_output?: [str]  # <p>A list of voices with their properties.</p>





    # S3tables Service
    schema S3tablesService:
        """
        Service for s3tables resources.
        """



    # Fms Service
    schema FmsService:
        """
        Service for fms resources.
        """


        schema Protection_status:
            """
            ProtectionStatus resource
            """



            # Outputs

            admin_account_id_output?: str  # <p>The ID of the Firewall Manager administrator account for this policy.</p>

            service_type_output?: str  # <p>The service type that is protected by the policy. Currently, this is always
            <code>SHIELD_ADVANCED</code>.</p>

            next_token_output?: str  # <p>If you have more objects than the number that you specified for <code>MaxResults</code> in the request,
         the response includes a <code>NextToken</code> value. To list more objects, submit another
         <code>GetProtectionStatus</code> request, and specify the <code>NextToken</code> value from the response in the
         <code>NextToken</code> value in the next request.</p>
         <p>Amazon Web Services SDKs provide auto-pagination that identify <code>NextToken</code> in a response and
         make subsequent request calls automatically on your behalf. However, this feature is not
         supported by <code>GetProtectionStatus</code>. You must submit subsequent requests with
            <code>NextToken</code> using your own processes. </p>

            data_output?: str  # <p>Details about the attack, including the following:</p>
         <ul>
            <li>
               <p>Attack type</p>
            </li>
            <li>
               <p>Account ID</p>
            </li>
            <li>
               <p>ARN of the resource attacked</p>
            </li>
            <li>
               <p>Start time of the attack</p>
            </li>
            <li>
               <p>End time of the attack (ongoing attacks will not have an end time)</p>
            </li>
         </ul>
         <p>The details are in JSON format. </p>




        schema Third_party_firewall_association_status:
            """
            ThirdPartyFirewallAssociationStatus resource
            """



            # Outputs

            third_party_firewall_status_output?: str  # <p>The current status for setting a Firewall Manager policy administrators account as an administrator of the third-party firewall tenant.</p>
         <ul>
            <li>
               <p>
                  <code>ONBOARDING</code> - The Firewall Manager policy administrator is being designated as a tenant administrator.</p>
            </li>
            <li>
               <p>
                  <code>ONBOARD_COMPLETE</code> - The Firewall Manager policy administrator is designated as a tenant administrator.</p>
            </li>
            <li>
               <p>
                  <code>OFFBOARDING</code> - The Firewall Manager policy administrator is being removed as a tenant administrator.</p>
            </li>
            <li>
               <p>
                  <code>OFFBOARD_COMPLETE</code> - The Firewall Manager policy administrator has been removed as a tenant administrator.</p>
            </li>
            <li>
               <p>
                  <code>NOT_EXIST</code> - The Firewall Manager policy administrator doesn't exist as a tenant administrator.</p>
            </li>
         </ul>

            marketplace_onboarding_status_output?: str  # <p>The status for subscribing to the third-party firewall vendor in the Amazon Web Services Marketplace.</p>
         <ul>
            <li>
               <p>
                  <code>NO_SUBSCRIPTION</code> - The Firewall Manager policy administrator isn't subscribed to the third-party firewall service in the Amazon Web Services Marketplace.</p>
            </li>
            <li>
               <p>
                  <code>NOT_COMPLETE</code> - The Firewall Manager policy administrator is in the process of subscribing to the third-party firewall service in the Amazon Web Services Marketplace, but doesn't yet have an active subscription.</p>
            </li>
            <li>
               <p>
                  <code>COMPLETE</code> - The Firewall Manager policy administrator has an active subscription to the third-party firewall service in the Amazon Web Services Marketplace.</p>
            </li>
         </ul>




        schema Compliance_detail:
            """
            ComplianceDetail resource
            """



            # Outputs

            policy_compliance_detail_output?: str  # <p>Information about the resources and the policy that you specified in the
        <code>GetComplianceDetail</code> request.</p>




        schema Resource_set:
            """
            ResourceSet resource
            """

            tag_list: [str]?  # <p>Retrieves the tags associated with the specified resource set. Tags are key:value pairs that
         you can use to categorize and manage your resources, for purposes like billing. For
         example, you might set the tag key to "customer" and the value to the customer name or ID.
         You can specify one or more tags to add to each Amazon Web Services resource, up to 50 tags for a
         resource.</p>

            resource_set: str  # <p>Details about the resource set to be created or updated.></p>



            # Outputs

            resource_set_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the resource set.</p>

            resource_set_output?: str  # <p>Information about the specified resource set.</p>




        schema Protocols_list:
            """
