            idempotent (executes only once).</p>
         <important>
            <p>This token is listed as not required because Amazon Web Services SDKs (for example
                the Amazon Web Services SDK for Java) auto-generate the token for you. If you are not
                using the Amazon Web Services SDK or the Amazon Web Services CLI, you must provide
                this token or the action will fail.</p>
         </important>

            name: str  # <p>The name of the <code>ipynb</code> file to be created in the Spark workgroup, without
            the <code>.ipynb</code> extension.</p>




        schema Calculation_execution:
            """
            CalculationExecution resource
            """



            # Outputs

            calculation_execution_id_output?: str  # <p>The calculation execution UUID.</p>

            status_output?: str  # <p>Contains information about the status of the calculation.</p>

            statistics_output?: str  # <p>Contains information about the data processing unit (DPU) execution time and progress.
            This field is populated only when statistics are available.</p>

            session_id_output?: str  # <p>The session ID that the calculation ran in.</p>

            result_output?: str  # <p>Contains result information. This field is populated only if the calculation is
            completed.</p>

            working_directory_output?: str  # <p>The Amazon S3 location in which calculation results are stored.</p>

            description_output?: str  # <p>The description of the calculation execution.</p>




        schema Notebook_metadata:
            """
            NotebookMetadata resource
            """

            name: str  # <p>The name to update the notebook to.</p>

            notebook_id: str  # <p>The ID of the notebook to update the metadata for.</p>

            client_request_token: str?  # <p>A unique case-sensitive string used to ensure the request to create the notebook is
            idempotent (executes only once).</p>
         <important>
            <p>This token is listed as not required because Amazon Web Services SDKs (for example
                the Amazon Web Services SDK for Java) auto-generate the token for you. If you are not
                using the Amazon Web Services SDK or the Amazon Web Services CLI, you must provide
                this token or the action will fail.</p>
         </important>



            # Outputs

            notebook_metadata_output?: str  # <p>The metadata that is returned for the specified notebook ID.</p>




