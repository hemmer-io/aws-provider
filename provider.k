    # Applicationcostprofiler Service
    schema ApplicationcostprofilerService:
        """
        Service for applicationcostprofiler resources.
        """


        schema Report_definition:
            """
            ReportDefinition resource
            """

            report_frequency: str  # <p>Required. The cadence to generate the report.</p>

            report_description: str  # <p>Required. Description of the report.</p>

            format: str  # <p>Required. The format to use for the generated report.</p>

            destination_s3_location: str  # <p>Required. Amazon Simple Storage Service (Amazon S3) location where Application Cost Profiler uploads the
      report.</p>

            report_id: str  # <p>Required. ID of the report. You can choose any valid string matching the pattern for the
      ID.</p>



            # Outputs

            report_description_output?: str  # <p>Description of the report.</p>

            destination_s3_location_output?: str  # <p>Amazon Simple Storage Service (Amazon S3) location where the report is uploaded.</p>

            report_frequency_output?: str  # <p>Cadence used to generate the report.</p>

            created_at_output?: str  # <p>Timestamp (milliseconds) when this report definition was created.</p>

            format_output?: str  # <p>Format of the generated report.</p>

            last_updated_output?: str  # <p>Timestamp (milliseconds) when this report definition was last updated.</p>

            report_id_output?: str  # <p>ID of the report retrieved.</p>





    # Ses Service
    schema SesService:
        """
