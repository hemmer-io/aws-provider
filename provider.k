            error_details_output?: str  # <p>The error details when the status is shown as <code>ERROR</code>.</p>

            expected_bucket_owner_output?: str  # <p>The Amazon Web Services account ID that owns the Amazon S3 bucket specified in the <b>location</b>
       parameter.</p>

