            id_output?: str  # The unique id of the multiplex.

            tags_output?: {str: str}  # A collection of key-value pairs.

            multiplex_settings_output?: str  # Configuration for a multiplex event.




        schema Input_device:
            """
            InputDevice resource
            """

            input_device_id: str  # The unique ID of the input device. For example, hd-123456789abcdef.

            uhd_device_settings: str?  # The settings that you want to apply to the UHD input device.

            hd_device_settings: str?  # The settings that you want to apply to the HD input device.

            name: str?  # The name that you assigned to this input device (not the unique ID).

            availability_zone: str?  # The Availability Zone you want associated with this input device.



            # Outputs

            uhd_device_settings_output?: str  # Settings that describe an input device that is type UHD.

            device_settings_sync_state_output?: str  # The status of the action to synchronize the device configuration. If you change the configuration of the input device (for example, the maximum bitrate), MediaLive sends the new data to the device. The device might not update itself immediately. SYNCED means the device has updated its configuration. SYNCING means that it has not updated its configuration.

            network_settings_output?: str  # The network settings for the input device.

            serial_number_output?: str  # The unique serial number of the input device.

            id_output?: str  # The unique ID of the input device.

            device_update_status_output?: str  # The status of software on the input device.

            availability_zone_output?: str  # The Availability Zone associated with this input device.

            medialive_input_arns_output?: [str]  # An array of the ARNs for the MediaLive inputs attached to the device. Returned only if the outputType is MEDIALIVE_INPUT.

            type_output?: str  # The type of the input device.

            mac_address_output?: str  # The network MAC address of the input device.

            hd_device_settings_output?: str  # Settings that describe an input device that is type HD.

            output_type_output?: str  # The output attachment type of the input device. Specifies MEDIACONNECT_FLOW if this device is the source for a MediaConnect flow. Specifies MEDIALIVE_INPUT if this device is the source for a MediaLive input.

            name_output?: str  # A name that you specify for the input device.

            tags_output?: {str: str}  # A collection of key-value pairs.

            arn_output?: str  # The unique ARN of the input device.

            connection_state_output?: str  # The state of the connection between the input device and AWS.




        schema Network:
            """
            Network resource
            """

            routes: [str]?  # An array of routes that MediaLive Anywhere needs to know about in order to route encoding traffic.

            name: str?  # Specify a name that is unique in the AWS account. We recommend that you assign a name that hints at the type of traffic on the network. Names are case-sensitive.

            request_id: str?  # An ID that you assign to a create request. This ID ensures idempotency when creating resources.

            tags: {str: str}?  # A collection of key-value pairs.

            ip_pools: [str]?  # An array of IpPoolCreateRequests that identify a collection of IP addresses in your network that you want to reserve for use in MediaLive Anywhere. MediaLiveAnywhere uses these IP addresses for Push inputs (in both Bridge and NATnetworks) and for output destinations (only in Bridge networks). EachIpPoolUpdateRequest specifies one CIDR block.



            # Outputs

            associated_cluster_ids_output?: [str]  # 

            name_output?: str  # The name that you specified for the Network.

            state_output?: str  # The current state of the Network. Only MediaLive Anywhere can change the state.

            routes_output?: [str]  # An array of routes that MediaLive Anywhere needs to know about in order to route encoding traffic.

            arn_output?: str  # The ARN of this Network. It is automatically assigned when the Network is created.

            ip_pools_output?: [str]  # An array of IpPools in your organization's network that identify a collection of IP addresses in this network that are reserved for use in MediaLive Anywhere. MediaLive Anywhere uses these IP addresses for Push inputs (in both Bridge and NAT networks) and for output destinations (only in Bridge networks). Each IpPool specifies one CIDR block.

            id_output?: str  # The ID of the Network. Unique in the AWS account. The ID is the resource-id portion of the ARN.




