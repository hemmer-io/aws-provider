            db_security_groups_output?: [str]  # <p>A list of <code>DBSecurityGroup</code> instances.</p>

            marker_output?: str  # <p>An optional pagination token provided by a previous request.
            If this parameter is specified, the response includes
            only records beyond the marker,
            up to the value specified by <code>MaxRecords</code>.</p>




        schema Db_cluster_snapshot_attributes:
