            canary_settings: str?  # <p>The canary deployment settings of this stage.</p>

            rest_api_id: str  # <p>The string identifier of the associated RestApi.</p>

            documentation_version: str?  # <p>The version of the associated API documentation.</p>

            stage_name: str  # <p>The name for the Stage resource. Stage names can only contain alphanumeric characters, hyphens, and underscores. Maximum length is 128 characters.</p>

