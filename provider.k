    # Managedblockchain Service
    schema ManagedblockchainService:
        """
        Service for managedblockchain resources.
        """


        schema Member:
            """
            Member resource
            """

            invitation_id: str  # <p>The unique identifier of the invitation that is sent to the member to join the network.</p>

            member_configuration: str  # <p>Member configuration parameters.</p>

            client_request_token: str  # <p>A unique, case-sensitive identifier that you provide to ensure the idempotency of the operation. An idempotent operation completes no more than one time. This identifier is required only if you make a service request directly using an HTTP client. It is generated automatically if you use an Amazon Web Services SDK or the CLI.</p>

            network_id: str  # <p>The unique identifier of the network in which the member is created.</p>



            # Outputs

            member_output?: str  # <p>The properties of a member.</p>




        schema Node:
            """
            Node resource
            """

            network_id: str  # <p>The unique identifier of the network for the node.</p>
         <p>Ethereum public networks have the following <code>NetworkId</code>s:</p>
         <ul>
            <li>
               <p>
                  <code>n-ethereum-mainnet</code>
               </p>
            </li>
         </ul>

            tags: {str: str}?  # <p>Tags to assign to the node.</p>
         <p> Each tag consists of a key and an optional value. You can specify 
          multiple key-value pairs in a single request with an overall maximum of 50 tags 
          allowed per resource.</p>
         <p>For more information about tags, see <a href="https://docs.aws.amazon.com/managed-blockchain/latest/ethereum-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Ethereum Developer Guide</i>, or <a href="https://docs.aws.amazon.com/managed-blockchain/latest/hyperledger-fabric-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Hyperledger Fabric Developer Guide</i>.</p>

            client_request_token: str  # <p>A unique, case-sensitive identifier that you provide to ensure the idempotency of the operation. An idempotent operation completes no more than one time. This identifier is required only if you make a service request directly using an HTTP client. It is generated automatically if you use an Amazon Web Services SDK or the CLI.</p>

            node_configuration: str  # <p>The properties of a node configuration.</p>

            member_id: str?  # <p>The unique identifier of the member that owns this node.</p>
         <p>Applies only to Hyperledger Fabric.</p>



            # Outputs

            node_output?: str  # <p>Properties of the node configuration.</p>




        schema Accessor:
            """
            Accessor resource
            """

            accessor_type: str  # <p>The type of accessor.</p>
         <note>
            <p>Currently, accessor type is restricted to <code>BILLING_TOKEN</code>.</p>
         </note>

            client_request_token: str  # <p>This is a unique, case-sensitive identifier that you provide to ensure the idempotency of 
         the operation. An idempotent operation completes no more than once. This 
         identifier is required only if you make a service request directly using 
         an HTTP client. It is generated automatically if you use an Amazon Web Services SDK or the 
         Amazon Web Services CLI.</p>

            tags: {str: str}?  # <p>Tags to assign to the Accessor.</p>
         <p> Each tag consists of a key and an optional value. You can specify 
          multiple key-value pairs in a single request with an overall maximum of 50 tags 
          allowed per resource.</p>
         <p>For more information about tags, see <a href="https://docs.aws.amazon.com/managed-blockchain/latest/ethereum-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Ethereum Developer Guide</i>, or <a href="https://docs.aws.amazon.com/managed-blockchain/latest/hyperledger-fabric-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Hyperledger Fabric Developer Guide</i>.</p>

            network_type: str?  # <p>The blockchain network that the <code>Accessor</code> token is created for.</p>
         <note>
            <ul>
               <li>
                  <p>Use the actual <code>networkType</code> value for the blockchain network that you are creating 
            the <code>Accessor</code> token for.</p>
               </li>
               <li>
                  <p>With the shut down of the <i>Ethereum Goerli</i> and <i>Polygon Mumbai 
            Testnet</i> networks the following <code>networkType</code> values are no longer available 
            for selection and use.</p>
                  <ul>
                     <li>
                        <p>
                           <code>ETHEREUM_MAINNET_AND_GOERLI</code>
                        </p>
                     </li>
                     <li>
                        <p>
                           <code>ETHEREUM_GOERLI</code>
                        </p>
                     </li>
                     <li>
                        <p>
                           <code>POLYGON_MUMBAI</code>
                        </p>
                     </li>
                  </ul>
                  <p>However, your existing <code>Accessor</code> tokens with these <code>networkType</code> 
               values will remain unchanged.</p>
               </li>
            </ul>
         </note>



            # Outputs

            accessor_output?: str  # <p>The properties of the accessor.</p>




        schema Proposal:
            """
            Proposal resource
            """

            description: str?  # <p>A description for the proposal that is visible to voting members, for example, "Proposal to add Example Corp. as member."</p>

            member_id: str  # <p>The unique identifier of the member that is creating the proposal. This 
         identifier is especially useful for identifying the member making the proposal 
         when multiple members exist in a single Amazon Web Services account.</p>

            tags: {str: str}?  # <p>Tags to assign to the proposal.</p>
         <p> Each tag consists of a key and an optional value. You can specify 
          multiple key-value pairs in a single request with an overall maximum of 50 tags 
          allowed per resource.</p>
         <p>For more information about tags, see <a href="https://docs.aws.amazon.com/managed-blockchain/latest/ethereum-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Ethereum Developer Guide</i>, or <a href="https://docs.aws.amazon.com/managed-blockchain/latest/hyperledger-fabric-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Hyperledger Fabric Developer Guide</i>.</p>

            network_id: str  # <p>
         The unique identifier of the network for which the proposal is made.</p>

            actions: str  # <p>The type of actions proposed, such as inviting a member or removing a member. The types of <code>Actions</code> in a proposal are mutually exclusive. For example, a proposal with <code>Invitations</code> actions cannot also contain <code>Removals</code> actions.</p>

            client_request_token: str  # <p>A unique, case-sensitive identifier that you provide to ensure the idempotency of the operation. An idempotent operation completes no more than one time. This identifier is required only if you make a service request directly using an HTTP client. It is generated automatically if you use an Amazon Web Services SDK or the CLI.</p>



            # Outputs

            proposal_output?: str  # <p>Information about a proposal.</p>




        schema Network:
            """
            Network resource
            """

            voting_policy: str  # <p>
         The voting rules used by the network to determine if a proposal is approved.
      </p>

            description: str?  # <p>An optional description for the network.</p>

            client_request_token: str  # <p>This is a unique, case-sensitive identifier that you provide to ensure the idempotency of the
         operation. An idempotent operation completes no more than once. This identifier is required only 
         if you make a service request directly using an HTTP client. It is generated automatically if you 
         use an Amazon Web Services SDK or the Amazon Web Services CLI.
      </p>

            framework_version: str  # <p>The version of the blockchain framework that the network uses.</p>

            tags: {str: str}?  # <p>Tags to assign to the network.</p>
         <p> Each tag consists of a key and an optional value. You can specify 
          multiple key-value pairs in a single request with an overall maximum of 50 tags 
          allowed per resource.</p>
         <p>For more information about tags, see <a href="https://docs.aws.amazon.com/managed-blockchain/latest/ethereum-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Ethereum Developer Guide</i>, or <a href="https://docs.aws.amazon.com/managed-blockchain/latest/hyperledger-fabric-dev/tagging-resources.html">Tagging Resources</a> in the <i>Amazon Managed Blockchain Hyperledger Fabric Developer Guide</i>.</p>

            member_configuration: str  # <p>Configuration properties for the first member within the network.</p>

            framework: str  # <p>The blockchain framework that the network uses.</p>

            name: str  # <p>The name of the network.</p>

            framework_configuration: str?  # <p>
         Configuration properties of the blockchain framework relevant to the network configuration.
      </p>



            # Outputs

            network_output?: str  # <p>An object containing network configuration parameters.</p>





    # Appstream Service
    schema AppstreamService:
        """
        Service for appstream resources.
        """


        schema User:
            """
            User resource
            """

            authentication_type: str  # <p>The authentication type for the user. You must specify USERPOOL. </p>

            message_action: str?  # <p>The action to take for the welcome email that is sent to a user after the user is created in the user pool. If you specify SUPPRESS, no email is sent. If you specify RESEND, do not specify the first name or last name of the user. If the value is null, the email is sent. </p>
         <note>
            <p>The temporary password in the welcome email is valid for only 7 days. If users don’t set their passwords within 7 days, you must send them a new welcome email.</p>
         </note>

            first_name: str?  # <p>The first name, or given name, of the user.</p>

            last_name: str?  # <p>The last name, or surname, of the user.</p>

            user_name: str  # <p>The email address of the user.</p>
         <note>
            <p>Users' email addresses are case-sensitive. During login, if they specify an email address that doesn't use the same capitalization as the email address specified when their user pool account was created, a "user does not exist" error message displays.</p>
         </note>




        schema App_block:
            """
            AppBlock resource
            """

            post_setup_script_details: str?  # <p>The post setup script details of the app block. This can only be provided for the
                <code>APPSTREAM2</code> PackagingType.</p>

            source_s3_location: str  # <p>The source S3 location of the app block.</p>

            tags: {str: str}?  # <p>The tags assigned to the app block.</p>

            display_name: str?  # <p>The display name of the app block. This is not displayed to the user.</p>

            setup_script_details: str?  # <p>The setup script details of the app block. This must be provided for the
                <code>CUSTOM</code> PackagingType.</p>

            name: str  # <p>The name of the app block.</p>

            description: str?  # <p>The description of the app block.</p>

            packaging_type: str?  # <p>The packaging type of the app block.</p>




        schema Usage_report_subscriptions:
            """
            UsageReportSubscriptions resource
            """



            # Outputs

            next_token_output?: str  # <p>The pagination token to use to retrieve the next page of results for this operation. If there are no more pages, this value is null.</p>

            usage_report_subscriptions_output?: [str]  # <p>Information about the usage report subscription.</p>




        schema Application:
            """
            Application resource
            """

            launch_parameters: str?  # <p>The launch parameters of the application.</p>

            instance_families: str  # <p>The instance families the application supports. Valid values are GENERAL_PURPOSE and GRAPHICS_G4.</p>

            app_block_arn: str  # <p>The app block ARN to which the application should be associated</p>

            tags: {str: str}?  # <p>The tags assigned to the application.</p>

            working_directory: str?  # <p>The working directory of the application.</p>

            name: str  # <p>The name of the application. This name is visible to users when display name is not specified.</p>

            description: str?  # <p>The description of the application.</p>

            icon_s3_location: str  # <p>The location in S3 of the application icon.</p>

            launch_path: str  # <p>The launch path of the application.</p>

            platforms: [str]  # <p>The platforms the application supports. WINDOWS_SERVER_2019 and AMAZON_LINUX2 are supported for Elastic fleets.</p>

            display_name: str?  # <p>The display name of the application. This name is visible to users in the application catalog.</p>




        schema Applications:
            """
            Applications resource
            """



            # Outputs

            next_token_output?: str  # <p>The pagination token used to retrieve the next page of results for this
            operation.</p>

            applications_output?: [str]  # <p>The applications in the list.</p>




        schema Images:
            """
            Images resource
            """



            # Outputs

            next_token_output?: str  # <p>The pagination token to use to retrieve the next page of results for this operation. If there are no more pages, this value is null.</p>

            images_output?: [str]  # <p>Information about the images.</p>




        schema App_blocks:
            """
            AppBlocks resource
            """



            # Outputs

            next_token_output?: str  # <p>The pagination token used to retrieve the next page of results for this
            operation.</p>

            app_blocks_output?: [str]  # <p>The app blocks in the list.</p>




        schema Usage_report_subscription:
            """
            UsageReportSubscription resource
            """




        schema Entitlements:
            """
            Entitlements resource
            """



            # Outputs

            entitlements_output?: [str]  # <p>The entitlements.</p>

            next_token_output?: str  # <p>The pagination token used to retrieve the next page of results for this
            operation.</p>




        schema Image_builder_streaming_url:
            """
            ImageBuilderStreamingURL resource
            """

            name: str  # <p>The name of the image builder.</p>

            validity: int?  # <p>The time that the streaming URL will be valid, in seconds. 
            Specify a value between 1 and 604800 seconds. The default is 3600 seconds.</p>




        schema Stack:
            """
            Stack resource
            """

            access_endpoints: [str]?  # <p>The list of interface VPC endpoint (interface endpoint) objects. Users of the stack can connect to AppStream 2.0 only through the specified endpoints.</p>

            embed_host_domains: [str]?  # <p>The domains where AppStream 2.0 streaming sessions can be embedded in an iframe. You must approve the domains that you want to host embedded AppStream 2.0 streaming sessions. </p>

            streaming_experience_settings: str?  # <p>The streaming protocol you want your stack to prefer. This can be UDP or TCP. Currently, UDP is only supported in the Windows native client.</p>

            display_name: str?  # <p>The stack name to display.</p>

            name: str  # <p>The name of the stack.</p>

            storage_connectors: [str]?  # <p>The storage connectors to enable.</p>

            redirect_url: str?  # <p>The URL that users are redirected to after their streaming session ends.</p>

            user_settings: [str]?  # <p>The actions that are enabled or disabled for users during their streaming sessions. By default, these actions are enabled. </p>

            description: str?  # <p>The description to display.</p>

            application_settings: str?  # <p>The persistent application settings for users of a stack. When these settings are enabled, changes that users make to applications and Windows settings are automatically saved after each session and applied to the next session.</p>

            tags: {str: str}?  # <p>The tags to associate with the stack. A tag is a key-value pair, and the value is optional. For example, Environment=Test. If you do not specify a value, Environment=. </p>
         <p>If you do not specify a value, the value is set to an empty string.</p>
         <p>Generally allowed characters are: letters, numbers, and spaces representable in UTF-8, and the following special characters: </p>
         <p>_ . : / = + \ - @</p>
         <p>For more information about tags, see <a href="https://docs.aws.amazon.com/appstream2/latest/developerguide/tagging-basic.html">Tagging Your Resources</a> in the <i>Amazon AppStream 2.0 Administration Guide</i>.</p>

            feedback_url: str?  # <p>The URL that users are redirected to after they click the Send Feedback link. If no URL is specified, no Send Feedback link is displayed.</p>




        schema Theme_for_stack:
            """
            ThemeForStack resource
            """

            theme_styling: str  # <p>The color theme that is applied to website links, text, and buttons. These colors are also applied as accents in the background for the streaming application catalog page.</p>

            favicon_s3_location: str  # <p>The S3 location of the favicon. The favicon enables users to recognize their application streaming site in a browser full of tabs or bookmarks. It is displayed at the top of the browser tab for the application streaming site during users' streaming sessions.</p>

            title_text: str  # <p>The title that is displayed at the top of the browser tab during users' application streaming sessions.</p>

            footer_links: [str]?  # <p>The links that are displayed in the footer of the streaming application catalog page. These links are helpful resources for users, such as the organization's IT support and product marketing sites.</p>

            organization_logo_s3_location: str  # <p>The organization logo that appears on the streaming application catalog page.</p>

            stack_name: str  # <p>The name of the stack for the theme.</p>



            # Outputs

            theme_output?: str  # <p> The theme object that contains the metadata of the custom branding.</p>




        schema Updated_image:
            """
            UpdatedImage resource
            """

            new_image_description: str?  # <p>The description to display for the new image.</p>

            new_image_tags: {str: str}?  # <p>The tags to associate with the new image. A tag is a key-value pair, and the value is optional. For example, Environment=Test. If you do not specify a value, Environment=. </p>
         <p>Generally allowed characters are: letters, numbers, and spaces representable in UTF-8, and the following special characters: </p>
         <p>_ . : / = + \ - @</p>
         <p>If you do not specify a value, the value is set to an empty string.</p>
         <p>For more information about tags, see <a href="https://docs.aws.amazon.com/appstream2/latest/developerguide/tagging-basic.html">Tagging Your Resources</a> in the <i>Amazon AppStream 2.0 Administration Guide</i>.</p>

            new_image_name: str  # <p>The name of the new image. The name must be unique within the AWS account and Region.</p>

            new_image_display_name: str?  # <p>The name to display for the new image.</p>

            dry_run: bool?  # <p>Indicates whether to display the status of image update availability before AppStream 2.0 initiates the process of creating a new updated image. If this value is set to <code>true</code>, AppStream 2.0 displays whether image updates are available. If this value is set to <code>false</code>, AppStream 2.0 initiates the process of creating a new updated image without displaying whether image updates are available.</p>

            existing_image_name: str  # <p>The name of the image to update.</p>




        schema Users:
            """
            Users resource
            """



            # Outputs

            users_output?: [str]  # <p>Information about users in the user pool.</p>

            next_token_output?: str  # <p>The pagination token to use to retrieve the next page of results for this operation. If there are no more pages, this value is null.</p>




        schema Fleet:
            """
            Fleet resource
            """

            display_name: str?  # <p>The fleet name to display.</p>

            platform: str?  # <p>The fleet platform. WINDOWS_SERVER_2019 and AMAZON_LINUX2 are supported for Elastic
            fleets. </p>

            image_arn: str?  # <p>The ARN of the public, private, or shared image to use.</p>

            description: str?  # <p>The description to display.</p>

            idle_disconnect_timeout_in_seconds: int?  # <p>The amount of time that users can be idle (inactive) before they are disconnected
            from their streaming session and the <code>DisconnectTimeoutInSeconds</code> time
            interval begins. Users are notified before they are disconnected due to inactivity. If
            they try to reconnect to the streaming session before the time interval specified in
            <code>DisconnectTimeoutInSeconds</code> elapses, they are connected to their
            previous session. Users are considered idle when they stop providing keyboard or mouse
            input during their streaming session. File uploads and downloads, audio in, audio out,
            and pixels changing do not qualify as user activity. If users continue to be idle after
            the time interval in <code>IdleDisconnectTimeoutInSeconds</code> elapses, they are
            disconnected.</p>
         <p>To prevent users from being disconnected due to inactivity, specify a value of 0. Otherwise, specify a value between 60 and 36000. The default value is 0.</p>
         <note>
            <p>If you enable this feature, we recommend that you specify a value that corresponds exactly to a whole number of minutes (for example, 60, 120, and 180). If you don't do this, the value is rounded to the nearest minute. For example, if you specify a value of 70, users are disconnected after 1 minute of inactivity. If you specify a value that is at the midpoint between two different minutes, the value is rounded up. For example, if you specify a value of 90, users are disconnected after 2 minutes of inactivity. </p>
         </note>

            fleet_type: str?  # <p>The fleet type.</p>
         <dl>
            <dt>ALWAYS_ON</dt>
            <dd>
               <p>Provides users with instant-on access to their apps.
                        You are charged for all running instances in your fleet, even if no users are streaming apps.</p>
            </dd>
            <dt>ON_DEMAND</dt>
            <dd>
               <p>Provide users with access to applications after they connect, which takes one to two minutes.
                        You are charged for instance streaming when users are connected and a
                        small hourly fee for instances that are not streaming apps.</p>
            </dd>
         </dl>

            tags: {str: str}?  # <p>The tags to associate with the fleet. A tag is a key-value pair, and the value is optional. For example, Environment=Test. If you do not specify a value, Environment=. </p>
         <p>If you do not specify a value, the value is set to an empty string.</p>
         <p>Generally allowed characters are: letters, numbers, and spaces representable in UTF-8, and the following special characters: </p>
         <p>_ . : / = + \ - @</p>
         <p>For more information, see <a href="https://docs.aws.amazon.com/appstream2/latest/developerguide/tagging-basic.html">Tagging Your Resources</a> in the <i>Amazon AppStream 2.0 Administration Guide</i>.</p>

            stream_view: str?  # <p>The AppStream 2.0 view that is displayed to your users when they stream from the fleet. When <code>APP</code> is specified, only the windows of applications opened by users display. When <code>DESKTOP</code> is specified, the standard desktop that is provided by the operating system displays.</p>
         <p>The default value is <code>APP</code>.</p>

            compute_capacity: str?  # <p>The desired capacity for the fleet. This is not allowed for Elastic fleets. For Elastic fleets, specify MaxConcurrentSessions instead.</p>

            max_user_duration_in_seconds: int?  # <p>The maximum amount of time that a streaming session can remain active, in seconds. If users are still connected to a streaming instance five minutes before this limit is reached, they are prompted to save any open documents before being disconnected. After this time elapses, the instance is terminated and replaced by a new instance.</p>
         <p>Specify a value between 600 and 432000.</p>

