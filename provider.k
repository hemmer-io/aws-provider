            alarm_model_description: str?  # <p>A description that tells you what the alarm model detects.</p>

            alarm_model_name: str  # <p>A unique name that helps you identify the alarm model. You can't change this name after
      you create the alarm model.</p>

            role_arn: str  # <p>The ARN of the IAM role that allows the alarm to perform actions and access AWS resources. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws-arns-and-namespaces.html">Amazon Resource Names (ARNs)</a> in the <i>AWS General Reference</i>.</p>

            key: str?  # <p>An input attribute used as a key to create an alarm. 
AWS IoT Events routes <a href="https://docs.aws.amazon.com/iotevents/latest/apireference/API_Input.html">inputs</a> 
associated with this key to the alarm.</p>

            tags: [str]?  # <p>A list of key-value pairs that contain metadata for the alarm model. The tags help you
      manage the alarm model. For more information, see <a href="https://docs.aws.amazon.com/iotevents/latest/developerguide/tagging-iotevents.html">Tagging your AWS IoT Events
        resources</a> in the <i>AWS IoT Events Developer Guide</i>.</p>
         <p>You can create up to 50 tags for one alarm model.</p>



            # Outputs

            alarm_notification_output?: str  # <p>Contains information about one or more notification actions.</p>

            alarm_model_description_output?: str  # <p>The description of the alarm model.</p>

            alarm_event_actions_output?: str  # <p>Contains information about one or more alarm actions.</p>

            alarm_model_version_output?: str  # <p>The version of the alarm model.</p>

            status_output?: str  # <p>The status of the alarm model. The status can be one of the following values:</p>
         <ul>
            <li>
               <p>
                  <code>ACTIVE</code> - The alarm model is active and it's ready to evaluate data.</p>
            </li>
            <li>
               <p>
                  <code>ACTIVATING</code> - AWS IoT Events is activating your alarm model. 
        Activating an alarm model can take up to a few minutes.</p>
            </li>
            <li>
               <p>
                  <code>INACTIVE</code> - The alarm model is inactive, so it isn't ready to evaluate data. 
	  Check your alarm model information and update the alarm model.</p>
            </li>
            <li>
               <p>
                  <code>FAILED</code> - You couldn't create or update the alarm model. Check your alarm model information 
        and try again.</p>
            </li>
         </ul>

            alarm_model_name_output?: str  # <p>The name of the alarm model.</p>

            last_update_time_output?: str  # <p>The time the alarm model was last updated, in the Unix epoch format.</p>

            alarm_model_arn_output?: str  # <p>The ARN of the alarm model. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws-arns-and-namespaces.html">Amazon Resource Names (ARNs)</a> in the <i>AWS General Reference</i>.</p>

            key_output?: str  # <p>An input attribute used as a key to create an alarm. 
AWS IoT Events routes <a href="https://docs.aws.amazon.com/iotevents/latest/apireference/API_Input.html">inputs</a> 
associated with this key to the alarm.</p>

            role_arn_output?: str  # <p>The ARN of the IAM role that allows the alarm to perform actions and access AWS resources. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws-arns-and-namespaces.html">Amazon Resource Names (ARNs)</a> in the <i>AWS General Reference</i>.</p>

            creation_time_output?: str  # <p>The time the alarm model was created, in the Unix epoch format.</p>

            alarm_rule_output?: str  # <p>Defines when your alarm is invoked.</p>

            status_message_output?: str  # <p>
      Contains information about the status of the alarm model.
    </p>

            alarm_capabilities_output?: str  # <p>Contains the configuration information of alarm state changes.</p>

            severity_output?: int  # <p>A non-negative integer that reflects the severity level of the alarm.</p>




