        schema Identity_resolution_job:
            """
            IdentityResolutionJob resource
            """



            # Outputs

            job_stats_output?: str  # <p>Statistics about the Identity Resolution Job.</p>

            job_id_output?: str  # <p>The unique identifier of the Identity Resolution Job.</p>

            job_start_time_output?: str  # <p>The timestamp of when the Identity Resolution Job was started or will be started.</p>

            job_end_time_output?: str  # <p>The timestamp of when the Identity Resolution Job was completed.</p>

            last_updated_at_output?: str  # <p>The timestamp of when the Identity Resolution Job was most recently edited.</p>

            auto_merging_output?: str  # <p>Configuration settings for how to perform the auto-merging of profiles.</p>

            exporting_location_output?: str  # <p>The S3 location where the Identity Resolution Job writes result files.</p>

            domain_name_output?: str  # <p>The unique name of the domain.</p>

            status_output?: str  # <p>The status of the Identity Resolution Job.</p>
         <ul>
            <li>
               <p>
                  <code>PENDING</code>: The Identity Resolution Job is scheduled but has not started yet. If you turn
               off the Identity Resolution feature in your domain, jobs in the <code>PENDING</code> state are
               deleted.</p>
            </li>
            <li>
               <p>
                  <code>PREPROCESSING</code>: The Identity Resolution Job is loading your data.</p>
            </li>
            <li>
               <p>
                  <code>FIND_MATCHING</code>: The Identity Resolution Job is using the machine learning model to
               identify profiles that belong to the same matching group.</p>
            </li>
            <li>
               <p>
                  <code>MERGING</code>: The Identity Resolution Job is merging duplicate profiles.</p>
            </li>
            <li>
               <p>
                  <code>COMPLETED</code>: The Identity Resolution Job completed successfully.</p>
            </li>
            <li>
               <p>
                  <code>PARTIAL_SUCCESS</code>: There's a system error and not all of the data is
               merged. The Identity Resolution Job writes a message indicating the source of the problem.</p>
            </li>
            <li>
               <p>
                  <code>FAILED</code>: The Identity Resolution Job did not merge any data. It writes a message
               indicating the source of the problem.</p>
            </li>
         </ul>

            message_output?: str  # <p>The error messages that are generated when the Identity Resolution Job runs.</p>

            job_expiration_time_output?: str  # <p>The timestamp of when the Identity Resolution Job will expire.</p>




