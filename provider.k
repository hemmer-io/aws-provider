            tags_output?: str  # <p>The collection of tags. Each tag element is associated with a given resource.</p>

            deployment_id_output?: str  # <p>The identifier of the Deployment that the stage points to.</p>

            cache_cluster_enabled_output?: bool  # <p>Specifies whether a cache cluster is enabled for the stage. To activate a method-level cache, set <code>CachingEnabled</code> to <code>true</code> for a method. </p>

            client_certificate_id_output?: str  # <p>The identifier of a client certificate for an API stage.</p>

            method_settings_output?: {str: str}  # <p>A map that defines the method settings for a Stage resource. Keys (designated as <code>/{method_setting_key</code> below) are method paths defined as <code>{resource_path}/{http_method}</code> for an individual method override, or <code>/\*/\*</code> for overriding all methods in the stage.  </p>

            variables_output?: str  # <p>A map that defines the stage variables for a Stage resource. Variable names can
          have alphanumeric and underscore characters, and the values must match <code>[A-Za-z0-9-._~:/?#&=,]+</code>.</p>

            description_output?: str  # <p>The stage's description.</p>

            documentation_version_output?: str  # <p>The version of the associated API documentation.</p>

            access_log_settings_output?: str  # <p>Settings for logging access in this stage.</p>

            cache_cluster_size_output?: str  # <p>The stage's cache capacity in GB. For more information about choosing a cache size, see <a href="https://docs.aws.amazon.com/apigateway/latest/developerguide/api-gateway-caching.html">Enabling API caching to enhance responsiveness</a>.</p>

            cache_cluster_status_output?: str  # <p>The status of the cache cluster for the stage, if enabled.</p>

