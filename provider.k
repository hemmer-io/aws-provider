            content_location_output?: str  # <p>The relative path that specifies the location of the content definition file.</p>

            workspace_id_output?: str  # <p>The ID of the workspace that contains the scene.</p>

            scene_id_output?: str  # <p>The ID of the scene.</p>

            generated_scene_metadata_output?: {str: str}  # <p>The generated scene metadata.</p>

            description_output?: str  # <p>The description of the scene.</p>

            capabilities_output?: [str]  # <p>A list of capabilities that the scene uses to render.</p>

            scene_metadata_output?: {str: str}  # <p>The response metadata.</p>

            error_output?: str  # <p>The SceneResponse error.</p>

            update_date_time_output?: str  # <p>The date and time when the scene was last updated.</p>




        schema Sync_job:
            """
            SyncJob resource
            """

            sync_source: str  # <p>The sync source.</p>
         <note>
            <p>Currently the only supported syncSoource is <code>SITEWISE </code>.</p>
         </note>

            workspace_id: str  # <p>The workspace ID.</p>

            sync_role: str  # <p>The SyncJob IAM role. This IAM role is used by the SyncJob to read from the syncSource,
         and create, update, or delete the corresponding resources.</p>

            tags: {str: str}?  # <p>The SyncJob tags.</p>



            # Outputs

            sync_role_output?: str  # <p>The sync IAM role.</p>

            arn_output?: str  # <p>The sync job ARN.</p>

            update_date_time_output?: str  # <p>The update date and time.</p>

            workspace_id_output?: str  # <p>The ID of the workspace that contains the sync job.</p>

            sync_source_output?: str  # <p>The sync soucre.</p>
         <note>
            <p>Currently the only supported syncSource is <code>SITEWISE </code>.</p>
         </note>

            creation_date_time_output?: str  # <p>The creation date and time.</p>

            status_output?: str  # <p>The SyncJob response status.</p>




        schema Component_type:
