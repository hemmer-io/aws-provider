            external_source_setting_output?: str  # 

            description_output?: str  # <p>The description specified for the slot type.</p>

            value_selection_setting_output?: str  # <p>The strategy that Amazon Lex uses to choose a value from a list of
         possible values.</p>

            bot_id_output?: str  # <p>The identifier of the bot associated with the slot type.</p>

            bot_version_output?: str  # <p>The version of the bot associated with the slot type.</p>




        schema Bot_recommendation:
            """
            BotRecommendation resource
            """

            locale_id: str  # <p>The identifier of the language and locale of the bot recommendation
         to update. The string must match one of the supported locales. For more
         information, see <a href="https://docs.aws.amazon.com/lexv2/latest/dg/how-languages.html">Supported languages</a>
         </p>

            bot_recommendation_id: str  # <p>The unique identifier of the bot recommendation to be
         updated.</p>

            encryption_setting: str  # <p>The object representing the passwords that will be used to encrypt
         the data related to the bot recommendation results, as well as the KMS
         key ARN used to encrypt the associated metadata.</p>

            bot_id: str  # <p>The unique identifier of the bot containing the bot recommendation
         to be updated.</p>

            bot_version: str  # <p>The version of the bot containing the bot recommendation to be
         updated.</p>



            # Outputs

            locale_id_output?: str  # <p>The identifier of the language and locale of the bot recommendation
         to describe.</p>

            transcript_source_setting_output?: str  # <p>The object representing the Amazon S3 bucket containing the transcript,
         as well as the associated metadata.</p>

            encryption_setting_output?: str  # <p>The object representing the passwords that were used to encrypt the
         data related to the bot recommendation results, as well as the KMS key
         ARN used to encrypt the associated metadata.</p>

            bot_id_output?: str  # <p>The identifier of the bot associated with the bot
         recommendation.</p>

            bot_version_output?: str  # <p>The version of the bot associated with the bot
         recommendation.</p>

            bot_recommendation_status_output?: str  # <p>The status of the bot recommendation. If the status is Failed, then
         the reasons for the failure are listed in the failureReasons field.
      </p>

            last_updated_date_time_output?: str  # <p>The date and time that the bot recommendation was last
         updated.</p>

            bot_recommendation_id_output?: str  # <p>The identifier of the bot recommendation being described.</p>

            failure_reasons_output?: [str]  # <p>If botRecommendationStatus is Failed, Amazon Lex explains why.</p>

            creation_date_time_output?: str  # <p>The date and time that the bot recommendation was created.</p>

            bot_recommendation_results_output?: str  # <p>The object representing the URL of the bot definition, the URL of
         the associated transcript and a statistical summary of the bot
         recommendation results.</p>




        schema Bot_alias:
            """
            BotAlias resource
            """

            conversation_log_settings: str?  # <p>Specifies whether Amazon Lex logs text and audio for a conversation with
         the bot. When you enable conversation logs, text logs store text input,
         transcripts of audio input, and associated metadata in Amazon CloudWatch Logs. Audio
         logs store audio input in Amazon S3.</p>

            bot_alias_locale_settings: {str: str}?  # <p>Maps configuration information to a specific locale. You can use
         this parameter to specify a specific Lambda function to run different
         functions in different locales.</p>

            description: str?  # <p>A description of the alias. Use this description to help identify
         the alias.</p>

            tags: {str: str}?  # <p>A list of tags to add to the bot alias. You can only add tags when
         you create an alias, you can't use the <code>UpdateBotAlias</code>
         operation to update the tags on a bot alias. To update tags, use the
            <code>TagResource</code> operation.</p>

            sentiment_analysis_settings: str?  # 

            bot_version: str?  # <p>The version of the bot that this alias points to. You can use the
            <a href="https://docs.aws.amazon.com/lexv2/latest/APIReference/API_UpdateBotAlias.html">UpdateBotAlias</a> operation to change the
         bot version associated with the alias.</p>

            bot_alias_name: str  # <p>The alias to create. The name must be unique for the bot.</p>

            bot_id: str  # <p>The unique identifier of the bot that the alias applies to.</p>



            # Outputs

            bot_alias_locale_settings_output?: {str: str}  # <p>The locale settings that are unique to the alias.</p>

            bot_id_output?: str  # <p>The identifier of the bot associated with the bot alias.</p>

            creation_date_time_output?: str  # <p>A timestamp of the date and time that the alias was created.</p>

            conversation_log_settings_output?: str  # <p>Specifics of how Amazon Lex logs text and audio conversations with the
         bot associated with the alias.</p>

            last_updated_date_time_output?: str  # <p>A timestamp of the date and time that the alias was last
         updated.</p>

            bot_alias_status_output?: str  # <p>The current status of the alias. When the alias is
            <code>Available</code>, the alias is ready for use with your
         bot.</p>

            sentiment_analysis_settings_output?: str  # 

            parent_bot_networks_output?: [str]  # <p>A list of the networks to which the bot alias you described belongs.</p>

            bot_alias_history_events_output?: [str]  # <p>A list of events that affect a bot alias. For example, an event is
         recorded when the version that the alias points to changes.</p>

            bot_version_output?: str  # <p>The version of the bot associated with the bot alias.</p>

            bot_alias_name_output?: str  # <p>The name of the bot alias.</p>

            bot_alias_id_output?: str  # <p>The identifier of the bot alias.</p>

            description_output?: str  # <p>The description of the bot alias.</p>




        schema Export:
            """
            Export resource
            """

            file_format: str  # <p>The file format of the bot or bot locale definition files.</p>

            file_password: str?  # <p>An password to use to encrypt the exported archive. Using a password
         is optional, but you should encrypt the archive to protect the data in
         transit between Amazon Lex and your local computer.</p>

            resource_specification: str  # <p>Specifies the type of resource to export, either a bot or a bot
         locale. You can only specify one type of resource to export.</p>



            # Outputs

            export_id_output?: str  # <p>The unique identifier of the described export.</p>

            failure_reasons_output?: [str]  # <p>If the <code>exportStatus</code> is failed, contains one or more
         reasons why the export could not be completed.</p>

            last_updated_date_time_output?: str  # <p>The last date and time that the export was updated.</p>

            creation_date_time_output?: str  # <p>The date and time that the export was created.</p>

            resource_specification_output?: str  # <p>The bot, bot ID, and optional locale ID of the exported bot or bot
         locale.</p>

            download_url_output?: str  # <p>A pre-signed S3 URL that points to the bot or bot locale archive.
         The URL is only available for 5 minutes after calling the
            <code>DescribeExport</code> operation.</p>

            file_format_output?: str  # <p>The file format used in the files that describe the resource.
      </p>

            export_status_output?: str  # <p>The status of the export. When the status is <code>Complete</code>
         the export archive file is available for download.</p>




        schema Custom_vocabulary:
            """
            CustomVocabulary resource
            """




        schema Test_execution:
            """
            TestExecution resource
            """



            # Outputs

            test_set_id_output?: str  # <p>The test set Id for the test set execution.</p>

            test_execution_status_output?: str  # <p>The test execution status for the test execution.</p>

            test_set_name_output?: str  # <p>The test set name of the test set execution.</p>

            last_updated_date_time_output?: str  # <p>The date and time of the last update for the execution.</p>

            test_execution_modality_output?: str  # <p>Indicates whether test set is audio or text.</p>

            target_output?: str  # <p>The target bot for the test set execution details.</p>

            api_mode_output?: str  # <p>Indicates whether we use streaming or non-streaming APIs are used for 
      the test set execution. For streaming, <code>StartConversation</code> 
      Amazon Lex Runtime API is used. Whereas for non-streaming, <code>RecognizeUtterance</code> 
      and <code>RecognizeText</code> Amazon Lex Runtime API is used.</p>

            creation_date_time_output?: str  # <p>The execution creation date and time for the test set execution.</p>

            failure_reasons_output?: [str]  # <p>Reasons for the failure of the test set execution.</p>

            test_execution_id_output?: str  # <p>The execution Id for the test set execution.</p>




        schema Bot_version:
            """
            BotVersion resource
            """

            bot_version_locale_specification: {str: str}  # <p>Specifies the locales that Amazon Lex adds to this version. You can
         choose the <code>Draft</code> version or any other previously published
         version for each locale. When you specify a source version, the locale
         data is copied from the source version to the new version.</p>

            description: str?  # <p>A description of the version. Use the description to help identify
         the version in lists.</p>

            bot_id: str  # <p>The identifier of the bot to create the version for.</p>



            # Outputs

            bot_type_output?: str  # <p>The type of the bot in the version that was described.</p>

            idle_session_ttl_in_seconds_output?: int  # <p>The number of seconds that a session with the bot remains active
         before it is discarded by Amazon Lex.</p>

            bot_members_output?: [str]  # <p>The members of bot network in the version that was described.</p>

            bot_status_output?: str  # <p>The current status of the bot. When the status is
            <code>Available</code>, the bot version is ready for use.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of an IAM role that has permission to
         access the bot version.</p>

            failure_reasons_output?: [str]  # <p>If the <code>botStatus</code> is <code>Failed</code>, this contains
         a list of reasons that the version couldn't be built.</p>

            bot_id_output?: str  # <p>The identifier of the bot that contains the version.</p>

            bot_version_output?: str  # <p>The version of the bot that was described.</p>

            data_privacy_output?: str  # <p>Data privacy settings for the bot version.</p>

            creation_date_time_output?: str  # <p>A timestamp of the date and time that the bot version was
         created.</p>

            parent_bot_networks_output?: [str]  # <p>A list of the networks to which the bot version you described belongs.</p>

            bot_name_output?: str  # <p>The name of the bot that contains the version.</p>

            description_output?: str  # <p>The description specified for the bot.</p>




        schema Intent:
            """
            Intent resource
            """

            dialog_code_hook: str?  # <p>Specifies that Amazon Lex invokes the alias Lambda function for each user
         input. You can invoke this Lambda function to personalize user
         interaction.</p>
         <p>For example, suppose that your bot determines that the user's name
         is John. You Lambda function might retrieve John's information from a
         backend database and prepopulate some of the values. For example, if
         you find that John is gluten intolerant, you might set the
         corresponding intent slot, <code>glutenIntolerant</code> to
            <code>true</code>. You might find John's phone number and set the
         corresponding session attribute.</p>

            qn_a_intent_configuration: str?  # <p>Specifies the configuration of the built-in <code>Amazon.QnAIntent</code>. The <code>AMAZON.QnAIntent</code> intent is called when
         Amazon Lex can't determine another intent to invoke. If you specify this field, you can't specify the <code>kendraConfiguration</code> field.</p>

            fulfillment_code_hook: str?  # <p>Specifies that Amazon Lex invokes the alias Lambda function when the
         intent is ready for fulfillment. You can invoke this function to
         complete the bot's transaction with the user.</p>
         <p>For example, in a pizza ordering bot, the Lambda function can look up
         the closest pizza restaurant to the customer's location and then place
         an order on the customer's behalf.</p>

            input_contexts: [str]?  # <p>A list of contexts that must be active for this intent to be
         considered by Amazon Lex.</p>
         <p>When an intent has an input context list, Amazon Lex only considers using
         the intent in an interaction with the user when the specified contexts
         are included in the active context list for the session. If the
         contexts are not active, then Amazon Lex will not use the intent.</p>
         <p>A context can be automatically activated using the
            <code>outputContexts</code> property or it can be set at
         runtime.</p>
         <p> For example, if there are two intents with different input contexts
         that respond to the same utterances, only the intent with the active
         context will respond.</p>
         <p>An intent may have up to 5 input contexts. If an intent has multiple
         input contexts, all of the contexts must be active to consider the
         intent.</p>

            bot_id: str  # <p>The identifier of the bot associated with this intent.</p>

            locale_id: str  # <p>The identifier of the language and locale where this intent is used.
         All of the bots, slot types, and slots used by the intent must have the
         same locale. For more information, see <a href="https://docs.aws.amazon.com/lexv2/latest/dg/how-languages.html">Supported languages</a>.</p>

            parent_intent_signature: str?  # <p>A unique identifier for the built-in intent to base this intent
         on.</p>

            output_contexts: [str]?  # <p>A lists of contexts that the intent activates when it is
         fulfilled.</p>
         <p>You can use an output context to indicate the intents that Amazon Lex
         should consider for the next turn of the conversation with a customer. </p>
         <p>When you use the <code>outputContextsList</code> property, all of
         the contexts specified in the list are activated when the intent is
         fulfilled. You can set up to 10 output contexts. You can also set the
         number of conversation turns that the context should be active, or the
         length of time that the context should be active.</p>

            bot_version: str  # <p>The version of the bot associated with this
         intent.</p>

            sample_utterances: [str]?  # <p>An array of strings that a user might say to signal the intent. For
         example, "I want a pizza", or "I want a {PizzaSize} pizza". </p>
         <p>In an utterance, slot names are enclosed in curly braces ("{", "}")
         to indicate where they should be displayed in the utterance shown to
         the user.. </p>

            initial_response_setting: str?  # <p>Configuration settings for the response that is sent to the user at
         the beginning of a conversation, before eliciting slot values.</p>

            intent_name: str  # <p>The name of the intent. Intent names must be unique in the locale
         that contains the intent and cannot match the name of any built-in
         intent.</p>

            q_in_connect_intent_configuration: str?  # <p>Qinconnect intent configuration details for the create intent request.</p>

            intent_confirmation_setting: str?  # <p>Provides prompts that Amazon Lex sends to the user to confirm the
         completion of an intent. If the user answers "no," the settings contain
         a statement that is sent to the user to end the intent.</p>

            description: str?  # <p>A description of the intent. Use the description to help identify
         the intent in lists.</p>

            intent_closing_setting: str?  # <p>Sets the response that Amazon Lex sends to the user when the intent is
         closed.</p>

            kendra_configuration: str?  # <p>Configuration information required to use the
            <code>AMAZON.KendraSearchIntent</code> intent to connect to an Amazon Kendra
         index. The <code>AMAZON.KendraSearchIntent</code> intent is called when
         Amazon Lex can't determine another intent to invoke.</p>



            # Outputs

            initial_response_setting_output?: str  # <p>Configuration setting for a response sent to the user before Amazon Lex starts eliciting slots.</p>

            qn_a_intent_configuration_output?: str  # <p>Details about the configuration of the built-in <code>Amazon.QnAIntent</code>.</p>

            fulfillment_code_hook_output?: str  # <p>The Lambda function called when the intent is complete and ready for
         fulfillment.</p>

            input_contexts_output?: [str]  # <p>A list of contexts that must be active for the intent to be
         considered for sending to the user.</p>

            intent_confirmation_setting_output?: str  # <p>Prompts that Amazon Lex sends to the user to confirm completion of an
         intent.</p>

            kendra_configuration_output?: str  # <p>Configuration information required to use the
            <code>AMAZON.KendraSearchIntent</code> intent.</p>

            locale_id_output?: str  # <p>The language and locale specified for the intent.</p>

            dialog_code_hook_output?: str  # <p>The Lambda function called during each turn of a conversation with
         the intent.</p>

            output_contexts_output?: [str]  # <p>A list of contexts that are activated when the intent is
         fulfilled.</p>

            bot_version_output?: str  # <p>The version of the bot associated with the intent.</p>

            q_in_connect_intent_configuration_output?: str  # <p>Qinconnect intent configuration details for the describe intent response.</p>

            slot_priorities_output?: [str]  # <p>The list that determines the priority that slots should be elicited
         from the user.</p>

            sample_utterances_output?: [str]  # <p>User utterances that trigger this intent.</p>

            bot_id_output?: str  # <p>The identifier of the bot associated with the intent.</p>

            intent_closing_setting_output?: str  # <p>The response that Amazon Lex sends to when the intent is closed.</p>

            intent_id_output?: str  # <p>The unique identifier assigned to the intent when it was
         created.</p>

            intent_name_output?: str  # <p>The name specified for the intent.</p>

            creation_date_time_output?: str  # <p>A timestamp of the date and time that the intent was created.</p>

            last_updated_date_time_output?: str  # <p>A timestamp of the date and time that the intent was last
         updated.</p>

            parent_intent_signature_output?: str  # <p>The identifier of the built-in intent that this intent is derived
         from, if any.</p>

            description_output?: str  # <p>The description of the intent.</p>




        schema Bot_replica:
            """
            BotReplica resource
            """

            bot_id: str  # <p>The request for the unique bot ID of the source bot to be replicated in the secondary region.</p>

            replica_region: str  # <p>The request for the secondary region that will be used in the replication of the source bot.</p>



            # Outputs

            replica_region_output?: str  # <p>The region of the replicated bot being monitored.</p>

            creation_date_time_output?: str  # <p>The creation date and time of the replicated bot being monitored.</p>

            source_region_output?: str  # <p>The source region of the replicated bot being monitored.</p>

            failure_reasons_output?: [str]  # <p>The failure reasons the bot being monitored failed to replicate.</p>

            bot_replica_status_output?: str  # <p>The operational status of the replicated bot being monitored.</p>

            bot_id_output?: str  # <p>The unique bot ID of the replicated bot being monitored.</p>




        schema Test_set_generation:
            """
            TestSetGeneration resource
            """



            # Outputs

            test_set_generation_id_output?: str  # <p>The unique identifier of the test set generation.</p>

            failure_reasons_output?: [str]  # <p>The reasons the test set generation failed.</p>

            test_set_name_output?: str  # <p>The test set name for the generated test set.</p>

            generation_data_source_output?: str  # <p>The data source of the test set used for the test set generation.</p>

            test_set_id_output?: str  # <p>The unique identifier for the test set created for the generated test set.</p>

            description_output?: str  # <p>The test set description for the test set generation.</p>

            last_updated_date_time_output?: str  # <p>The date and time of the last update for the test set generation.</p>

            test_set_generation_status_output?: str  # <p>The status for the test set generation.</p>

            creation_date_time_output?: str  # <p>The creation date and time for the test set generation.</p>

            role_arn_output?: str  # <p> The roleARN of the test set used for the test set generation.</p>

            storage_location_output?: str  # <p>The Amazon S3 storage location for the test set generation.</p>




        schema Slot:
            """
            Slot resource
            """

            slot_type_id: str?  # <p>The unique identifier for the slot type associated with this slot.
         The slot type determines the values that can be entered into the
         slot.</p>

            slot_name: str  # <p>The name of the slot. Slot names must be unique within the bot that
         contains the slot.</p>

            locale_id: str  # <p>The identifier of the language and locale that the slot will be used
         in. The string must match one of the supported locales. All of the
         bots, intents, slot types used by the slot must have the same locale.
         For more information, see <a href="https://docs.aws.amazon.com/lexv2/latest/dg/how-languages.html">Supported languages</a>.</p>

            intent_id: str  # <p>The identifier of the intent that contains the slot.</p>

            value_elicitation_setting: str  # <p>Specifies prompts that Amazon Lex sends to the user to elicit a response
         that provides the value for the slot. </p>

            bot_version: str  # <p>The version of the bot associated with the slot.</p>

            obfuscation_setting: str?  # <p>Determines how slot values are used in Amazon CloudWatch logs. If the value of
         the <code>obfuscationSetting</code> parameter is
            <code>DefaultObfuscation</code>, slot values are obfuscated in the
         log output. If the value is <code>None</code>, the actual value is
         present in the log output.</p>
         <p>The default is to obfuscate values in the CloudWatch logs.</p>

            sub_slot_setting: str?  # <p>Specifications for the constituent sub slots and the  
        expression for the composite slot.</p>

            bot_id: str  # <p>The identifier of the bot associated with the slot.</p>

            multiple_values_setting: str?  # <p>Indicates whether the slot returns multiple values in one response.
         Multi-value slots are only available in the <code>en-US</code> locale. 
         If you set this value to <code>true</code> in any other locale, Amazon Lex throws a
            <code>ValidationException</code>. </p>
         <p>If the <code>multipleValuesSetting</code> is not set, the default
         value is <code>false</code>.</p>

            description: str?  # <p>A description of the slot. Use this to help identify the slot in
         lists.</p>



            # Outputs

            intent_id_output?: str  # <p>The identifier of the intent associated with the slot.</p>

            slot_name_output?: str  # <p>The name specified for the slot.</p>

            slot_type_id_output?: str  # <p>The identifier of the slot type that determines the values entered
         into the slot.</p>

            slot_id_output?: str  # <p>The unique identifier generated for the slot.</p>

            locale_id_output?: str  # <p>The language and locale specified for the slot.</p>

            creation_date_time_output?: str  # <p>A timestamp of the date and time that the slot was created.</p>

            multiple_values_setting_output?: str  # <p>Indicates whether the slot accepts multiple values in a single
         utterance.</p>
         <p>If the <code>multipleValuesSetting</code> is not set, the default
         value is <code>false</code>.</p>

            obfuscation_setting_output?: str  # <p>Whether slot values are shown in Amazon CloudWatch logs. If the value is
            <code>None</code>, the actual value of the slot is shown in
         logs.</p>

            last_updated_date_time_output?: str  # <p>A timestamp of the date and time that the slot was last
         updated.</p>

            value_elicitation_setting_output?: str  # <p>Prompts that Amazon Lex uses to elicit a value for the slot.</p>

            sub_slot_setting_output?: str  # <p>Specifications for the constituent sub slots and the  
        expression for the composite slot.</p>

            description_output?: str  # <p>The description specified for the slot.</p>

            bot_id_output?: str  # <p>The identifier of the bot associated with the slot.</p>

            bot_version_output?: str  # <p>The version of the bot associated with the slot.</p>




        schema Test_set:
            """
            TestSet resource
            """

            test_set_id: str  # <p>The test set Id for which update test operation to be performed.</p>

            description: str?  # <p>The new test set description.</p>

            test_set_name: str  # <p>The new test set name.</p>



            # Outputs

            modality_output?: str  # <p>Indicates whether the test set is audio or text data.</p>

            last_updated_date_time_output?: str  # <p>The date and time for the last update of the test set data.</p>

            test_set_id_output?: str  # <p>The test set Id for the test set response.</p>

            status_output?: str  # <p>The status of the test set.</p>

            num_turns_output?: int  # <p>The total number of agent and user turn in the test set.</p>

            creation_date_time_output?: str  # <p>The creation date and time for the test set data.</p>

            storage_location_output?: str  # <p>The Amazon S3 storage location for the test set data.</p>

            role_arn_output?: str  # <p>The roleARN used for any operation in the test set to access 
      resources in the Amazon Web Services account.</p>

            description_output?: str  # <p>The description of the test set.</p>

            test_set_name_output?: str  # <p>The test set name of the test set.</p>




        schema Resource_policy_statement:
            """
            ResourcePolicyStatement resource
            """

            resource_arn: str  # <p>The Amazon Resource Name (ARN) of the bot or bot alias that the
         resource policy is attached to.</p>

            principal: [str]  # <p>An IAM principal, such as an IAM user, IAM role, 
         or Amazon Web Services services
         that is allowed or denied access to a resource. For more information,
         see <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_principal.html">Amazon Web Services JSON policy elements: Principal</a>.</p>

            statement_id: str  # <p>The name of the statement. The ID is the same as the
            <code>Sid</code> IAM property. The statement name must be unique
         within the policy. For more information, see <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_sid.html">IAM
            JSON policy elements: Sid</a>. </p>

            effect: str  # <p>Determines whether the statement allows or denies access to the
         resource.</p>

            action: [str]  # <p>The Amazon Lex action that this policy either allows or denies. The
         action must apply to the resource type of the specified ARN. For more
         information, see <a href="https://docs.aws.amazon.com/service-authorization/latest/reference/list_amazonlexv2.html">
            Actions, resources, and condition keys for Amazon Lex V2</a>.</p>

            expected_revision_id: str?  # <p>The identifier of the revision of the policy to edit. If this
         revision ID doesn't match the current revision ID, Amazon Lex throws an
         exception.</p>
         <p>If you don't specify a revision, Amazon Lex overwrites the contents of
         the policy with the new values.</p>

            condition: {str: str}?  # <p>Specifies a condition when the policy is in effect. If the principal
         of the policy is a service principal, you must provide two condition
         blocks, one with a SourceAccount global condition key and one with a
         SourceArn global condition key.</p>
