            entity_name: str  # <p>The name of the entity.</p>

            parent_entity_id: str?  # <p>The ID of the entity's parent entity.</p>

            entity_id: str?  # <p>The ID of the entity.</p>

            tags: {str: str}?  # <p>Metadata that you can use to manage the entity.</p>

            composite_components: {str: str}?  # <p>This is an object that maps strings to <code>compositeComponent</code> updates in the request. 
