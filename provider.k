            """
            LaunchAction resource
            """

            parameters: {str: str}?  # 

            order: int  # 

            description: str  # 

            resource_id: str  # 

            optional: bool  # <p>Whether the launch will not be marked as failed if this action fails.</p>

            active: bool  # <p>Whether the launch action is active.</p>

            category: str  # 

            action_id: str  # 

            action_code: str  # <p>Launch action code.</p>

            name: str  # 

            action_version: str  # 




