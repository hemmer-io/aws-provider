               <p>US West (Oregon) (<code>us-west-2</code>)</p>
            </li>
            <li>
               <p>Europe (Ireland) (<code>eu-west-1</code>)</p>
            </li>
            <li>
               <p>Asia Pacific (Tokyo) (<code>ap-northeast-1</code>)</p>
            </li>
            <li>
