            action_type: str  # <p>The action type.</p>

            description: str?  # <p>The description of the action.</p>

            metadata_properties: str?  # 



            # Outputs

            last_modified_by_output?: str  # 

            last_modified_time_output?: str  # <p>When the action was last modified.</p>

            action_name_output?: str  # <p>The name of the action.</p>

            action_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the action.</p>

            source_output?: str  # <p>The source of the action.</p>

            metadata_properties_output?: str  # 

            creation_time_output?: str  # <p>When the action was created.</p>

            created_by_output?: str  # 

            lineage_group_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the lineage group.</p>

            status_output?: str  # <p>The status of the action.</p>

