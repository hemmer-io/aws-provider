            updated_at_output?: str  # <p>The date and time the Q App was last updated.</p>

            initial_prompt_output?: str  # <p>The initial prompt displayed when the Q App is started.</p>

            title_output?: str  # <p>The title of the Q App.</p>

            app_version_output?: int  # <p>The version of the Q App.</p>

            status_output?: str  # <p>The status of the Q App.</p>

            description_output?: str  # <p>The description of the Q App.</p>

            app_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the Q App.</p>





