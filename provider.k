            # Outputs

            last_modified_time_output?: str  # <p>A timestamp indicating when the metadata for the feature group was modified. For example, if you add a parameter describing the feature, the timestamp changes to reflect the last time you </p>

            description_output?: str  # <p>The description you added to describe the feature.</p>

            creation_time_output?: str  # <p>A timestamp indicating when the feature was created.</p>

            feature_group_name_output?: str  # <p>The name of the feature group that you've specified.</p>

            feature_group_arn_output?: str  # <p>The Amazon Resource Number (ARN) of the feature group that contains the feature.</p>

            parameters_output?: [str]  # <p>The key-value pairs that you added to describe the feature.</p>

            feature_name_output?: str  # <p>The name of the feature that you've specified.</p>

