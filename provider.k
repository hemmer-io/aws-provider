            evaluation_periods: int  # The number of periods over which data is compared to the specified threshold.

            metric_name: str  # The name of the metric associated with the alarm. Must be compatible with targetResourceType.

            datapoints_to_alarm: int?  # The number of datapoints within the evaluation period that must be breaching to trigger the alarm.

            statistic: str  # 

            comparison_operator: str  # 

            group_identifier: str  # A cloudwatch alarm template group's identifier. Can be either be its id or current name.

            tags: {str: str}?  # 

            description: str?  # A resource's optional description.

            name: str  # A resource's name. Names must be unique within the scope of a resource type in a specific region.



            # Outputs

            group_id_output?: str  # A cloudwatch alarm template group's id. AWS provided template groups have ids that start with `aws-`

            modified_at_output?: str  # 

