            context_type_output?: str  # <p>The type of the context.</p>

            source_output?: str  # <p>The source of the context.</p>

            properties_output?: {str: str}  # <p>A list of the context's properties.</p>

            created_by_output?: str  # 

            description_output?: str  # <p>The description of the context.</p>

            context_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the context.</p>

            creation_time_output?: str  # <p>When the context was created.</p>

            last_modified_by_output?: str  # 

            lineage_group_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the lineage group.</p>

            last_modified_time_output?: str  # <p>When the context was last modified.</p>




        schema Model_card:
            """
            ModelCard resource
            """

            content: str  # <p>The content of the model card. Content must be in <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/model-cards.html#model-cards-json-schema">model card JSON schema</a> and provided as a string.</p>

            model_card_name: str  # <p>The unique name of the model card.</p>

            model_card_status: str  # <p>The approval status of the model card within your organization. Different organizations might have different criteria for model card review and approval.</p> <ul> <li> <p> <code>Draft</code>: The model card is a work in progress.</p> </li> <li> <p> <code>PendingReview</code>: The model card is pending review.</p> </li> <li> <p> <code>Approved</code>: The model card is approved.</p> </li> <li> <p> <code>Archived</code>: The model card is archived. No more updates should be made to the model card, but it can still be exported.</p> </li> </ul>

            tags: [str]?  # <p>Key-value pairs used to manage metadata for model cards.</p>

            security_config: str?  # <p>An optional Key Management Service key to encrypt, decrypt, and re-encrypt model card content for regulated workloads with highly sensitive data.</p>



            # Outputs

            last_modified_time_output?: str  # <p>The date and time the model card was last modified.</p>

            last_modified_by_output?: str  # 

            model_card_version_output?: int  # <p>The version of the model card.</p>

            security_config_output?: str  # <p>The security configuration used to protect model card content.</p>

            model_card_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the model card.</p>

            content_output?: str  # <p>The content of the model card.</p>

            creation_time_output?: str  # <p>The date and time the model card was created.</p>

            model_card_status_output?: str  # <p>The approval status of the model card within your organization. Different organizations might have different criteria for model card review and approval.</p> <ul> <li> <p> <code>Draft</code>: The model card is a work in progress.</p> </li> <li> <p> <code>PendingReview</code>: The model card is pending review.</p> </li> <li> <p> <code>Approved</code>: The model card is approved.</p> </li> <li> <p> <code>Archived</code>: The model card is archived. No more updates should be made to the model card, but it can still be exported.</p> </li> </ul>

            created_by_output?: str  # 

            model_card_processing_status_output?: str  # <p>The processing status of model card deletion. The <code>ModelCardProcessingStatus</code> updates throughout the different deletion steps.</p> <ul> <li> <p> <code>DeletePending</code>: Model card deletion request received.</p> </li> <li> <p> <code>DeleteInProgress</code>: Model card deletion is in progress.</p> </li> <li> <p> <code>ContentDeleted</code>: Deleted model card content.</p> </li> <li> <p> <code>ExportJobsDeleted</code>: Deleted all export jobs associated with the model card.</p> </li> <li> <p> <code>DeleteCompleted</code>: Successfully deleted the model card.</p> </li> <li> <p> <code>DeleteFailed</code>: The model card failed to delete.</p> </li> </ul>

            model_card_name_output?: str  # <p>The name of the model card.</p>




        schema Studio_lifecycle_config:
            """
