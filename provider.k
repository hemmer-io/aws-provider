            context_name: str  # <p>The name of the context. Must be unique to your account in an Amazon Web Services Region.</p>

            source: str  # <p>The source type, ID, and URI.</p>

            tags: [str]?  # <p>A list of tags to apply to the context.</p>

            context_type: str  # <p>The context type.</p>

            description: str?  # <p>The description of the context.</p>

            properties: {str: str}?  # <p>A list of properties to add to the context.</p>



