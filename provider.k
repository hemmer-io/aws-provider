            tag_specifications: [str]?  # <p>Metadata tags for the volume.</p>

            encrypted: bool?  # <p>Indicates if the volume should be encrypted.</p>

            iops: int?  # <p>Input/output operations per second for the volume.</p>

            kms_key_id: str?  # <p>KMS key for volume encryption.</p>

            snapshot_id: str?  # <p>Source snapshot for volume creation.</p>

            volume_type: str?  # <p>Type of EBS volume.</p>




