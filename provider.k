    # Signer Service
    schema SignerService:
        """
        Service for signer resources.
        """


        schema Signing_job:
            """
            SigningJob resource
            """



            # Outputs

            signature_expires_at_output?: str  # <p>Thr expiration timestamp for the signature generated by the signing job.</p>

            revocation_record_output?: str  # <p>A revocation record if the signature generated by the signing job has been revoked.
			Contains a timestamp and the ID of the IAM entity that revoked the signature.</p>

            signing_parameters_output?: {str: str}  # <p>Map of user-assigned key-value pairs used during signing. These values contain any
			information that you specified for use in your signing job. </p>

            created_at_output?: str  # <p>Date and time that the signing job was created.</p>

            profile_version_output?: str  # <p>The version of the signing profile used to initiate the signing job.</p>

            job_id_output?: str  # <p>The ID of the signing job on output.</p>

            platform_id_output?: str  # <p>The microcontroller platform to which your signed code image will be
			distributed.</p>

            completed_at_output?: str  # <p>Date and time that the signing job was completed.</p>

            requested_by_output?: str  # <p>The IAM principal that requested the signing job.</p>

            signed_object_output?: str  # <p>Name of the S3 bucket where the signed code image is saved by AWS Signer.</p>

            status_reason_output?: str  # <p>String value that contains the status reason.</p>

            overrides_output?: str  # <p>A list of any overrides that were applied to the signing operation.</p>

            job_owner_output?: str  # <p>The AWS account ID of the job owner.</p>

            profile_name_output?: str  # <p>The name of the profile that initiated the signing operation.</p>

            status_output?: str  # <p>Status of the signing job.</p>

            job_invoker_output?: str  # <p>The IAM entity that initiated the signing job.</p>

            signing_material_output?: str  # <p>The Amazon Resource Name (ARN) of your code signing certificate.</p>

            source_output?: str  # <p>The object that contains the name of your S3 bucket or your raw code.</p>

            platform_display_name_output?: str  # <p>A human-readable name for the signing platform associated with the signing job.</p>




        schema Revocation_status:
            """
            RevocationStatus resource
            """



            # Outputs

            revoked_entities_output?: [str]  # <p>A list of revoked entities (including zero or more of the signing profile ARN, signing job
			ARN, and certificate hashes) supplied as input to the API.</p>




        schema Signing_platform:
            """
            SigningPlatform resource
            """



            # Outputs

            max_size_in_mb_output?: int  # <p>The maximum size (in MB) of the payload that can be signed by the target
			platform.</p>

            category_output?: str  # <p>The category type of the target signing platform.</p>

            signing_configuration_output?: str  # <p>A list of configurations applied to the target platform at signing.</p>

            platform_id_output?: str  # <p>The ID of the target signing platform.</p>

            partner_output?: str  # <p>A list of partner entities that use the target signing platform.</p>

            target_output?: str  # <p>The validation template that is used by the target signing platform.</p>

            revocation_supported_output?: bool  # <p>A flag indicating whether signatures generated for the signing platform can be
			revoked.</p>

            display_name_output?: str  # <p>The display name of the target signing platform.</p>

            signing_image_format_output?: str  # <p>The format of the target platform's signing image.</p>




        schema Signing_profile:
            """
            SigningProfile resource
            """

            signature_validity_period: str?  # <p>The default validity period override for any signature generated using this signing
			profile. If unspecified, the default is 135 months.</p>

            overrides: str?  # <p>A subfield of <code>platform</code>. This specifies any different configuration
			options that you want to apply to the chosen platform (such as a different
				<code>hash-algorithm</code> or <code>signing-algorithm</code>).</p>

            platform_id: str  # <p>The ID of the signing platform to be created.</p>

            signing_parameters: {str: str}?  # <p>Map of key-value pairs for signing. These can include any information that you want to
			use during signing.</p>

            tags: {str: str}?  # <p>Tags to be associated with the signing profile that is being created.</p>

            profile_name: str  # <p>The name of the signing profile to be created.</p>

            signing_material: str?  # <p>The AWS Certificate Manager certificate that will be used to sign code with the new signing
			profile.</p>



            # Outputs

            revocation_record_output?: str  # 

            status_output?: str  # <p>The status of the target signing profile.</p>

            status_reason_output?: str  # <p>Reason for the status of the target signing profile.</p>

            tags_output?: {str: str}  # <p>A list of tags associated with the signing profile.</p>

            platform_display_name_output?: str  # <p>A human-readable name for the signing platform associated with the signing
			profile.</p>

            arn_output?: str  # <p>The Amazon Resource Name (ARN) for the signing profile.</p>

            platform_id_output?: str  # <p>The ID of the platform that is used by the target signing profile.</p>

            signing_material_output?: str  # <p>The ARN of the certificate that the target profile uses for signing operations.</p>

            signing_parameters_output?: {str: str}  # <p>A map of key-value pairs for signing operations that is attached to the target signing
			profile.</p>

            profile_version_arn_output?: str  # <p>The signing profile ARN, including the profile version.</p>

            signature_validity_period_output?: str  # 

            profile_name_output?: str  # <p>The name of the target signing profile.</p>

            overrides_output?: str  # <p>A list of overrides applied by the target signing profile for signing
			operations.</p>

            profile_version_output?: str  # <p>The current version of the signing profile.</p>





