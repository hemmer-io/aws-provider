            environment_configurations_output?: [str]  # <p>The environment configurations of the project profile.</p>

            id_output?: str  # <p>The ID of the project profile.</p>

            name_output?: str  # <p>The name of the project profile.</p>

            domain_id_output?: str  # <p>The ID of the domain of the project profile.</p>

            description_output?: str  # <p>The description of the project profile.</p>

            status_output?: str  # <p>The status of the project profile.</p>




