            end_time_output?: str  # <p>Time at which the license type conversion task was completed.</p>

            license_conversion_task_id_output?: str  # <p>ID of the license type conversion task.</p>

            source_license_context_output?: str  # <p>Information about the license type converted from.</p>

            start_time_output?: str  # <p>Time at which the license type conversion task was started .</p>

            license_conversion_time_output?: str  # <p>Amount of time to complete the license type conversion.</p>

            status_output?: str  # <p>Status of the license type conversion task.</p>

            resource_arn_output?: str  # <p>Amazon Resource Names (ARN) of the resources the license conversion task is associated with.</p>

            status_message_output?: str  # <p>The status message for the conversion task.</p>

            destination_license_context_output?: str  # <p>Information about the license type converted to.</p>




        schema License_manager_report_generator:
            """
            LicenseManagerReportGenerator resource
            """

            type: [str]  # <p>Type of reports to generate. The following report types an be generated:</p>
         <ul>
            <li>
               <p>License configuration report - Reports the number and details of consumed licenses for a license configuration.</p>
            </li>
            <li>
               <p>Resource report - Reports the tracked licenses and resource consumption for a license configuration.</p>
            </li>
         </ul>

            report_context: str  # <p>Defines the type of license configuration the report generator tracks.</p>

            description: str?  # <p>Description of the report generator.</p>

            tags: [str]?  # <p>Tags to add to the report generator.</p>

            report_frequency: str  # <p>Frequency by which reports are generated.  Reports can be generated daily, monthly, or weekly.</p>

            report_generator_name: str  # <p>Name of the report generator.</p>

            client_token: str  # <p>Unique, case-sensitive identifier that you provide to ensure the idempotency of the request.</p>



            # Outputs

            report_generator_output?: str  # <p>A report generator that creates periodic reports about your license configurations.</p>




        schema License_configuration:
            """
            LicenseConfiguration resource
            """

            disassociate_when_not_found: bool?  # <p>When true, disassociates a resource when software is uninstalled.</p>

            product_information_list: [str]?  # <p>Product information.</p>

            license_rules: str?  # <p>License rules. The syntax is #name=value (for example, #allowedTenancy=EC2-DedicatedHost). The available rules 
         vary by dimension, as follows.</p>
         <ul>
            <li>
               <p>
                  <code>Cores</code> dimension: <code>allowedTenancy</code> |
               <code>licenseAffinityToHost</code> |
               <code>maximumCores</code> | <code>minimumCores</code>
               </p>
            </li>
            <li>
               <p>
                  <code>Instances</code> dimension: <code>allowedTenancy</code> | 
               <code>maximumVcpus</code> | <code>minimumVcpus</code>
               </p>
            </li>
            <li>
               <p>
                  <code>Sockets</code> dimension: <code>allowedTenancy</code> | 
               <code>licenseAffinityToHost</code> |
               <code>maximumSockets</code> | <code>minimumSockets</code>
               </p>
            </li>
            <li>
               <p>
                  <code>vCPUs</code> dimension: <code>allowedTenancy</code> | 
               <code>honorVcpuOptimization</code> | 
               <code>maximumVcpus</code> | <code>minimumVcpus</code>
               </p>
            </li>
         </ul>
         <p>The unit for <code>licenseAffinityToHost</code> is days and the range is 1 to 180. The possible 
         values for <code>allowedTenancy</code> are <code>EC2-Default</code>, <code>EC2-DedicatedHost</code>, and 
         <code>EC2-DedicatedInstance</code>. The possible values for <code>honorVcpuOptimization</code> are 
         <code>True</code> and <code>False</code>.</p>

            description: str?  # <p>Description of the license configuration.</p>

            license_count_hard_limit: bool?  # <p>Indicates whether hard or soft license enforcement is used. Exceeding a hard limit
         blocks the launch of new instances.</p>

            tags: [str]?  # <p>Tags to add to the license configuration.</p>

            name: str  # <p>Name of the license configuration.</p>

            license_counting_type: str  # <p>Dimension used to track the license inventory.</p>

            license_count: int?  # <p>Number of licenses managed by the license configuration.</p>



            # Outputs

            tags_output?: [str]  # <p>Tags for the license configuration.</p>

            name_output?: str  # <p>Name of the license configuration.</p>

            consumed_licenses_output?: int  # <p>Number of licenses assigned to resources.</p>

            license_count_hard_limit_output?: bool  # <p>Sets the number of available licenses as a hard limit.</p>

            consumed_license_summary_list_output?: [str]  # <p>Summaries of the licenses consumed by resources.</p>

            license_rules_output?: str  # <p>License rules.</p>

            disassociate_when_not_found_output?: bool  # <p>When true, disassociates a resource when software is uninstalled.</p>

            license_configuration_id_output?: str  # <p>Unique ID for the license configuration.</p>

            automated_discovery_information_output?: str  # <p>Automated discovery information.</p>

            license_configuration_arn_output?: str  # <p>Amazon Resource Name (ARN) of the license configuration.</p>

            description_output?: str  # <p>Description of the license configuration.</p>

            status_output?: str  # <p>License configuration status.</p>

            owner_account_id_output?: str  # <p>Account ID of the owner of the license configuration.</p>

            managed_resource_summary_list_output?: [str]  # <p>Summaries of the managed resources.</p>

            product_information_list_output?: [str]  # <p>Product information.</p>

            license_counting_type_output?: str  # <p>Dimension for which the licenses are counted.</p>

            license_count_output?: int  # <p>Number of available licenses.</p>





