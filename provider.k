        schema Space:
            """
            Space resource
            """

            tags: [str]?  # <p>Tags to associated with the space. Each tag consists of a key and an optional value. Tag keys must be unique for each resource. Tags are searchable using the <code>Search</code> API.</p>

            ownership_settings: str?  # <p>A collection of ownership settings.</p>

            space_display_name: str?  # <p>The name of the space that appears in the SageMaker Studio UI.</p>

            space_settings: str?  # <p>A collection of space settings.</p>

            domain_id: str  # <p>The ID of the associated domain.</p>

            space_sharing_settings: str?  # <p>A collection of space sharing settings.</p>

            space_name: str  # <p>The name of the space.</p>



            # Outputs

            space_arn_output?: str  # <p>The space's Amazon Resource Name (ARN).</p>

            home_efs_file_system_uid_output?: str  # <p>The ID of the space's profile in the Amazon EFS volume.</p>

            creation_time_output?: str  # <p>The creation time.</p>

            domain_id_output?: str  # <p>The ID of the associated domain.</p>

            space_name_output?: str  # <p>The name of the space.</p>

            failure_reason_output?: str  # <p>The failure reason.</p>

            status_output?: str  # <p>The status.</p>

            ownership_settings_output?: str  # <p>The collection of ownership settings for a space.</p>

            space_sharing_settings_output?: str  # <p>The collection of space sharing settings for a space.</p>

            space_display_name_output?: str  # <p>The name of the space that appears in the Amazon SageMaker Studio UI.</p>

            url_output?: str  # <p>Returns the URL of the space. If the space is created with Amazon Web Services IAM Identity Center (Successor to Amazon Web Services Single Sign-On) authentication, users can navigate to the URL after appending the respective redirect parameter for the application type to be federated through Amazon Web Services IAM Identity Center.</p> <p>The following application types are supported:</p> <ul> <li> <p>Studio Classic: <code>&amp;redirect=JupyterServer</code> </p> </li> <li> <p>JupyterLab: <code>&amp;redirect=JupyterLab</code> </p> </li> <li> <p>Code Editor, based on Code-OSS, Visual Studio Code - Open Source: <code>&amp;redirect=CodeEditor</code> </p> </li> </ul>

            last_modified_time_output?: str  # <p>The last modified time.</p>

            space_settings_output?: str  # <p>A collection of space settings.</p>




        schema Workforce:
            """
            Workforce resource
            """

            workforce_name: str  # <p>The name of the private workforce.</p>

            tags: [str]?  # <p>An array of key-value pairs that contain metadata to help you categorize and organize our workforce. Each tag consists of a key and a value, both of which you define.</p>

            source_ip_config: str?  # 

            ip_address_type: str?  # <p>Use this parameter to specify whether you want <code>IPv4</code> only or <code>dualstack</code> (<code>IPv4</code> and <code>IPv6</code>) to support your labeling workforce.</p>

            cognito_config: str?  # <p>Use this parameter to configure an Amazon Cognito private workforce. A single Cognito workforce is created using and corresponds to a single <a href="https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-identity-pools.html"> Amazon Cognito user pool</a>.</p> <p>Do not use <code>OidcConfig</code> if you specify values for <code>CognitoConfig</code>.</p>

            oidc_config: str?  # <p>Use this parameter to configure a private workforce using your own OIDC Identity Provider.</p> <p>Do not use <code>CognitoConfig</code> if you specify values for <code>OidcConfig</code>.</p>

            workforce_vpc_config: str?  # <p>Use this parameter to configure a workforce using VPC.</p>



            # Outputs

            workforce_output?: str  # <p>A single private workforce, which is automatically created when you create your first private work team. You can create one private work force in each Amazon Web Services Region. By default, any workforce-related API operation used in a specific region will apply to the workforce created in that region. To learn how to create a private workforce, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/sms-workforce-create-private.html">Create a Private Workforce</a>.</p>




        schema Model_card_export_job:
            """
            ModelCardExportJob resource
            """

            model_card_version: int?  # <p>The version of the model card to export. If a version is not provided, then the latest version of the model card is exported.</p>

            model_card_export_job_name: str  # <p>The name of the model card export job.</p>

            output_config: str  # <p>The model card output configuration that specifies the Amazon S3 path for exporting.</p>

            model_card_name: str  # <p>The name or Amazon Resource Name (ARN) of the model card to export.</p>



            # Outputs

            model_card_export_job_name_output?: str  # <p>The name of the model card export job to describe.</p>

            failure_reason_output?: str  # <p>The failure reason if the model export job fails.</p>

            model_card_name_output?: str  # <p>The name or Amazon Resource Name (ARN) of the model card that the model export job exports.</p>

            output_config_output?: str  # <p>The export output details for the model card.</p>

            last_modified_at_output?: str  # <p>The date and time that the model export job was last modified.</p>

            export_artifacts_output?: str  # <p>The exported model card artifacts.</p>

            model_card_export_job_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the model card export job.</p>

            model_card_version_output?: int  # <p>The version of the model card that the model export job exports.</p>

            status_output?: str  # <p>The completion status of the model card export job.</p> <ul> <li> <p> <code>InProgress</code>: The model card export job is in progress.</p> </li> <li> <p> <code>Completed</code>: The model card export job is complete.</p> </li> <li> <p> <code>Failed</code>: The model card export job failed. To see the reason for the failure, see the <code>FailureReason</code> field in the response to a <code>DescribeModelCardExportJob</code> call.</p> </li> </ul>

            created_at_output?: str  # <p>The date and time that the model export job was created.</p>




        schema Partner_app_presigned_url:
            """
            PartnerAppPresignedUrl resource
            """

            arn: str  # <p>The ARN of the SageMaker Partner AI App to create the presigned URL for.</p>

            expires_in_seconds: int?  # <p>The time that will pass before the presigned URL expires.</p>

            session_expiration_duration_in_seconds: int?  # <p>Indicates how long the Amazon SageMaker Partner AI App session can be accessed for after logging in.</p>





