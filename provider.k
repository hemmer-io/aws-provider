    # Route53_recovery_control_config Service
    schema Route53_recovery_control_configService:
        """
        Service for route53_recovery_control_config resources.
        """


        schema Control_panel:
            """
            ControlPanel resource
            """

            cluster_arn: str  # <p>The Amazon Resource Name (ARN) of the cluster for the control panel.</p>

            client_token: str?  # <p>A unique, case-sensitive string of up to 64 ASCII characters. To make an idempotent API request with an action, specify a client token in the request.</p>

            tags: {str: str}?  # <p>The tags associated with the control panel.</p>

            control_panel_name: str  # <p>The name of the control panel.</p>



            # Outputs

            control_panel_output?: str  # <p>Information about the control panel.</p>




        schema Safety_rule:
            """
            SafetyRule resource
            """

            tags: {str: str}?  # <p>The tags associated with the safety rule.</p>

            gating_rule: str?  # <p>The gating rule requested.</p>

            assertion_rule: str?  # <p>The assertion rule requested.</p>

            client_token: str?  # <p>A unique, case-sensitive string of up to 64 ASCII characters. To make an idempotent API request with an action, specify a client token in the request.</p>



            # Outputs

            gating_rule_output?: str  # <p>The gating rule in the response.</p>

            assertion_rule_output?: str  # <p>The assertion rule in the response.</p>




        schema Resource_policy:
            """
            ResourcePolicy resource
            """



            # Outputs

            policy_output?: str  # <p>The resource policy.</p>




        schema Routing_control:
            """
            RoutingControl resource
            """

            control_panel_arn: str?  # <p>The Amazon Resource Name (ARN) of the control panel that includes the routing control.</p>

            cluster_arn: str  # <p>The Amazon Resource Name (ARN) of the cluster that includes the routing control.</p>

            routing_control_name: str  # <p>The name of the routing control.</p>

            client_token: str?  # <p>A unique, case-sensitive string of up to 64 ASCII characters. To make an idempotent API request with an action, specify a client token in the request.</p>



            # Outputs

            routing_control_output?: str  # <p>Information about the routing control.</p>




        schema Cluster:
            """
            Cluster resource
            """

            network_type: str?  # <p>The network type of the cluster. NetworkType can be one of the following: IPV4, DUALSTACK.</p>

            tags: {str: str}?  # <p>The tags associated with the cluster.</p>

            client_token: str?  # <p>A unique, case-sensitive string of up to 64 ASCII characters. To make an idempotent API request with an action, specify a client token in the request.</p>

            cluster_name: str  # <p>The name of the cluster.</p>



            # Outputs

            cluster_output?: str  # <p>The cluster for the DescribeCluster request.</p>





    # Mediastore Service
    schema MediastoreService:
        """
        Service for mediastore resources.
        """


        schema Container:
            """
            Container resource
            """

            tags: [str]?  # <p>An array of key:value pairs that you define. These values can be anything that you want. Typically, the tag key represents a category (such as
           "environment") and the tag value represents a specific value within that category (such as "test," "development," or "production"). You can add up to 50 
           tags to each container. For more information about tagging, including naming and usage conventions, see <a href="https://docs.aws.amazon.com/mediastore/latest/ug/tagging.html">Tagging Resources in MediaStore</a>.</p>

            container_name: str  # <p>The name for the container. The name must be from 1 to 255 characters. Container
         names must be unique to your AWS account within a specific region. As an example, you could
         create a container named <code>movies</code> in every region, as long as you don’t have an
         existing container with that name.</p>



            # Outputs

            container_output?: str  # <p>The name of the queried container.</p>




        schema Container_policy:
            """
            ContainerPolicy resource
            """

            policy: str  # <p>The contents of the policy, which includes the following: </p>
         <ul>
            <li>
               <p>One <code>Version</code> tag</p>
            </li>
            <li>
               <p>One <code>Statement</code> tag that contains the standard tags for the
               policy.</p>
            </li>
         </ul>

            container_name: str  # <p>The name of the container.</p>



            # Outputs

            policy_output?: str  # <p>The contents of the access policy.</p>




        schema Lifecycle_policy:
            """
            LifecyclePolicy resource
            """

            container_name: str  # <p>The name of the container that you want to assign the object lifecycle policy to.</p>

            lifecycle_policy: str  # <p>The object lifecycle policy to apply to the container.</p>



            # Outputs

            lifecycle_policy_output?: str  # <p>The object lifecycle policy that is assigned to the container.</p>




        schema Metric_policy:
            """
            MetricPolicy resource
            """

            metric_policy: str  # <p>The metric policy that you want to associate with the container. In the policy, you must indicate whether you want MediaStore to send container-level metrics. You can also include up to five rules to define groups of objects that you want MediaStore to send object-level metrics for.  If you include rules in the policy, construct each rule with both of the following:</p>
         <ul>
            <li>
               <p>An object group that defines which objects to include in the group. The definition can be a path or a file name, but it can't have more than 900 characters. Valid characters are: a-z, A-Z, 0-9, _ (underscore), = (equal), : (colon), . (period), - (hyphen), ~ (tilde), / (forward slash), and * (asterisk). Wildcards (*) are acceptable.</p>
            </li>
            <li>
               <p>An object group name that allows you to refer to the object group. The name can't have more than 30 characters. Valid characters are: a-z, A-Z, 0-9, and _ (underscore).</p>
            </li>
         </ul>

            container_name: str  # <p>The name of the container that you want to add the metric policy to.</p>



            # Outputs

            metric_policy_output?: str  # <p>The metric policy that is associated with the specific container.</p>




        schema Cors_policy:
            """
            CorsPolicy resource
            """

            container_name: str  # <p>The name of the container that you want to assign the CORS policy to.</p>

            cors_policy: [str]  # <p>The CORS policy to apply to the container.  </p>



            # Outputs

            cors_policy_output?: [str]  # <p>The CORS policy assigned to the container.</p>





    # Workdocs Service
    schema WorkdocsService:
        """
        Service for workdocs resources.
        """


        schema User:
            """
            User resource
            """

            username: str  # <p>The login name of the user.</p>

            organization_id: str?  # <p>The ID of the organization.</p>

            surname: str  # <p>The surname of the user.</p>

            password: str  # <p>The password of the user.</p>

            time_zone_id: str?  # <p>The time zone ID of the user.</p>

            authentication_token: str?  # <p>Amazon WorkDocs authentication token. Not required when using Amazon Web Services administrator credentials to access the API.</p>

            email_address: str?  # <p>The email address of the user.</p>

            storage_rule: str?  # <p>The amount of storage for the user.</p>

            given_name: str  # <p>The given name of the user.</p>




        schema Custom_metadata:
            """
            CustomMetadata resource
            """

            resource_id: str  # <p>The ID of the resource.</p>

            custom_metadata: {str: str}  # <p>Custom metadata in the form of name-value pairs.</p>

            authentication_token: str?  # <p>Amazon WorkDocs authentication token. Not required when using Amazon Web Services administrator credentials to access the API.</p>

            version_id: str?  # <p>The ID of the version, if the custom metadata is being added to a document
            version.</p>




        schema Notification_subscription:
            """
            NotificationSubscription resource
            """

            subscription_type: str  # <p>The notification type.</p>

            organization_id: str  # <p>The ID of the organization.</p>

            endpoint: str  # <p>The endpoint to receive the notifications. If the protocol is HTTPS, the endpoint
            is a URL that begins with <code>https</code>.</p>

            protocol: str  # <p>The protocol to use. The supported value is https, which delivers JSON-encoded
            messages using HTTPS POST.</p>




        schema Comment:
            """
            Comment resource
            """

            notify_collaborators: bool?  # <p>Set this parameter to TRUE to send an email out to the document collaborators after
            the comment is created.</p>

            version_id: str  # <p>The ID of the document version.</p>

            visibility: str?  # <p>The visibility of the comment. Options are either PRIVATE, where the comment is
            visible only to the comment author and document owner and co-owners, or PUBLIC, where
            the comment is visible to document owners, co-owners, and contributors.</p>

            authentication_token: str?  # <p>Amazon WorkDocs authentication token. Not required when using Amazon Web Services administrator credentials to access the API.</p>

            thread_id: str?  # <p>The ID of the root comment in the thread.</p>

            parent_id: str?  # <p>The ID of the parent comment.</p>

            document_id: str  # <p>The ID of the document.</p>

            text: str  # <p>The text of the comment.</p>




        schema Labels:
            """
            Labels resource
            """

            resource_id: str  # <p>The ID of the resource.</p>

            authentication_token: str?  # <p>Amazon WorkDocs authentication token. Not required when using Amazon Web Services administrator credentials to access the API.</p>

            labels: [str]  # <p>List of labels to add to the resource.</p>




        schema Groups:
            """
            Groups resource
            """



            # Outputs

            groups_output?: [str]  # <p>The list of groups.</p>

            marker_output?: str  # <p>The marker to use when requesting the next set of results. If there are no additional
            results, the string is empty.</p>




        schema Folder:
            """
            Folder resource
            """

            name: str?  # <p>The name of the new folder.</p>

            parent_folder_id: str  # <p>The ID of the parent folder.</p>

            authentication_token: str?  # <p>Amazon WorkDocs authentication token. Not required when using Amazon Web Services administrator credentials to access the API.</p>



            # Outputs

            metadata_output?: str  # <p>The metadata of the folder.</p>

            custom_metadata_output?: {str: str}  # <p>The custom metadata on the folder.</p>




        schema Document_version:
            """
            DocumentVersion resource
            """

            authentication_token: str?  # <p>Amazon WorkDocs authentication token. Not required when using Amazon Web Services administrator credentials to access the API.</p>

            document_id: str  # <p>The ID of the document.</p>

            version_status: str?  # <p>The status of the version.</p>

            version_id: str  # <p>The version ID of the document.</p>



            # Outputs

            custom_metadata_output?: {str: str}  # <p>The custom metadata on the document version.</p>

            metadata_output?: str  # <p>The version metadata.</p>




        schema Root_folders:
            """
            RootFolders resource
            """



            # Outputs

            folders_output?: [str]  # <p>The user's special folders.</p>

            marker_output?: str  # <p>The marker for the next set of results.</p>




        schema Users:
            """
            Users resource
            """



            # Outputs

            users_output?: [str]  # <p>The users.</p>

            marker_output?: str  # <p>The marker to use when requesting the next set of results. If there are no
            additional results, the string is empty.</p>

            total_number_of_users_output?: int  # <p>The total number of users included in the results.</p>




        schema Current_user:
            """
            CurrentUser resource
            """



            # Outputs

            user_output?: str  # <p>Metadata of the user.</p>




        schema Resources:
            """
            Resources resource
            """



            # Outputs

            documents_output?: [str]  # <p>The documents in the specified collection.</p>

            folders_output?: [str]  # <p>The folders in the specified folder.</p>

            marker_output?: str  # <p>The marker to use when requesting the next set of results. If there are no additional results, the string is empty.</p>




        schema Notification_subscriptions:
            """
            NotificationSubscriptions resource
            """



            # Outputs

            marker_output?: str  # <p>The marker to use when requesting the next set of results. If there are no
            additional results, the string is empty.</p>

            subscriptions_output?: [str]  # <p>The subscriptions.</p>




        schema Activities:
            """
            Activities resource
