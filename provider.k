            # Outputs

            source_api_association_output?: str  # <p>The <code>SourceApiAssociation</code> object data.</p>




        schema Graphql_api:
            """
            GraphqlApi resource
            """

            merged_api_execution_role_arn: str?  # <p>The Identity and Access Management service role ARN for a merged API. The AppSync
         service assumes this role on behalf of the Merged API to validate access to source APIs at
         runtime and to prompt the <code>AUTO_MERGE</code> to update the merged API endpoint with
         the source API changes automatically.</p>

            query_depth_limit: int?  # <p>The maximum depth a query can have in a single request. Depth refers to the amount of
         nested levels allowed in the body of query. The default value is <code>0</code> (or
         unspecified), which indicates there's no depth limit. If you set a limit, it can be between
            <code>1</code> and <code>75</code> nested levels. This field will produce a limit error
         if the operation falls out of bounds.</p>
         <p>Note that fields can still be set to nullable or non-nullable. If a non-nullable field
         produces an error, the error will be thrown upwards to the first nullable field
         available.</p>

            log_config: str?  # <p>The Amazon CloudWatch Logs configuration.</p>

            api_type: str?  # <p>The value that indicates whether the GraphQL API is a standard API
         (<code>GRAPHQL</code>) or merged API (<code>MERGED</code>).</p>

            enhanced_metrics_config: str?  # <p>The <code>enhancedMetricsConfig</code> object.</p>

            owner_contact: str?  # <p>The owner contact information for an API resource.</p>
         <p>This field accepts any string input with a length of 0 - 256 characters.</p>

            lambda_authorizer_config: str?  # <p>Configuration for Lambda function authorization.</p>

            additional_authentication_providers: [str]?  # <p>A list of additional authentication providers for the <code>GraphqlApi</code>
         API.</p>

            authentication_type: str  # <p>The authentication type: API key, Identity and Access Management (IAM), OpenID
         Connect (OIDC), Amazon Cognito user pools, or Lambda.</p>

            open_id_connect_config: str?  # <p>The OIDC configuration.</p>

            tags: {str: str}?  # <p>A <code>TagMap</code> object.</p>

            introspection_config: str?  # <p>Sets the value of the GraphQL API to enable (<code>ENABLED</code>) or disable
            (<code>DISABLED</code>) introspection. If no value is provided, the introspection
         configuration will be set to <code>ENABLED</code> by default. This field will produce an
         error if the operation attempts to use the introspection feature while this field is
         disabled.</p>
         <p>For more information about introspection, see <a href="https://graphql.org/learn/introspection/">GraphQL introspection</a>.</p>

            user_pool_config: str?  # <p>The Amazon Cognito user pool configuration.</p>

            xray_enabled: bool?  # <p>A flag indicating whether to use X-Ray tracing for the
            <code>GraphqlApi</code>.</p>

            resolver_count_limit: int?  # <p>The maximum number of resolvers that can be invoked in a single request. The default
         value is <code>0</code> (or unspecified), which will set the limit to <code>10000</code>.
         When specified, the limit value can be between <code>1</code> and <code>10000</code>. This
         field will produce a limit error if the operation falls out of bounds.</p>

            visibility: str?  # <p>Sets the value of the GraphQL API to public (<code>GLOBAL</code>) or private
            (<code>PRIVATE</code>). If no value is provided, the visibility will be set to
            <code>GLOBAL</code> by default. This value cannot be changed once the API has been
         created.</p>

            name: str  # <p>A user-supplied name for the <code>GraphqlApi</code>.</p>



            # Outputs

            graphql_api_output?: str  # <p>The <code>GraphqlApi</code> object.</p>




        schema Data_source_introspection:
            """
            DataSourceIntrospection resource
            """



            # Outputs

            introspection_status_output?: str  # <p>The status of the introspection during retrieval. By default, when a new instrospection
         is being retrieved, the status will be set to <code>PROCESSING</code>. Once the operation
         has been completed, the status will change to <code>SUCCESS</code> or <code>FAILED</code>
         depending on how the data was parsed. A <code>FAILED</code> operation will return an error
         and its details as an <code>introspectionStatusDetail</code>.</p>

            introspection_status_detail_output?: str  # <p>The error detail field. When a <code>FAILED</code>
            <code>introspectionStatus</code> is returned, the <code>introspectionStatusDetail</code>
         will also return the exact error that was generated during the operation.</p>

            introspection_id_output?: str  # <p>The introspection ID. Each introspection contains a unique ID that can be used to
         reference the instrospection record.</p>

            introspection_result_output?: str  # <p>The <code>DataSourceIntrospectionResult</code> object data.</p>




        schema Api_cache:
            """
            ApiCache resource
            """

            api_caching_behavior: str  # <p>Caching behavior.</p>
         <ul>
            <li>
               <p>
                  <b>FULL_REQUEST_CACHING</b>: All requests from the
               same user are cached. Individual resolvers are automatically cached. All API calls
               will try to return responses from the cache.</p>
            </li>
            <li>
               <p>
                  <b>PER_RESOLVER_CACHING</b>: Individual resolvers
               that you specify are cached.</p>
            </li>
            <li>
               <p>
                  <b>OPERATION_LEVEL_CACHING</b>: Full requests are cached together and returned without executing resolvers.</p>
            </li>
         </ul>

            api_id: str  # <p>The GraphQL API ID.</p>

            type: str  # <p>The cache instance type. Valid values are </p>
         <ul>
            <li>
               <p>
                  <code>SMALL</code>
               </p>
            </li>
            <li>
               <p>
                  <code>MEDIUM</code>
               </p>
            </li>
            <li>
               <p>
                  <code>LARGE</code>
               </p>
            </li>
            <li>
               <p>
                  <code>XLARGE</code>
               </p>
            </li>
            <li>
               <p>
                  <code>LARGE_2X</code>
               </p>
            </li>
            <li>
               <p>
                  <code>LARGE_4X</code>
               </p>
            </li>
            <li>
               <p>
                  <code>LARGE_8X</code> (not available in all regions)</p>
            </li>
            <li>
               <p>
                  <code>LARGE_12X</code>
               </p>
            </li>
         </ul>
         <p>Historically, instance types were identified by an EC2-style value. As of July 2020, this is deprecated, and the generic identifiers above should be used.</p>
         <p>The following legacy instance types are available, but their use is discouraged:</p>
         <ul>
            <li>
               <p>
                  <b>T2_SMALL</b>: A t2.small instance type.</p>
            </li>
            <li>
               <p>
                  <b>T2_MEDIUM</b>: A t2.medium instance type.</p>
            </li>
            <li>
               <p>
                  <b>R4_LARGE</b>: A r4.large instance type.</p>
            </li>
            <li>
               <p>
                  <b>R4_XLARGE</b>: A r4.xlarge instance type.</p>
            </li>
            <li>
               <p>
                  <b>R4_2XLARGE</b>: A r4.2xlarge instance type.</p>
            </li>
            <li>
               <p>
                  <b>R4_4XLARGE</b>: A r4.4xlarge instance type.</p>
            </li>
            <li>
               <p>
                  <b>R4_8XLARGE</b>: A r4.8xlarge instance type.</p>
            </li>
         </ul>

            ttl: int  # <p>TTL in seconds for cache entries.</p>
         <p>Valid values are 1–3,600 seconds.</p>

            health_metrics_config: str?  # <p>Controls how cache health metrics will be emitted to CloudWatch. Cache health metrics
         include:</p>
         <ul>
            <li>
               <p>NetworkBandwidthOutAllowanceExceeded: The network packets dropped because the
               throughput exceeded the aggregated bandwidth limit. This is useful for diagnosing
               bottlenecks in a cache configuration.</p>
            </li>
            <li>
               <p>EngineCPUUtilization: The CPU utilization (percentage) allocated to the Redis
               process. This is useful for diagnosing bottlenecks in a cache
               configuration.</p>
            </li>
         </ul>
         <p>Metrics will be recorded by API ID. You can set the value to <code>ENABLED</code> or
            <code>DISABLED</code>.</p>

            transit_encryption_enabled: bool?  # <p>Transit encryption flag when connecting to cache. You cannot update this setting after
         creation.</p>

            at_rest_encryption_enabled: bool?  # <p>At-rest encryption flag for cache. You cannot update this setting after creation.</p>



            # Outputs

            api_cache_output?: str  # <p>The <code>ApiCache</code> object.</p>




        schema Api_association:
            """
            ApiAssociation resource
            """



            # Outputs

            api_association_output?: str  # <p>The <code>ApiAssociation</code> object.</p>




        schema Domain_name:
            """
            DomainName resource
            """

            tags: {str: str}?  # 

            certificate_arn: str  # <p>The Amazon Resource Name (ARN) of the certificate. This can be an Certificate Manager
            (ACM) certificate or an Identity and Access Management (IAM)
         server certificate.</p>

            description: str?  # <p>A description of the <code>DomainName</code>.</p>

            domain_name: str  # <p>The domain name.</p>



            # Outputs

            domain_name_config_output?: str  # <p>The configuration for the <code>DomainName</code>.</p>




        schema Api:
            """
            Api resource
            """

            event_config: str?  # <p>The Event API configuration. This includes the default authorization configuration for
         connecting, publishing, and subscribing to an Event API.</p>

            tags: {str: str}?  # 

            name: str  # <p>The name for the <code>Api</code>.</p>

            owner_contact: str?  # <p>The owner contact information for the <code>Api</code>.</p>



            # Outputs

            api_output?: str  # <p>The <code>Api</code> object.</p>





    # Dsql Service
    schema DsqlService:
        """
        Service for dsql resources.
        """



    # Databrew Service
    schema DatabrewService:
        """
        Service for databrew resources.
        """


        schema Recipe_version:
            """
            RecipeVersion resource
            """




        schema Job_run:
            """
            JobRun resource
            """



            # Outputs

            log_subscription_output?: str  # <p>The current status of Amazon CloudWatch logging for the job run.</p>

            run_id_output?: str  # <p>The unique identifier of the job run.</p>

            dataset_name_output?: str  # <p>The name of the dataset for the job to process.</p>

            attempt_output?: int  # <p>The number of times that DataBrew has attempted to run the job.</p>

            execution_time_output?: int  # <p>The amount of time, in seconds, during which the job run consumed resources.</p>

            log_group_name_output?: str  # <p>The name of an Amazon CloudWatch log group, where the job writes diagnostic messages
            when it runs.</p>

            outputs_output?: [str]  # <p>One or more output artifacts from a job run.</p>

            recipe_reference_output?: str  # 

            job_sample_output?: str  # <p>Sample configuration for profile jobs only. Determines the number of rows on which the
            profile job will be executed. If a JobSample value is not provided, the default value
            will be used. The default value is CUSTOM_ROWS for the mode parameter and 20000 for the
            size parameter.</p>

            state_output?: str  # <p>The current state of the job run entity itself.</p>

            error_message_output?: str  # <p>A message indicating an error (if any) that was encountered when the job ran.</p>

            database_outputs_output?: [str]  # <p>Represents a list of JDBC database output objects which defines the output 
            destination for a DataBrew recipe job to write into.</p>

            data_catalog_outputs_output?: [str]  # <p>One or more artifacts that represent the Glue Data Catalog output from running the job.</p>

            job_name_output?: str  # <p>The name of the job being processed during this run.</p>

            completed_on_output?: str  # <p>The date and time when the job completed processing.</p>

            started_by_output?: str  # <p>The Amazon Resource Name (ARN) of the user who started the job run.</p>

            started_on_output?: str  # <p>The date and time when the job run began.</p>

            profile_configuration_output?: str  # <p>Configuration for profile jobs. Used to select columns, do evaluations, 
            and override default parameters of evaluations. When configuration is null, the
            profile job will run with default settings.</p>

            validation_configurations_output?: [str]  # <p>List of validation configurations that are applied to the profile job.</p>




        schema Profile_job:
            """
            ProfileJob resource
            """

            log_subscription: str?  # <p>Enables or disables Amazon CloudWatch logging for the job. If logging is enabled,
            CloudWatch writes one log stream for each job run.</p>

            tags: {str: str}?  # <p>Metadata tags to apply to this job.</p>

            timeout: int?  # <p>The job's timeout in minutes. A job that attempts to run longer than this timeout
            period ends with a status of <code>TIMEOUT</code>.</p>

            job_sample: str?  # <p>Sample configuration for profile jobs only. Determines the number of rows on which the
            profile job will be executed. If a JobSample value is not provided, the default value
            will be used. The default value is CUSTOM_ROWS for the mode parameter and 20000 for the
            size parameter.</p>

            encryption_key_arn: str?  # <p>The Amazon Resource Name (ARN) of an encryption key that is used to protect the
            job.</p>

            validation_configurations: [str]?  # <p>List of validation configurations that are applied to the profile job.</p>

            encryption_mode: str?  # <p>The encryption mode for the job, which can be one of the following:</p>
         <ul>
            <li>
               <p>
                  <code>SSE-KMS</code> - <code>SSE-KMS</code> - Server-side encryption with 
                    KMS-managed keys.</p>
            </li>
            <li>
               <p>
                  <code>SSE-S3</code> - Server-side encryption with keys managed by Amazon S3.</p>
            </li>
         </ul>

            max_capacity: int?  # <p>The maximum number of nodes that DataBrew can use when the job processes data.</p>

            output_location: str  # 

            max_retries: int?  # <p>The maximum number of times to retry the job after a job run fails.</p>

            name: str  # <p>The name of the job to be created. Valid characters are alphanumeric (A-Z, a-z, 0-9),
            hyphen (-), period (.), and space.</p>

            configuration: str?  # <p>Configuration for profile jobs. Used to select columns, do evaluations, 
            and override default parameters of evaluations. When configuration is null, the
            profile job will run with default settings.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of the Identity and Access Management (IAM) role to
            be assumed when DataBrew runs the job.</p>

            dataset_name: str  # <p>The name of the dataset that this job is to act upon.</p>




        schema Ruleset:
            """
            Ruleset resource
            """

            target_arn: str  # <p>The Amazon Resource Name (ARN) of a resource (dataset) that the 
            ruleset is associated with.</p>

            rules: [str]  # <p>A list of rules that are defined with the ruleset. A rule includes 
            one or more checks to be validated on a DataBrew dataset.</p>

            name: str  # <p>The name of the ruleset to be created. Valid characters are alphanumeric 
            (A-Z, a-z, 0-9), hyphen (-), period (.), and space.</p>

            tags: {str: str}?  # <p>Metadata tags to apply to the ruleset.</p>

            description: str?  # <p>The description of the ruleset.</p>



            # Outputs

            description_output?: str  # <p>The description of the ruleset.</p>

            last_modified_date_output?: str  # <p>The modification date and time of the ruleset.</p>

            rules_output?: [str]  # <p>A list of rules that are defined with the ruleset. A rule includes one 
            or more checks to be validated on a DataBrew dataset.</p>

            name_output?: str  # <p>The name of the ruleset.</p>

            target_arn_output?: str  # <p>The Amazon Resource Name (ARN) of a resource (dataset) that the ruleset is 
            associated with.</p>

            resource_arn_output?: str  # <p>The Amazon Resource Name (ARN) for the ruleset.</p>

            tags_output?: {str: str}  # <p>Metadata tags that have been applied to the ruleset.</p>

            last_modified_by_output?: str  # <p>The Amazon Resource Name (ARN) of the user who last modified the ruleset.</p>

            created_by_output?: str  # <p>The Amazon Resource Name (ARN) of the user who created the ruleset.</p>

            create_date_output?: str  # <p>The date and time that the ruleset was created.</p>




        schema Recipe_job:
            """
            RecipeJob resource
            """

            dataset_name: str?  # <p>The name of the dataset that this job processes.</p>

            encryption_mode: str?  # <p>The encryption mode for the job, which can be one of the following:</p>
         <ul>
            <li>
               <p>
                  <code>SSE-KMS</code> - Server-side encryption with keys managed by KMS.</p>
            </li>
            <li>
               <p>
                  <code>SSE-S3</code> - Server-side encryption with keys managed by Amazon S3.</p>
            </li>
         </ul>

            max_capacity: int?  # <p>The maximum number of nodes that DataBrew can consume when the job processes
            data.</p>

            max_retries: int?  # <p>The maximum number of times to retry the job after a job run fails.</p>

            timeout: int?  # <p>The job's timeout in minutes. A job that attempts to run longer than this timeout
            period ends with a status of <code>TIMEOUT</code>.</p>

            name: str  # <p>A unique name for the job. Valid characters are alphanumeric (A-Z, a-z, 0-9), hyphen
            (-), period (.), and space.</p>

            recipe_reference: str?  # 

            database_outputs: [str]?  # <p>Represents a list of JDBC database output objects which defines the output destination for 
            a DataBrew recipe job to write to. </p>

            project_name: str?  # <p>Either the name of an existing project, or a combination of a recipe and a dataset to
            associate with the recipe.</p>

            encryption_key_arn: str?  # <p>The Amazon Resource Name (ARN) of an encryption key that is used to protect the
            job.</p>

            tags: {str: str}?  # <p>Metadata tags to apply to this job.</p>

            outputs: [str]?  # <p>One or more artifacts that represent the output from running the job.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of the Identity and Access Management (IAM) role to
            be assumed when DataBrew runs the job.</p>

            data_catalog_outputs: [str]?  # <p>One or more artifacts that represent the Glue Data Catalog output from running the job.</p>

            log_subscription: str?  # <p>Enables or disables Amazon CloudWatch logging for the job. If logging is enabled,
            CloudWatch writes one log stream for each job run.</p>




        schema Dataset:
            """
            Dataset resource
            """

            format: str?  # <p>The file format of a dataset that is created from an Amazon S3 file or folder.</p>

            input: str  # 

            name: str  # <p>The name of the dataset to be created. Valid characters are alphanumeric (A-Z, a-z,
            0-9), hyphen (-), period (.), and space.</p>

            path_options: str?  # <p>A set of options that defines how DataBrew interprets an Amazon S3 path of the dataset.</p>

            tags: {str: str}?  # <p>Metadata tags to apply to this dataset.</p>

            format_options: str?  # 



            # Outputs

            input_output?: str  # 

            create_date_output?: str  # <p>The date and time that the dataset was created.</p>

            name_output?: str  # <p>The name of the dataset.</p>

            format_options_output?: str  # 

            last_modified_date_output?: str  # <p>The date and time that the dataset was last modified.</p>

            created_by_output?: str  # <p>The identifier (user name) of the user who created the dataset.</p>

            last_modified_by_output?: str  # <p>The identifier (user name) of the user who last modified the dataset.</p>

            source_output?: str  # <p>The location of the data for this dataset, Amazon S3 or the 
            Glue Data Catalog.</p>

            path_options_output?: str  # <p>A set of options that defines how DataBrew interprets an Amazon S3 
            path of the dataset.</p>

            tags_output?: {str: str}  # <p>Metadata tags associated with this dataset.</p>

            format_output?: str  # <p>The file format of a dataset that is created from an Amazon S3 file 
            or folder.</p>

            resource_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the dataset.</p>




        schema Job:
            """
            Job resource
            """



            # Outputs

            role_arn_output?: str  # <p>The ARN of the Identity and Access Management (IAM) role to be assumed when
            DataBrew runs the job.</p>

            max_capacity_output?: int  # <p>The maximum number of compute nodes that DataBrew can consume when the job processes
            data.</p>

            type_output?: str  # <p>The job type, which must be one of the following:</p>
         <ul>
            <li>
               <p>
                  <code>PROFILE</code> - The job analyzes the dataset to determine its size,
                    data types, data distribution, and more.</p>
            </li>
            <li>
               <p>
                  <code>RECIPE</code> - The job applies one or more transformations to a
                    dataset.</p>
            </li>
         </ul>

            encryption_key_arn_output?: str  # <p>The Amazon Resource Name (ARN) of an encryption key that is used to protect the
            job.</p>

            encryption_mode_output?: str  # <p>The encryption mode for the job, which can be one of the following:</p>
         <ul>
            <li>
               <p>
                  <code>SSE-KMS</code> - Server-side encryption with keys managed by KMS.</p>
            </li>
            <li>
               <p>
                  <code>SSE-S3</code> - Server-side encryption with keys managed by Amazon
                    S3.</p>
            </li>
         </ul>

            log_subscription_output?: str  # <p>Indicates whether Amazon CloudWatch logging is enabled for this job.</p>

            validation_configurations_output?: [str]  # <p>List of validation configurations that are applied to the profile job.</p>

            created_by_output?: str  # <p>The identifier (user name) of the user associated with the creation of the job.</p>

            create_date_output?: str  # <p>The date and time that the job was created.</p>

            last_modified_date_output?: str  # <p>The date and time that the job was last modified.</p>

            recipe_reference_output?: str  # 

            timeout_output?: int  # <p>The job's timeout in minutes. A job that attempts to run longer than this timeout
            period ends with a status of <code>TIMEOUT</code>.</p>

            job_sample_output?: str  # <p>Sample configuration for profile jobs only. Determines the number of rows on which the
            profile job will be executed.</p>

            outputs_output?: [str]  # <p>One or more artifacts that represent the output from running the job.</p>

            dataset_name_output?: str  # <p>The dataset that the job acts upon.</p>

            name_output?: str  # <p>The name of the job.</p>

            database_outputs_output?: [str]  # <p>Represents a list of JDBC database output objects which defines the output 
            destination for a DataBrew recipe job to write into.</p>

            data_catalog_outputs_output?: [str]  # <p>One or more artifacts that represent the Glue Data Catalog output from running the job.</p>

            profile_configuration_output?: str  # <p>Configuration for profile jobs. Used to select columns, do evaluations, 
            and override default parameters of evaluations. When configuration is null, the
            profile job will run with default settings.</p>

            tags_output?: {str: str}  # <p>Metadata tags associated with this job.</p>

            max_retries_output?: int  # <p>The maximum number of times to retry the job after a job run fails.</p>

            project_name_output?: str  # <p>The DataBrew project associated with this job.</p>

            last_modified_by_output?: str  # <p>The identifier (user name) of the user who last modified the job.</p>

            resource_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the job.</p>




        schema Schedule:
            """
            Schedule resource
            """

            cron_expression: str  # <p>The date or dates and time or times when the jobs are to be run. For more information,
            see <a href="https://docs.aws.amazon.com/databrew/latest/dg/jobs.cron.html">Cron
                expressions</a> in the <i>Glue DataBrew Developer
            Guide</i>.</p>

            job_names: [str]?  # <p>The name or names of one or more jobs to be run.</p>

            tags: {str: str}?  # <p>Metadata tags to apply to this schedule.</p>

            name: str  # <p>A unique name for the schedule. Valid characters are alphanumeric (A-Z, a-z, 0-9),
            hyphen (-), period (.), and space.</p>



            # Outputs

            cron_expression_output?: str  # <p>The date or dates and time or times when the jobs are to be run for the schedule. For
            more information, see <a href="https://docs.aws.amazon.com/databrew/latest/dg/jobs.cron.html">Cron expressions</a> in the
            <i>Glue DataBrew Developer Guide</i>.</p>

            job_names_output?: [str]  # <p>The name or names of one or more jobs to be run by using the schedule.</p>

            name_output?: str  # <p>The name of the schedule.</p>

            create_date_output?: str  # <p>The date and time that the schedule was created.</p>

            last_modified_date_output?: str  # <p>The date and time that the schedule was last modified.</p>

            tags_output?: {str: str}  # <p>Metadata tags associated with this schedule.</p>

            created_by_output?: str  # <p>The identifier (user name) of the user who created the schedule. </p>

            resource_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the schedule.</p>

            last_modified_by_output?: str  # <p>The identifier (user name) of the user who last modified the schedule.</p>




        schema Project:
            """
            Project resource
            """

            dataset_name: str  # <p>The name of an existing dataset to associate this project with.</p>

            sample: str?  # 

            recipe_name: str  # <p>The name of an existing recipe to associate with the project.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of the Identity and Access Management (IAM) role to
            be assumed for this request.</p>

            tags: {str: str}?  # <p>Metadata tags to apply to this project.</p>

            name: str  # <p>A unique name for the new project. Valid characters are alphanumeric (A-Z, a-z, 0-9),
            hyphen (-), period (.), and space.</p>



            # Outputs

            last_modified_by_output?: str  # <p>The identifier (user name) of the user who last modified the project.</p>

            session_status_output?: str  # <p>Describes the current state of the session:</p>
         <ul>
            <li>
               <p>
                  <code>PROVISIONING</code> - allocating resources for the session.</p>
            </li>
            <li>
               <p>
                  <code>INITIALIZING</code> - getting the session ready for first use.</p>
            </li>
            <li>
               <p>
                  <code>ASSIGNED</code> - the session is ready for use.</p>
            </li>
         </ul>

            dataset_name_output?: str  # <p>The dataset associated with the project.</p>

            sample_output?: str  # 

            created_by_output?: str  # <p>The identifier (user name) of the user who created the project.</p>

            resource_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the project.</p>

            name_output?: str  # <p>The name of the project.</p>

            tags_output?: {str: str}  # <p>Metadata tags associated with this project.</p>

            role_arn_output?: str  # <p>The ARN of the Identity and Access Management (IAM) role to be assumed when
            DataBrew runs the job.</p>

            opened_by_output?: str  # <p>The identifier (user name) of the user that opened the project for use. </p>

            open_date_output?: str  # <p>The date and time when the project was opened. </p>

            create_date_output?: str  # <p>The date and time that the project was created.</p>

            last_modified_date_output?: str  # <p>The date and time that the project was last modified.</p>

            recipe_name_output?: str  # <p>The recipe associated with this job.</p>




        schema Recipe:
            """
            Recipe resource
            """

            steps: [str]  # <p>An array containing the steps to be performed by the recipe. Each recipe step consists
            of one recipe action and (optionally) an array of condition expressions.</p>

            tags: {str: str}?  # <p>Metadata tags to apply to this recipe.</p>

            name: str  # <p>A unique name for the recipe. Valid characters are alphanumeric (A-Z, a-z, 0-9),
            hyphen (-), period (.), and space.</p>

            description: str?  # <p>A description for the recipe.</p>



            # Outputs

            created_by_output?: str  # <p>The identifier (user name) of the user who created the recipe.</p>

