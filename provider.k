            """

            blocked_phrases_configuration_update: str?  # <p>The phrases blocked from chat by your chat control configuration.</p>

            response_scope: str?  # <p>The response scope configured for your application. This determines whether your application uses its retrieval augmented generation (RAG) system to generate answers only from your enterprise data, or also uses the large language models (LLM) knowledge to respons to end user questions in chat.</p>

            topic_configurations_to_delete: [str]?  # <p>The configured topic specific chat controls you want to delete.</p>

            orchestration_configuration: str?  # <p> The chat response orchestration settings for your application.</p>

            hallucination_reduction_configuration: str?  # <p> The hallucination reduction settings for your application.</p>

            application_id: str  # <p>The identifier of the application for which the chat controls are configured.</p>

            client_token: str?  # <p>A token that you provide to identify the request to update a Amazon Q Business application chat configuration.</p>

            topic_configurations_to_create_or_update: [str]?  # <p>The configured topic specific chat controls you want to update.</p>

            creator_mode_configuration: str?  # <p>The configuration details for <code>CREATOR_MODE</code>.</p>



            # Outputs

            response_scope_output?: str  # <p>The response scope configured for a Amazon Q Business application. This determines whether your application uses its retrieval augmented generation (RAG) system to generate answers only from your enterprise data, or also uses the large language models (LLM) knowledge to respons to end user questions in chat.</p>

            topic_configurations_output?: [str]  # <p>The topic specific controls configured for a Amazon Q Business application.</p>

            orchestration_configuration_output?: str  # <p> The chat response orchestration settings for your application.</p> <note> <p>Chat orchestration is optimized to work for English language content. For more details on language support in Amazon Q Business, see <a href="https://docs.aws.amazon.com/amazonq/latest/qbusiness-ug/supported-languages.html">Supported languages</a>.</p> </note>

            creator_mode_configuration_output?: str  # <p>The configuration details for <code>CREATOR_MODE</code>.</p>

            next_token_output?: str  # <p>If the <code>maxResults</code> response was incomplete because there is more data to retrieve, Amazon Q Business returns a pagination token in the response. You can use this pagination token to retrieve the next set of Amazon Q Business chat controls configured.</p>

            hallucination_reduction_configuration_output?: str  # <p> The hallucination reduction settings for your application.</p>

            blocked_phrases_output?: str  # <p>The phrases blocked from chat by your chat control configuration.</p>




        schema Conversation:
