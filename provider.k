            created_at_output?: str  # <p>The timestamp when the associated threat entity set was created.</p>

            location_output?: str  # <p>The URI of the file that contains the threat entity set.</p>

            format_output?: str  # <p>The format of the file that contains the threat entity set.</p>

            tags_output?: {str: str}  # <p>The tags associated with the threat entity set resource.</p>

            updated_at_output?: str  # <p>The timestamp when the associated threat entity set was updated.</p>




