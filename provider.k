            """

            granted_entity: str  # <p>The entity to which the subscription is to be granted.</p>

            domain_identifier: str  # <p>The ID of the Amazon DataZone domain in which the subscription grant is created.</p>

            asset_target_names: [str]?  # <p>The names of the assets for which the subscription grant is created.</p>

            subscription_target_identifier: str?  # <p>The ID of the subscription target for which the subscription grant is created.</p>

            client_token: str?  # <p>A unique, case-sensitive identifier that is provided to ensure the idempotency of the request.</p>

            environment_identifier: str  # <p>The ID of the environment in which the subscription grant is created.</p>



            # Outputs

            created_by_output?: str  # <p>The Amazon DataZone user who created the subscription grant.</p>

            id_output?: str  # <p>The ID of the subscription grant.</p>

            subscription_target_id_output?: str  # <p>The subscription target ID associated with the subscription grant.</p>

            granted_entity_output?: str  # <p>The entity to which the subscription is granted.</p>

            assets_output?: [str]  # <p>The assets for which the subscription grant is created.</p>

            domain_id_output?: str  # <p>The ID of the Amazon DataZone domain in which the subscription grant exists.</p>

            created_at_output?: str  # <p>The timestamp of when the subscription grant is created.</p>

            updated_at_output?: str  # <p>The timestamp of when the subscription grant was upated.</p>

            subscription_id_output?: str  # <p>The identifier of the subscription.</p>

            status_output?: str  # <p>The status of the subscription grant.</p>

            updated_by_output?: str  # <p>The Amazon DataZone user who updated the subscription grant.</p>




        schema Job_run:
