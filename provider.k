            </li>
            <li>
               <p>
                  <code>PENDING_SUPPORT_CASE</code>: The operation includes a support case and
					is waiting for its resolution.</p>
            </li>
         </ul>

            submitted_date_output?: str  # <p>The date when the request was submitted.</p>

            operation_id_output?: str  # <p>The identifier for the operation.</p>

            last_updated_date_output?: str  # <p> The date when the operation was last updated. </p>

            message_output?: str  # <p>Detailed information on the status including possible errors.</p>

            domain_name_output?: str  # <p>The name of a domain.</p>

