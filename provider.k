            name_output?: str  # <p>The name of the requested host.</p>

            provider_type_output?: str  # <p>The provider type of the requested host, such as GitHub Enterprise Server.</p>

            status_output?: str  # <p>The status of the requested host.</p>

            vpc_configuration_output?: str  # <p>The VPC configuration of the requested host.</p>




