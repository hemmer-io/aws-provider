            audio: str?  # <p>A section of the request body that specifies the audio parameters.</p>

            description: str?  # <p>A description of the preset.</p>

            thumbnails: str?  # <p>A section of the request body that specifies the thumbnail parameters, if any.</p>

            container: str  # <p>The container type for the output file. Valid values include <code>flac</code>,
            <code>flv</code>, <code>fmp4</code>, 
            <code>gif</code>, <code>mp3</code>, 
            <code>mp4</code>, <code>mpg</code>, <code>mxf</code>, <code>oga</code>, 
            <code>ogg</code>, <code>ts</code>, and <code>webm</code>.</p>





