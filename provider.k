            scheduler_config_output?: str  # <p>Cluster policy configuration. This policy is used for task prioritization and fair-share allocation. This helps prioritize critical workloads and distributes idle compute across entities.</p>

            cluster_scheduler_config_id_output?: str  # <p>ID of the cluster policy.</p>

