            ca_certificates_bundle_s3_key: str  # <p>The Amazon S3 path for the ca certificates bundle.</p>

            name: str  # <p>The name of the trust store.</p>
         <p>This name must be unique per region and can't be changed after creation.</p>

            ca_certificates_bundle_s3_bucket: str  # <p>The Amazon S3 bucket for the ca certificates bundle.</p>




