            model_transform_job_output?: str  # <p>The model transform job.</p>

            processing_job_output?: str  # <p>The data processing job.</p>

            hpo_job_output?: str  # <p>The HPO job.</p>

            status_output?: str  # <p>The status of the model training job.</p>

            id_output?: str  # <p>The unique identifier of this model-training job.</p>




        schema Gremlin_query_status:
            """
            GremlinQueryStatus resource
            """



            # Outputs

            query_eval_stats_output?: str  # <p>The evaluation status of the Gremlin query.</p>

            query_id_output?: str  # <p>The ID of the query for which status is being returned.</p>

            query_string_output?: str  # <p>The Gremlin query string.</p>




        schema Ml_data_processing_job:
            """
            MLDataProcessingJob resource
            """



            # Outputs

            status_output?: str  # <p>Status of the data processing job.</p>

            id_output?: str  # <p>The unique identifier of this data-processing job.</p>

