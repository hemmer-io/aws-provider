        schema Organization_configuration:
            """
            OrganizationConfiguration resource
            """

            graph_arn: str  # <p>The ARN of the organization behavior graph.</p>

            auto_enable: bool?  # <p>Indicates whether to automatically enable new organization accounts as member accounts
         in the organization behavior graph.</p>



            # Outputs

            auto_enable_output?: bool  # <p>Indicates whether to automatically enable new organization accounts as member accounts
         in the organization behavior graph.</p>




        schema Investigation:
            """
            Investigation resource
            """



            # Outputs

            entity_type_output?: str  # <p>Type of entity. For example, Amazon Web Services accounts, such as an IAM user and/or IAM role.</p>

            entity_arn_output?: str  # <p>The unique Amazon Resource Name (ARN). Detective supports IAM user ARNs and IAM role ARNs.</p>

            graph_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the behavior graph.</p>

            created_time_output?: str  # <p>The creation time of the investigation report in UTC time stamp format.</p>

            scope_start_time_output?: str  # <p>The start date and time used to set the scope time within which you want to generate the investigation report. The value is an UTC ISO8601 formatted
         string. For example, <code>2021-08-18T16:35:56.284Z</code>.</p>

            scope_end_time_output?: str  # <p>The data and time when the investigation began. The value is an UTC ISO8601 formatted
         string. For example, <code>2021-08-18T16:35:56.284Z</code>.</p>

            state_output?: str  # <p>The current state of the investigation. An archived investigation indicates that you
         have completed reviewing the investigation.</p>

            investigation_id_output?: str  # <p>The investigation ID of the investigation report.</p>

            severity_output?: str  # <p>The severity assigned is based on the likelihood and impact of the indicators of
         compromise discovered in the investigation.</p>

            status_output?: str  # <p>The status based on the completion status of the investigation.</p>




        schema Members:
            """
            Members resource
            """

            accounts: [str]  # <p>The list of Amazon Web Services accounts to invite or to enable. You can invite or enable
         up to 50 accounts at a time. For each invited account, the account list contains the
         account identifier and the Amazon Web Services account root user email address. For
         organization accounts in the organization behavior graph, the email address is not
         required.</p>

            message: str?  # <p>Customized message text to include in the invitation email message to the invited member
         accounts.</p>

            disable_email_notification: bool?  # <p>if set to <code>true</code>, then the invited accounts do not receive email
         notifications. By default, this is set to <code>false</code>, and the invited accounts
         receive email notifications.</p>
         <p>Organization accounts in the organization behavior graph do not receive email
         notifications.</p>

            graph_arn: str  # <p>The ARN of the behavior graph.</p>



            # Outputs

            member_details_output?: [str]  # <p>The member account details that Detective is returning in response to the
         request.</p>

            unprocessed_accounts_output?: [str]  # <p>The requested member accounts for which Detective was unable to return member
         details.</p>
         <p>For each account, provides the reason why the request could not be processed.</p>




        schema Investigation_state:
            """
            InvestigationState resource
            """

            investigation_id: str  # <p>The investigation ID of the investigation report.</p>

            graph_arn: str  # <p>The Amazon Resource Name (ARN) of the behavior graph.</p>

            state: str  # <p>The current state of the investigation. An archived investigation indicates you have completed reviewing the investigation.</p>




        schema Graph:
            """
            Graph resource
            """

            tags: {str: str}?  # <p>The tags to assign to the new behavior graph. You can add up to 50 tags. For each tag,
