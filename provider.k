            status_output?: str  # <p>The metadata transfer job's status.</p>

            metadata_transfer_job_id_output?: str  # <p>The metadata transfer job Id.</p>

            sources_output?: [str]  # <p>The metadata transfer job's sources.</p>

            creation_date_time_output?: str  # <p>The metadata transfer job's creation DateTime property.</p>

            report_url_output?: str  # <p>The metadata transfer job's report URL.</p>

            destination_output?: str  # <p>The metadata transfer job's destination.</p>

            update_date_time_output?: str  # <p>The metadata transfer job's update DateTime property.</p>

            progress_output?: str  # <p>The metadata transfer job's progress.</p>

            description_output?: str  # <p>The metadata transfer job description.</p>

            arn_output?: str  # <p>The metadata transfer job ARN.</p>




        schema Workspace:
