            cells: [str]?  # <p>A list of cell Amazon Resource Names (ARNs) contained within this cell, for use in nested cells. For example, Availability Zones within specific Amazon Web Services Regions.</p>

            tags: {str: str}?  # 

            cell_name: str  # <p>The name of the cell to create.</p>



