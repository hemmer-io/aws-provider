            metric_output?: str  # <p>An object with a list of metrics that were benchmarked during the previously completed Inference Recommender job.</p>

            recommendation_id_output?: str  # <p>The recommendation ID of a previously completed inference recommendation.</p>

            scaling_policy_objective_output?: str  # <p>An object representing the anticipated traffic pattern for an endpoint that you specified in the request.</p>

            inference_recommendations_job_name_output?: str  # <p>The name of a previously completed Inference Recommender job.</p>

            endpoint_name_output?: str  # <p>The name of an endpoint benchmarked during a previously completed Inference Recommender job.</p>

            target_cpu_utilization_per_core_output?: int  # <p>The percentage of how much utilization you want an instance to use before autoscaling, which you specified in the request. The default value is 50%.</p>




