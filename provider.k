            max24_hour_send_output?: float  # <p>The maximum number of emails the user is allowed to send in a 24-hour interval. A
            value of -1 signifies an unlimited quota.</p>

            max_send_rate_output?: float  # <p>The maximum number of emails that Amazon SES can accept from the user's account per
            second.</p>
         <note>
            <p>The rate at which Amazon SES accepts the user's messages might be less than the maximum
                send rate.</p>
         </note>

            sent_last24_hours_output?: float  # <p>The number of emails sent during the previous 24 hours.</p>




        schema Receipt_filter:
