            description_output?: str  # <p>The description of the workspace.</p>

            role_output?: str  # <p>The ARN of the execution role associated with the workspace.</p>

            creation_date_time_output?: str  # <p>The date and time when the workspace was created.</p>

            workspace_id_output?: str  # <p>The ID of the workspace.</p>

            update_date_time_output?: str  # <p>The date and time when the workspace was last updated.</p>

            linked_services_output?: [str]  # <p>A list of services that are linked to the workspace.</p>




