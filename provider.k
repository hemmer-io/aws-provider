            id_output?: str  # <p>The identifier of the subscription request.</p>

            updated_at_output?: str  # <p>The timestamp of when the subscription request was updated.</p>

            reviewer_id_output?: str  # <p>The identifier of the Amazon DataZone user who reviewed the subscription request.</p>

