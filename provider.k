            source_data_set_id_output?: str  # <p>The ID of the data set used to create the data grant.</p>

            receiver_principal_output?: str  # <p>The Amazon Web Services account ID of the data grant receiver.</p>

            grant_distribution_scope_output?: str  # <p>The distribution scope for the data grant.</p>

            created_at_output?: str  # <p>The timestamp of when the data grant was created.</p>

            data_set_id_output?: str  # <p>The ID of the data set associated to the data grant.</p>

            updated_at_output?: str  # <p>The timestamp of when the data grant was last updated.</p>

            id_output?: str  # <p>The ID of the data grant.</p>

            arn_output?: str  # <p>The Amazon Resource Name (ARN) of the data grant.</p>

            acceptance_state_output?: str  # <p>The acceptance state of the data grant.</p>

            accepted_at_output?: str  # <p>The timestamp of when the data grant was accepted.</p>

            tags_output?: {str: str}  # <p>The tags associated to the data grant. A tag is a key-value pair.</p>

            description_output?: str  # <p>The description of the data grant.</p>

            ends_at_output?: str  # <p>The timestamp of when access to the associated data set ends.</p>




