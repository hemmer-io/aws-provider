            studio_lifecycle_config_name: str  # <p>The name of the Amazon SageMaker AI Studio Lifecycle Configuration to create.</p>

            studio_lifecycle_config_app_type: str  # <p>The App type that the Lifecycle Configuration is attached to.</p>

            tags: [str]?  # <p>Tags to be associated with the Lifecycle Configuration. Each tag consists of a key and an optional value. Tag keys must be unique per resource. Tags are searchable using the Search API. </p>

            studio_lifecycle_config_content: str  # <p>The content of your Amazon SageMaker AI Studio Lifecycle Configuration script. This content must be base64 encoded.</p>



            # Outputs

            last_modified_time_output?: str  # <p>This value is equivalent to CreationTime because Amazon SageMaker AI Studio Lifecycle Configurations are immutable.</p>

            studio_lifecycle_config_arn_output?: str  # <p>The ARN of the Lifecycle Configuration to describe.</p>

            studio_lifecycle_config_app_type_output?: str  # <p>The App type that the Lifecycle Configuration is attached to.</p>

            studio_lifecycle_config_content_output?: str  # <p>The content of your Amazon SageMaker AI Studio Lifecycle Configuration script.</p>

            studio_lifecycle_config_name_output?: str  # <p>The name of the Amazon SageMaker AI Studio Lifecycle Configuration that is described.</p>

            creation_time_output?: str  # <p>The creation time of the Amazon SageMaker AI Studio Lifecycle Configuration.</p>




        schema User_profile:
            """
            UserProfile resource
            """

            tags: [str]?  # <p>Each tag consists of a key and an optional value. Tag keys must be unique per resource.</p> <p>Tags that you specify for the User Profile are also added to all Apps that the User Profile launches.</p>

            user_settings: str?  # <p>A collection of settings.</p>

            single_sign_on_user_identifier: str?  # <p>A specifier for the type of value specified in SingleSignOnUserValue. Currently, the only supported value is "UserName". If the Domain's AuthMode is IAM Identity Center, this field is required. If the Domain's AuthMode is not IAM Identity Center, this field cannot be specified. </p>

            domain_id: str  # <p>The ID of the associated Domain.</p>

            single_sign_on_user_value: str?  # <p>The username of the associated Amazon Web Services Single Sign-On User for this UserProfile. If the Domain's AuthMode is IAM Identity Center, this field is required, and must match a valid username of a user in your directory. If the Domain's AuthMode is not IAM Identity Center, this field cannot be specified. </p>

            user_profile_name: str  # <p>A name for the UserProfile. This value is not case sensitive.</p>



            # Outputs

            single_sign_on_user_value_output?: str  # <p>The IAM Identity Center user value.</p>

            status_output?: str  # <p>The status.</p>

            single_sign_on_user_identifier_output?: str  # <p>The IAM Identity Center user identifier.</p>

            user_profile_name_output?: str  # <p>The user profile name.</p>

            creation_time_output?: str  # <p>The creation time.</p>

            home_efs_file_system_uid_output?: str  # <p>The ID of the user's profile in the Amazon Elastic File System volume.</p>

            user_profile_arn_output?: str  # <p>The user profile Amazon Resource Name (ARN).</p>

            failure_reason_output?: str  # <p>The failure reason.</p>

            user_settings_output?: str  # <p>A collection of settings.</p>

            domain_id_output?: str  # <p>The ID of the domain that contains the profile.</p>

            last_modified_time_output?: str  # <p>The last modified time.</p>




        schema Endpoint_config:
            """
            EndpointConfig resource
            """

            tags: [str]?  # <p>An array of key-value pairs. You can use tags to categorize your Amazon Web Services resources in different ways, for example, by purpose, owner, or environment. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services Resources</a>.</p>

            vpc_config: str?  # 

            enable_network_isolation: bool?  # <p>Sets whether all model containers deployed to the endpoint are isolated. If they are, no inbound or outbound network calls can be made to or from the model containers.</p>

            async_inference_config: str?  # <p>Specifies configuration for how an endpoint performs asynchronous inference. This is a required field in order for your Endpoint to be invoked using <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_runtime_InvokeEndpointAsync.html">InvokeEndpointAsync</a>.</p>

            data_capture_config: str?  # 

            kms_key_id: str?  # <p>The Amazon Resource Name (ARN) of a Amazon Web Services Key Management Service key that SageMaker uses to encrypt data on the storage volume attached to the ML compute instance that hosts the endpoint.</p> <p>The KmsKeyId can be any of the following formats: </p> <ul> <li> <p>Key ID: <code>1234abcd-12ab-34cd-56ef-1234567890ab</code> </p> </li> <li> <p>Key ARN: <code>arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab</code> </p> </li> <li> <p>Alias name: <code>alias/ExampleAlias</code> </p> </li> <li> <p>Alias name ARN: <code>arn:aws:kms:us-west-2:111122223333:alias/ExampleAlias</code> </p> </li> </ul> <p>The KMS key policy must grant permission to the IAM role that you specify in your <code>CreateEndpoint</code>, <code>UpdateEndpoint</code> requests. For more information, refer to the Amazon Web Services Key Management Service section<a href="https://docs.aws.amazon.com/kms/latest/developerguide/key-policies.html"> Using Key Policies in Amazon Web Services KMS </a> </p> <note> <p>Certain Nitro-based instances include local storage, dependent on the instance type. Local storage volumes are encrypted using a hardware module on the instance. You can't request a <code>KmsKeyId</code> when using an instance type with local storage. If any of the models that you specify in the <code>ProductionVariants</code> parameter use nitro-based instances with local storage, do not specify a value for the <code>KmsKeyId</code> parameter. If you specify a value for <code>KmsKeyId</code> when using any nitro-based instances with local storage, the call to <code>CreateEndpointConfig</code> fails.</p> <p>For a list of instance types that support local instance storage, see <a href="https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/InstanceStorage.html#instance-store-volumes">Instance Store Volumes</a>.</p> <p>For more information about local instance storage encryption, see <a href="https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/ssd-instance-store.html">SSD Instance Store Volumes</a>.</p> </note>

            shadow_production_variants: [str]?  # <p>An array of <code>ProductionVariant</code> objects, one for each model that you want to host at this endpoint in shadow mode with production traffic replicated from the model specified on <code>ProductionVariants</code>. If you use this field, you can only specify one variant for <code>ProductionVariants</code> and one variant for <code>ShadowProductionVariants</code>.</p>

            production_variants: [str]  # <p>An array of <code>ProductionVariant</code> objects, one for each model that you want to host at this endpoint.</p>

            explainer_config: str?  # <p>A member of <code>CreateEndpointConfig</code> that enables explainers.</p>

            execution_role_arn: str?  # <p>The Amazon Resource Name (ARN) of an IAM role that Amazon SageMaker AI can assume to perform actions on your behalf. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/sagemaker-roles.html">SageMaker AI Roles</a>. </p> <note> <p>To be able to pass this role to Amazon SageMaker AI, the caller of this action must have the <code>iam:PassRole</code> permission.</p> </note>

            endpoint_config_name: str  # <p>The name of the endpoint configuration. You specify this name in a <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_CreateEndpoint.html">CreateEndpoint</a> request. </p>



            # Outputs

            enable_network_isolation_output?: bool  # <p>Indicates whether all model containers deployed to the endpoint are isolated. If they are, no inbound or outbound network calls can be made to or from the model containers.</p>

            kms_key_id_output?: str  # <p>Amazon Web Services KMS key ID Amazon SageMaker uses to encrypt data when storing it on the ML storage volume attached to the instance.</p>

            creation_time_output?: str  # <p>A timestamp that shows when the endpoint configuration was created.</p>

            execution_role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the IAM role that you assigned to the endpoint configuration.</p>

            vpc_config_output?: str  # 

            endpoint_config_name_output?: str  # <p>Name of the SageMaker endpoint configuration.</p>

            data_capture_config_output?: str  # 

            async_inference_config_output?: str  # <p>Returns the description of an endpoint configuration created using the <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_CreateEndpointConfig.html"> <code>CreateEndpointConfig</code> </a> API.</p>

            production_variants_output?: [str]  # <p>An array of <code>ProductionVariant</code> objects, one for each model that you want to host at this endpoint.</p>

            endpoint_config_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the endpoint configuration.</p>

            explainer_config_output?: str  # <p>The configuration parameters for an explainer.</p>

            shadow_production_variants_output?: [str]  # <p>An array of <code>ProductionVariant</code> objects, one for each model that you want to host at this endpoint in shadow mode with production traffic replicated from the model specified on <code>ProductionVariants</code>.</p>




        schema Experiment:
            """
            Experiment resource
            """

            display_name: str?  # <p>The name of the experiment as displayed. The name doesn't need to be unique. If you don't specify <code>DisplayName</code>, the value in <code>ExperimentName</code> is displayed.</p>

            description: str?  # <p>The description of the experiment.</p>

            tags: [str]?  # <p>A list of tags to associate with the experiment. You can use <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_Search.html">Search</a> API to search on the tags.</p>

            experiment_name: str  # <p>The name of the experiment. The name must be unique in your Amazon Web Services account and is not case-sensitive.</p>



            # Outputs

            creation_time_output?: str  # <p>When the experiment was created.</p>

            experiment_name_output?: str  # <p>The name of the experiment.</p>

            last_modified_time_output?: str  # <p>When the experiment was last modified.</p>

            experiment_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the experiment.</p>

            source_output?: str  # <p>The Amazon Resource Name (ARN) of the source and, optionally, the type.</p>

            created_by_output?: str  # <p>Who created the experiment.</p>

            description_output?: str  # <p>The description of the experiment.</p>

            display_name_output?: str  # <p>The name of the experiment as displayed. If <code>DisplayName</code> isn't specified, <code>ExperimentName</code> is displayed.</p>

            last_modified_by_output?: str  # <p>Who last modified the experiment.</p>




        schema Endpoint_weights_and_capacities:
            """
            EndpointWeightsAndCapacities resource
            """

            endpoint_name: str  # <p>The name of an existing SageMaker endpoint.</p>

            desired_weights_and_capacities: [str]  # <p>An object that provides new capacity and weight values for a variant.</p>




        schema Training_plan:
            """
            TrainingPlan resource
            """

            training_plan_name: str  # <p>The name of the training plan to create.</p>

            training_plan_offering_id: str  # <p>The unique identifier of the training plan offering to use for creating this plan.</p>

            spare_instance_count_per_ultra_server: int?  # <p>Number of spare instances to reserve per UltraServer for enhanced resiliency. Default is 1.</p>

            tags: [str]?  # <p>An array of key-value pairs to apply to this training plan.</p>



            # Outputs

            start_time_output?: str  # <p>The start time of the training plan.</p>

            currency_code_output?: str  # <p>The currency code for the upfront fee (e.g., USD).</p>

            reserved_capacity_summaries_output?: [str]  # <p>The list of Reserved Capacity providing the underlying compute resources of the plan. </p>

            status_output?: str  # <p>The current status of the training plan (e.g., Pending, Active, Expired). To see the complete list of status values available for a training plan, refer to the <code>Status</code> attribute within the <code> <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_TrainingPlanSummary.html">TrainingPlanSummary</a> </code> object.</p>

            end_time_output?: str  # <p>The end time of the training plan.</p>

            duration_minutes_output?: int  # <p>The additional minutes beyond whole hours in the total duration for this training plan.</p>

            total_instance_count_output?: int  # <p>The total number of instances reserved in this training plan.</p>

            unhealthy_instance_count_output?: int  # <p>The number of instances in the training plan that are currently in an unhealthy state.</p>

            available_spare_instance_count_output?: int  # <p>The number of available spare instances in the training plan.</p>

            duration_hours_output?: int  # <p>The number of whole hours in the total duration for this training plan.</p>

            training_plan_arn_output?: str  # <p>The Amazon Resource Name (ARN); of the training plan.</p>

            training_plan_name_output?: str  # <p>The name of the training plan.</p>

            status_message_output?: str  # <p>A message providing additional information about the current status of the training plan.</p>

            total_ultra_server_count_output?: int  # <p>The total number of UltraServers reserved to this training plan.</p>

            target_resources_output?: [str]  # <p>The target resources (e.g., SageMaker Training Jobs, SageMaker HyperPod) that can use this training plan.</p> <p>Training plans are specific to their target resource.</p> <ul> <li> <p>A training plan designed for SageMaker training jobs can only be used to schedule and run training jobs.</p> </li> <li> <p>A training plan for HyperPod clusters can be used exclusively to provide compute resources to a cluster's instance group.</p> </li> </ul>

            in_use_instance_count_output?: int  # <p>The number of instances currently in use from this training plan.</p>

            available_instance_count_output?: int  # <p>The number of instances currently available for use in this training plan.</p>

            upfront_fee_output?: str  # <p>The upfront fee for the training plan.</p>




        schema Cluster:
            """
            Cluster resource
            """

            tiered_storage_config: str?  # <p>The configuration for managed tier checkpointing on the HyperPod cluster. When enabled, this feature uses a multi-tier storage approach for storing model checkpoints, providing faster checkpoint operations and improved fault tolerance across cluster nodes.</p>

            vpc_config: str?  # <p>Specifies the Amazon Virtual Private Cloud (VPC) that is associated with the Amazon SageMaker HyperPod cluster. You can control access to and from your resources by configuring your VPC. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/infrastructure-give-access.html">Give SageMaker access to resources in your Amazon VPC</a>.</p> <note> <p>When your Amazon VPC and subnets support IPv6, network communications differ based on the cluster orchestration platform:</p> <ul> <li> <p>Slurm-orchestrated clusters automatically configure nodes with dual IPv6 and IPv4 addresses, allowing immediate IPv6 network communications.</p> </li> <li> <p>In Amazon EKS-orchestrated clusters, nodes receive dual-stack addressing, but pods can only use IPv6 when the Amazon EKS cluster is explicitly IPv6-enabled. For information about deploying an IPv6 Amazon EKS cluster, see <a href="https://docs.aws.amazon.com/eks/latest/userguide/deploy-ipv6-cluster.html#_deploy_an_ipv6_cluster_with_eksctl">Amazon EKS IPv6 Cluster Deployment</a>.</p> </li> </ul> <p>Additional resources for IPv6 configuration:</p> <ul> <li> <p>For information about adding IPv6 support to your VPC, see to <a href="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-migrate-ipv6.html">IPv6 Support for VPC</a>.</p> </li> <li> <p>For information about creating a new IPv6-compatible VPC, see <a href="https://docs.aws.amazon.com/vpc/latest/userguide/create-vpc.html">Amazon VPC Creation Guide</a>.</p> </li> <li> <p>To configure SageMaker HyperPod with a custom Amazon VPC, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/sagemaker-hyperpod-prerequisites.html#sagemaker-hyperpod-prerequisites-optional-vpc">Custom Amazon VPC Setup for SageMaker HyperPod</a>.</p> </li> </ul> </note>

            auto_scaling: str?  # <p>The autoscaling configuration for the cluster. Enables automatic scaling of cluster nodes based on workload demand using a Karpenter-based system.</p>

            cluster_name: str  # <p>The name for the new SageMaker HyperPod cluster.</p>

            node_provisioning_mode: str?  # <p>The mode for provisioning nodes in the cluster. You can specify the following modes:</p> <ul> <li> <p> <b>Continuous</b>: Scaling behavior that enables 1) concurrent operation execution within instance groups, 2) continuous retry mechanisms for failed operations, 3) enhanced customer visibility into cluster events through detailed event streams, 4) partial provisioning capabilities. Your clusters and instance groups remain <code>InService</code> while scaling. This mode is only supported for EKS orchestrated clusters.</p> </li> </ul>

            restricted_instance_groups: [str]?  # <p>The specialized instance groups for training models like Amazon Nova to be created in the SageMaker HyperPod cluster.</p>

            cluster_role: str?  # <p>The Amazon Resource Name (ARN) of the IAM role that HyperPod assumes to perform cluster autoscaling operations. This role must have permissions for <code>sagemaker:BatchAddClusterNodes</code> and <code>sagemaker:BatchDeleteClusterNodes</code>. This is only required when autoscaling is enabled and when HyperPod is performing autoscaling operations.</p>

            tags: [str]?  # <p>Custom tags for managing the SageMaker HyperPod cluster as an Amazon Web Services resource. You can add tags to your cluster in the same way you add them in other Amazon Web Services services that support tagging. To learn more about tagging Amazon Web Services resources in general, see <a href="https://docs.aws.amazon.com/tag-editor/latest/userguide/tagging.html">Tagging Amazon Web Services Resources User Guide</a>.</p>

            orchestrator: str?  # <p>The type of orchestrator to use for the SageMaker HyperPod cluster. Currently, the only supported value is <code>"eks"</code>, which is to use an Amazon Elastic Kubernetes Service cluster as the orchestrator.</p>

            instance_groups: [str]?  # <p>The instance groups to be created in the SageMaker HyperPod cluster.</p>

            node_recovery: str?  # <p>The node recovery mode for the SageMaker HyperPod cluster. When set to <code>Automatic</code>, SageMaker HyperPod will automatically reboot or replace faulty nodes when issues are detected. When set to <code>None</code>, cluster administrators will need to manually manage any faulty cluster instances.</p>



            # Outputs

            cluster_name_output?: str  # <p>The name of the SageMaker HyperPod cluster.</p>

            creation_time_output?: str  # <p>The time when the SageMaker Cluster is created.</p>

            tiered_storage_config_output?: str  # <p>The current configuration for managed tier checkpointing on the HyperPod cluster. For example, this shows whether the feature is enabled and the percentage of cluster memory allocated for checkpoint storage.</p>

            cluster_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the SageMaker HyperPod cluster.</p>

            node_recovery_output?: str  # <p>The node recovery mode configured for the SageMaker HyperPod cluster.</p>

            instance_groups_output?: [str]  # <p>The instance groups of the SageMaker HyperPod cluster.</p>

            node_provisioning_mode_output?: str  # <p>The mode used for provisioning nodes in the cluster.</p>

            cluster_role_output?: str  # <p>The Amazon Resource Name (ARN) of the IAM role that HyperPod uses for cluster autoscaling operations.</p>

            cluster_status_output?: str  # <p>The status of the SageMaker HyperPod cluster.</p>

            failure_message_output?: str  # <p>The failure message of the SageMaker HyperPod cluster.</p>

            vpc_config_output?: str  # 

            orchestrator_output?: str  # <p>The type of orchestrator used for the SageMaker HyperPod cluster. </p>

            restricted_instance_groups_output?: [str]  # <p>The specialized instance groups for training models like Amazon Nova to be created in the SageMaker HyperPod cluster.</p>

            auto_scaling_output?: str  # <p>The current autoscaling configuration and status for the autoscaler.</p>




        schema Devices:
            """
            Devices resource
            """

            devices: [str]  # <p>List of devices to register with Edge Manager agent.</p>

            device_fleet_name: str  # <p>The name of the fleet the devices belong to.</p>




        schema Compilation_job:
            """
            CompilationJob resource
            """

            stopping_condition: str  # <p>Specifies a limit to how long a model compilation job can run. When the job reaches the time limit, Amazon SageMaker AI ends the compilation job. Use this API to cap model training costs.</p>

            input_config: str?  # <p>Provides information about the location of input model artifacts, the name and shape of the expected data inputs, and the framework in which the model was trained.</p>

            vpc_config: str?  # <p>A <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_VpcConfig.html">VpcConfig</a> object that specifies the VPC that you want your compilation job to connect to. Control access to your models by configuring the VPC. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/neo-vpc.html">Protect Compilation Jobs by Using an Amazon Virtual Private Cloud</a>.</p>

            tags: [str]?  # <p>An array of key-value pairs. You can use tags to categorize your Amazon Web Services resources in different ways, for example, by purpose, owner, or environment. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services Resources</a>.</p>

            output_config: str  # <p>Provides information about the output location for the compiled model and the target device the model runs on.</p>

            compilation_job_name: str  # <p>A name for the model compilation job. The name must be unique within the Amazon Web Services Region and within your Amazon Web Services account. </p>

            model_package_version_arn: str?  # <p>The Amazon Resource Name (ARN) of a versioned model package. Provide either a <code>ModelPackageVersionArn</code> or an <code>InputConfig</code> object in the request syntax. The presence of both objects in the <code>CreateCompilationJob</code> request will return an exception.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of an IAM role that enables Amazon SageMaker AI to perform tasks on your behalf. </p> <p>During model compilation, Amazon SageMaker AI needs your permission to:</p> <ul> <li> <p>Read input data from an S3 bucket</p> </li> <li> <p>Write model artifacts to an S3 bucket</p> </li> <li> <p>Write logs to Amazon CloudWatch Logs</p> </li> <li> <p>Publish metrics to Amazon CloudWatch</p> </li> </ul> <p>You grant permissions for all of these tasks to an IAM role. To pass this role to Amazon SageMaker AI, the caller of this API must have the <code>iam:PassRole</code> permission. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/sagemaker-roles.html">Amazon SageMaker AI Roles.</a> </p>



            # Outputs

            output_config_output?: str  # <p>Information about the output location for the compiled model and the target device that the model runs on.</p>

            vpc_config_output?: str  # <p>A <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_VpcConfig.html">VpcConfig</a> object that specifies the VPC that you want your compilation job to connect to. Control access to your models by configuring the VPC. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/neo-vpc.html">Protect Compilation Jobs by Using an Amazon Virtual Private Cloud</a>.</p>

            derived_information_output?: str  # <p>Information that SageMaker Neo automatically derived about the model.</p>

            model_digests_output?: str  # <p>Provides a BLAKE2 hash value that identifies the compiled model artifacts in Amazon S3.</p>

            stopping_condition_output?: str  # <p>Specifies a limit to how long a model compilation job can run. When the job reaches the time limit, Amazon SageMaker AI ends the compilation job. Use this API to cap model training costs.</p>

            compilation_job_status_output?: str  # <p>The status of the model compilation job.</p>

            input_config_output?: str  # <p>Information about the location in Amazon S3 of the input model artifacts, the name and shape of the expected data inputs, and the framework in which the model was trained.</p>

            failure_reason_output?: str  # <p>If a model compilation job failed, the reason it failed. </p>

            model_artifacts_output?: str  # <p>Information about the location in Amazon S3 that has been configured for storing the model artifacts used in the compilation job.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of an IAM role that Amazon SageMaker AI assumes to perform the model compilation job.</p>

            compilation_end_time_output?: str  # <p>The time when the model compilation job on a compilation job instance ended. For a successful or stopped job, this is when the job's model artifacts have finished uploading. For a failed job, this is when Amazon SageMaker AI detected that the job failed. </p>

            compilation_job_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the model compilation job.</p>

            compilation_start_time_output?: str  # <p>The time when the model compilation job started the <code>CompilationJob</code> instances. </p> <p>You are billed for the time between this timestamp and the timestamp in the <code>CompilationEndTime</code> field. In Amazon CloudWatch Logs, the start time might be later than this time. That's because it takes time to download the compilation job, which depends on the size of the compilation job container. </p>

            compilation_job_name_output?: str  # <p>The name of the model compilation job.</p>

            inference_image_output?: str  # <p>The inference image to use when compiling a model. Specify an image only if the target device is a cloud instance.</p>

            model_package_version_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the versioned model package that was provided to SageMaker Neo when you initiated a compilation job.</p>

            creation_time_output?: str  # <p>The time that the model compilation job was created.</p>

            last_modified_time_output?: str  # <p>The time that the status of the model compilation job was last modified.</p>




        schema Optimization_job:
            """
            OptimizationJob resource
            """

            model_source: str  # <p>The location of the source model to optimize with an optimization job.</p>

            optimization_environment: {str: str}?  # <p>The environment variables to set in the model container.</p>

            optimization_configs: [str]  # <p>Settings for each of the optimization techniques that the job applies.</p>

            optimization_job_name: str  # <p>A custom name for the new optimization job.</p>

            deployment_instance_type: str  # <p>The type of instance that hosts the optimized model that you create with the optimization job.</p>

            tags: [str]?  # <p>A list of key-value pairs associated with the optimization job. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services resources</a> in the <i>Amazon Web Services General Reference Guide</i>.</p>

            stopping_condition: str  # 

            vpc_config: str?  # <p>A VPC in Amazon VPC that your optimized model has access to.</p>

            output_config: str  # <p>Details for where to store the optimized model that you create with the optimization job.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of an IAM role that enables Amazon SageMaker AI to perform tasks on your behalf. </p> <p>During model optimization, Amazon SageMaker AI needs your permission to:</p> <ul> <li> <p>Read input data from an S3 bucket</p> </li> <li> <p>Write model artifacts to an S3 bucket</p> </li> <li> <p>Write logs to Amazon CloudWatch Logs</p> </li> <li> <p>Publish metrics to Amazon CloudWatch</p> </li> </ul> <p>You grant permissions for all of these tasks to an IAM role. To pass this role to Amazon SageMaker AI, the caller of this API must have the <code>iam:PassRole</code> permission. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/sagemaker-roles.html">Amazon SageMaker AI Roles.</a> </p>



            # Outputs

            optimization_configs_output?: [str]  # <p>Settings for each of the optimization techniques that the job applies.</p>

            vpc_config_output?: str  # <p>A VPC in Amazon VPC that your optimized model has access to.</p>

            optimization_job_name_output?: str  # <p>The name that you assigned to the optimization job.</p>

            optimization_start_time_output?: str  # <p>The time when the optimization job started.</p>

            creation_time_output?: str  # <p>The time when you created the optimization job.</p>

            model_source_output?: str  # <p>The location of the source model to optimize with an optimization job.</p>

            optimization_environment_output?: {str: str}  # <p>The environment variables to set in the model container.</p>

            optimization_end_time_output?: str  # <p>The time when the optimization job finished processing.</p>

            output_config_output?: str  # <p>Details for where to store the optimized model that you create with the optimization job.</p>

            optimization_output_output?: str  # <p>Output values produced by an optimization job.</p>

            failure_reason_output?: str  # <p>If the optimization job status is <code>FAILED</code>, the reason for the failure.</p>

            optimization_job_status_output?: str  # <p>The current status of the optimization job.</p>

            role_arn_output?: str  # <p>The ARN of the IAM role that you assigned to the optimization job.</p>

            optimization_job_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the optimization job.</p>

            stopping_condition_output?: str  # 

            last_modified_time_output?: str  # <p>The time when the optimization job was last updated.</p>

            deployment_instance_type_output?: str  # <p>The type of instance that hosts the optimized model that you create with the optimization job.</p>




        schema Project:
            """
            Project resource
            """

            project_description: str?  # <p>A description for the project.</p>

            project_name: str  # <p>The name of the project.</p>

            service_catalog_provisioning_details: str?  # <p>The product ID and provisioning artifact ID to provision a service catalog. The provisioning artifact ID will default to the latest provisioning artifact ID of the product, if you don't provide the provisioning artifact ID. For more information, see <a href="https://docs.aws.amazon.com/servicecatalog/latest/adminguide/introduction.html">What is Amazon Web Services Service Catalog</a>.</p>

            template_providers: [str]?  # <p> An array of template provider configurations for creating infrastructure resources for the project. </p>

            tags: [str]?  # <p>An array of key-value pairs that you want to use to organize and track your Amazon Web Services resource costs. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services resources</a> in the <i>Amazon Web Services General Reference Guide</i>.</p>



            # Outputs

            creation_time_output?: str  # <p>The time when the project was created.</p>

            template_provider_details_output?: [str]  # <p> An array of template providers associated with the project. </p>

            project_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the project.</p>

            created_by_output?: str  # 

            project_name_output?: str  # <p>The name of the project.</p>

            service_catalog_provisioning_details_output?: str  # <p>Information used to provision a service catalog product. For information, see <a href="https://docs.aws.amazon.com/servicecatalog/latest/adminguide/introduction.html">What is Amazon Web Services Service Catalog</a>.</p>

            last_modified_time_output?: str  # <p>The timestamp when project was last modified.</p>

            project_id_output?: str  # <p>The ID of the project.</p>

            service_catalog_provisioned_product_details_output?: str  # <p>Information about a provisioned service catalog product.</p>

            project_status_output?: str  # <p>The status of the project.</p>

            last_modified_by_output?: str  # 

            project_description_output?: str  # <p>The description of the project.</p>




        schema Trial:
            """
            Trial resource
            """

            metadata_properties: str?  # 

            experiment_name: str  # <p>The name of the experiment to associate the trial with.</p>

            display_name: str?  # <p>The name of the trial as displayed. The name doesn't need to be unique. If <code>DisplayName</code> isn't specified, <code>TrialName</code> is displayed.</p>

            trial_name: str  # <p>The name of the trial. The name must be unique in your Amazon Web Services account and is not case-sensitive.</p>

            tags: [str]?  # <p>A list of tags to associate with the trial. You can use <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_Search.html">Search</a> API to search on the tags.</p>



            # Outputs

            metadata_properties_output?: str  # 

            trial_name_output?: str  # <p>The name of the trial.</p>

            trial_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the trial.</p>

            last_modified_time_output?: str  # <p>When the trial was last modified.</p>

            experiment_name_output?: str  # <p>The name of the experiment the trial is part of.</p>

            display_name_output?: str  # <p>The name of the trial as displayed. If <code>DisplayName</code> isn't specified, <code>TrialName</code> is displayed.</p>

            source_output?: str  # <p>The Amazon Resource Name (ARN) of the source and, optionally, the job type.</p>

            created_by_output?: str  # <p>Who created the trial.</p>

            creation_time_output?: str  # <p>When the trial was created.</p>

            last_modified_by_output?: str  # <p>Who last modified the trial.</p>




        schema Sagemaker_servicecatalog_portfolio_status:
            """
            SagemakerServicecatalogPortfolioStatus resource
            """



            # Outputs

            status_output?: str  # <p>Whether Service Catalog is enabled or disabled in SageMaker.</p>




        schema Auto_ml_job:
            """
            AutoMLJob resource
            """

            model_deploy_config: str?  # <p>Specifies how to generate the endpoint name for an automatic one-click Autopilot model deployment.</p>

            auto_ml_job_objective: str?  # <p>Specifies a metric to minimize or maximize as the objective of a job. If not specified, the default objective metric depends on the problem type. See <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_AutoMLJobObjective.html">AutoMLJobObjective</a> for the default values.</p>

            input_data_config: [str]  # <p>An array of channel objects that describes the input data and its location. Each channel is a named input source. Similar to <code>InputDataConfig</code> supported by <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTrainingJobDefinition.html">HyperParameterTrainingJobDefinition</a>. Format(s) supported: CSV, Parquet. A minimum of 500 rows is required for the training dataset. There is not a minimum number of rows required for the validation dataset.</p>

            auto_ml_job_config: str?  # <p>A collection of settings used to configure an AutoML job.</p>

            auto_ml_job_name: str  # <p>Identifies an Autopilot job. The name must be unique to your account and is case insensitive.</p>

            generate_candidate_definitions_only: bool?  # <p>Generates possible candidates without training the models. A candidate is a combination of data preprocessors, algorithms, and algorithm parameter settings.</p>

            problem_type: str?  # <p>Defines the type of supervised learning problem available for the candidates. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/autopilot-datasets-problem-types.html#autopilot-problem-types"> SageMaker Autopilot problem types</a>.</p>

            role_arn: str  # <p>The ARN of the role that is used to access the data.</p>

            output_data_config: str  # <p>Provides information about encryption and the Amazon S3 output path needed to store artifacts from an AutoML job. Format(s) supported: CSV.</p>

            tags: [str]?  # <p>An array of key-value pairs. You can use tags to categorize your Amazon Web Services resources in different ways, for example, by purpose, owner, or environment. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web ServicesResources</a>. Tag keys must be unique per resource.</p>



            # Outputs

            partial_failure_reasons_output?: [str]  # <p>Returns a list of reasons for partial failures within an AutoML job.</p>

            model_deploy_config_output?: str  # <p>Indicates whether the model was deployed automatically to an endpoint and the name of that endpoint if deployed automatically.</p>

            role_arn_output?: str  # <p>The ARN of the IAM role that has read permission to the input data location and write permission to the output data location in Amazon S3.</p>

            problem_type_output?: str  # <p>Returns the job's problem type.</p>

            best_candidate_output?: str  # <p>The best model candidate selected by SageMaker AI Autopilot using both the best objective metric and lowest <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/autopilot-metrics-validation.html">InferenceLatency</a> for an experiment.</p>

            last_modified_time_output?: str  # <p>Returns the job's last modified time.</p>

            input_data_config_output?: [str]  # <p>Returns the input data configuration for the AutoML job.</p>

            model_deploy_result_output?: str  # <p>Provides information about endpoint for the model deployment.</p>

            generate_candidate_definitions_only_output?: bool  # <p>Indicates whether the output for an AutoML job generates candidate definitions only.</p>

            auto_ml_job_artifacts_output?: str  # <p>Returns information on the job's artifacts found in <code>AutoMLJobArtifacts</code>.</p>

            auto_ml_job_secondary_status_output?: str  # <p>Returns the secondary status of the AutoML job.</p>

            output_data_config_output?: str  # <p>Returns the job's output data config.</p>

            end_time_output?: str  # <p>Returns the end time of the AutoML job.</p>

            auto_ml_job_status_output?: str  # <p>Returns the status of the AutoML job.</p>

            auto_ml_job_name_output?: str  # <p>Returns the name of the AutoML job.</p>

            failure_reason_output?: str  # <p>Returns the failure reason for an AutoML job, when applicable.</p>

            auto_ml_job_config_output?: str  # <p>Returns the configuration for the AutoML job.</p>

            creation_time_output?: str  # <p>Returns the creation time of the AutoML job.</p>

            auto_ml_job_arn_output?: str  # <p>Returns the ARN of the AutoML job.</p>

            resolved_attributes_output?: str  # <p>Contains <code>ProblemType</code>, <code>AutoMLJobObjective</code>, and <code>CompletionCriteria</code>. If you do not provide these values, they are inferred.</p>

            auto_ml_job_objective_output?: str  # <p>Returns the job's objective.</p>




        schema Model_package:
            """
            ModelPackage resource
            """

            model_package_group_name: str?  # <p>The name or Amazon Resource Name (ARN) of the model package group that this model version belongs to.</p> <p>This parameter is required for versioned models, and does not apply to unversioned models.</p>

            security_config: str?  # <p>The KMS Key ID (<code>KMSKeyId</code>) used for encryption of model package information.</p>

            model_card: str?  # <p>The model card associated with the model package. Since <code>ModelPackageModelCard</code> is tied to a model package, it is a specific usage of a model card and its schema is simplified compared to the schema of <code>ModelCard</code>. The <code>ModelPackageModelCard</code> schema does not include <code>model_package_details</code>, and <code>model_overview</code> is composed of the <code>model_creator</code> and <code>model_artifact</code> properties. For more information about the model package model card schema, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/model-registry-details.html#model-card-schema">Model package model card schema</a>. For more information about the model card associated with the model package, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/model-registry-details.html">View the Details of a Model Version</a>.</p>

            domain: str?  # <p>The machine learning domain of your model package and its components. Common machine learning domains include computer vision and natural language processing.</p>

            drift_check_baselines: str?  # <p>Represents the drift check baselines that can be used when the model monitor is set using the model package. For more information, see the topic on <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/pipelines-quality-clarify-baseline-lifecycle.html#pipelines-quality-clarify-baseline-drift-detection">Drift Detection against Previous Baselines in SageMaker Pipelines</a> in the <i>Amazon SageMaker Developer Guide</i>. </p>

            certify_for_marketplace: bool?  # <p>Whether to certify the model package for listing on Amazon Web Services Marketplace.</p> <p>This parameter is optional for unversioned models, and does not apply to versioned models.</p>

            metadata_properties: str?  # 

            model_life_cycle: str?  # <p> A structure describing the current state of the model in its life cycle. </p>

            model_package_name: str?  # <p>The name of the model package. The name must have 1 to 63 characters. Valid characters are a-z, A-Z, 0-9, and - (hyphen).</p> <p>This parameter is required for unversioned models. It is not applicable to versioned models.</p>

            model_approval_status: str?  # <p>Whether the model is approved for deployment.</p> <p>This parameter is optional for versioned models, and does not apply to unversioned models.</p> <p>For versioned models, the value of this parameter must be set to <code>Approved</code> to deploy the model.</p>

            client_token: str?  # <p>A unique token that guarantees that the call to this API is idempotent.</p>

            sample_payload_url: str?  # <p>The Amazon Simple Storage Service (Amazon S3) path where the sample payload is stored. This path must point to a single gzip compressed tar archive (.tar.gz suffix). This archive can hold multiple files that are all equally used in the load test. Each file in the archive must satisfy the size constraints of the <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_runtime_InvokeEndpoint.html#API_runtime_InvokeEndpoint_RequestSyntax">InvokeEndpoint</a> call.</p>

            skip_model_validation: str?  # <p>Indicates if you want to skip model validation.</p>

            tags: [str]?  # <p>A list of key value pairs associated with the model. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services resources</a> in the <i>Amazon Web Services General Reference Guide</i>.</p> <p>If you supply <code>ModelPackageGroupName</code>, your model package belongs to the model group you specify and uses the tags associated with the model group. In this case, you cannot supply a <code>tag</code> argument. </p>

            model_package_description: str?  # <p>A description of the model package.</p>

            validation_specification: str?  # <p>Specifies configurations for one or more transform jobs that SageMaker runs to test the model package.</p>

            source_algorithm_specification: str?  # <p>Details about the algorithm that was used to create the model package.</p>

            model_metrics: str?  # <p>A structure that contains model metrics reports.</p>

            additional_inference_specifications: [str]?  # <p>An array of additional Inference Specification objects. Each additional Inference Specification specifies artifacts based on this model package that can be used on inference endpoints. Generally used with SageMaker Neo to store the compiled artifacts. </p>

            source_uri: str?  # <p>The URI of the source for the model package. If you want to clone a model package, set it to the model package Amazon Resource Name (ARN). If you want to register a model, set it to the model ARN.</p>

            inference_specification: str?  # <p>Specifies details about inference jobs that you can run with models based on this model package, including the following information:</p> <ul> <li> <p>The Amazon ECR paths of containers that contain the inference code and model artifacts.</p> </li> <li> <p>The instance types that the model package supports for transform jobs and real-time endpoints used for inference.</p> </li> <li> <p>The input and output content formats that the model package supports for inference.</p> </li> </ul>

            task: str?  # <p>The machine learning task your model package accomplishes. Common machine learning tasks include object detection and image classification. The following tasks are supported by Inference Recommender: <code>"IMAGE_CLASSIFICATION"</code> | <code>"OBJECT_DETECTION"</code> | <code>"TEXT_GENERATION"</code> |<code>"IMAGE_SEGMENTATION"</code> | <code>"FILL_MASK"</code> | <code>"CLASSIFICATION"</code> | <code>"REGRESSION"</code> | <code>"OTHER"</code>.</p> <p>Specify "OTHER" if none of the tasks listed fit your use case.</p>

            customer_metadata_properties: {str: str}?  # <p>The metadata properties associated with the model package versions.</p>



            # Outputs

            model_package_description_output?: str  # <p>A brief summary of the model package.</p>

            domain_output?: str  # <p>The machine learning domain of the model package you specified. Common machine learning domains include computer vision and natural language processing.</p>

            model_package_status_output?: str  # <p>The current status of the model package.</p>

            certify_for_marketplace_output?: bool  # <p>Whether the model package is certified for listing on Amazon Web Services Marketplace.</p>

            task_output?: str  # <p>The machine learning task you specified that your model package accomplishes. Common machine learning tasks include object detection and image classification.</p>

            model_life_cycle_output?: str  # <p> A structure describing the current state of the model in its life cycle. </p>

            skip_model_validation_output?: str  # <p>Indicates if you want to skip model validation.</p>

            model_package_group_name_output?: str  # <p>If the model is a versioned model, the name of the model group that the versioned model belongs to.</p>

            created_by_output?: str  # 

            model_approval_status_output?: str  # <p>The approval status of the model package.</p>

            drift_check_baselines_output?: str  # <p>Represents the drift check baselines that can be used when the model monitor is set using the model package. For more information, see the topic on <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/pipelines-quality-clarify-baseline-lifecycle.html#pipelines-quality-clarify-baseline-drift-detection">Drift Detection against Previous Baselines in SageMaker Pipelines</a> in the <i>Amazon SageMaker Developer Guide</i>. </p>

            security_config_output?: str  # <p>The KMS Key ID (<code>KMSKeyId</code>) used for encryption of model package information.</p>

            model_card_output?: str  # <p>The model card associated with the model package. Since <code>ModelPackageModelCard</code> is tied to a model package, it is a specific usage of a model card and its schema is simplified compared to the schema of <code>ModelCard</code>. The <code>ModelPackageModelCard</code> schema does not include <code>model_package_details</code>, and <code>model_overview</code> is composed of the <code>model_creator</code> and <code>model_artifact</code> properties. For more information about the model package model card schema, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/model-registry-details.html#model-card-schema">Model package model card schema</a>. For more information about the model card associated with the model package, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/model-registry-details.html">View the Details of a Model Version</a>.</p>

            sample_payload_url_output?: str  # <p>The Amazon Simple Storage Service (Amazon S3) path where the sample payload are stored. This path points to a single gzip compressed tar archive (.tar.gz suffix).</p>

            model_package_version_output?: int  # <p>The version of the model package.</p>

            model_metrics_output?: str  # <p>Metrics for the model.</p>

            customer_metadata_properties_output?: {str: str}  # <p>The metadata properties associated with the model package versions.</p>

            inference_specification_output?: str  # <p>Details about inference jobs that you can run with models based on this model package.</p>

            additional_inference_specifications_output?: [str]  # <p>An array of additional Inference Specification objects. Each additional Inference Specification specifies artifacts based on this model package that can be used on inference endpoints. Generally used with SageMaker Neo to store the compiled artifacts.</p>

            creation_time_output?: str  # <p>A timestamp specifying when the model package was created.</p>

            model_package_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the model package.</p>

            validation_specification_output?: str  # <p>Configurations for one or more transform jobs that SageMaker runs to test the model package.</p>

            last_modified_time_output?: str  # <p>The last time that the model package was modified.</p>

            source_uri_output?: str  # <p>The URI of the source for the model package.</p>

            model_package_name_output?: str  # <p>The name of the model package being described.</p>

            metadata_properties_output?: str  # 

            model_package_status_details_output?: str  # <p>Details about the current status of the model package.</p>

            last_modified_by_output?: str  # 

            source_algorithm_specification_output?: str  # <p>Details about the algorithm that was used to create the model package.</p>

            approval_description_output?: str  # <p>A description provided for the model approval.</p>




        schema Reserved_capacity:
            """
            ReservedCapacity resource
            """



            # Outputs

            duration_minutes_output?: int  # <p>The number of minutes for the duration of the reserved capacity. For example, if a reserved capacity starts at 08:55 and ends at 11:30, the minutes field would be 35.</p>

            start_time_output?: str  # <p>The timestamp when the reserved capacity becomes active.</p>

            end_time_output?: str  # <p>The timestamp when the reserved capacity expires.</p>

            total_instance_count_output?: int  # <p>The total number of instances allocated to this reserved capacity.</p>

            in_use_instance_count_output?: int  # <p>The number of instances currently in use from this reserved capacity.</p>

            instance_type_output?: str  # <p>The Amazon EC2 instance type used in the reserved capacity.</p>

            duration_hours_output?: int  # <p>The total duration of the reserved capacity in hours.</p>

            available_instance_count_output?: int  # <p>The number of instances currently available for use in this reserved capacity.</p>

            ultra_server_summary_output?: str  # <p>A summary of the UltraServer associated with this reserved capacity.</p>

            reserved_capacity_arn_output?: str  # <p>ARN of the reserved capacity.</p>

            reserved_capacity_type_output?: str  # <p>The type of reserved capacity.</p>

            status_output?: str  # <p>The current status of the reserved capacity.</p>

            availability_zone_output?: str  # <p>The Availability Zone where the reserved capacity is provisioned.</p>




        schema Search_suggestions:
            """
            SearchSuggestions resource
            """



            # Outputs

            property_name_suggestions_output?: [str]  # <p>A list of property names for a <code>Resource</code> that match a <code>SuggestionQuery</code>.</p>




        schema Image:
            """
            Image resource
            """

            tags: [str]?  # <p>A list of tags to apply to the image.</p>

            image_name: str  # <p>The name of the image. Must be unique to your account.</p>

            role_arn: str  # <p>The ARN of an IAM role that enables Amazon SageMaker AI to perform tasks on your behalf.</p>

            description: str?  # <p>The description of the image.</p>

            display_name: str?  # <p>The display name of the image. If not provided, <code>ImageName</code> is displayed.</p>



            # Outputs

            display_name_output?: str  # <p>The name of the image as displayed.</p>

            role_arn_output?: str  # <p>The ARN of the IAM role that enables Amazon SageMaker AI to perform tasks on your behalf.</p>

            creation_time_output?: str  # <p>When the image was created.</p>

            image_arn_output?: str  # <p>The ARN of the image.</p>

            image_name_output?: str  # <p>The name of the image.</p>

            failure_reason_output?: str  # <p>When a create, update, or delete operation fails, the reason for the failure.</p>

            image_status_output?: str  # <p>The status of the image.</p>

            description_output?: str  # <p>The description of the image.</p>

            last_modified_time_output?: str  # <p>When the image was last modified.</p>




        schema Mlflow_tracking_server:
            """
            MlflowTrackingServer resource
            """

            tracking_server_name: str  # <p>A unique string identifying the tracking server name. This string is part of the tracking server ARN.</p>

            artifact_store_uri: str  # <p>The S3 URI for a general purpose bucket to use as the MLflow Tracking Server artifact store.</p>

            automatic_model_registration: bool?  # <p>Whether to enable or disable automatic registration of new MLflow models to the SageMaker Model Registry. To enable automatic model registration, set this value to <code>True</code>. To disable automatic model registration, set this value to <code>False</code>. If not specified, <code>AutomaticModelRegistration</code> defaults to <code>False</code>.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) for an IAM role in your account that the MLflow Tracking Server uses to access the artifact store in Amazon S3. The role should have <code>AmazonS3FullAccess</code> permissions. For more information on IAM permissions for tracking server creation, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/mlflow-create-tracking-server-iam.html">Set up IAM permissions for MLflow</a>.</p>

            weekly_maintenance_window_start: str?  # <p>The day and time of the week in Coordinated Universal Time (UTC) 24-hour standard time that weekly maintenance updates are scheduled. For example: TUE:03:30.</p>

            tracking_server_size: str?  # <p>The size of the tracking server you want to create. You can choose between <code>"Small"</code>, <code>"Medium"</code>, and <code>"Large"</code>. The default MLflow Tracking Server configuration size is <code>"Small"</code>. You can choose a size depending on the projected use of the tracking server such as the volume of data logged, number of users, and frequency of use. </p> <p>We recommend using a small tracking server for teams of up to 25 users, a medium tracking server for teams of up to 50 users, and a large tracking server for teams of up to 100 users. </p>

            mlflow_version: str?  # <p>The version of MLflow that the tracking server uses. To see which MLflow versions are available to use, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/mlflow.html#mlflow-create-tracking-server-how-it-works">How it works</a>.</p>

            tags: [str]?  # <p>Tags consisting of key-value pairs used to manage metadata for the tracking server.</p>



            # Outputs

            tracking_server_url_output?: str  # <p>The URL to connect to the MLflow user interface for the described tracking server.</p>

            created_by_output?: str  # 

            weekly_maintenance_window_start_output?: str  # <p>The day and time of the week when weekly maintenance occurs on the described tracking server.</p>

            artifact_store_uri_output?: str  # <p>The S3 URI of the general purpose bucket used as the MLflow Tracking Server artifact store.</p>

            tracking_server_size_output?: str  # <p>The size of the described tracking server.</p>

            tracking_server_status_output?: str  # <p>The current creation status of the described MLflow Tracking Server.</p>

            tracking_server_name_output?: str  # <p>The name of the described tracking server.</p>

            tracking_server_maintenance_status_output?: str  # <p> The current maintenance status of the described MLflow Tracking Server. </p>

            automatic_model_registration_output?: bool  # <p>Whether automatic registration of new MLflow models to the SageMaker Model Registry is enabled.</p>

            is_active_output?: str  # <p>Whether the described MLflow Tracking Server is currently active.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) for an IAM role in your account that the described MLflow Tracking Server uses to access the artifact store in Amazon S3.</p>

            creation_time_output?: str  # <p>The timestamp of when the described MLflow Tracking Server was created.</p>

            tracking_server_arn_output?: str  # <p>The ARN of the described tracking server.</p>

            last_modified_time_output?: str  # <p>The timestamp of when the described MLflow Tracking Server was last modified.</p>

            last_modified_by_output?: str  # 

            mlflow_version_output?: str  # <p>The MLflow version used for the described tracking server.</p>




        schema Device_fleet:
            """
            DeviceFleet resource
            """

            enable_iot_role_alias: bool?  # <p>Whether to create an Amazon Web Services IoT Role Alias during device fleet creation. The name of the role alias generated will match this pattern: "SageMakerEdge-{DeviceFleetName}".</p> <p>For example, if your device fleet is called "demo-fleet", the name of the role alias will be "SageMakerEdge-demo-fleet".</p>

            device_fleet_name: str  # <p>The name of the fleet that the device belongs to.</p>

            description: str?  # <p>A description of the fleet.</p>

            output_config: str  # <p>The output configuration for storing sample data collected by the fleet.</p>

            tags: [str]?  # <p>Creates tags for the specified fleet.</p>

            role_arn: str?  # <p>The Amazon Resource Name (ARN) that has access to Amazon Web Services Internet of Things (IoT).</p>



            # Outputs

            description_output?: str  # <p>A description of the fleet.</p>

            device_fleet_arn_output?: str  # <p>The The Amazon Resource Name (ARN) of the fleet.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) that has access to Amazon Web Services Internet of Things (IoT).</p>

            last_modified_time_output?: str  # <p>Timestamp of when the device fleet was last updated.</p>

            iot_role_alias_output?: str  # <p>The Amazon Resource Name (ARN) alias created in Amazon Web Services Internet of Things (IoT).</p>

            device_fleet_name_output?: str  # <p>The name of the fleet.</p>

            output_config_output?: str  # <p>The output configuration for storing sampled data.</p>

            creation_time_output?: str  # <p>Timestamp of when the device fleet was created.</p>




        schema Notebook_instance:
            """
            NotebookInstance resource
            """

            security_group_ids: [str]?  # <p>The VPC security group IDs, in the form sg-xxxxxxxx. The security groups must be for the same VPC as specified in the subnet. </p>

            platform_identifier: str?  # <p>The platform identifier of the notebook instance runtime environment. The default value is <code>notebook-al2-v2</code>.</p>

            instance_type: str  # <p>The type of ML compute instance to launch for the notebook instance.</p>

            ip_address_type: str?  # <p>The IP address type for the notebook instance. Specify <code>ipv4</code> for IPv4-only connectivity or <code>dualstack</code> for both IPv4 and IPv6 connectivity. When you specify <code>dualstack</code>, the subnet must support IPv6 CIDR blocks. If not specified, defaults to <code>ipv4</code>.</p>

            role_arn: str  # <p> When you send any requests to Amazon Web Services resources from the notebook instance, SageMaker AI assumes this role to perform tasks on your behalf. You must grant this role necessary permissions so SageMaker AI can perform these tasks. The policy must allow the SageMaker AI service principal (sagemaker.amazonaws.com) permissions to assume this role. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/sagemaker-roles.html">SageMaker AI Roles</a>. </p> <note> <p>To be able to pass this role to SageMaker AI, the caller of this API must have the <code>iam:PassRole</code> permission.</p> </note>

            notebook_instance_name: str  # <p>The name of the new notebook instance.</p>

            accelerator_types: [str]?  # <p>This parameter is no longer supported. Elastic Inference (EI) is no longer available.</p> <p>This parameter was used to specify a list of EI instance types to associate with this notebook instance.</p>

            root_access: str?  # <p>Whether root access is enabled or disabled for users of the notebook instance. The default value is <code>Enabled</code>.</p> <note> <p>Lifecycle configurations need root access to be able to set up a notebook instance. Because of this, lifecycle configurations associated with a notebook instance always run with root access even if you disable root access for users.</p> </note>

            instance_metadata_service_configuration: str?  # <p>Information on the IMDS configuration of the notebook instance</p>

            additional_code_repositories: [str]?  # <p>An array of up to three Git repositories to associate with the notebook instance. These can be either the names of Git repositories stored as resources in your account, or the URL of Git repositories in <a href="https://docs.aws.amazon.com/codecommit/latest/userguide/welcome.html">Amazon Web Services CodeCommit</a> or in any other Git repository. These repositories are cloned at the same level as the default repository of your notebook instance. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/nbi-git-repo.html">Associating Git Repositories with SageMaker AI Notebook Instances</a>.</p>

            direct_internet_access: str?  # <p>Sets whether SageMaker AI provides internet access to the notebook instance. If you set this to <code>Disabled</code> this notebook instance is able to access resources only in your VPC, and is not be able to connect to SageMaker AI training and endpoint services unless you configure a NAT Gateway in your VPC.</p> <p>For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/appendix-additional-considerations.html#appendix-notebook-and-internet-access">Notebook Instances Are Internet-Enabled by Default</a>. You can set the value of this parameter to <code>Disabled</code> only if you set a value for the <code>SubnetId</code> parameter.</p>

            volume_size_in_gb: int?  # <p>The size, in GB, of the ML storage volume to attach to the notebook instance. The default value is 5 GB.</p>

            tags: [str]?  # <p>An array of key-value pairs. You can use tags to categorize your Amazon Web Services resources in different ways, for example, by purpose, owner, or environment. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services Resources</a>.</p>

            lifecycle_config_name: str?  # <p>The name of a lifecycle configuration to associate with the notebook instance. For information about lifestyle configurations, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/notebook-lifecycle-config.html">Step 2.1: (Optional) Customize a Notebook Instance</a>.</p>

            subnet_id: str?  # <p>The ID of the subnet in a VPC to which you would like to have a connectivity from your ML compute instance. </p>

            kms_key_id: str?  # <p>The Amazon Resource Name (ARN) of a Amazon Web Services Key Management Service key that SageMaker AI uses to encrypt data on the storage volume attached to your notebook instance. The KMS key you provide must be enabled. For information, see <a href="https://docs.aws.amazon.com/kms/latest/developerguide/enabling-keys.html">Enabling and Disabling Keys</a> in the <i>Amazon Web Services Key Management Service Developer Guide</i>.</p>

            default_code_repository: str?  # <p>A Git repository to associate with the notebook instance as its default code repository. This can be either the name of a Git repository stored as a resource in your account, or the URL of a Git repository in <a href="https://docs.aws.amazon.com/codecommit/latest/userguide/welcome.html">Amazon Web Services CodeCommit</a> or in any other Git repository. When you open a notebook instance, it opens in the directory that contains this repository. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/nbi-git-repo.html">Associating Git Repositories with SageMaker AI Notebook Instances</a>.</p>



            # Outputs

            notebook_instance_status_output?: str  # <p>The status of the notebook instance.</p>

            notebook_instance_name_output?: str  # <p>The name of the SageMaker AI notebook instance. </p>

            ip_address_type_output?: str  # <p>The IP address type configured for the notebook instance. Returns <code>ipv4</code> for IPv4-only connectivity or <code>dualstack</code> for both IPv4 and IPv6 connectivity.</p>

            volume_size_in_gb_output?: int  # <p>The size, in GB, of the ML storage volume attached to the notebook instance.</p>

            failure_reason_output?: str  # <p>If status is <code>Failed</code>, the reason it failed.</p>

            notebook_instance_lifecycle_config_name_output?: str  # <p>Returns the name of a notebook instance lifecycle configuration.</p> <p>For information about notebook instance lifestyle configurations, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/notebook-lifecycle-config.html">Step 2.1: (Optional) Customize a Notebook Instance</a> </p>

            platform_identifier_output?: str  # <p>The platform identifier of the notebook instance runtime environment.</p>

            direct_internet_access_output?: str  # <p>Describes whether SageMaker AI provides internet access to the notebook instance. If this value is set to <i>Disabled</i>, the notebook instance does not have internet access, and cannot connect to SageMaker AI training and endpoint services.</p> <p>For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/appendix-additional-considerations.html#appendix-notebook-and-internet-access">Notebook Instances Are Internet-Enabled by Default</a>.</p>

            security_groups_output?: [str]  # <p>The IDs of the VPC security groups.</p>

            network_interface_id_output?: str  # <p>The network interface IDs that SageMaker AI created at the time of creating the instance. </p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the IAM role associated with the instance. </p>

            last_modified_time_output?: str  # <p>A timestamp. Use this parameter to retrieve the time when the notebook instance was last modified. </p>

            notebook_instance_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the notebook instance.</p>

            accelerator_types_output?: [str]  # <p>This parameter is no longer supported. Elastic Inference (EI) is no longer available.</p> <p>This parameter was used to specify a list of the EI instance types associated with this notebook instance.</p>

            default_code_repository_output?: str  # <p>The Git repository associated with the notebook instance as its default code repository. This can be either the name of a Git repository stored as a resource in your account, or the URL of a Git repository in <a href="https://docs.aws.amazon.com/codecommit/latest/userguide/welcome.html">Amazon Web Services CodeCommit</a> or in any other Git repository. When you open a notebook instance, it opens in the directory that contains this repository. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/nbi-git-repo.html">Associating Git Repositories with SageMaker AI Notebook Instances</a>.</p>

            instance_metadata_service_configuration_output?: str  # <p>Information on the IMDS configuration of the notebook instance</p>

            url_output?: str  # <p>The URL that you use to connect to the Jupyter notebook that is running in your notebook instance. </p>

            root_access_output?: str  # <p>Whether root access is enabled or disabled for users of the notebook instance.</p> <note> <p>Lifecycle configurations need root access to be able to set up a notebook instance. Because of this, lifecycle configurations associated with a notebook instance always run with root access even if you disable root access for users.</p> </note>

            additional_code_repositories_output?: [str]  # <p>An array of up to three Git repositories associated with the notebook instance. These can be either the names of Git repositories stored as resources in your account, or the URL of Git repositories in <a href="https://docs.aws.amazon.com/codecommit/latest/userguide/welcome.html">Amazon Web Services CodeCommit</a> or in any other Git repository. These repositories are cloned at the same level as the default repository of your notebook instance. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/nbi-git-repo.html">Associating Git Repositories with SageMaker AI Notebook Instances</a>.</p>

            kms_key_id_output?: str  # <p>The Amazon Web Services KMS key ID SageMaker AI uses to encrypt data when storing it on the ML storage volume attached to the instance. </p>

            creation_time_output?: str  # <p>A timestamp. Use this parameter to return the time when the notebook instance was created</p>

            instance_type_output?: str  # <p>The type of ML compute instance running on the notebook instance.</p>

            subnet_id_output?: str  # <p>The ID of the VPC subnet.</p>




        schema Device_fleet_report:
            """
            DeviceFleetReport resource
            """



            # Outputs

            output_config_output?: str  # <p>The output configuration for storing sample data collected by the fleet.</p>

            model_stats_output?: [str]  # <p>Status of model on device.</p>

            report_generated_output?: str  # <p>Timestamp of when the report was generated.</p>

            device_fleet_name_output?: str  # <p>The name of the fleet.</p>

            device_fleet_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the device.</p>

            agent_versions_output?: [str]  # <p>The versions of Edge Manager agent deployed on the fleet.</p>

            device_stats_output?: str  # <p>Status of devices.</p>

            description_output?: str  # <p>Description of the fleet.</p>




        schema Inference_component_runtime_config:
            """
            InferenceComponentRuntimeConfig resource
            """

            inference_component_name: str  # <p>The name of the inference component to update.</p>

            desired_runtime_config: str  # <p>Runtime settings for a model that is deployed with an inference component.</p>




        schema Feature_group:
            """
            FeatureGroup resource
            """

            tags: [str]?  # <p>Tags used to identify <code>Features</code> in each <code>FeatureGroup</code>.</p>

            offline_store_config: str?  # <p>Use this to configure an <code>OfflineFeatureStore</code>. This parameter allows you to specify:</p> <ul> <li> <p>The Amazon Simple Storage Service (Amazon S3) location of an <code>OfflineStore</code>.</p> </li> <li> <p>A configuration for an Amazon Web Services Glue or Amazon Web Services Hive data catalog. </p> </li> <li> <p>An KMS encryption key to encrypt the Amazon S3 location used for <code>OfflineStore</code>. If KMS encryption key is not specified, by default we encrypt all data at rest using Amazon Web Services KMS key. By defining your <a href="https://docs.aws.amazon.com/AmazonS3/latest/userguide/bucket-key.html">bucket-level key</a> for SSE, you can reduce Amazon Web Services KMS requests costs by up to 99 percent.</p> </li> <li> <p>Format for the offline store table. Supported formats are Glue (Default) and <a href="https://iceberg.apache.org/">Apache Iceberg</a>.</p> </li> </ul> <p>To learn more about this parameter, see <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_OfflineStoreConfig.html">OfflineStoreConfig</a>.</p>

            description: str?  # <p>A free-form description of a <code>FeatureGroup</code>.</p>

            role_arn: str?  # <p>The Amazon Resource Name (ARN) of the IAM execution role used to persist data into the <code>OfflineStore</code> if an <code>OfflineStoreConfig</code> is provided.</p>

            online_store_config: str?  # <p>You can turn the <code>OnlineStore</code> on or off by specifying <code>True</code> for the <code>EnableOnlineStore</code> flag in <code>OnlineStoreConfig</code>.</p> <p>You can also include an Amazon Web Services KMS key ID (<code>KMSKeyId</code>) for at-rest encryption of the <code>OnlineStore</code>.</p> <p>The default value is <code>False</code>.</p>

            feature_group_name: str  # <p>The name of the <code>FeatureGroup</code>. The name must be unique within an Amazon Web Services Region in an Amazon Web Services account.</p> <p>The name:</p> <ul> <li> <p>Must start with an alphanumeric character.</p> </li> <li> <p>Can only include alphanumeric characters, underscores, and hyphens. Spaces are not allowed.</p> </li> </ul>

            event_time_feature_name: str  # <p>The name of the feature that stores the <code>EventTime</code> of a <code>Record</code> in a <code>FeatureGroup</code>.</p> <p>An <code>EventTime</code> is a point in time when a new event occurs that corresponds to the creation or update of a <code>Record</code> in a <code>FeatureGroup</code>. All <code>Records</code> in the <code>FeatureGroup</code> must have a corresponding <code>EventTime</code>.</p> <p>An <code>EventTime</code> can be a <code>String</code> or <code>Fractional</code>. </p> <ul> <li> <p> <code>Fractional</code>: <code>EventTime</code> feature values must be a Unix timestamp in seconds.</p> </li> <li> <p> <code>String</code>: <code>EventTime</code> feature values must be an ISO-8601 string in the format. The following formats are supported <code>yyyy-MM-dd'T'HH:mm:ssZ</code> and <code>yyyy-MM-dd'T'HH:mm:ss.SSSZ</code> where <code>yyyy</code>, <code>MM</code>, and <code>dd</code> represent the year, month, and day respectively and <code>HH</code>, <code>mm</code>, <code>ss</code>, and if applicable, <code>SSS</code> represent the hour, month, second and milliseconds respsectively. <code>'T'</code> and <code>Z</code> are constants.</p> </li> </ul>

            feature_definitions: [str]  # <p>A list of <code>Feature</code> names and types. <code>Name</code> and <code>Type</code> is compulsory per <code>Feature</code>. </p> <p>Valid feature <code>FeatureType</code>s are <code>Integral</code>, <code>Fractional</code> and <code>String</code>.</p> <p> <code>FeatureName</code>s cannot be any of the following: <code>is_deleted</code>, <code>write_time</code>, <code>api_invocation_time</code> </p> <p>You can create up to 2,500 <code>FeatureDefinition</code>s per <code>FeatureGroup</code>.</p>

            record_identifier_feature_name: str  # <p>The name of the <code>Feature</code> whose value uniquely identifies a <code>Record</code> defined in the <code>FeatureStore</code>. Only the latest record per identifier value will be stored in the <code>OnlineStore</code>. <code>RecordIdentifierFeatureName</code> must be one of feature definitions' names.</p> <p>You use the <code>RecordIdentifierFeatureName</code> to access data in a <code>FeatureStore</code>.</p> <p>This name:</p> <ul> <li> <p>Must start with an alphanumeric character.</p> </li> <li> <p>Can only contains alphanumeric characters, hyphens, underscores. Spaces are not allowed. </p> </li> </ul>

            throughput_config: str?  # 



            # Outputs

            last_update_status_output?: str  # <p>A value indicating whether the update made to the feature group was successful.</p>

            online_store_total_size_bytes_output?: int  # <p>The size of the <code>OnlineStore</code> in bytes.</p>

            feature_group_name_output?: str  # <p>he name of the <code>FeatureGroup</code>.</p>

            online_store_config_output?: str  # <p>The configuration for the <code>OnlineStore</code>.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the IAM execution role used to persist data into the OfflineStore if an OfflineStoreConfig is provided.</p>

            throughput_config_output?: str  # 

            feature_definitions_output?: [str]  # <p>A list of the <code>Features</code> in the <code>FeatureGroup</code>. Each feature is defined by a <code>FeatureName</code> and <code>FeatureType</code>.</p>

            last_modified_time_output?: str  # <p>A timestamp indicating when the feature group was last updated.</p>

            failure_reason_output?: str  # <p>The reason that the <code>FeatureGroup</code> failed to be replicated in the <code>OfflineStore</code>. This is failure can occur because:</p> <ul> <li> <p>The <code>FeatureGroup</code> could not be created in the <code>OfflineStore</code>.</p> </li> <li> <p>The <code>FeatureGroup</code> could not be deleted from the <code>OfflineStore</code>.</p> </li> </ul>

            feature_group_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the <code>FeatureGroup</code>. </p>

            description_output?: str  # <p>A free form description of the feature group.</p>

            creation_time_output?: str  # <p>A timestamp indicating when SageMaker created the <code>FeatureGroup</code>.</p>

            next_token_output?: str  # <p>A token to resume pagination of the list of <code>Features</code> (<code>FeatureDefinitions</code>).</p>

            offline_store_config_output?: str  # <p>The configuration of the offline store. It includes the following configurations:</p> <ul> <li> <p>Amazon S3 location of the offline store.</p> </li> <li> <p>Configuration of the Glue data catalog.</p> </li> <li> <p>Table format of the offline store.</p> </li> <li> <p>Option to disable the automatic creation of a Glue table for the offline store.</p> </li> <li> <p>Encryption configuration.</p> </li> </ul>

            offline_store_status_output?: str  # <p>The status of the <code>OfflineStore</code>. Notifies you if replicating data into the <code>OfflineStore</code> has failed. Returns either: <code>Active</code> or <code>Blocked</code> </p>

            record_identifier_feature_name_output?: str  # <p>The name of the <code>Feature</code> used for <code>RecordIdentifier</code>, whose value uniquely identifies a record stored in the feature store.</p>

            feature_group_status_output?: str  # <p>The status of the feature group.</p>

            event_time_feature_name_output?: str  # <p>The name of the feature that stores the <code>EventTime</code> of a Record in a <code>FeatureGroup</code>.</p> <p> An <code>EventTime</code> is a point in time when a new event occurs that corresponds to the creation or update of a <code>Record</code> in a <code>FeatureGroup</code>. All <code>Records</code> in the <code>FeatureGroup</code> have a corresponding <code>EventTime</code>.</p>




        schema Auto_ml_job_v2:
            """
            AutoMLJobV2 resource
            """

            security_config: str?  # <p>The security configuration for traffic encryption or Amazon VPC settings.</p>

            data_split_config: str?  # <p>This structure specifies how to split the data into train and validation datasets.</p> <p>The validation and training datasets must contain the same headers. For jobs created by calling <code>CreateAutoMLJob</code>, the validation dataset must be less than 2 GB in size.</p> <note> <p>This attribute must not be set for the time-series forecasting problem type, as Autopilot automatically splits the input dataset into training and validation sets.</p> </note>

            auto_ml_compute_config: str?  # <p>Specifies the compute configuration for the AutoML job V2.</p>

            tags: [str]?  # <p>An array of key-value pairs. You can use tags to categorize your Amazon Web Services resources in different ways, such as by purpose, owner, or environment. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web ServicesResources</a>. Tag keys must be unique per resource.</p>

            model_deploy_config: str?  # <p>Specifies how to generate the endpoint name for an automatic one-click Autopilot model deployment.</p>

            auto_ml_job_name: str  # <p>Identifies an Autopilot job. The name must be unique to your account and is case insensitive.</p>

            auto_ml_job_objective: str?  # <p>Specifies a metric to minimize or maximize as the objective of a job. If not specified, the default objective metric depends on the problem type. For the list of default values per problem type, see <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_AutoMLJobObjective.html">AutoMLJobObjective</a>.</p> <note> <ul> <li> <p>For tabular problem types: You must either provide both the <code>AutoMLJobObjective</code> and indicate the type of supervised learning problem in <code>AutoMLProblemTypeConfig</code> (<code>TabularJobConfig.ProblemType</code>), or none at all.</p> </li> <li> <p>For text generation problem types (LLMs fine-tuning): Fine-tuning language models in Autopilot does not require setting the <code>AutoMLJobObjective</code> field. Autopilot fine-tunes LLMs without requiring multiple candidates to be trained and evaluated. Instead, using your dataset, Autopilot directly fine-tunes your target model to enhance a default objective metric, the cross-entropy loss. After fine-tuning a language model, you can evaluate the quality of its generated text using different metrics. For a list of the available metrics, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/autopilot-llms-finetuning-metrics.html">Metrics for fine-tuning LLMs in Autopilot</a>.</p> </li> </ul> </note>

            auto_ml_problem_type_config: str  # <p>Defines the configuration settings of one of the supported problem types.</p>

            auto_ml_job_input_data_config: [str]  # <p>An array of channel objects describing the input data and their location. Each channel is a named input source. Similar to the <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_CreateAutoMLJob.html#sagemaker-CreateAutoMLJob-request-InputDataConfig">InputDataConfig</a> attribute in the <code>CreateAutoMLJob</code> input parameters. The supported formats depend on the problem type:</p> <ul> <li> <p>For tabular problem types: <code>S3Prefix</code>, <code>ManifestFile</code>.</p> </li> <li> <p>For image classification: <code>S3Prefix</code>, <code>ManifestFile</code>, <code>AugmentedManifestFile</code>.</p> </li> <li> <p>For text classification: <code>S3Prefix</code>.</p> </li> <li> <p>For time-series forecasting: <code>S3Prefix</code>.</p> </li> <li> <p>For text generation (LLMs fine-tuning): <code>S3Prefix</code>.</p> </li> </ul>

            output_data_config: str  # <p>Provides information about encryption and the Amazon S3 output path needed to store artifacts from an AutoML job.</p>

            role_arn: str  # <p>The ARN of the role that is used to access the data.</p>



            # Outputs

            failure_reason_output?: str  # <p>Returns the reason for the failure of the AutoML job V2, when applicable.</p>

            auto_ml_job_status_output?: str  # <p>Returns the status of the AutoML job V2.</p>

            security_config_output?: str  # <p>Returns the security configuration for traffic encryption or Amazon VPC settings.</p>

            auto_ml_job_secondary_status_output?: str  # <p>Returns the secondary status of the AutoML job V2.</p>

            output_data_config_output?: str  # <p>Returns the job's output data config.</p>

            auto_ml_job_input_data_config_output?: [str]  # <p>Returns an array of channel objects describing the input data and their location.</p>

            partial_failure_reasons_output?: [str]  # <p>Returns a list of reasons for partial failures within an AutoML job V2.</p>

            creation_time_output?: str  # <p>Returns the creation time of the AutoML job V2.</p>

            auto_ml_job_name_output?: str  # <p>Returns the name of the AutoML job V2.</p>

            model_deploy_config_output?: str  # <p>Indicates whether the model was deployed automatically to an endpoint and the name of that endpoint if deployed automatically.</p>

            end_time_output?: str  # <p>Returns the end time of the AutoML job V2.</p>

            last_modified_time_output?: str  # <p>Returns the job's last modified time.</p>

            model_deploy_result_output?: str  # <p>Provides information about endpoint for the model deployment.</p>

            role_arn_output?: str  # <p>The ARN of the IAM role that has read permission to the input data location and write permission to the output data location in Amazon S3.</p>

            auto_ml_job_artifacts_output?: str  # 

            auto_ml_compute_config_output?: str  # <p>The compute configuration used for the AutoML job V2.</p>

            auto_ml_job_objective_output?: str  # <p>Returns the job's objective.</p>

            data_split_config_output?: str  # <p>Returns the configuration settings of how the data are split into train and validation datasets.</p>

            auto_ml_problem_type_config_output?: str  # <p>Returns the configuration settings of the problem type set for the AutoML job V2.</p>

            auto_ml_problem_type_config_name_output?: str  # <p>Returns the name of the problem type configuration set for the AutoML job V2.</p>

            best_candidate_output?: str  # <p>Information about the candidate produced by an AutoML training job V2, including its status, steps, and other properties.</p>

            resolved_attributes_output?: str  # <p>Returns the resolved attributes used by the AutoML job V2.</p>

            auto_ml_job_arn_output?: str  # <p>Returns the Amazon Resource Name (ARN) of the AutoML job V2.</p>




        schema Lineage_group_policy:
            """
            LineageGroupPolicy resource
            """



            # Outputs

            lineage_group_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the lineage group.</p>

            resource_policy_output?: str  # <p>The resource policy that gives access to the lineage group in another account.</p>




        schema Image_version:
            """
            ImageVersion resource
            """

            release_notes: str?  # <p>The maintainer description of the image version.</p>

            client_token: str  # <p>A unique ID. If not specified, the Amazon Web Services CLI and Amazon Web Services SDKs, such as the SDK for Python (Boto3), add a unique value to the call.</p>

            ml_framework: str?  # <p>The machine learning framework vended in the image version.</p>

            vendor_guidance: str?  # <p>The stability of the image version, specified by the maintainer.</p> <ul> <li> <p> <code>NOT_PROVIDED</code>: The maintainers did not provide a status for image version stability.</p> </li> <li> <p> <code>STABLE</code>: The image version is stable.</p> </li> <li> <p> <code>TO_BE_ARCHIVED</code>: The image version is set to be archived. Custom image versions that are set to be archived are automatically archived after three months.</p> </li> <li> <p> <code>ARCHIVED</code>: The image version is archived. Archived image versions are not searchable and are no longer actively supported. </p> </li> </ul>

            base_image: str  # <p>The registry path of the container image to use as the starting point for this version. The path is an Amazon ECR URI in the following format:</p> <p> <code>&lt;acct-id&gt;.dkr.ecr.&lt;region&gt;.amazonaws.com/&lt;repo-name[:tag] or [@digest]&gt;</code> </p>

            job_type: str?  # <p>Indicates SageMaker AI job type compatibility.</p> <ul> <li> <p> <code>TRAINING</code>: The image version is compatible with SageMaker AI training jobs.</p> </li> <li> <p> <code>INFERENCE</code>: The image version is compatible with SageMaker AI inference jobs.</p> </li> <li> <p> <code>NOTEBOOK_KERNEL</code>: The image version is compatible with SageMaker AI notebook kernels.</p> </li> </ul>

            programming_lang: str?  # <p>The supported programming language and its version.</p>

            image_name: str  # <p>The <code>ImageName</code> of the <code>Image</code> to create a version of.</p>

            aliases: [str]?  # <p>A list of aliases created with the image version.</p>

            processor: str?  # <p>Indicates CPU or GPU compatibility.</p> <ul> <li> <p> <code>CPU</code>: The image version is compatible with CPU.</p> </li> <li> <p> <code>GPU</code>: The image version is compatible with GPU.</p> </li> </ul>

            horovod: bool?  # <p>Indicates Horovod compatibility.</p>



            # Outputs

            container_image_output?: str  # <p>The registry path of the container image that contains this image version.</p>

            programming_lang_output?: str  # <p>The supported programming language and its version.</p>

            creation_time_output?: str  # <p>When the version was created.</p>

            image_version_arn_output?: str  # <p>The ARN of the version.</p>

            vendor_guidance_output?: str  # <p>The stability of the image version specified by the maintainer.</p> <ul> <li> <p> <code>NOT_PROVIDED</code>: The maintainers did not provide a status for image version stability.</p> </li> <li> <p> <code>STABLE</code>: The image version is stable.</p> </li> <li> <p> <code>TO_BE_ARCHIVED</code>: The image version is set to be archived. Custom image versions that are set to be archived are automatically archived after three months.</p> </li> <li> <p> <code>ARCHIVED</code>: The image version is archived. Archived image versions are not searchable and are no longer actively supported. </p> </li> </ul>

            processor_output?: str  # <p>Indicates CPU or GPU compatibility.</p> <ul> <li> <p> <code>CPU</code>: The image version is compatible with CPU.</p> </li> <li> <p> <code>GPU</code>: The image version is compatible with GPU.</p> </li> </ul>

            image_arn_output?: str  # <p>The ARN of the image the version is based on.</p>

            failure_reason_output?: str  # <p>When a create or delete operation fails, the reason for the failure.</p>

            job_type_output?: str  # <p>Indicates SageMaker AI job type compatibility.</p> <ul> <li> <p> <code>TRAINING</code>: The image version is compatible with SageMaker AI training jobs.</p> </li> <li> <p> <code>INFERENCE</code>: The image version is compatible with SageMaker AI inference jobs.</p> </li> <li> <p> <code>NOTEBOOK_KERNEL</code>: The image version is compatible with SageMaker AI notebook kernels.</p> </li> </ul>

            ml_framework_output?: str  # <p>The machine learning framework vended in the image version.</p>

            horovod_output?: bool  # <p>Indicates Horovod compatibility.</p>

            last_modified_time_output?: str  # <p>When the version was last modified.</p>

            release_notes_output?: str  # <p>The maintainer description of the image version.</p>

            image_version_status_output?: str  # <p>The status of the version.</p>

            base_image_output?: str  # <p>The registry path of the container image on which this image version is based.</p>

            version_output?: int  # <p>The version number.</p>




        schema Hyper_parameter_tuning_job:
            """
            HyperParameterTuningJob resource
            """

            hyper_parameter_tuning_job_name: str  # <p>The name of the tuning job. This name is the prefix for the names of all training jobs that this tuning job launches. The name must be unique within the same Amazon Web Services account and Amazon Web Services Region. The name must have 1 to 32 characters. Valid characters are a-z, A-Z, 0-9, and : + = @ _ % - (hyphen). The name is not case sensitive.</p>

            hyper_parameter_tuning_job_config: str  # <p>The <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTuningJobConfig.html">HyperParameterTuningJobConfig</a> object that describes the tuning job, including the search strategy, the objective metric used to evaluate training jobs, ranges of parameters to search, and resource limits for the tuning job. For more information, see <a href="https://docs.aws.amazon.com/sagemaker/latest/dg/automatic-model-tuning-how-it-works.html">How Hyperparameter Tuning Works</a>.</p>

            training_job_definition: str?  # <p>The <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTrainingJobDefinition.html">HyperParameterTrainingJobDefinition</a> object that describes the training jobs that this tuning job launches, including static hyperparameters, input data configuration, output data configuration, resource configuration, and stopping condition.</p>

            training_job_definitions: [str]?  # <p>A list of the <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTrainingJobDefinition.html">HyperParameterTrainingJobDefinition</a> objects launched for this tuning job.</p>

            warm_start_config: str?  # <p>Specifies the configuration for starting the hyperparameter tuning job using one or more previous tuning jobs as a starting point. The results of previous tuning jobs are used to inform which combinations of hyperparameters to search over in the new tuning job.</p> <p>All training jobs launched by the new hyperparameter tuning job are evaluated by using the objective metric. If you specify <code>IDENTICAL_DATA_AND_ALGORITHM</code> as the <code>WarmStartType</code> value for the warm start configuration, the training job that performs the best in the new tuning job is compared to the best training jobs from the parent tuning jobs. From these, the training job that performs the best as measured by the objective metric is returned as the overall best training job.</p> <note> <p>All training jobs launched by parent hyperparameter tuning jobs and the new hyperparameter tuning jobs count against the limit of training jobs for the tuning job.</p> </note>

            tags: [str]?  # <p>An array of key-value pairs. You can use tags to categorize your Amazon Web Services resources in different ways, for example, by purpose, owner, or environment. For more information, see <a href="https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html">Tagging Amazon Web Services Resources</a>.</p> <p>Tags that you specify for the tuning job are also added to all training jobs that the tuning job launches.</p>

            autotune: str?  # <p>Configures SageMaker Automatic model tuning (AMT) to automatically find optimal parameters for the following fields:</p> <ul> <li> <p> <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTuningJobConfig.html#sagemaker-Type-HyperParameterTuningJobConfig-ParameterRanges">ParameterRanges</a>: The names and ranges of parameters that a hyperparameter tuning job can optimize.</p> </li> <li> <p> <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_ResourceLimits.html">ResourceLimits</a>: The maximum resources that can be used for a training job. These resources include the maximum number of training jobs, the maximum runtime of a tuning job, and the maximum number of training jobs to run at the same time.</p> </li> <li> <p> <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTuningJobConfig.html#sagemaker-Type-HyperParameterTuningJobConfig-TrainingJobEarlyStoppingType">TrainingJobEarlyStoppingType</a>: A flag that specifies whether or not to use early stopping for training jobs launched by a hyperparameter tuning job.</p> </li> <li> <p> <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTrainingJobDefinition.html#sagemaker-Type-HyperParameterTrainingJobDefinition-RetryStrategy">RetryStrategy</a>: The number of times to retry a training job.</p> </li> <li> <p> <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTuningJobConfig.html">Strategy</a>: Specifies how hyperparameter tuning chooses the combinations of hyperparameter values to use for the training jobs that it launches.</p> </li> <li> <p> <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_ConvergenceDetected.html">ConvergenceDetected</a>: A flag to indicate that Automatic model tuning (AMT) has detected model convergence.</p> </li> </ul>



            # Outputs

            training_job_status_counters_output?: str  # <p>The <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_TrainingJobStatusCounters.html">TrainingJobStatusCounters</a> object that specifies the number of training jobs, categorized by status, that this tuning job launched.</p>

            creation_time_output?: str  # <p>The date and time that the tuning job started.</p>

            autotune_output?: str  # <p>A flag to indicate if autotune is enabled for the hyperparameter tuning job.</p>

            hyper_parameter_tuning_job_status_output?: str  # <p>The status of the tuning job.</p>

            warm_start_config_output?: str  # <p>The configuration for starting the hyperparameter parameter tuning job using one or more previous tuning jobs as a starting point. The results of previous tuning jobs are used to inform which combinations of hyperparameters to search over in the new tuning job.</p>

            hyper_parameter_tuning_end_time_output?: str  # <p>The date and time that the tuning job ended.</p>

            hyper_parameter_tuning_job_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the tuning job.</p>

            consumed_resources_output?: str  # 

            last_modified_time_output?: str  # <p>The date and time that the status of the tuning job was modified. </p>

            training_job_definitions_output?: [str]  # <p>A list of the <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTrainingJobDefinition.html">HyperParameterTrainingJobDefinition</a> objects launched for this tuning job.</p>

            best_training_job_output?: str  # <p>A <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_TrainingJobSummary.html">TrainingJobSummary</a> object that describes the training job that completed with the best current <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTuningJobObjective.html">HyperParameterTuningJobObjective</a>.</p>

            training_job_definition_output?: str  # <p>The <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTrainingJobDefinition.html">HyperParameterTrainingJobDefinition</a> object that specifies the definition of the training jobs that this tuning job launches.</p>

            overall_best_training_job_output?: str  # <p>If the hyperparameter tuning job is an warm start tuning job with a <code>WarmStartType</code> of <code>IDENTICAL_DATA_AND_ALGORITHM</code>, this is the <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_TrainingJobSummary.html">TrainingJobSummary</a> for the training job with the best objective metric value of all training jobs launched by this tuning job and all parent jobs specified for the warm start tuning job.</p>

            tuning_job_completion_details_output?: str  # <p>Tuning job completion information returned as the response from a hyperparameter tuning job. This information tells if your tuning job has or has not converged. It also includes the number of training jobs that have not improved model performance as evaluated against the objective function.</p>

            hyper_parameter_tuning_job_config_output?: str  # <p>The <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_HyperParameterTuningJobConfig.html">HyperParameterTuningJobConfig</a> object that specifies the configuration of the tuning job.</p>

            failure_reason_output?: str  # <p>If the tuning job failed, the reason it failed.</p>

            objective_status_counters_output?: str  # <p>The <a href="https://docs.aws.amazon.com/sagemaker/latest/APIReference/API_ObjectiveStatusCounters.html">ObjectiveStatusCounters</a> object that specifies the number of training jobs, categorized by the status of their final objective metric, that this tuning job launched.</p>

            hyper_parameter_tuning_job_name_output?: str  # <p>The name of the hyperparameter tuning job.</p>




        schema Processing_job:
            """
            ProcessingJob resource
            """

            processing_resources: str  # <p>Identifies the resources, ML compute instances, and ML storage volumes to deploy for a processing job. In distributed training, you specify more than one instance.</p>

            network_config: str?  # <p>Networking options for a processing job, such as whether to allow inbound and outbound network calls to and from processing containers, and the VPC subnets and security groups to use for VPC-enabled processing jobs.</p>

            processing_inputs: [str]?  # <p>An array of inputs configuring the data to download into the processing container.</p>

            processing_output_config: str?  # <p>Output configuration for the processing job.</p>

            environment: {str: str}?  # <p>The environment variables to set in the Docker container. Up to 100 key and values entries in the map are supported.</p> <important> <p>Do not include any security-sensitive information including account access IDs, secrets, or tokens in any environment fields. As part of the shared responsibility model, you are responsible for any potential exposure, unauthorized access, or compromise of your sensitive data if caused by security-sensitive information included in the request environment variable or plain text fields.</p> </important>

            experiment_config: str?  # 

            processing_job_name: str  # <p> The name of the processing job. The name must be unique within an Amazon Web Services Region in the Amazon Web Services account.</p>

            stopping_condition: str?  # <p>The time limit for how long the processing job is allowed to run.</p>

            tags: [str]?  # <p>(Optional) An array of key-value pairs. For more information, see <a href="https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/cost-alloc-tags.html#allocation-whatURL">Using Cost Allocation Tags</a> in the <i>Amazon Web Services Billing and Cost Management User Guide</i>.</p> <important> <p>Do not include any security-sensitive information including account access IDs, secrets, or tokens in any tags. As part of the shared responsibility model, you are responsible for any potential exposure, unauthorized access, or compromise of your sensitive data if caused by security-sensitive information included in the request tag variable or plain text fields.</p> </important>

            app_specification: str  # <p>Configures the processing job to run a specified Docker container image.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of an IAM role that Amazon SageMaker can assume to perform tasks on your behalf.</p>



            # Outputs

            processing_job_status_output?: str  # <p>Provides the status of a processing job.</p>

            processing_inputs_output?: [str]  # <p>The inputs for a processing job.</p>

            processing_start_time_output?: str  # <p>The time at which the processing job started.</p>

            stopping_condition_output?: str  # <p>The time limit for how long the processing job is allowed to run.</p>

            processing_job_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the processing job.</p>

            processing_end_time_output?: str  # <p>The time at which the processing job completed.</p>

            experiment_config_output?: str  # <p>The configuration information used to create an experiment.</p>

            last_modified_time_output?: str  # <p>The time at which the processing job was last modified.</p>

            network_config_output?: str  # <p>Networking options for a processing job.</p>

            creation_time_output?: str  # <p>The time at which the processing job was created.</p>

            processing_resources_output?: str  # <p>Identifies the resources, ML compute instances, and ML storage volumes to deploy for a processing job. In distributed training, you specify more than one instance.</p>

            exit_message_output?: str  # <p>An optional string, up to one KB in size, that contains metadata from the processing container when the processing job exits.</p>

            monitoring_schedule_arn_output?: str  # <p>The ARN of a monitoring schedule for an endpoint associated with this processing job.</p>

            failure_reason_output?: str  # <p>A string, up to one KB in size, that contains the reason a processing job failed, if it failed.</p>

            processing_job_name_output?: str  # <p>The name of the processing job. The name must be unique within an Amazon Web Services Region in the Amazon Web Services account.</p>

            app_specification_output?: str  # <p>Configures the processing job to run a specified container image.</p>

            environment_output?: {str: str}  # <p>The environment variables set in the Docker container.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of an IAM role that Amazon SageMaker can assume to perform tasks on your behalf.</p>

            auto_ml_job_arn_output?: str  # <p>The ARN of an AutoML job associated with this processing job.</p>

            processing_output_config_output?: str  # <p>Output configuration for the processing job.</p>

            training_job_arn_output?: str  # <p>The ARN of a training job associated with this processing job.</p>




