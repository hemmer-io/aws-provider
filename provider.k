         client request token, Lookout for Equipment generates one. </p>

            label_group_name: str  # <p> Names a group of labels.</p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data. </p>

            tags: [str]?  # <p> Tags that provide metadata about the label group you are creating. </p>
         <p>Data in this field will be retained for service usage. Follow best practices for the
         security of your data.</p>



            # Outputs

            updated_at_output?: str  # <p> The time at which the label group was updated. </p>

            created_at_output?: str  # <p> The time at which the label group was created. </p>

            label_group_name_output?: str  # <p> The name of the label group. </p>

            fault_codes_output?: [str]  # <p> Codes indicating the type of anomaly associated with the labels in the lagbel group.
      </p>

            label_group_arn_output?: str  # <p> The Amazon Resource Name (ARN) of the label group. </p>





    # Appsync Service
    schema AppsyncService:
        """
