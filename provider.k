            incremental_run_config: str?  # <p> The incremental run configuration for the ID mapping workflow.</p>

            id_mapping_techniques: str  # <p>An object which defines the ID mapping technique and any additional configurations.</p>

            output_source_config: [str]?  # <p>A list of <code>IdMappingWorkflowOutputSource</code> objects, each of which contains fields <code>outputS3Path</code> and <code>KMSArn</code>.</p>



            # Outputs

