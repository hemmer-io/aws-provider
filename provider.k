            repository_name: str  # <p>The name of the repository to be associated with the repository link.</p>

            tags: [str]?  # <p>The tags for the repository to be associated with the repository link.</p>

            encryption_key_arn: str?  # <p>The Amazon Resource Name (ARN) encryption key for the repository to be associated with the repository link.</p>



