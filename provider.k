            """

            resource_arn: str  # <p>Amazon Resource Name (ARN) of the resource you are converting the license type for.</p>

            source_license_context: str  # <p>Information that identifies the license type you are converting from. 

         For the structure of the source license, see <a href="https://docs.aws.amazon.com/license-manager/latest/userguide/conversion-procedures.html#conversion-cli">Convert a license type using the CLI </a> in the <i>License Manager User Guide</i>.</p>

            destination_license_context: str  # <p>Information that identifies the license type you are converting to. For the structure of the destination license, see <a href="https://docs.aws.amazon.com/license-manager/latest/userguide/conversion-procedures.html#conversion-cli">Convert a license type using the CLI </a> in the <i>License Manager User Guide</i>.</p>




        schema License_usage:
            """
            LicenseUsage resource
            """



            # Outputs

            license_usage_output?: str  # <p>License usage details.</p>




        schema Token:
            """
            Token resource
            """

            token_properties: [str]?  # <p>Data specified by the caller to be included in the JWT token. The data is mapped
          to the amr claim of the JWT token.</p>

            role_arns: [str]?  # <p>Amazon Resource Name (ARN) of the IAM roles to embed in the token. 
         License Manager does not check whether the roles are in use.</p>

            client_token: str  # <p>Idempotency token, valid for 10 minutes.</p>

            license_arn: str  # <p>Amazon Resource Name (ARN) of the license. The ARN is mapped to the aud claim of the
          JWT token.</p>

            expiration_in_days: int?  # <p>Token expiration, in days, counted from token creation. The default is 365 days.</p>




