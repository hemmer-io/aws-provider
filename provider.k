            # Outputs

            readiness_check_arn_output?: str  # <p>The Amazon Resource Name (ARN) associated with a readiness check.</p>

            tags_output?: {str: str}  # 

            readiness_check_name_output?: str  # <p>Name of a readiness check.</p>

            resource_set_output?: str  # <p>Name of the resource set to be checked.</p>




        schema Recovery_group:
