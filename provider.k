            certificate_domain_name: str  # <p>The domain name (<code>example.com</code>) for your SSL/TLS certificate.</p>

            certificate_name: str  # <p>The SSL/TLS certificate name.</p>
         <p>You can have up to 10 certificates in your account at one time. Each Lightsail load
