        schema Plan_execution:
            """
            PlanExecution resource
            """

            execution_id: str  # <p>The execution identifier of a plan execution.</p>

            comment: str?  # <p>An optional comment about the plan execution.</p>

            action: str  # <p>The action specified for a plan execution, for example, Switch to Graceful or Pause.</p>

            plan_arn: str  # <p>The Amazon Resource Name (ARN) of the plan with the execution to update.</p>



            # Outputs

            plan_output?: str  # <p>The details of the Region switch plan.</p>

            updated_at_output?: str  # <p>The timestamp when the plan execution was last updated.</p>

            mode_output?: str  # <p>The plan execution mode. Valid values are <code>Practice</code>, for testing without making actual changes, or <code>Recovery</code>, for actual traffic shifting and application recovery.</p>

            start_time_output?: str  # <p>The time (UTC) when the plan execution started.</p>

            next_token_output?: str  # <p>Specifies that you want to receive the next page of results. Valid only if you received a <code>nextToken</code> response in the previous request. If you did, it indicates that more output is available. Set this parameter to the value provided by the previous call's <code>nextToken</code> response to request the next page of results.</p>

            plan_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the plan.</p>

            comment_output?: str  # <p>A comment included on the plan execution.</p>

            execution_id_output?: str  # <p>The execution identifier of a plan execution.</p>

            version_output?: str  # <p>The version for the plan.</p>

            actual_recovery_time_output?: str  # <p>The actual recovery time that Region switch calculates for a plan execution. Actual recovery time includes the time for the plan to run added to the time elapsed until the application health alarms that you've specified are healthy again.</p>

            execution_state_output?: str  # <p>The plan execution state. Provides the state of a plan execution, for example, In Progress or Paused by Operator.</p>

            step_states_output?: [str]  # <p>The states of the steps in the plan execution.</p>

            end_time_output?: str  # <p>The time (UTC) when the plan execution ended.</p>

            execution_action_output?: str  # <p>The plan execution action. Valid values are <code>Activate</code>, to activate an Amazon Web Services Region, or <code>Deactivate</code>, to deactivate a Region.</p>

            execution_region_output?: str  # <p>The Amazon Web Services Region for a plan execution.</p>




        schema Plan_evaluation_status:
            """
            PlanEvaluationStatus resource
            """



