            domain: str?  # <p>The domain of the dataset group. Specify a domain to create a
      Domain dataset group. The domain you specify determines the default
      schemas for datasets and the use cases available for recommenders. If you
      don't specify a domain, you create a Custom dataset group with solution
      versions that you deploy with a campaign. </p>

            role_arn: str?  # <p>The ARN of the Identity and Access Management (IAM) role that has permissions to access
      the Key Management Service (KMS) key. Supplying an IAM role is only valid when also
      specifying a KMS key.</p>

            name: str  # <p>The name for the new dataset group.</p>

            tags: [str]?  # <p>A list of <a href="https://docs.aws.amazon.com/personalize/latest/dg/tagging-resources.html">tags</a> to apply to the dataset group.</p>



            # Outputs

