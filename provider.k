            """
            Reservation resource
            """

            name: str?  # Name of the reservation

            reservation_id: str  # Unique reservation ID, e.g. '1234567'

            renewal_settings: str?  # Renewal settings for the reservation



            # Outputs

            duration_output?: int  # Lease duration, e.g. '12'

            resource_specification_output?: str  # Resource configuration details

            tags_output?: {str: str}  # A collection of key-value pairs

            arn_output?: str  # Unique reservation ARN, e.g. 'arn:aws:medialive:us-west-2:123456789012:reservation:1234567'

            count_output?: int  # Number of reserved resources

            duration_units_output?: str  # Units for duration, e.g. 'MONTHS'

            fixed_price_output?: float  # One-time charge for each reserved resource, e.g. '0.0' for a NO_UPFRONT offering

            state_output?: str  # Current state of reservation, e.g. 'ACTIVE'

            reservation_id_output?: str  # Unique reservation ID, e.g. '1234567'

            usage_price_output?: float  # Recurring usage charge for each reserved resource, e.g. '157.0'

            offering_type_output?: str  # Offering type, e.g. 'NO_UPFRONT'

            offering_id_output?: str  # Unique offering ID, e.g. '87654321'

            offering_description_output?: str  # Offering description, e.g. 'HD AVC output at 10-20 Mbps, 30 fps, and standard VQ in US West (Oregon)'

            start_output?: str  # Reservation UTC start date and time in ISO-8601 format, e.g. '2018-03-01T00:00:00'

            renewal_settings_output?: str  # Renewal settings for the reservation

            currency_code_output?: str  # Currency code for usagePrice and fixedPrice in ISO-4217 format, e.g. 'USD'

            region_output?: str  # AWS region, e.g. 'us-west-2'

            name_output?: str  # User specified reservation name

            end_output?: str  # Reservation UTC end date and time in ISO-8601 format, e.g. '2019-03-01T00:00:00'




        schema Channel:
