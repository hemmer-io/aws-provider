            managed_instance: str  # <p>Comprehensive configuration settings for the WorkSpaces Instance, including network, compute, and storage parameters.</p>



            # Outputs

            workspace_instance_id_output?: str  # <p>Unique identifier of the retrieved WorkSpaces Instance.</p>

            provision_state_output?: str  # <p>Current provisioning state of the WorkSpaces Instance.</p>

            ec2_instance_errors_output?: [str]  # <p>Includes any underlying EC2 instance errors encountered.</p>

            workspace_instance_errors_output?: [str]  # <p>Captures any errors specific to the WorkSpace Instance lifecycle.</p>

            ec2_managed_instance_output?: str  # <p>Details of the associated EC2 managed instance.</p>





