            extension_version_number_output?: int  # <p>The version number for the extension defined in the association.</p>

            arn_output?: str  # <p>The system-generated Amazon Resource Name (ARN) for the extension.</p>

            extension_arn_output?: str  # <p>The ARN of the extension defined in the association.</p>

            resource_arn_output?: str  # <p>The ARNs of applications, configuration profiles, or environments defined in the
         association.</p>

            id_output?: str  # <p>The system-generated ID for the association.</p>

            parameters_output?: {str: str}  # <p>The parameter names and values defined in the association.</p>




        schema Deployment:
            """
            Deployment resource
            """



            # Outputs

            configuration_version_output?: str  # <p>The configuration version that was deployed.</p>

            deployment_duration_in_minutes_output?: int  # <p>Total amount of time the deployment lasted.</p>

            started_at_output?: str  # <p>The time the deployment started.</p>

            state_output?: str  # <p>The state of the deployment.</p>

            percentage_complete_output?: str  # <p>The percentage of targets for which the deployment is available.</p>

            application_id_output?: str  # <p>The ID of the application that was deployed.</p>

            description_output?: str  # <p>The description of the deployment.</p>

            configuration_name_output?: str  # <p>The name of the configuration.</p>

            completed_at_output?: str  # <p>The time the deployment completed. </p>

            kms_key_identifier_output?: str  # <p>The Key Management Service key identifier (key ID, key alias, or key ARN) provided when
         the resource was created or updated.</p>

            growth_factor_output?: str  # <p>The percentage of targets to receive a deployed configuration during each
         interval.</p>

            configuration_profile_id_output?: str  # <p>The ID of the configuration profile that was deployed.</p>

            growth_type_output?: str  # <p>The algorithm used to define how percentage grew over time.</p>

            final_bake_time_in_minutes_output?: int  # <p>The amount of time that AppConfig monitored for alarms before considering the
         deployment to be complete and no longer eligible for automatic rollback.</p>

            environment_id_output?: str  # <p>The ID of the environment that was deployed.</p>

            event_log_output?: [str]  # <p>A list containing all events related to a deployment. The most recent events are
         displayed first.</p>

            configuration_location_uri_output?: str  # <p>Information about the source location of the configuration.</p>

            deployment_strategy_id_output?: str  # <p>The ID of the deployment strategy that was deployed.</p>

            kms_key_arn_output?: str  # <p>The Amazon Resource Name of the Key Management Service key used to encrypt configuration
         data. You can encrypt secrets stored in Secrets Manager, Amazon Simple Storage Service
         (Amazon S3) objects encrypted with SSE-KMS, or secure string parameters stored in Amazon Web Services Systems Manager
         Parameter Store. </p>

            version_label_output?: str  # <p>A user-defined label for an AppConfig hosted configuration version.</p>

            deployment_number_output?: int  # <p>The sequence number of the deployment.</p>

            applied_extensions_output?: [str]  # <p>A list of extensions that were processed as part of the deployment. The extensions that
         were previously associated to the configuration profile, environment, or the application
         when <code>StartDeployment</code> was called.</p>




        schema Deployment_strategy:
            """
            DeploymentStrategy resource
            """

            growth_factor: str  # <p>The percentage of targets to receive a deployed configuration during each
         interval.</p>

            description: str?  # <p>A description of the deployment strategy.</p>

            final_bake_time_in_minutes: int?  # <p>Specifies the amount of time AppConfig monitors for Amazon CloudWatch alarms after the
         configuration has been deployed to 100% of its targets, before considering the deployment
         to be complete. If an alarm is triggered during this time, AppConfig rolls back
         the deployment. You must configure permissions for AppConfig to roll back based
         on CloudWatch alarms. For more information, see <a href="https://docs.aws.amazon.com/appconfig/latest/userguide/getting-started-with-appconfig-cloudwatch-alarms-permissions.html">Configuring permissions for rollback based on Amazon CloudWatch alarms</a> in the
            <i>AppConfig User Guide</i>.</p>

            replicate_to: str?  # <p>Save the deployment strategy to a Systems Manager (SSM) document.</p>

            tags: {str: str}?  # <p>Metadata to assign to the deployment strategy. Tags help organize and categorize your
            AppConfig resources. Each tag consists of a key and an optional value, both of
         which you define.</p>

            deployment_duration_in_minutes: int  # <p>Total amount of time for a deployment to last.</p>

            name: str  # <p>A name for the deployment strategy.</p>

            growth_type: str?  # <p>The algorithm used to define how percentage grows over time. AppConfig
         supports the following growth types:</p>
         <p>
            <b>Linear</b>: For this type, AppConfig processes
         the deployment by dividing the total number of targets by the value specified for
            <code>Step percentage</code>. For example, a linear deployment that uses a <code>Step
            percentage</code> of 10 deploys the configuration to 10 percent of the hosts. After
         those deployments are complete, the system deploys the configuration to the next 10
         percent. This continues until 100% of the targets have successfully received the
         configuration.</p>
         <p>
            <b>Exponential</b>: For this type, AppConfig
         processes the deployment exponentially using the following formula: <code>G*(2^N)</code>.
         In this formula, <code>G</code> is the growth factor specified by the user and
            <code>N</code> is the number of steps until the configuration is deployed to all
         targets. For example, if you specify a growth factor of 2, then the system rolls out the
         configuration as follows:</p>
         <p>
            <code>2*(2^0)</code>
         </p>
         <p>
            <code>2*(2^1)</code>
         </p>
         <p>
            <code>2*(2^2)</code>
         </p>
         <p>Expressed numerically, the deployment rolls out as follows: 2% of the targets, 4% of the
         targets, 8% of the targets, and continues until the configuration has been deployed to all
         targets.</p>



            # Outputs

            growth_type_output?: str  # <p>The algorithm used to define how percentage grew over time.</p>

            replicate_to_output?: str  # <p>Save the deployment strategy to a Systems Manager (SSM) document.</p>

            deployment_duration_in_minutes_output?: int  # <p>Total amount of time the deployment lasted.</p>

            name_output?: str  # <p>The name of the deployment strategy.</p>

            growth_factor_output?: str  # <p>The percentage of targets that received a deployed configuration during each
         interval.</p>

            final_bake_time_in_minutes_output?: int  # <p>The amount of time that AppConfig monitored for alarms before considering the
         deployment to be complete and no longer eligible for automatic rollback.</p>

            description_output?: str  # <p>The description of the deployment strategy.</p>

            id_output?: str  # <p>The deployment strategy ID.</p>




        schema Account_settings:
            """
            AccountSettings resource
            """

            deletion_protection: str?  # <p>A parameter to configure deletion protection. Deletion protection prevents a user from
         deleting a configuration profile or an environment if AppConfig has called either
            <a href="https://docs.aws.amazon.com/appconfig/2019-10-09/APIReference/API_appconfigdata_GetLatestConfiguration.html">GetLatestConfiguration</a> or  for the
         configuration profile or from the environment during the specified interval. The default
         interval for <code>ProtectionPeriodInMinutes</code> is 60.</p>



            # Outputs

            deletion_protection_output?: str  # <p>A parameter to configure deletion protection. Deletion protection prevents a user from
         deleting a configuration profile or an environment if AppConfig has called either
            <a href="https://docs.aws.amazon.com/appconfig/2019-10-09/APIReference/API_appconfigdata_GetLatestConfiguration.html">GetLatestConfiguration</a> or  for the
         configuration profile or from the environment during the specified interval. The default
         interval for <code>ProtectionPeriodInMinutes</code> is 60.</p>





