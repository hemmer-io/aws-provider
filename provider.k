    # Finspace_data Service
    schema Finspace_dataService:
        """
        Service for finspace_data resources.
        """


        schema External_data_view_access_details:
            """
            ExternalDataViewAccessDetails resource
            """



            # Outputs

            credentials_output?: str  # <p>The credentials required to access the external Dataview from the S3 location.</p>

            s3_location_output?: str  # <p>The location where the external Dataview is stored.</p>




        schema Permission_group:
            """
            PermissionGroup resource
            """

            name: str  # <p>The name of the permission group.</p>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            description: str?  # <p>A brief description for the permission group.</p>

            application_permissions: [str]  # <p>The option to indicate FinSpace application permissions that are granted to a specific group.</p>
         <important>
            <p>When assigning application permissions, be aware that the permission <code>ManageUsersAndGroups</code> allows users to grant themselves or others access to any functionality in their FinSpace environment's application. It should only be granted to trusted users.</p>
         </important>
         <ul>
            <li>
               <p>
                  <code>CreateDataset</code> – Group members can create new datasets.</p>
            </li>
            <li>
               <p>
                  <code>ManageClusters</code> – Group members can manage Apache Spark clusters from FinSpace notebooks.</p>
            </li>
            <li>
               <p>
                  <code>ManageUsersAndGroups</code> – Group members can manage users and permission groups. This is a privileged permission that allows users to grant themselves or others access to any functionality in the application. It should only be granted to trusted users.</p>
            </li>
            <li>
               <p>
                  <code>ManageAttributeSets</code> – Group members can manage attribute sets.</p>
            </li>
            <li>
               <p>
                  <code>ViewAuditData</code> – Group members can view audit data.</p>
            </li>
            <li>
               <p>
                  <code>AccessNotebooks</code> – Group members will have access to FinSpace notebooks.</p>
            </li>
            <li>
               <p>
                  <code>GetTemporaryCredentials</code> – Group members can get temporary API credentials.</p>
            </li>
         </ul>



            # Outputs

            permission_group_output?: str  # 




        schema Programmatic_access_credentials:
            """
            ProgrammaticAccessCredentials resource
            """



            # Outputs

            credentials_output?: str  # <p>Returns the programmatic credentials.</p>

            duration_in_minutes_output?: int  # <p>Returns the duration in which the credentials will remain valid.</p>




        schema Changeset:
            """
            Changeset resource
            """

            source_params: {str: str}  # <p>Options that define the location of the data being ingested (<code>s3SourcePath</code>) and the source of the changeset (<code>sourceType</code>).</p>
         <p>Both <code>s3SourcePath</code> and <code>sourceType</code> are required attributes.</p>
         <p>Here is an example of how you could specify the <code>sourceParams</code>:</p>
         <p>
            <code>
        "sourceParams": 
        {
        "s3SourcePath": "s3://finspace-landing-us-east-2-bk7gcfvitndqa6ebnvys4d/scratch/wr5hh8pwkpqqkxa4sxrmcw/ingestion/equity.csv",
        "sourceType": "S3"
        }
      </code>
         </p>
         <p>The S3 path that you specify must allow the FinSpace role access. To do that, you first need to configure the IAM policy on S3 bucket. For more information, see <a href="https://docs.aws.amazon.com/finspace/latest/data-api/fs-using-the-finspace-api.html#access-s3-buckets">Loading data from an Amazon S3 Bucket using the FinSpace API</a> section.</p>

            dataset_id: str  # <p>The unique identifier for the FinSpace Dataset where the Changeset will be created.
    </p>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            change_type: str  # <p>The option to indicate how a Changeset will be applied to a Dataset.</p>
         <ul>
            <li>
               <p>
                  <code>REPLACE</code> – Changeset will be considered as a replacement to all prior
          loaded Changesets.</p>
            </li>
            <li>
               <p>
                  <code>APPEND</code> – Changeset will be considered as an addition to the end of all
          prior loaded Changesets.</p>
            </li>
            <li>
               <p>
                  <code>MODIFY</code> – Changeset is considered as a replacement to a specific prior ingested Changeset.</p>
            </li>
         </ul>

            format_params: {str: str}  # <p>Options that define the structure of the source file(s) including the format type (<code>formatType</code>), header row (<code>withHeader</code>), data separation character (<code>separator</code>) and the type of compression (<code>compression</code>).
    </p>
         <p>
            <code>formatType</code> is a required attribute and can have the following values:
    </p>
         <ul>
            <li>
               <p>
                  <code>PARQUET</code> – Parquet source file format.</p>
            </li>
            <li>
               <p>
                  <code>CSV</code> – CSV source file format.</p>
            </li>
            <li>
               <p>
                  <code>JSON</code> – JSON source file format.</p>
            </li>
            <li>
               <p>
                  <code>XML</code> – XML source file format.</p>
            </li>
         </ul>
         <p>Here is an example of how you could specify the <code>formatParams</code>:</p>
         <p>
            <code>
          "formatParams": 
        {
         "formatType": "CSV",
         "withHeader": "true",
         "separator": ",",
         "compression":"None"
         } 
      </code>
         </p>
         <p>Note that if you only provide <code>formatType</code> as <code>CSV</code>, the rest of the attributes will automatically default to CSV values as following:</p>
         <p>
            <code>
          {
          "withHeader": "true",
          "separator": ","
           }
        </code>
         </p>
         <p> For more information about supported file formats, see <a href="https://docs.aws.amazon.com/finspace/latest/userguide/supported-data-types.html">Supported Data Types and File Formats</a> in the FinSpace User Guide.</p>



            # Outputs

            dataset_id_output?: str  # <p>The unique identifier for the FinSpace Dataset where the Changeset is created.</p>

            changeset_arn_output?: str  # <p>The ARN identifier of the Changeset.</p>

            changeset_id_output?: str  # <p>The unique identifier for a Changeset.</p>

            format_params_output?: {str: str}  # <p>Structure of the source file(s).</p>

            updates_changeset_id_output?: str  # <p>The unique identifier of the Changeset that is being updated.</p>

            active_from_timestamp_output?: str  # <p>Beginning time from which the Changeset is active. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            create_time_output?: str  # <p>The timestamp at which the Changeset was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            status_output?: str  # <p>The status of Changeset creation operation.</p>

            updated_by_changeset_id_output?: str  # <p>The unique identifier of the updated Changeset.</p>

            change_type_output?: str  # <p>Type that indicates how a Changeset is applied to a Dataset.</p>
         <ul>
            <li>
               <p>
                  <code>REPLACE</code> – Changeset is considered as a replacement to all prior loaded Changesets.</p>
            </li>
            <li>
               <p>
                  <code>APPEND</code> – Changeset is considered as an addition to the end of all prior loaded Changesets.</p>
            </li>
            <li>
               <p>
                  <code>MODIFY</code> – Changeset is considered as a replacement to a specific prior ingested Changeset.</p>
            </li>
         </ul>

            error_info_output?: str  # <p>The structure with error messages.</p>

            source_params_output?: {str: str}  # <p>Options that define the location of the data being ingested.</p>

            active_until_timestamp_output?: str  # <p>Time until which the Changeset is active. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>




        schema Dataset:
            """
            Dataset resource
            """

            permission_group_params: str  # <p>Permission group parameters for Dataset permissions.</p>

            owner_info: str?  # <p>Contact information for a Dataset owner.</p>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            dataset_title: str  # <p>Display title for a FinSpace Dataset.</p>

            dataset_description: str?  # <p>Description of a Dataset.</p>

            alias: str?  # <p>The unique resource identifier for a Dataset.</p>

            kind: str  # <p>The format in which Dataset data is structured.</p>
         <ul>
            <li>
               <p>
                  <code>TABULAR</code> – Data is structured in a tabular format.</p>
            </li>
            <li>
               <p>
                  <code>NON_TABULAR</code> – Data is structured in a non-tabular format.</p>
            </li>
         </ul>

            schema_definition: str?  # <p>Definition for a schema on a tabular Dataset.</p>



            # Outputs

            schema_definition_output?: str  # <p>Definition for a schema on a tabular Dataset.</p>

            alias_output?: str  # <p>The unique resource identifier for a Dataset.</p>

            status_output?: str  # <p>Status of the Dataset creation.</p>
         <ul>
            <li>
               <p>
                  <code>PENDING</code> – Dataset is pending creation.</p>
            </li>
            <li>
               <p>
                  <code>FAILED</code> – Dataset creation has failed.</p>
            </li>
            <li>
               <p>
                  <code>SUCCESS</code> – Dataset creation has succeeded.</p>
            </li>
            <li>
               <p>
                  <code>RUNNING</code> – Dataset creation is running.</p>
            </li>
         </ul>

            dataset_arn_output?: str  # <p>The ARN identifier of the Dataset.</p>

            kind_output?: str  # <p>The format in which Dataset data is structured.</p>
         <ul>
            <li>
               <p>
                  <code>TABULAR</code> – Data is structured in a tabular format.</p>
            </li>
            <li>
               <p>
                  <code>NON_TABULAR</code> – Data is structured in a non-tabular format.</p>
            </li>
         </ul>

            dataset_id_output?: str  # <p>The unique identifier for a Dataset.</p>

            dataset_title_output?: str  # <p>Display title for a Dataset.</p>

            dataset_description_output?: str  # <p>A description of the Dataset.</p>

            create_time_output?: str  # <p>The timestamp at which the Dataset was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            last_modified_time_output?: str  # <p>The last time that the Dataset was modified. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>




        schema User:
            """
            User resource
            """

            email_address: str  # <p>The email address of the user that you want to register. The email address serves as a uniquer identifier for each user and cannot be changed after it's created.</p>

            first_name: str?  # <p>The first name of the user that you want to register.</p>

            last_name: str?  # <p>The last name of the user that you want to register.</p>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            type: str  # <p>The option to indicate the type of user. Use one of the following options to specify this parameter:</p>
         <ul>
            <li>
               <p>
                  <code>SUPER_USER</code> – A user with permission to all the functionality and data in FinSpace.</p>
            </li>
            <li>
               <p>
                  <code>APP_USER</code> – A user with specific permissions in FinSpace. The users are assigned permissions by adding them to a permission group.</p>
            </li>
         </ul>

            api_access: str?  # <p>The option to indicate whether the user can use the <code>GetProgrammaticAccessCredentials</code> API to obtain credentials that can then be used to access other FinSpace Data API operations.</p>
         <ul>
            <li>
               <p>
                  <code>ENABLED</code> – The user has permissions to use the APIs.</p>
            </li>
            <li>
               <p>
                  <code>DISABLED</code> – The user does not have permissions to use any APIs.</p>
            </li>
         </ul>

            api_access_principal_arn: str?  # <p>The ARN identifier of an AWS user or role that is allowed to call the <code>GetProgrammaticAccessCredentials</code> API to obtain a credentials token for a specific FinSpace user. This must be an IAM role within your FinSpace account.</p>



            # Outputs

            last_modified_time_output?: str  # <p>Describes the last time the user details were updated. The value is determined as epoch time in milliseconds.</p>

            email_address_output?: str  # <p>The email address that is associated with the user.</p>

            last_disabled_time_output?: str  # <p>Describes the last time the user was deactivated. The value is determined as epoch time in milliseconds.</p>

            type_output?: str  # <p>Indicates the type of user.  </p>
         <ul>
            <li>
               <p>
                  <code>SUPER_USER</code> – A user with permission to all the functionality and data in FinSpace.</p>
            </li>
         </ul>
         <ul>
            <li>
               <p>
                  <code>APP_USER</code> – A user with specific permissions in FinSpace. The users are assigned permissions by adding them to a permission group.</p>
            </li>
         </ul>

            api_access_principal_arn_output?: str  # <p>The ARN identifier of an AWS user or role that is allowed to call the <code>GetProgrammaticAccessCredentials</code> API to obtain a credentials token for a specific FinSpace user. This must be an IAM role within your FinSpace account.</p>

            first_name_output?: str  # <p>The first name of the user.</p>

            last_enabled_time_output?: str  # <p>Describes the last time the user was activated. The value is determined as epoch time in milliseconds.</p>

            last_login_time_output?: str  # <p>Describes the last time that the user logged into their account. The value is determined as epoch time in milliseconds.</p>

            status_output?: str  # <p>The current status of the user. </p>
         <ul>
            <li>
               <p>
                  <code>CREATING</code> – The creation is in progress.</p>
            </li>
            <li>
               <p>
                  <code>ENABLED</code> – The user is created and is currently active.</p>
            </li>
            <li>
               <p>
                  <code>DISABLED</code> – The user is currently inactive.</p>
            </li>
         </ul>

            create_time_output?: str  # <p>The timestamp at which the user was created in FinSpace. The value is determined as epoch time in milliseconds. </p>

            api_access_output?: str  # <p>Indicates whether the user can use the <code>GetProgrammaticAccessCredentials</code> API to obtain credentials that can then be used to access other FinSpace Data API operations. </p>
         <ul>
            <li>
               <p>
                  <code>ENABLED</code> – The user has permissions to use the APIs.</p>
            </li>
            <li>
               <p>
                  <code>DISABLED</code> – The user does not have permissions to use any APIs.</p>
            </li>
         </ul>

            last_name_output?: str  # <p>The last name of the user.</p>

            user_id_output?: str  # <p>The unique identifier for the user that is retrieved.</p>




        schema Data_view:
            """
            DataView resource
            """

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            partition_columns: [str]?  # <p>Ordered set of column names used to partition data.</p>

            destination_type_params: str  # <p>Options that define the destination type for the Dataview.</p>

            as_of_timestamp: str?  # <p>Beginning time to use for the Dataview. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            dataset_id: str  # <p>The unique Dataset identifier that is used to create a Dataview.</p>

            auto_update: bool?  # <p>Flag to indicate Dataview should be updated automatically.</p>

            sort_columns: [str]?  # <p>Columns to be used for sorting the data.</p>



            # Outputs

            dataset_id_output?: str  # <p>The unique identifier for the Dataset used in the Dataview.</p>

            destination_type_params_output?: str  # <p>Options that define the destination type for the Dataview.</p>

            auto_update_output?: bool  # <p>Flag to indicate Dataview should be updated automatically.</p>

            status_output?: str  # <p>The status of a Dataview creation.</p>
         <ul>
            <li>
               <p>
                  <code>RUNNING</code> – Dataview creation is running.</p>
            </li>
            <li>
               <p>
                  <code>STARTING</code> – Dataview creation is starting.</p>
            </li>
            <li>
               <p>
                  <code>FAILED</code> – Dataview creation has failed.</p>
            </li>
            <li>
               <p>
                  <code>CANCELLED</code> – Dataview creation has been cancelled.</p>
            </li>
            <li>
               <p>
                  <code>TIMEOUT</code> – Dataview creation has timed out.</p>
            </li>
            <li>
               <p>
                  <code>SUCCESS</code> – Dataview creation has succeeded.</p>
            </li>
            <li>
               <p>
                  <code>PENDING</code> – Dataview creation is pending.</p>
            </li>
            <li>
               <p>
                  <code>FAILED_CLEANUP_FAILED</code> – Dataview creation failed and resource cleanup failed.</p>
            </li>
         </ul>

            create_time_output?: str  # <p>The timestamp at which the Dataview was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            sort_columns_output?: [str]  # <p>Columns to be used for sorting the data.</p>

            partition_columns_output?: [str]  # <p>Ordered set of column names used to partition data.</p>

            error_info_output?: str  # <p>Information about an error that occurred for the Dataview.</p>

            data_view_id_output?: str  # <p>The unique identifier for the Dataview.</p>

            as_of_timestamp_output?: str  # <p>Time range to use for the Dataview. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            last_modified_time_output?: str  # <p>The last time that a Dataview was modified. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            data_view_arn_output?: str  # <p>The ARN identifier of the Dataview.</p>




