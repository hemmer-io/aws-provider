            asset_composite_model_summaries_output?: [str]  # <p>The list of composite model summaries.</p>

            asset_composite_model_id_output?: str  # <p>The ID of a composite model on this asset.</p>

            asset_composite_model_description_output?: str  # <p>A description for the composite model.</p>

            asset_composite_model_external_id_output?: str  # <p>An external ID to assign to the asset model.</p>
         <p>If the composite model is a component-based composite model, or one nested inside a
      component model, you can only set the external ID using
        <code>UpdateAssetModelCompositeModel</code> and specifying the derived ID of the model or
      property from the created model it's a part of.</p>

            asset_composite_model_properties_output?: [str]  # <p>The property definitions of the composite model that was used to create the asset.</p>

            asset_composite_model_path_output?: [str]  # <p>The path to the composite model listing the parent composite models.</p>

            asset_id_output?: str  # <p>The ID of the asset, in UUID format. This ID uniquely identifies the asset within IoT SiteWise and can be used with other
      IoT SiteWise APIs.</p>

            asset_composite_model_type_output?: str  # <p>The composite model type. Valid values are <code>AWS/ALARM</code>, <code>CUSTOM</code>, or
        <code> AWS/L4E_ANOMALY</code>.</p>

            action_definitions_output?: [str]  # <p>The available actions for a composite model on this asset.</p>




        schema Access_policy:
            """
            AccessPolicy resource
