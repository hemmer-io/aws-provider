            provider_type_output?: str  # <p>The provider type of the requested host, such as GitHub Enterprise Server.</p>

            name_output?: str  # <p>The name of the requested host.</p>

            status_output?: str  # <p>The status of the requested host.</p>

            provider_endpoint_output?: str  # <p>The endpoint of the infrastructure represented by the requested host.</p>

            vpc_configuration_output?: str  # <p>The VPC configuration of the requested host.</p>




        schema Sync_configuration:
            """
            SyncConfiguration resource
            """

            trigger_resource_update_on: str?  # <p>When to trigger Git sync to begin the stack update.</p>

            repository_link_id: str  # <p>The ID of the repository link created for the connection. A repository link allows Git
      sync to monitor and sync changes to files in a specified Git repository.</p>

            resource_name: str  # <p>The name of the Amazon Web Services resource (for example, a CloudFormation stack in the
      case of CFN_STACK_SYNC) that will be synchronized from the linked repository.</p>

            config_file: str  # <p>The file name of the configuration file that manages syncing between the connection and the repository. This configuration file is stored in the repository.</p>

            pull_request_comment: str?  # <p>A toggle that specifies whether to enable or disable pull request comments for the sync configuration to be created.</p>

            branch: str  # <p>The branch in the repository from which changes will be synced.</p>

            sync_type: str  # <p>The type of sync configuration.</p>

            publish_deployment_status: str?  # <p>Whether to enable or disable publishing of deployment status to source providers.</p>

            role_arn: str  # <p>The ARN of the IAM role that grants permission for Amazon Web Services to use Git sync to
      update a given Amazon Web Services resource on your behalf.</p>



            # Outputs

            sync_configuration_output?: str  # <p>The details about the sync configuration for which you want to retrieve information.</p>




