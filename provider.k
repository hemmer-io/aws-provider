            model_quality_baseline_config: str?  # <p>Specifies the constraints and baselines for the monitoring job.</p>

            stopping_condition: str?  # 

            model_quality_job_input: str  # <p>A list of the inputs that are monitored. Currently endpoints are supported.</p>

            tags: [str]?  # <p>(Optional) An array of key-value pairs. For more information, see <a href="https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/cost-alloc-tags.html#allocation-whatURL"> Using Cost Allocation Tags</a> in the <i>Amazon Web Services Billing and Cost Management User Guide</i>.</p>

            network_config: str?  # <p>Specifies the network configuration for the monitoring job.</p>

            role_arn: str  # <p>The Amazon Resource Name (ARN) of an IAM role that Amazon SageMaker AI can assume to perform tasks on your behalf.</p>

            job_definition_name: str  # <p>The name of the monitoring job definition.</p>

            job_resources: str  # 



            # Outputs

            creation_time_output?: str  # <p>The time at which the model quality job was created.</p>

            model_quality_job_input_output?: str  # <p>Inputs for the model quality job.</p>

            model_quality_job_output_config_output?: str  # 

            network_config_output?: str  # <p>Networking options for a model quality job.</p>

            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of an IAM role that Amazon SageMaker AI can assume to perform tasks on your behalf.</p>

            stopping_condition_output?: str  # 

            model_quality_baseline_config_output?: str  # <p>The baseline configuration for a model quality job.</p>

            job_resources_output?: str  # 

            job_definition_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the model quality job.</p>

            model_quality_app_specification_output?: str  # <p>Configures the model quality job to run a specified Docker container image.</p>

            job_definition_name_output?: str  # <p>The name of the quality job definition. The name must be unique within an Amazon Web Services Region in the Amazon Web Services account.</p>




        schema Hub_content_presigned_urls:
            """
            HubContentPresignedUrls resource
            """

            next_token: str?  # <p> A token for pagination. Use this token to retrieve the next set of presigned URLs when the response is truncated.</p>

            hub_content_name: str  # <p>The name of the hub content for which to generate presigned URLs. This identifies the specific model or content within the hub.</p>

            hub_name: str  # <p>The name or Amazon Resource Name (ARN) of the hub that contains the content. For public content, use <code>SageMakerPublicHub</code>.</p>

            hub_content_type: str  # <p>The type of hub content to access. Valid values include <code>Model</code>, <code>Notebook</code>, and <code>ModelReference</code>.</p>

            hub_content_version: str?  # <p>The version of the hub content. If not specified, the latest version is used.</p>

            access_config: str?  # <p>Configuration settings for accessing the hub content, including end-user license agreement acceptance for gated models and expected S3 URL validation.</p>

            max_results: int?  # <p>The maximum number of presigned URLs to return in the response. Default value is 100. Large models may contain hundreds of files, requiring pagination to retrieve all URLs.</p>




