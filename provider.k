        schema Origin_endpoint:
            """
            OriginEndpoint resource
            """

            id: str  # The ID of the OriginEndpoint.  The ID must be unique within the region
and it cannot be changed after the OriginEndpoint is created.

            channel_id: str  # The ID of the Channel that the OriginEndpoint will be associated with.
This cannot be changed after the OriginEndpoint is created.

            startover_window_seconds: int?  # Maximum duration (seconds) of content to retain for startover playback.
If not specified, startover playback will be disabled for the OriginEndpoint.

            time_delay_seconds: int?  # Amount of delay (seconds) to enforce on the playback of live content.
If not specified, there will be no time delay in effect for the OriginEndpoint.

            hls_package: str?  # 

            mss_package: str?  # 

            whitelist: [str]?  # A list of source IP CIDR blocks that will be allowed to access the OriginEndpoint.

            manifest_name: str?  # A short string that will be used as the filename of the OriginEndpoint URL (defaults to "index").

            origination: str?  # Control whether origination of video is allowed for this OriginEndpoint. If set to ALLOW, the OriginEndpoint
may by requested, pursuant to any other form of access control. If set to DENY, the OriginEndpoint may not be
requested. This can be helpful for Live to VOD harvesting, or for temporarily disabling origination

            cmaf_package: str?  # 

            dash_package: str?  # 

            description: str?  # A short text description of the OriginEndpoint.

            authorization: str?  # 

            tags: {str: str}?  # 



            # Outputs

            arn_output?: str  # The Amazon Resource Name (ARN) assigned to the OriginEndpoint.

            authorization_output?: str  # 

            time_delay_seconds_output?: int  # Amount of delay (seconds) to enforce on the playback of live content.
If not specified, there will be no time delay in effect for the OriginEndpoint.

            hls_package_output?: str  # 

            channel_id_output?: str  # The ID of the Channel the OriginEndpoint is associated with.

            id_output?: str  # The ID of the OriginEndpoint.

            cmaf_package_output?: str  # 

            created_at_output?: str  # The date and time the OriginEndpoint was created.

            manifest_name_output?: str  # A short string appended to the end of the OriginEndpoint URL.

            startover_window_seconds_output?: int  # Maximum duration (seconds) of content to retain for startover playback.
If not specified, startover playback will be disabled for the OriginEndpoint.

            dash_package_output?: str  # 

            mss_package_output?: str  # 

            tags_output?: {str: str}  # 

            url_output?: str  # The URL of the packaged OriginEndpoint for consumption.

            whitelist_output?: [str]  # A list of source IP CIDR blocks that will be allowed to access the OriginEndpoint.

            description_output?: str  # A short text description of the OriginEndpoint.

            origination_output?: str  # Control whether origination of video is allowed for this OriginEndpoint. If set to ALLOW, the OriginEndpoint
may by requested, pursuant to any other form of access control. If set to DENY, the OriginEndpoint may not be
requested. This can be helpful for Live to VOD harvesting, or for temporarily disabling origination




