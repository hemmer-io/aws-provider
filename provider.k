            last_updated_date_time_output?: str  # <p>A timestamp of the date and time that the slot type was last
         updated.</p>

            slot_type_id_output?: str  # <p>The unique identifier for the slot type.</p>

            slot_type_values_output?: [str]  # <p>The values that the slot type can take. Includes any synonyms for
