    # Mediaconvert Service
    schema MediaconvertService:
        """
        Service for mediaconvert resources.
        """


        schema Policy:
            """
            Policy resource
            """

            policy: str  # A policy configures behavior that you allow or disallow for your account. For information about MediaConvert policies, see the user guide at http://docs.aws.amazon.com/mediaconvert/latest/ug/what-is.html



            # Outputs

            policy_output?: str  # A policy configures behavior that you allow or disallow for your account. For information about MediaConvert policies, see the user guide at http://docs.aws.amazon.com/mediaconvert/latest/ug/what-is.html




        schema Resource_share:
            """
            ResourceShare resource
            """

            job_id: str  # Specify MediaConvert Job ID or ARN to share

            support_case_id: str  # AWS Support case identifier




        schema Job:
            """
            Job resource
            """

            client_request_token: str?  # Prevent duplicate jobs from being created and ensure idempotency for your requests. A client request token can be any string that includes up to 64 ASCII characters. If you reuse a client request token within one minute of a successful request, the API returns the job details of the original request instead. For more information see https://docs.aws.amazon.com/mediaconvert/latest/apireference/idempotency.html.

            hop_destinations: [str]?  # Optional. Use queue hopping to avoid overly long waits in the backlog of the queue that you submit your job to. Specify an alternate queue and the maximum time that your job will wait in the initial queue before hopping. For more information about this feature, see the AWS Elemental MediaConvert User Guide.

            role: str  # Required. The IAM role you use for creating this job. For details about permissions, see the User Guide topic at the User Guide at https://docs.aws.amazon.com/mediaconvert/latest/ug/iam-role.html.

            job_template: str?  # Optional. When you create a job, you can either specify a job template or specify the transcoding settings individually.

            queue: str?  # Optional. When you create a job, you can specify a queue to send it to. If you don't specify, the job will go to the default queue. For more about queues, see the User Guide topic at https://docs.aws.amazon.com/mediaconvert/latest/ug/what-is.html.

            job_engine_version: str?  # Use Job engine versions to run jobs for your production workflow on one version, while you test and validate the latest version. Job engine versions represent periodically grouped MediaConvert releases with new features, updates, improvements, and fixes. Job engine versions are in a YYYY-MM-DD format. Note that the Job engine version feature is not publicly available at this time. To request access, contact AWS support.

            simulate_reserved_queue: str?  # Optional. Enable this setting when you run a test job to estimate how many reserved transcoding slots (RTS) you need. When this is enabled, MediaConvert runs your job from an on-demand queue with similar performance to what you will see with one RTS in a reserved queue. This setting is disabled by default.

            tags: {str: str}?  # Optional. The tags that you want to add to the resource. You can tag resources with a key-value pair or with only a key.  Use standard AWS tags on your job for automatic integration with AWS services and for custom integrations and workflows.

            acceleration_settings: str?  # Optional. Accelerated transcoding can significantly speed up jobs with long, visually complex content. Outputs that use this feature incur pro-tier pricing. For information about feature limitations, see the AWS Elemental MediaConvert User Guide.

            priority: int?  # Optional. Specify the relative priority for this job. In any given queue, the service begins processing the job with the highest value first. When more than one job has the same priority, the service begins processing the job that you submitted first. If you don't specify a priority, the service uses the default value 0.

            billing_tags_source: str?  # Optionally choose a Billing tags source that AWS Billing and Cost Management will use to display tags for individual output costs on any billing report that you set up. Leave blank to use the default value, Job.

            settings: str  # JobSettings contains all the transcode settings for a job.

            status_update_interval: str?  # Optional. Specify how often MediaConvert sends STATUS_UPDATE events to Amazon CloudWatch Events. Set the interval, in seconds, between status updates. MediaConvert sends an update at this interval from the time the service begins processing your job to the time it completes the transcode or encounters an error.

            user_metadata: {str: str}?  # Optional. User-defined metadata that you want to associate with an MediaConvert job. You specify metadata in key/value pairs.  Use only for existing integrations or workflows that rely on job metadata tags. Otherwise, we recommend that you use standard AWS tags.



            # Outputs

            job_output?: str  # Each job converts an input file into an output file or files. For more information, see the User Guide at https://docs.aws.amazon.com/mediaconvert/latest/ug/what-is.html




        schema Job_template:
            """
            JobTemplate resource
            """

            priority: int?  # Specify the relative priority for this job. In any given queue, the service begins processing the job with the highest value first. When more than one job has the same priority, the service begins processing the job that you submitted first. If you don't specify a priority, the service uses the default value 0.

            settings: str  # JobTemplateSettings contains all the transcode settings saved in the template that will be applied to jobs created from it.

            tags: {str: str}?  # The tags that you want to add to the resource. You can tag resources with a key-value pair or with only a key.

            description: str?  # Optional. A description of the job template you are creating.

            hop_destinations: [str]?  # Optional. Use queue hopping to avoid overly long waits in the backlog of the queue that you submit your job to. Specify an alternate queue and the maximum time that your job will wait in the initial queue before hopping. For more information about this feature, see the AWS Elemental MediaConvert User Guide.

            name: str  # The name of the job template you are creating.

            queue: str?  # Optional. The queue that jobs created from this template are assigned to. If you don't specify this, jobs will go to the default queue.

            acceleration_settings: str?  # Accelerated transcoding can significantly speed up jobs with long, visually complex content. Outputs that use this feature incur pro-tier pricing. For information about feature limitations, see the AWS Elemental MediaConvert User Guide.

            category: str?  # Optional. A category for the job template you are creating

            status_update_interval: str?  # Specify how often MediaConvert sends STATUS_UPDATE events to Amazon CloudWatch Events. Set the interval, in seconds, between status updates. MediaConvert sends an update at this interval from the time the service begins processing your job to the time it completes the transcode or encounters an error.



            # Outputs

            job_template_output?: str  # A job template is a pre-made set of encoding instructions that you can use to quickly create a job.




        schema Preset:
            """
            Preset resource
            """

            category: str?  # Optional. A category for the preset you are creating.

            tags: {str: str}?  # The tags that you want to add to the resource. You can tag resources with a key-value pair or with only a key.

            description: str?  # Optional. A description of the preset you are creating.

            name: str  # The name of the preset you are creating.

            settings: str  # Settings for preset



            # Outputs

            preset_output?: str  # A preset is a collection of preconfigured media conversion settings that you want MediaConvert to apply to the output during the conversion process.




        schema Jobs_query_results:
            """
            JobsQueryResults resource
            """



            # Outputs

            jobs_output?: [str]  # List of jobs.

            status_output?: str  # The status of the jobs query.

            next_token_output?: str  # Use this string to request the next batch of jobs via the StartJobsQuery API.




        schema Endpoints:
            """
            Endpoints resource
            """



            # Outputs

            next_token_output?: str  # Use this string to request the next batch of endpoints.

            endpoints_output?: [str]  # List of endpoints




        schema Queue:
            """
            Queue resource
            """

            description: str?  # Optional. A description of the queue that you are creating.

            name: str  # The name of the queue that you are creating.

            pricing_plan: str?  # Specifies whether the pricing plan for the queue is on-demand or reserved. For on-demand, you pay per minute, billed in increments of .01 minute. For reserved, you pay for the transcoding capacity of the entire queue, regardless of how much or how little you use it. Reserved pricing requires a 12-month commitment. When you use the API to create a queue, the default is on-demand.

            concurrent_jobs: int?  # Specify the maximum number of jobs your queue can process concurrently. For on-demand queues, the value you enter is constrained by your service quotas for Maximum concurrent jobs, per on-demand queue and Maximum concurrent jobs, per account. For reserved queues, specify the number of jobs you can process concurrently in your reservation plan instead.

            reservation_plan_settings: str?  # Details about the pricing plan for your reserved queue. Required for reserved queues and not applicable to on-demand queues.

            status: str?  # Initial state of the queue. If you create a paused queue, then jobs in that queue won't begin.

            tags: {str: str}?  # The tags that you want to add to the resource. You can tag resources with a key-value pair or with only a key.



            # Outputs

            queue_output?: str  # You can use queues to manage the resources that are available to your AWS account for running multiple transcoding jobs at the same time. If you don't specify a queue, the service sends all jobs through the default queue. For more information, see https://docs.aws.amazon.com/mediaconvert/latest/ug/working-with-queues.html.





    # Mq Service
    schema MqService:
        """
        Service for mq resources.
        """


        schema Configuration_revision:
            """
            ConfigurationRevision resource
            """



            # Outputs

            description_output?: str  # <p>The description of the configuration.</p>

            configuration_id_output?: str  # <p>Required. The unique ID that Amazon MQ generates for the configuration.</p>

            created_output?: str  # <p>Required. The date and time of the configuration.</p>

            data_output?: str  # <p>Amazon MQ for ActiveMQ: the base64-encoded XML configuration. Amazon MQ for RabbitMQ: base64-encoded Cuttlefish.</p>




        schema Broker:
            """
            Broker resource
            """

            logs: str?  # <p>Enables Amazon CloudWatch logging for brokers.</p>

            tags: {str: str}?  # <p>Create tags when creating the broker.</p>

            creator_request_id: str?  # <p>The unique ID that the requester receives for the created broker. Amazon MQ passes your ID with the API action.</p> <note><p>We recommend using a Universally Unique Identifier (UUID) for the creatorRequestId. You may omit the creatorRequestId if your application doesn't require idempotency.</p></note>

            data_replication_mode: str?  # <p>Defines whether this broker is a part of a data replication pair.</p>

            configuration: str?  # <p>A list of information about the configuration.</p>

            broker_name: str  # <p>Required. The broker's name. This value must be unique in your Amazon Web Services account, 1-50 characters long, must contain only letters, numbers, dashes, and underscores, and must not contain white spaces, brackets, wildcard characters, or special characters.</p> <important><p>Do not add personally identifiable information (PII) or other confidential or sensitive information in broker names. Broker names are accessible to other Amazon Web Services services, including CloudWatch Logs. Broker names are not intended to be used for private or sensitive data.</p></important>

            security_groups: [str]?  # <p>The list of rules (1 minimum, 125 maximum) that authorize connections to brokers.</p>

            subnet_ids: [str]?  # <p>The list of groups that define which subnets and IP ranges the broker can use from different Availability Zones. If you specify more than one subnet, the subnets must be in different Availability Zones. Amazon MQ will not be able to create VPC endpoints for your broker with multiple subnets in the same Availability Zone. A SINGLE_INSTANCE deployment requires one subnet (for example, the default subnet). An ACTIVE_STANDBY_MULTI_AZ Amazon MQ for ActiveMQ deployment requires two subnets. A CLUSTER_MULTI_AZ Amazon MQ for RabbitMQ deployment has no subnet requirements when deployed with public accessibility. Deployment without public accessibility requires at least one subnet.</p> <important><p>If you specify subnets in a <a href="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-sharing.html">shared VPC</a> for a RabbitMQ broker, the associated VPC to which the specified subnets belong must be owned by your Amazon Web Services account. Amazon MQ will not be able to create VPC endpoints in VPCs that are not owned by your Amazon Web Services account.</p></important>

            auto_minor_version_upgrade: bool?  # <p>Enables automatic upgrades to new patch versions for brokers as new versions are released and supported by Amazon MQ. Automatic upgrades occur during the scheduled maintenance window or after a manual broker reboot. Set to true by default, if no value is specified.</p> <note><p>Must be set to true for ActiveMQ brokers version 5.18 and above and for RabbitMQ brokers version 3.13 and above.</p></note>

            maintenance_window_start_time: str?  # <p>The parameters that determine the WeeklyStartTime.</p>

            ldap_server_metadata: str?  # <p>Optional. The metadata of the LDAP server used to authenticate and authorize connections to the broker. Does not apply to RabbitMQ brokers.</p>

            storage_type: str?  # <p>The broker's storage type.</p>

            publicly_accessible: bool  # <p>Enables connections from applications outside of the VPC that hosts the broker's subnets. Set to false by default, if no value is provided.</p>

            deployment_mode: str  # <p>Required. The broker's deployment mode.</p>

            engine_type: str  # <p>Required. The type of broker engine. Currently, Amazon MQ supports ACTIVEMQ and RABBITMQ.</p>

            data_replication_primary_broker_arn: str?  # <p>The Amazon Resource Name (ARN) of the primary broker that is used to replicate data from in a data replication pair, and is applied to the replica broker. Must be set when dataReplicationMode is set to CRDR.</p>

            encryption_options: str?  # <p>Encryption options for the broker.</p>

            users: [str]?  # <p>The list of broker users (persons or applications) who can access queues and topics. For Amazon MQ for RabbitMQ brokers, an administrative user is required if using simple authentication and authorization. For brokers using OAuth2, this user is optional. When provided, one and only one administrative user is accepted and created when a broker is first provisioned. All subsequent broker users are created by making RabbitMQ API calls directly to brokers or via the RabbitMQ web console.</p>

            engine_version: str?  # <p>The broker engine version. Defaults to the latest available version for the specified broker engine type. For more information, see the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/activemq-version-management.html">ActiveMQ version management</a> and the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/rabbitmq-version-management.html">RabbitMQ version management</a> sections in the Amazon MQ Developer Guide.</p>

            host_instance_type: str  # <p>Required. The broker's instance type.</p>

            authentication_strategy: str?  # <p>Optional. The authentication strategy used to secure the broker. The default is SIMPLE.</p>



            # Outputs

            broker_instances_output?: [str]  # <p>A list of information about allocated brokers.</p>

            pending_authentication_strategy_output?: str  # <p>The authentication strategy that will be applied when the broker is rebooted. The default is SIMPLE.</p>

            created_output?: str  # <p>The time when the broker was created.</p>

            publicly_accessible_output?: bool  # <p>Enables connections from applications outside of the VPC that hosts the broker's subnets.</p>

            configurations_output?: str  # <p>The list of all revisions for the specified configuration.</p>

            engine_version_output?: str  # <p>The broker engine version. For more information, see the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/activemq-version-management.html">ActiveMQ version management</a> and the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/rabbitmq-version-management.html">RabbitMQ version management</a> sections in the Amazon MQ Developer Guide.</p>

            data_replication_metadata_output?: str  # <p>The replication details of the data replication-enabled broker. Only returned if dataReplicationMode is set to CRDR.</p>

            data_replication_mode_output?: str  # <p>Describes whether this broker is a part of a data replication pair.</p>

            pending_data_replication_mode_output?: str  # <p>Describes whether this broker will be a part of a data replication pair after reboot.</p>

            deployment_mode_output?: str  # <p>The broker's deployment mode.</p>

            engine_type_output?: str  # <p>The type of broker engine. Currently, Amazon MQ supports ACTIVEMQ and RABBITMQ.</p>

            pending_ldap_server_metadata_output?: str  # <p>The metadata of the LDAP server that will be used to authenticate and authorize connections to the broker after it is rebooted.</p>

            storage_type_output?: str  # <p>The broker's storage type.</p>

            subnet_ids_output?: [str]  # <p>The list of groups that define which subnets and IP ranges the broker can use from different Availability Zones.</p>

            broker_arn_output?: str  # <p>The broker's Amazon Resource Name (ARN).</p>

            broker_id_output?: str  # <p>The unique ID that Amazon MQ generates for the broker.</p>

            host_instance_type_output?: str  # <p>The broker's instance type.</p>

            logs_output?: str  # <p>The list of information about logs currently enabled and pending to be deployed for the specified broker.</p>

            pending_security_groups_output?: [str]  # <p>The list of pending security groups to authorize connections to brokers.</p>

            security_groups_output?: [str]  # <p>The list of rules (1 minimum, 125 maximum) that authorize connections to brokers.</p>

            pending_data_replication_metadata_output?: str  # <p>The pending replication details of the data replication-enabled broker. Only returned if pendingDataReplicationMode is set to CRDR.</p>

            broker_name_output?: str  # <p>The broker's name. This value must be unique in your Amazon Web Services account account, 1-50 characters long, must contain only letters, numbers, dashes, and underscores, and must not contain white spaces, brackets, wildcard characters, or special characters.</p>

            maintenance_window_start_time_output?: str  # <p>The parameters that determine the WeeklyStartTime.</p>

            broker_state_output?: str  # <p>The broker's status.</p>

            ldap_server_metadata_output?: str  # <p>The metadata of the LDAP server used to authenticate and authorize connections to the broker.</p>

            pending_engine_version_output?: str  # <p>The broker engine version to upgrade to. For more information, see the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/activemq-version-management.html">ActiveMQ version management</a> and the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/rabbitmq-version-management.html">RabbitMQ version management</a> sections in the Amazon MQ Developer Guide.</p>

            tags_output?: {str: str}  # <p>The list of all tags associated with this broker.</p>

            authentication_strategy_output?: str  # <p>The authentication strategy used to secure the broker. The default is SIMPLE.</p>

            auto_minor_version_upgrade_output?: bool  # <p>Enables automatic upgrades to new patch versions for brokers as new versions are released and supported by Amazon MQ. Automatic upgrades occur during the scheduled maintenance window or after a manual broker reboot.</p>

            encryption_options_output?: str  # <p>Encryption options for the broker.</p>

            users_output?: [str]  # <p>The list of all broker usernames for the specified broker.</p>

            pending_host_instance_type_output?: str  # <p>The broker's host instance type to upgrade to. For a list of supported instance types, see <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/broker.html#broker-instance-types">Broker instance types</a>.</p>

            actions_required_output?: [str]  # <p>Actions required for a broker.</p>




        schema Broker_engine_types:
            """
            BrokerEngineTypes resource
            """



            # Outputs

            max_results_output?: int  # <p>Required. The maximum number of engine types that can be returned per page (20 by default). This value must be an integer from 5 to 100.</p>

            next_token_output?: str  # <p>The token that specifies the next page of results Amazon MQ should return. To request the first page, leave nextToken empty.</p>

            broker_engine_types_output?: [str]  # <p>List of available engine types and versions.</p>




        schema Broker_instance_options:
            """
            BrokerInstanceOptions resource
            """



            # Outputs

            broker_instance_options_output?: [str]  # <p>List of available broker instance options.</p>

            max_results_output?: int  # <p>Required. The maximum number of instance options that can be returned per page (20 by default). This value must be an integer from 5 to 100.</p>

            next_token_output?: str  # <p>The token that specifies the next page of results Amazon MQ should return. To request the first page, leave nextToken empty.</p>




        schema User:
            """
            User resource
            """

            replication_user: bool?  # <p>Defines if this user is intended for CRDR replication purposes.</p>

            groups: [str]?  # <p>The list of groups (20 maximum) to which the ActiveMQ user belongs. This value can contain only alphanumeric characters, dashes, periods, underscores, and tildes (- . _ ~). This value must be 2-100 characters long.</p>

            username: str  # <p>The username of the ActiveMQ user. This value can contain only alphanumeric characters, dashes, periods, underscores, and tildes (- . _ ~). This value must be 2-100 characters long.</p>

            broker_id: str  # <p>The unique ID that Amazon MQ generates for the broker.</p>

            console_access: bool?  # <p>Enables access to the ActiveMQ Web Console for the ActiveMQ user.</p>

            password: str  # <p>Required. The password of the user. This value must be at least 12 characters long, must contain at least 4 unique characters, and must not contain commas, colons, or equal signs (,:=).</p>



            # Outputs

            broker_id_output?: str  # <p>Required. The unique ID that Amazon MQ generates for the broker.</p>

            replication_user_output?: bool  # <p>Describes whether the user is intended for data replication</p>

            pending_output?: str  # <p>The status of the changes pending for the ActiveMQ user.</p>

            username_output?: str  # <p>Required. The username of the ActiveMQ user. This value can contain only alphanumeric characters, dashes, periods, underscores, and tildes (- . _ ~). This value must be 2-100 characters long.</p>

            groups_output?: [str]  # <p>The list of groups (20 maximum) to which the ActiveMQ user belongs. This value can contain only alphanumeric characters, dashes, periods, underscores, and tildes (- . _ ~). This value must be 2-100 characters long.</p>

            console_access_output?: bool  # <p>Enables access to the the ActiveMQ Web Console for the ActiveMQ user.</p>




        schema Configuration:
            """
            Configuration resource
            """

            engine_type: str  # <p>Required. The type of broker engine. Currently, Amazon MQ supports ACTIVEMQ and RABBITMQ.</p>

            authentication_strategy: str?  # <p>Optional. The authentication strategy associated with the configuration. The default is SIMPLE.</p>

            engine_version: str?  # <p>The broker engine version. Defaults to the latest available version for the specified broker engine type. For more information, see the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/activemq-version-management.html">ActiveMQ version management</a> and the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/rabbitmq-version-management.html">RabbitMQ version management</a> sections in the Amazon MQ Developer Guide.</p>

            name: str  # <p>Required. The name of the configuration. This value can contain only alphanumeric characters, dashes, periods, underscores, and tildes (- . _ ~). This value must be 1-150 characters long.</p>

            tags: {str: str}?  # <p>Create tags when creating the configuration.</p>



            # Outputs

            authentication_strategy_output?: str  # <p>Optional. The authentication strategy associated with the configuration. The default is SIMPLE.</p>

            created_output?: str  # <p>Required. The date and time of the configuration revision.</p>

            name_output?: str  # <p>Required. The name of the configuration. This value can contain only alphanumeric characters, dashes, periods, underscores, and tildes (- . _ ~). This value must be 1-150 characters long.</p>

            description_output?: str  # <p>Required. The description of the configuration.</p>

            tags_output?: {str: str}  # <p>The list of all tags associated with this configuration.</p>

            engine_type_output?: str  # <p>Required. The type of broker engine. Currently, Amazon MQ supports ACTIVEMQ and RABBITMQ.</p>

            arn_output?: str  # <p>Required. The ARN of the configuration.</p>

            id_output?: str  # <p>Required. The unique ID that Amazon MQ generates for the configuration.</p>

            latest_revision_output?: str  # <p>Required. The latest revision of the configuration.</p>

            engine_version_output?: str  # <p>The broker engine version. Defaults to the latest available version for the specified broker engine type. For a list of supported engine versions, see the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/activemq-version-management.html">ActiveMQ version management</a> and the <a href="https://docs.aws.amazon.com//amazon-mq/latest/developer-guide/rabbitmq-version-management.html">RabbitMQ version management</a> sections in the Amazon MQ Developer Guide.</p>




        schema Tags:
            """
            Tags resource
            """

            tags: {str: str}?  # <p>The key-value pair for the resource tag.</p>

            resource_arn: str  # <p>The Amazon Resource Name (ARN) of the resource tag.</p>





    # Rum Service
    schema RumService:
        """
        Service for rum resources.
        """


        schema Rum_events:
            """
            RumEvents resource
            """

            rum_events: [str]  # <p>An array of structures that contain the telemetry event data.</p>

            user_details: str  # <p>A structure that contains information about the user session that this batch of events was collected from.</p>

            app_monitor_details: str  # <p>A structure that contains information about the app monitor that collected this telemetry information.</p>

            id: str  # <p>The ID of the app monitor that is sending this data.</p>

            batch_id: str  # <p>A unique identifier for this batch of RUM event data.</p>

            alias: str?  # <p>If the app monitor uses a resource-based policy that requires <code>PutRumEvents</code> requests to specify a certain alias,
         specify that alias here. This alias will be compared to the <code>rum:alias</code> context key in the resource-based policy.  For more information, see <a href="https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-RUM-resource-policies.html">Using resource-based policies with CloudWatch RUM</a>.</p>





    # Sesv2 Service
    schema Sesv2Service:
        """
        Service for sesv2 resources.
        """


        schema Email_identity_configuration_set_attributes:
            """
            EmailIdentityConfigurationSetAttributes resource
            """

            configuration_set_name: str?  # <p>The configuration set to associate with an email identity.</p>

            email_identity: str  # <p>The email address or domain to associate with a configuration set.</p>




        schema Reputation_entity_customer_managed_status:
            """
            ReputationEntityCustomerManagedStatus resource
            """

            reputation_entity_type: str  # <p>The type of reputation entity. Currently, only <code>RESOURCE</code> type entities are supported.</p>

            reputation_entity_reference: str  # <p>The unique identifier for the reputation entity. For resource-type entities, 
            this is the Amazon Resource Name (ARN) of the resource.</p>

            sending_status: str  # <p>The new customer-managed sending status for the reputation entity. This can be one of the following:</p>
         <ul>
            <li>
               <p>
                  <code>ENABLED</code> – Allow sending for this entity.</p>
            </li>
            <li>
               <p>
                  <code>DISABLED</code> – Prevent sending for this entity.</p>
            </li>
            <li>
               <p>
                  <code>REINSTATED</code> – Allow sending even if there are active reputation findings.</p>
            </li>
         </ul>




        schema Email_identity_mail_from_attributes:
            """
            EmailIdentityMailFromAttributes resource
            """

            behavior_on_mx_failure: str?  # <p>The action to take if the required MX record isn't found when you send an email. When
            you set this value to <code>UseDefaultValue</code>, the mail is sent using
                <i>amazonses.com</i> as the MAIL FROM domain. When you set this value
            to <code>RejectMessage</code>, the Amazon SES API v2 returns a
                <code>MailFromDomainNotVerified</code> error, and doesn't attempt to deliver the
            email.</p>
         <p>These behaviors are taken when the custom MAIL FROM domain configuration is in the
                <code>Pending</code>, <code>Failed</code>, and <code>TemporaryFailure</code>
            states.</p>

            mail_from_domain: str?  # <p> The custom MAIL FROM domain that you want the verified identity to use. The MAIL FROM
            domain must meet the following criteria:</p>
         <ul>
            <li>
               <p>It has to be a subdomain of the verified identity.</p>
            </li>
            <li>
               <p>It can't be used to receive email.</p>
            </li>
            <li>
               <p>It can't be used in a "From" address if the MAIL FROM domain is a destination
                    for feedback forwarding emails.</p>
            </li>
         </ul>

            email_identity: str  # <p>The verified email identity.</p>




        schema Reputation_entity_policy:
            """
            ReputationEntityPolicy resource
            """

            reputation_entity_policy: str  # <p>The Amazon Resource Name (ARN) of the reputation management policy to apply 
            to this entity. This is an Amazon Web Services Amazon SES-managed policy.</p>

            reputation_entity_type: str  # <p>The type of reputation entity. Currently, only <code>RESOURCE</code> type entities are supported.</p>

            reputation_entity_reference: str  # <p>The unique identifier for the reputation entity. For resource-type entities, 
            this is the Amazon Resource Name (ARN) of the resource.</p>




        schema Tenant:
            """
            Tenant resource
            """

            tags: [str]?  # <p>An array of objects that define the tags (keys and values) to associate with the tenant</p>

            tenant_name: str  # <p>The name of the tenant to create. The name can contain up to 64 alphanumeric
            characters, including letters, numbers, hyphens (-) and underscores (_) only.</p>



            # Outputs

            tenant_output?: str  # <p>A structure that contains details about the tenant.</p>




        schema Deliverability_dashboard_option:
            """
            DeliverabilityDashboardOption resource
            """

            subscribed_domains: [str]?  # <p>An array of objects, one for each verified domain that you use to send email and
            enabled the Deliverability dashboard for.</p>

            dashboard_enabled: bool  # <p>Specifies whether to enable the Deliverability dashboard. To enable the dashboard, set this
            value to <code>true</code>.</p>




        schema Message_insights:
            """
            MessageInsights resource
            """



            # Outputs

            insights_output?: [str]  # <p>A set of insights associated with the message.</p>

            email_tags_output?: [str]  # <p>
            A list of tags, in the form of name/value pairs, that were applied to the email you sent, along with Amazon SES
            <a href="https://docs.aws.amazon.com/ses/latest/dg/monitor-using-event-publishing.html">Auto-Tags</a>.
        </p>

            subject_output?: str  # <p>The subject line of the message.</p>

            message_id_output?: str  # <p>A unique identifier for the message.</p>

            from_email_address_output?: str  # <p>The from address used to send the message.</p>




        schema Account_details:
            """
            AccountDetails resource
            """

            production_access_enabled: bool?  # <p>Indicates whether or not your account should have production access in the current
            Amazon Web Services Region.</p>
         <p>If the value is <code>false</code>, then your account is in the
                <i>sandbox</i>. When your account is in the sandbox, you can only send
            email to verified identities.
            </p>
         <p>If the value is <code>true</code>, then your account has production access. When your
            account has production access, you can send email to any address. The sending quota and
            maximum sending rate for your account vary based on your specific use case.</p>

            use_case_description: str?  # <p>A description of the types of email that you plan to send.</p>

            contact_language: str?  # <p>The language you would prefer to be contacted with.</p>

            additional_contact_email_addresses: [str]?  # <p>Additional email addresses that you would like to be notified regarding Amazon SES
            matters.</p>

            mail_type: str  # <p>The type of email your account will send.</p>

            website_url: str  # <p>The URL of your website. This information helps us better understand the type of
            content that you plan to send.</p>




        schema Email_identity_dkim_signing_attributes:
            """
            EmailIdentityDkimSigningAttributes resource
            """

            signing_attributes_origin: str  # <p>The method to use to configure DKIM for the identity. There are the following possible
            values:</p>
         <ul>
            <li>
               <p>
                  <code>AWS_SES</code> – Configure DKIM for the identity by using <a href="https://docs.aws.amazon.com/ses/latest/DeveloperGuide/easy-dkim.html">Easy
                        DKIM</a>.</p>
            </li>
            <li>
               <p>
                  <code>EXTERNAL</code> – Configure DKIM for the identity by using Bring
                    Your Own DKIM (BYODKIM).</p>
            </li>
         </ul>

            email_identity: str  # <p>The email identity.</p>

            signing_attributes: str?  # <p>An object that contains information about the private key and selector that you want
            to use to configure DKIM for the identity for Bring Your Own DKIM (BYODKIM) for the
            identity, or, configures the key length to be used for <a href="https://docs.aws.amazon.com/ses/latest/DeveloperGuide/easy-dkim.html">Easy DKIM</a>.</p>




        schema Configuration_set_delivery_options:
            """
            ConfigurationSetDeliveryOptions resource
            """

            tls_policy: str?  # <p>Specifies whether messages that use the configuration set are required to use
            Transport Layer Security (TLS). If the value is <code>Require</code>, messages are only
            delivered if a TLS connection can be established. If the value is <code>Optional</code>,
            messages can be delivered in plain text if a TLS connection can't be established.</p>

