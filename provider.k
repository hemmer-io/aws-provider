            property_groups: {str: str}?  # <p/>

            description: str?  # <p>The description of the component type.</p>

            composite_component_types: {str: str}?  # <p>This is an object that maps strings to <code>compositeComponentTypes</code> of the <code>componentType</code>. 
          <code>CompositeComponentType</code> is referenced by <code>componentTypeId</code>.</p>

            component_type_id: str  # <p>The ID of the component type.</p>

            workspace_id: str  # <p>The ID of the workspace that contains the component type.</p>

            is_singleton: bool?  # <p>A Boolean value that specifies whether an entity can have more than one component of
         this type.</p>

            component_type_name: str?  # <p>A friendly name for the component type.</p>



            # Outputs

            arn_output?: str  # <p>The ARN of the component type.</p>

            description_output?: str  # <p>The description of the component type.</p>

            extends_from_output?: [str]  # <p>The name of the parent component type that this component type extends.</p>

            is_abstract_output?: bool  # <p>A Boolean value that specifies whether the component type is abstract.</p>

            composite_component_types_output?: {str: str}  # <p>This is an object that maps strings to <code>compositeComponentTypes</code> of the <code>componentType</code>. <code>CompositeComponentType</code> is referenced by <code>componentTypeId</code>.</p>

            component_type_id_output?: str  # <p>The ID of the component type.</p>

            is_singleton_output?: bool  # <p>A Boolean value that specifies whether an entity can have more than one component of
         this type.</p>

            component_type_name_output?: str  # <p>The component type name.</p>

            creation_date_time_output?: str  # <p>The date and time when the component type was created.</p>

            workspace_id_output?: str  # <p>The ID of the workspace that contains the component type.</p>

            property_definitions_output?: {str: str}  # <p>An object that maps strings to the property definitions in the component type. Each
         string in the mapping must be unique to this object.</p>

            property_groups_output?: {str: str}  # <p>The maximum number of results to return at one time. The default is 25.</p>
         <p>Valid Range: Minimum value of 1. Maximum value of 250.</p>

            sync_source_output?: str  # <p>The syncSource of the SyncJob, if this entity was created by a SyncJob.</p>

            status_output?: str  # <p>The current status of the component type.</p>

            update_date_time_output?: str  # <p>The date and time when the component was last updated.</p>

            is_schema_initialized_output?: bool  # <p>A Boolean value that specifies whether the component type has a schema initializer and
         that the schema initializer has run.</p>

            functions_output?: {str: str}  # <p>An object that maps strings to the functions in the component type. Each string in the
         mapping must be unique to this object.</p>




        schema Entity:
