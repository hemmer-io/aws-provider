        schema Change_set:
            """
            ChangeSet resource
            """



            # Outputs

            change_set_id_output?: str  # <p>Required. The unique identifier for the change set referenced in this request.</p>

            end_time_output?: str  # <p>The date and time, in ISO 8601 format (2018-02-27T13:45:22Z), the request transitioned
            to a terminal state. The change cannot transition to a different state. Null if the
            request is not in a terminal state. </p>

            start_time_output?: str  # <p>The date and time, in ISO 8601 format (2018-02-27T13:45:22Z), the request started.
        </p>

            intent_output?: str  # <p>The optional intent provided in the <code>StartChangeSet</code> request. If you do not
            provide an intent, <code>APPLY</code> is set by default.</p>

            change_set_output?: [str]  # <p>An array of <code>ChangeSummary</code> objects.</p>

            failure_code_output?: str  # <p>Returned if the change set is in <code>FAILED</code> status. Can be either
                <code>CLIENT_ERROR</code>, which means that there are issues with the request (see
            the <code>ErrorDetailList</code>), or <code>SERVER_FAULT</code>, which means that there
            is a problem in the system, and you should retry your request.</p>

            change_set_name_output?: str  # <p>The optional name provided in the <code>StartChangeSet</code> request. If you do not
            provide a name, one is set by default.</p>

            failure_description_output?: str  # <p>Returned if there is a failure on the change set, but that failure is not related to
            any of the changes in the request.</p>

            status_output?: str  # <p>The status of the change request.</p>

            change_set_arn_output?: str  # <p>The ARN associated with the unique identifier for the change set referenced in this
            request.</p>




        schema Resource_policy:
