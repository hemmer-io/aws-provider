            # Outputs

            v1_bot_name_output?: str  # <p>The name of the Amazon Lex V1 bot migrated to Amazon Lex V2.</p>

            v1_bot_locale_output?: str  # <p>The locale of the Amazon Lex V1 bot migrated to Amazon Lex V2.</p>

            migration_status_output?: str  # <p>Indicates the status of the migration. When the status is
        <code>COMPLETE</code> the migration is finished and the bot is available
      in Amazon Lex V2. There may be alerts and warnings that need to be resolved to
      complete the migration.</p>

            v2_bot_role_output?: str  # <p>The IAM role that Amazon Lex uses to run the Amazon Lex V2 bot.</p>

            alerts_output?: [str]  # <p>A list of alerts and warnings that indicate issues with the migration
      for the Amazon Lex V1 bot to Amazon Lex V2. You receive a warning when an Amazon Lex V1
      feature has a different implementation if Amazon Lex V2.</p>
         <p>For more information, see <a href="https://docs.aws.amazon.com/lexv2/latest/dg/migrate.html">Migrating a bot</a> in the <i>Amazon Lex V2
        developer guide</i>.</p>

            migration_strategy_output?: str  # <p>The strategy used to conduct the migration.</p>
         <ul>
            <li>
               <p>
                  <code>CREATE_NEW</code> - Creates a new Amazon Lex V2 bot and migrates
          the Amazon Lex V1 bot to the new bot.</p>
            </li>
            <li>
               <p>
                  <code>UPDATE_EXISTING</code> - Overwrites the existing Amazon Lex V2 bot
        metadata and the locale being migrated. It doesn't change any other
        locales in the Amazon Lex V2 bot. If the locale doesn't exist, a new locale
        is created in the Amazon Lex V2 bot.</p>
            </li>
         </ul>

            v1_bot_version_output?: str  # <p>The version of the Amazon Lex V1 bot migrated to Amazon Lex V2.</p>

            v2_bot_id_output?: str  # <p>The unique identifier of the Amazon Lex V2 bot that the Amazon Lex V1 is being
      migrated to.</p>

            migration_timestamp_output?: str  # <p>The date and time that the migration started.</p>

            migration_id_output?: str  # <p>The unique identifier of the migration. This is the same as the
      identifier used when calling the <code>GetMigration</code>
      operation.</p>




