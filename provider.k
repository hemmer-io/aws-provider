            cell_name_output?: str  # <p>The name of the cell.</p>

            cells_output?: [str]  # <p>A list of cell ARNs.</p>

            cell_arn_output?: str  # <p>The Amazon Resource Name (ARN) for the cell.</p>

            tags_output?: {str: str}  # <p>Tags on the resources.</p>

            parent_readiness_scopes_output?: [str]  # <p>The readiness scope for the cell, which can be a cell Amazon Resource Name (ARN) or a recovery group ARN. This is a list but currently can have only one element.</p>




        schema Readiness_check:
