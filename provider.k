         <p>As of September 2021, Amazon Elasticsearch service is Amazon OpenSearch Service. This
         configuration is deprecated. For new data sources, use <a>CreateDataSourceRequest$openSearchServiceConfig</a> to create an OpenSearch data source.</p>

            type: str  # <p>The type of the <code>DataSource</code>.</p>

            open_search_service_config: str?  # <p>Amazon OpenSearch Service settings.</p>

            relational_database_config: str?  # <p>Relational database settings.</p>

            dynamodb_config: str?  # <p>Amazon DynamoDB settings.</p>

            http_config: str?  # <p>HTTP endpoint settings.</p>

            description: str?  # <p>A description of the <code>DataSource</code>.</p>



            # Outputs

            data_source_output?: str  # <p>The <code>DataSource</code> object.</p>




