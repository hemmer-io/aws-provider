            features_output?: [str]  # <p>Describes the features that have been enabled for the detector.</p>

            created_at_output?: str  # <p>The timestamp of when the detector was created.</p>

            service_role_output?: str  # <p>The GuardDuty service role.</p>

            data_sources_output?: str  # <p>Describes which data sources are enabled for the detector.</p>

