            completed_at_output?: str  # <p>The time at which the retrieval of the finding recommendation was completed.</p>

            next_token_output?: str  # <p>A token used for pagination of results returned.</p>

            status_output?: str  # <p>The status of the retrieval of the finding recommendation.</p>

            started_at_output?: str  # <p>The time at which the retrieval of the finding recommendation was started.</p>

            error_output?: str  # <p>Detailed information about the reason that the retrieval of a recommendation for the finding failed.</p>

            recommended_steps_output?: [str]  # <p>A group of recommended steps for the finding.</p>





    # Lex_model_building_service Service
    schema Lex_model_building_serviceService:
        """
