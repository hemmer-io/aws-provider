            instance_id: str  # <p>The unique identifier of the Amazon Q Business application environment instance.</p>



            # Outputs

            app_id_output?: str  # <p>The unique identifier of the Amazon Q App for which permissions are returned.</p>

            resource_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the Amazon Q App for which permissions are returned.</p>

