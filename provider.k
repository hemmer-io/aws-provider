            receiver_principal: str  # <p>The Amazon Web Services account ID of the data grant receiver.</p>

            name: str  # <p>The name of the data grant.</p>

            source_data_set_id: str  # <p>The ID of the data set used to create the data grant.</p>

            tags: {str: str}?  # <p>The tags to add to the data grant. A tag is a key-value pair.</p>



