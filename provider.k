            <b>SNS notification action:</b>
         </p>
         <ul>
            <li>
               <p>
                  <code>arn:aws:sns:<i>region</i>:<i>account-id</i>:<i>sns-topic-name</i>
                  </code>
               </p>
            </li>
         </ul>
