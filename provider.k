            last_modified_time_output?: str  # <p>The time when the resource policy was last modified.</p>

            policy_revision_id_output?: str  # <p>A unique identifier for a revision of the resource policy.</p>

            creation_time_output?: str  # <p>The time when the resource policy was created.</p>




