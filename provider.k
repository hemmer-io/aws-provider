            role_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the IAM role that allows Customer Profiles service
         principal to assume the role for conducting KMS and S3 operations.</p>

            destination_uri_output?: str  # <p>The destination to which the segment will be exported. This field must be provided if
         the request is not submitted from the Amazon Connect Admin Website.</p>

