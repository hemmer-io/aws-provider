        schema User:
            """
            User resource
            """

            collection_id: str  # <p>The ID of an existing collection to which the new UserID needs to be created.</p>

            client_request_token: str?  # <p>Idempotent token used to identify the request to <code>CreateUser</code>. If you use the
      same token with multiple <code>CreateUser</code> requests, the same response is returned. Use
      ClientRequestToken to prevent the same request from being processed more than once.</p>

