            warnings_output?: [str]  # <p>The current evaluation warnings for the plan. </p>

            plan_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the plan.</p>

            next_token_output?: str  # <p>Specifies that you want to receive the next page of results. Valid only if you received a <code>nextToken</code> response in the previous request. If you did, it indicates that more output is available. Set this parameter to the value provided by the previous call's <code>nextToken</code> response to request the next page of results.</p>

            last_evaluated_version_output?: str  # <p>The version of the last evaluation of the plan.</p>

            region_output?: str  # <p>The Amazon Web Services Region for the plan.</p>

            evaluation_state_output?: str  # <p>The evaluation state for the plan.</p>

            last_evaluation_time_output?: str  # <p>The time of the last time that Region switch ran an evaluation of the plan.</p>




