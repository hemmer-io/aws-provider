            user_kms_key: str?  # <p>The AWS KMS key ARN that’s used for the AWS KMS encryption. If you don't provide a key, your data is encrypted by default with a key that AWS owns and manages for you.</p>

            tags: {str: str}?  # <p>The list of tags associated with the private re:Post.</p>

            role_arn: str?  # <p>The IAM role that grants permissions to the private re:Post to convert unanswered questions into AWS support tickets.</p>

            subdomain: str  # <p>The subdomain that you use to access your AWS re:Post Private private re:Post. All custom subdomains must be approved by AWS before use. In addition to your custom subdomain, all private re:Posts are issued an AWS generated subdomain for immediate use.</p>

            tier: str  # <p>The pricing tier for the private re:Post.</p>

            supported_email_domains: str?  # <p/>

            description: str?  # <p>A description for the private re:Post. This is used only to help you identify this private re:Post.</p>

            name: str  # <p>The name for the private re:Post. This must be unique in your account.</p>



            # Outputs

            application_arn_output?: str  # <p/>

            arn_output?: str  # <p>The ARN of the private re:Post.</p>

            space_id_output?: str  # <p>The unique ID of the private re:Post.</p>

            supported_email_domains_output?: str  # <p/>

            identity_store_id_output?: str  # <p/>

            tier_output?: str  # <p>The pricing tier of the private re:Post.</p>

            client_id_output?: str  # <p>The Identity Center identifier for the Application Instance.</p>

            vanity_domain_status_output?: str  # <p>The approval status of the custom subdomain.</p>

            random_domain_output?: str  # <p>The AWS generated subdomain of the private re:Post</p>

            customer_role_arn_output?: str  # <p>The IAM role that grants permissions to the private re:Post to convert unanswered questions into AWS support tickets.</p>

            vanity_domain_output?: str  # <p>The custom subdomain that you use to access your private re:Post. All custom subdomains must be approved by AWS before use.</p>

            create_date_time_output?: str  # <p>The date when the private re:Post was created.</p>

            delete_date_time_output?: str  # <p>The date when the private re:Post was deleted.</p>

            user_kms_key_output?: str  # <p>The custom AWS KMS key ARN that’s used for the AWS KMS encryption.</p>

            user_admins_output?: [str]  # <p>The list of users that are administrators of the private re:Post.</p>

            configuration_status_output?: str  # <p>The configuration status of the private re:Post.</p>

            description_output?: str  # <p>The description of the private re:Post.</p>

            storage_limit_output?: int  # <p>The storage limit of the private re:Post.</p>

            roles_output?: {str: str}  # <p>A map of accessor identifiers and their roles.</p>

            user_count_output?: int  # <p>The number of users that have onboarded to the private re:Post.</p>

            content_size_output?: int  # <p>The content size of the private re:Post.</p>

            name_output?: str  # <p>The name of the private re:Post.</p>

            group_admins_output?: [str]  # <p>The list of groups that are administrators of the private re:Post.</p>

            status_output?: str  # <p>The creation or deletion status of the private re:Post.</p>




