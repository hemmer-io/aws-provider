            # Outputs

            metric_alarms_output?: [str]  # <p>The information about any metric alarms returned by the operation.</p>

            composite_alarms_output?: [str]  # <p>The information about any composite alarms returned by the operation.</p>

            next_token_output?: str  # <p>The token that marks the start of the next batch of returned results.</p>




