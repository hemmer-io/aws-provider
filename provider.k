            tags_output?: {str: str}  # 

            name_output?: str  # A resource's name. Names must be unique within the scope of a resource type in a specific region.

            arn_output?: str  # A cloudwatch alarm template's ARN (Amazon Resource Name)

            comparison_operator_output?: str  # 

            created_at_output?: str  # 

            treat_missing_data_output?: str  # 

