            description: str?  # <p>A description of the new crawler.</p>

            schedule: str?  # <p>A <code>cron</code> expression used to specify the schedule (see <a href="https://docs.aws.amazon.com/glue/latest/dg/monitor-data-warehouse-schedule.html">Time-Based Schedules for Jobs and Crawlers</a>. For example, to run
      something every day at 12:15 UTC, you would specify:
      <code>cron(15 12 * * ? *)</code>.</p>

            schema_change_policy: str?  # <p>The policy for the crawler's update and deletion behavior.</p>

            configuration: str?  # <p>Crawler configuration information. This versioned JSON
      string allows users to specify aspects of a crawler's behavior.
      For more information, see <a href="https://docs.aws.amazon.com/glue/latest/dg/crawler-configuration.html">Setting crawler configuration options</a>.</p>

            crawler_security_configuration: str?  # <p>The name of the <code>SecurityConfiguration</code> structure to be used by this
      crawler.</p>

            role: str  # <p>The IAM role or Amazon Resource Name (ARN) of an IAM role used by the new crawler to
      access customer resources.</p>

            database_name: str?  # <p>The Glue database where results are written, such as:
        <code>arn:aws:daylight:us-east-1::database/sometable/*</code>.</p>

            table_prefix: str?  # <p>The table prefix used for catalog tables that are created.</p>

            lineage_configuration: str?  # <p>Specifies data lineage configuration settings for the crawler.</p>

            tags: {str: str}?  # <p>The tags to use with this crawler request. You may use tags to limit access to the
            crawler. For more information about tags in Glue, see <a href="https://docs.aws.amazon.com/glue/latest/dg/monitor-tags.html">Amazon Web Services Tags in Glue</a> in the developer
            guide.</p>

            classifiers: [str]?  # <p>A list of custom classifiers that the user has registered. By default, all built-in
      classifiers are included in a crawl, but these custom classifiers always override the default
      classifiers for a given classification.</p>

            targets: str  # <p>A list of collection of targets to crawl.</p>

            recrawl_policy: str?  # <p>A policy that specifies whether to crawl the entire dataset again, or to crawl only folders that were added since the last crawler run.</p>

            lake_formation_configuration: str?  # <p>Specifies Lake Formation configuration settings for the crawler.</p>

            name: str  # <p>Name of the new crawler.</p>



            # Outputs

            crawler_output?: str  # <p>The metadata for the specified crawler.</p>




