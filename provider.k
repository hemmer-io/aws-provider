            event_bridge_config: str?  # <p>Amazon EventBridge settings.</p>

            lambda_config: str?  # <p>Lambda settings.</p>

            metrics_config: str?  # <p>Enables or disables enhanced data source metrics for specified data sources. Note that
            <code>metricsConfig</code> won't be used unless the
            <code>dataSourceLevelMetricsBehavior</code> value is set to
            <code>PER_DATA_SOURCE_METRICS</code>. If the <code>dataSourceLevelMetricsBehavior</code>
