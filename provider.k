            description_output?: str  # <p>The session description.</p>

            work_group_output?: str  # <p>The workgroup to which the session belongs.</p>

            engine_version_output?: str  # <p>The engine version used by the session (for example, <code>PySpark engine version
                3</code>). You can get a list of engine versions by calling <a>ListEngineVersions</a>.</p>

            session_id_output?: str  # <p>The session ID.</p>

            notebook_version_output?: str  # <p>The notebook version.</p>

            status_output?: str  # <p>Contains information about the status of the session.</p>

            statistics_output?: str  # <p>Contains the DPU execution time.</p>




