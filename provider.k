            """

            tags: [str]?  # <p>Tags to add to the license. For more information about tagging support in
         License Manager, see the <a href="https://docs.aws.amazon.com/license-manager/latest/APIReference/API_TagResource.html">TagResource</a> operation.</p>

            product_name: str  # <p>Product name.</p>

            beneficiary: str  # <p>License beneficiary.</p>

            license_metadata: [str]?  # <p>Information about the license.</p>

            client_token: str  # <p>Unique, case-sensitive identifier that you provide to ensure the idempotency of the request.</p>

            entitlements: [str]  # <p>License entitlements.</p>

            license_name: str  # <p>License name.</p>

            product_sku: str  # <p>Product SKU.</p>

            home_region: str  # <p>Home Region for the license.</p>

            validity: str  # <p>Date and time range during which the license is valid, in ISO8601-UTC format.</p>

            consumption_configuration: str  # <p>Configuration for consumption of the license. Choose a provisional configuration for workloads
          running with continuous connectivity. Choose a borrow configuration for workloads with offline
          usage.</p>

            issuer: str  # <p>License issuer.</p>



            # Outputs

            license_output?: str  # <p>License details.</p>




        schema Grant_version:
            """
            GrantVersion resource
            """

            grant_arn: str  # <p>Amazon Resource Name (ARN) of the grant.</p>

            allowed_operations: [str]?  # <p>Allowed operations for the grant.</p>

            options: str?  # <p>The options specified for the grant.</p>

            client_token: str  # <p>Unique, case-sensitive identifier that you provide to ensure the idempotency of the request.</p>

            grant_name: str?  # <p>Grant name.</p>

            status_reason: str?  # <p>Grant status reason.</p>

            source_version: str?  # <p>Current version of the grant.</p>

            status: str?  # <p>Grant status.</p>




        schema License_specifications_for_resource:
            """
            LicenseSpecificationsForResource resource
            """

            resource_arn: str  # <p>Amazon Resource Name (ARN) of the Amazon Web Services resource.</p>

            remove_license_specifications: [str]?  # <p>ARNs of the license configurations to remove.</p>

            add_license_specifications: [str]?  # <p>ARNs of the license configurations to add.</p>




        schema License_version:
            """
            LicenseVersion resource
            """

            client_token: str  # <p>Unique, case-sensitive identifier that you provide to ensure the idempotency of the request.</p>

            license_metadata: [str]?  # <p>Information about the license.</p>

            validity: str  # <p>Date and time range during which the license is valid, in ISO8601-UTC format.</p>

            entitlements: [str]  # <p>License entitlements.</p>

            issuer: str  # <p>License issuer.</p>

            product_name: str  # <p>Product name.</p>

            license_name: str  # <p>License name.</p>

            source_version: str?  # <p>Current version of the license.</p>

            license_arn: str  # <p>Amazon Resource Name (ARN) of the license.</p>

            home_region: str  # <p>Home Region of the license.</p>

            status: str  # <p>License status.</p>

            consumption_configuration: str  # <p>Configuration for consumption of the license. Choose a provisional configuration for workloads
         running with continuous connectivity. Choose a borrow configuration for workloads with offline
         usage.</p>




        schema Service_settings:
            """
            ServiceSettings resource
            """

            organization_configuration: str?  # <p>Enables integration with Organizations for cross-account discovery.</p>

            enable_cross_accounts_discovery: bool?  # <p>Activates cross-account discovery.</p>

            s3_bucket_arn: str?  # <p>Amazon Resource Name (ARN) of the Amazon S3 bucket where the License Manager information is stored.</p>

            sns_topic_arn: str?  # <p>Amazon Resource Name (ARN) of the Amazon SNS topic used for License Manager alerts.</p>



            # Outputs

            license_manager_resource_share_arn_output?: str  # <p>Amazon Resource Name (ARN) of the resource share. The License Manager management account 
         provides member accounts with access to this share.</p>

            sns_topic_arn_output?: str  # <p>SNS topic configured to receive notifications from License Manager.</p>

            organization_configuration_output?: str  # <p>Indicates whether Organizations is integrated with License Manager for
         cross-account discovery.</p>

            enable_cross_accounts_discovery_output?: bool  # <p>Indicates whether cross-account discovery is enabled.</p>

            s3_bucket_arn_output?: str  # <p>Regional S3 bucket path for storing reports, license trail event data, discovery data,
         and so on.</p>




        schema License_conversion_task:
            """
            LicenseConversionTask resource
            """



