            destination_domain_info: str  # <p>Specifies the <code><a>DomainInformation</a></code> for the destination Elasticsearch domain.</p>

            connection_alias: str  # <p>Specifies the connection alias that will be used by the customer for this connection.</p>




        schema Elasticsearch_domain_config:
            """
            ElasticsearchDomainConfig resource
            """

            cognito_options: str?  # <p>Options to specify the Cognito user and identity pools for Kibana authentication. For more information, see <a href="http://docs.aws.amazon.com/elasticsearch-service/latest/developerguide/es-cognito-auth.html" target="_blank">Amazon Cognito Authentication for Kibana</a>.</p>

            log_publishing_options: {str: str}?  # <p>Map of <code>LogType</code> and <code>LogPublishingOption</code>, each containing options to publish a given type of Elasticsearch log.</p>

            ebs_options: str?  # <p>Specify the type and size of the EBS volume that you want to use. </p>

            domain_name: str  # <p>The name of the Elasticsearch domain that you are updating. </p>

            advanced_security_options: str?  # <p>Specifies advanced security options.</p>

            encryption_at_rest_options: str?  # <p>Specifies the Encryption At Rest Options.</p>

            domain_endpoint_options: str?  # <p>Options to specify configuration that will be applied to the domain endpoint.</p>

            dry_run: bool?  # <p>
           This flag, when set to True, specifies whether the <code>UpdateElasticsearchDomain</code> request should return the results of validation checks without actually applying the change.
           This flag, when set to True, specifies the deployment mechanism through which the update shall be applied on the domain.
           This will not actually perform the Update.
       </p>

