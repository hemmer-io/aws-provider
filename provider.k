            app_id_output?: str  # <p>The unique identifier of the Q App associated with the library item.</p>

            user_count_output?: int  # <p>The number of users who have associated the Q App with their account.</p>

            is_rated_by_user_output?: bool  # <p>Whether the current user has rated the library item.</p>

