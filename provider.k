            what_if_analysis_name_output?: str  # <p>The name of the what-if analysis.</p>

            what_if_analysis_arn_output?: str  # <p>The Amazon Resource Name (ARN) of the what-if analysis.</p>

            estimated_time_remaining_in_minutes_output?: int  # <p>The approximate time remaining to complete the what-if analysis, in minutes.</p>

