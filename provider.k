            update_timestamp_output?: str  # <p>The timestamp at which the kdb environment was updated. </p>

            error_message_output?: str  # <p>Specifies the error message that appears if a flow fails.</p>

            description_output?: str  # <p>A description for the kdb environment.</p>

            dedicated_service_account_id_output?: str  # <p>A unique identifier for the AWS environment infrastructure account.</p>

            environment_arn_output?: str  # <p>The ARN identifier of the environment.</p>

            kms_key_id_output?: str  # <p>The KMS key ID to encrypt your data in the FinSpace environment.</p>

            environment_id_output?: str  # <p>A unique identifier for the kdb environment.</p>

            status_output?: str  # <p>The status of the kdb environment.</p>

            aws_account_id_output?: str  # <p>The unique identifier of the AWS account that is used to create the kdb environment.</p>

            tgw_status_output?: str  # <p>The status of the network configuration.</p>

            availability_zone_ids_output?: [str]  # <p>The identifier of the availability zones where subnets for the environment are created.</p>




        schema Kx_scaling_group:
            """
            KxScalingGroup resource
            """

            environment_id: str  # <p>A unique identifier for the kdb environment, where you want to create the scaling group. </p>

            scaling_group_name: str  # <p>A unique identifier for the kdb scaling group. </p>

            host_type: str  # <p>
   The memory and CPU capabilities of the scaling group host on which FinSpace Managed kdb clusters will be placed.</p>
         <p>You can add one of the following values:</p>
         <ul>
            <li>
               <p>
                  <code>kx.sg.large</code> – The host type with a configuration of 16 GiB
            memory and 2 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.xlarge</code> – The host type with a configuration of 32 GiB
               memory and 4 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.2xlarge</code> – The host type with a configuration of 64 GiB
               memory and 8 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.4xlarge</code> – The host type with a configuration of 108 GiB memory and 16 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.8xlarge</code> – The host type with a configuration of 216 GiB memory and 32 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.16xlarge</code> – The host type with a configuration of 432 GiB memory and 64 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.32xlarge</code> – The host type with a configuration of 864 GiB memory and 128 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg1.16xlarge</code> – The host type with a configuration of 1949 GiB memory and 64 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg1.24xlarge</code> – The host type with a configuration of 2948 GiB memory and 96 vCPUs.</p>
            </li>
         </ul>

            client_token: str  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            availability_zone_id: str  # <p>The identifier of the availability zones.</p>

            tags: {str: str}?  # <p>
A list of key-value pairs to label the scaling group. You can add up to 50 tags to a scaling group.
</p>



            # Outputs

            scaling_group_arn_output?: str  # <p>
        The ARN identifier for the scaling group.
      </p>

            scaling_group_name_output?: str  # <p>A unique identifier for the kdb scaling group. </p>

            clusters_output?: [str]  # <p>
   The list of Managed kdb clusters that are currently active in the given scaling group.
   
</p>

            created_timestamp_output?: str  # <p>
   The timestamp at which the scaling group was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            host_type_output?: str  # <p>
      The memory and CPU capabilities of the scaling group host on which FinSpace Managed kdb clusters will be placed.</p>
         <p>It can have one of the following values:</p>
         <ul>
            <li>
               <p>
                  <code>kx.sg.large</code> – The host type with a configuration of 16 GiB
            memory and 2 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.xlarge</code> – The host type with a configuration of 32 GiB
               memory and 4 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.2xlarge</code> – The host type with a configuration of 64 GiB
               memory and 8 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.4xlarge</code> – The host type with a configuration of 108 GiB memory and 16 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.8xlarge</code> – The host type with a configuration of 216 GiB memory and 32 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.16xlarge</code> – The host type with a configuration of 432 GiB memory and 64 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg.32xlarge</code> – The host type with a configuration of 864 GiB memory and 128 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg1.16xlarge</code> – The host type with a configuration of 1949 GiB memory and 64 vCPUs.</p>
            </li>
            <li>
               <p>
                  <code>kx.sg1.24xlarge</code> – The host type with a configuration of 2948 GiB memory and 96 vCPUs.</p>
            </li>
         </ul>

            last_modified_timestamp_output?: str  # <p>
   The last time that the scaling group was updated in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.
</p>

            availability_zone_id_output?: str  # <p>The identifier of the availability zones.</p>

            status_reason_output?: str  # <p>
The error message when a failed state occurs. 
</p>

            status_output?: str  # <p>The status of scaling group.</p>
         <ul>
            <li>
               <p>CREATING – The scaling group creation is in progress.</p>
            </li>
            <li>
               <p>CREATE_FAILED – The scaling group creation has failed.</p>
            </li>
            <li>
               <p>ACTIVE – The scaling group is active.</p>
            </li>
            <li>
               <p>UPDATING – The scaling group is in the process of being updated.</p>
            </li>
            <li>
               <p>UPDATE_FAILED – The update action failed.</p>
            </li>
            <li>
               <p>DELETING – The scaling group is in the process of being deleted.</p>
            </li>
            <li>
               <p>DELETE_FAILED – The system failed to delete the scaling group.</p>
            </li>
            <li>
               <p>DELETED – The scaling group is successfully deleted.</p>
            </li>
         </ul>




        schema Environment:
            """
            Environment resource
            """

            federation_parameters: str?  # <p>Configuration information when authentication mode is FEDERATED.</p>

            superuser_parameters: str?  # <p>Configuration information for the superuser.</p>

            name: str  # <p>The name of the FinSpace environment to be created.</p>

            federation_mode: str?  # <p>Authentication mode for the environment.</p>
         <ul>
            <li>
               <p>
                  <code>FEDERATED</code> - Users access FinSpace through Single Sign On (SSO) via your Identity provider.</p>
            </li>
            <li>
               <p>
                  <code>LOCAL</code> - Users access FinSpace via email and password managed within the FinSpace environment.</p>
            </li>
         </ul>

            kms_key_id: str?  # <p>The KMS key id to encrypt your data in the FinSpace environment.</p>

            description: str?  # <p>The description of the FinSpace environment to be created.</p>

            tags: {str: str}?  # <p>Add tags to your FinSpace environment.</p>

            data_bundles: [str]?  # <p>The list of Amazon Resource Names (ARN) of the data bundles to install. Currently supported data bundle ARNs:</p>
         <ul>
            <li>
               <p>
                  <code>arn:aws:finspace:${Region}::data-bundle/capital-markets-sample</code> - Contains sample Capital Markets datasets, categories and controlled vocabularies.</p>
            </li>
            <li>
               <p>
                  <code>arn:aws:finspace:${Region}::data-bundle/taq</code> (default) - Contains trades and quotes data in addition to sample Capital Markets data.</p>
            </li>
         </ul>



            # Outputs

            environment_output?: str  # <p>The name of the FinSpace environment.</p>




        schema Kx_cluster_databases:
            """
            KxClusterDatabases resource
            """

            databases: [str]  # <p> The structure of databases mounted on the cluster.</p>

            environment_id: str  # <p>The unique identifier of a kdb environment.</p>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            deployment_configuration: str?  # <p>
         The configuration that allows you to choose how you want to update the databases on a cluster.
      </p>

            cluster_name: str  # <p>A unique name for the cluster that you want to modify.</p>




        schema Kx_cluster:
            """
            KxCluster resource
            """

            environment_id: str  # <p>A unique identifier for the kdb environment.</p>

            tickerplant_log_configuration: str?  # <p>
A configuration to store Tickerplant logs. It consists of
a list of volumes that will be mounted to your cluster. For the cluster type <code>Tickerplant</code>, the location of the TP volume on the cluster will be available by using the global variable <code>.aws.tp_log_path</code>. 
</p>

            scaling_group_configuration: str?  # <p>The structure that stores the configuration details of a scaling group.</p>

            release_label: str  # <p>The version of FinSpace managed kdb to run.</p>

            command_line_arguments: [str]?  # <p>Defines the key-value pairs to make them available inside the cluster.</p>

            availability_zone_id: str?  # <p>The availability zone identifiers for the requested regions.</p>

            initialization_script: str?  # <p>Specifies a Q program that will be run at launch of a cluster. It is a relative path within
            <i>.zip</i> file that contains the custom code, which will be loaded on
         the cluster. It must include the file name itself. For example,
         <code>somedir/init.q</code>.</p>

            cluster_type: str  # <p>Specifies the type of KDB database that is being created. The following types are available: </p>
         <ul>
            <li>
               <p>HDB – A Historical Database. The data is only accessible with read-only permissions from one of the FinSpace managed kdb databases mounted to the cluster.</p>
            </li>
            <li>
               <p>RDB – A Realtime Database. This type of database captures all the data from a ticker plant and stores it in memory until the end of day, after which it writes all of its data to a disk and reloads the HDB. This cluster type requires local storage for temporary storage of data during the savedown process. If you specify this field in your request, you must provide the <code>savedownStorageConfiguration</code> parameter.</p>
            </li>
            <li>
               <p>GATEWAY – A gateway cluster allows you to access data across processes in kdb systems. It allows you to create your own routing logic using the initialization scripts and custom code. This type of cluster does not require a  writable local storage.</p>
            </li>
            <li>
               <p>GP – A general purpose cluster allows you to quickly iterate on code during development by granting greater access to system commands and enabling a fast reload of custom code. This cluster type can optionally mount databases including cache and savedown storage. For this cluster type, the node count is fixed at 1. It does not support autoscaling and supports only <code>SINGLE</code> AZ mode.</p>
            </li>
            <li>
               <p>Tickerplant – A tickerplant cluster allows you to subscribe to feed handlers based on IAM permissions. It can publish to RDBs, other Tickerplants, and real-time subscribers (RTS). Tickerplants can persist messages to log, which is readable by any RDB environment. It supports only single-node that is only one kdb process.</p>
            </li>
         </ul>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            cluster_name: str  # <p>A unique name for the cluster that you want to create.</p>

            tags: {str: str}?  # <p>A list of key-value pairs to label the cluster. You can add up to 50 tags to a cluster.</p>

            cache_storage_configurations: [str]?  # <p>The configurations for a read only cache storage associated with a cluster. This cache will be stored as an FSx Lustre that reads from the S3 store. </p>

            code: str?  # <p>The details of the custom code that you want to use inside a cluster when analyzing a data. It consists of the S3 source bucket, location, S3 object version, and the relative path from where the custom code is loaded into the cluster. </p>

            capacity_configuration: str?  # <p>A structure for the metadata of a cluster. It includes information like the CPUs needed, memory of instances, and number of instances.</p>

            vpc_configuration: str  # <p>Configuration details about the network where the Privatelink endpoint of the cluster resides.</p>

            savedown_storage_configuration: str?  # <p>The size and type of the temporary storage that is used to hold data during the savedown process. This parameter is required when you choose <code>clusterType</code> as RDB. All the data written to this storage space is lost when the cluster node is restarted.</p>

            execution_role: str?  # <p>An IAM role that defines a set of permissions associated with a cluster. These permissions are assumed when a cluster attempts to access another cluster.</p>

            auto_scaling_configuration: str?  # <p>The configuration based on which FinSpace will scale in or scale out nodes in your cluster.</p>

            databases: [str]?  # <p>A list of databases that will be available for querying.</p>

            cluster_description: str?  # <p>A description of the cluster.</p>

            az_mode: str  # <p>The number of availability zones you want to assign per cluster. This can be one of the following </p>
         <ul>
            <li>
               <p>
                  <code>SINGLE</code> – Assigns one availability zone per cluster.</p>
            </li>
            <li>
               <p>
                  <code>MULTI</code> – Assigns all the availability zones per cluster.</p>
            </li>
         </ul>



            # Outputs

            savedown_storage_configuration_output?: str  # <p>The size and type of the temporary storage that is used to hold data during the savedown process. This parameter is required when you choose <code>clusterType</code> as RDB. All the data written to this storage space is lost when the cluster node is restarted.</p>

            status_reason_output?: str  # <p>The error message when a failed state occurs. </p>

            release_label_output?: str  # <p>The version of FinSpace managed kdb to run.</p>

            tickerplant_log_configuration_output?: str  # 

            capacity_configuration_output?: str  # <p>A structure for the metadata of a cluster. It includes information like the CPUs needed, memory of instances, and number of instances.</p>

            volumes_output?: [str]  # <p>
A list of volumes attached to the cluster.
</p>

            initialization_script_output?: str  # <p>Specifies a Q program that will be run at launch of a cluster. It is a relative path within
      <i>.zip</i> file that contains the custom code, which will be loaded on
      the cluster. It must include the file name itself. For example,
      <code>somedir/init.q</code>.</p>

            cluster_name_output?: str  # <p>A unique name for the cluster.</p>

            cluster_description_output?: str  # <p>A description of the cluster.</p>

            auto_scaling_configuration_output?: str  # <p>The configuration based on which FinSpace will scale in or scale out nodes in your cluster.</p>

            execution_role_output?: str  # <p>
            An IAM role that defines a set of permissions associated with a cluster. These permissions are assumed when a cluster attempts to access another cluster.
         </p>

            az_mode_output?: str  # <p>The number of availability zones you want to assign per cluster. This can be one of the following </p>
         <ul>
            <li>
               <p>
                  <code>SINGLE</code> – Assigns one availability zone per cluster.</p>
            </li>
            <li>
               <p>
                  <code>MULTI</code> – Assigns all the availability zones per cluster.</p>
            </li>
         </ul>

            availability_zone_id_output?: str  # <p>
            The availability zone identifiers for the requested regions.
         </p>

            status_output?: str  # <p>The status of cluster creation.</p>
         <ul>
            <li>
               <p>PENDING – The cluster is pending creation.</p>
            </li>
            <li>
               <p>CREATING – The cluster creation process is in progress.</p>
            </li>
            <li>
               <p>CREATE_FAILED – The cluster creation process has failed.</p>
            </li>
            <li>
               <p>RUNNING – The cluster creation process is running.</p>
            </li>
            <li>
               <p>UPDATING – The cluster is in the process of being updated.</p>
            </li>
            <li>
               <p>DELETING – The cluster is in the process of being deleted.</p>
            </li>
            <li>
               <p>DELETED – The cluster has been deleted.</p>
            </li>
            <li>
               <p>DELETE_FAILED – The cluster failed to delete.</p>
            </li>
         </ul>

            scaling_group_configuration_output?: str  # 

            command_line_arguments_output?: [str]  # <p>Defines key-value pairs to make them available inside the cluster.</p>

            cluster_type_output?: str  # <p>Specifies the type of KDB database that is being created. The following types are available: </p>
         <ul>
            <li>
               <p>HDB – A Historical Database. The data is only accessible with read-only permissions from one of the FinSpace managed kdb databases mounted to the cluster.</p>
            </li>
            <li>
               <p>RDB – A Realtime Database. This type of database captures all the data from a ticker plant and stores it in memory until the end of day, after which it writes all of its data to a disk and reloads the HDB. This cluster type requires local storage for temporary storage of data during the savedown process. If you specify this field in your request, you must provide the <code>savedownStorageConfiguration</code> parameter.</p>
            </li>
            <li>
               <p>GATEWAY – A gateway cluster allows you to access data across processes in kdb systems. It allows you to create your own routing logic using the initialization scripts and custom code. This type of cluster does not require a  writable local storage.</p>
            </li>
            <li>
               <p>GP – A general purpose cluster allows you to quickly iterate on code during development by granting greater access to system commands and enabling a fast reload of custom code. This cluster type can optionally mount databases including cache and savedown storage. For this cluster type, the node count is fixed at 1. It does not support autoscaling and supports only <code>SINGLE</code> AZ mode.</p>
            </li>
            <li>
               <p>Tickerplant – A tickerplant cluster allows you to subscribe to feed handlers based on IAM permissions. It can publish to RDBs, other Tickerplants, and real-time subscribers (RTS). Tickerplants can persist messages to log, which is readable by any RDB environment. It supports only single-node that is only one kdb process.</p>
            </li>
         </ul>

            cache_storage_configurations_output?: [str]  # <p>The configurations for a read only cache storage associated with a cluster. This cache will be stored as an FSx Lustre that reads from the S3 store. </p>

            vpc_configuration_output?: str  # <p>Configuration details about the network where the Privatelink endpoint of the cluster resides.</p>

            code_output?: str  # <p>The details of the custom code that you want to use inside a cluster when analyzing a data. It consists of the S3 source bucket, location, S3 object version, and the relative path from where the custom code is loaded into the cluster. </p>

            last_modified_timestamp_output?: str  # <p>The last time that the cluster was modified. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            databases_output?: [str]  # <p> A list of databases mounted on the cluster.</p>

            created_timestamp_output?: str  # <p>The timestamp at which the cluster was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>




        schema Kx_volume:
            """
            KxVolume resource
            """

            volume_name: str  # <p>A unique identifier for the volume.</p>

            availability_zone_ids: [str]  # <p>The identifier of the availability zones.</p>

            az_mode: str  # <p>The number of availability zones you want to assign per volume. Currently, FinSpace only supports <code>SINGLE</code> for volumes. This places dataview in a single AZ.</p>

            volume_type: str  # <p>
   The type of file system volume. Currently, FinSpace only supports <code>NAS_1</code> volume type. When you select <code>NAS_1</code> volume type, you must also provide <code>nas1Configuration</code>.
</p>

            client_token: str?  # <p>A token that ensures idempotency. This token expires in 10 minutes.</p>

            description: str?  # <p>
A description of the volume.
</p>

            nas1_configuration: str?  # <p> Specifies the configuration for the Network attached storage (NAS_1) file system volume. This
         parameter is required when you choose <code>volumeType</code> as
         <i>NAS_1</i>.</p>

            environment_id: str  # <p>A unique identifier for the kdb environment, whose clusters can attach to the volume. </p>

            tags: {str: str}?  # <p>
A list of key-value pairs to label the volume. You can add up to 50 tags to a volume.
</p>



            # Outputs

            status_reason_output?: str  # <p>The error message when a failed state occurs. </p>

            az_mode_output?: str  # <p>The number of availability zones you want to assign per volume. Currently, FinSpace only supports <code>SINGLE</code> for volumes. This places dataview in a single AZ.</p>

            volume_type_output?: str  # <p>
      The type of file system volume. Currently, FinSpace only supports <code>NAS_1</code> volume type.
   </p>

            availability_zone_ids_output?: [str]  # <p>The identifier of the availability zones.</p>

            status_output?: str  # <p>The status of volume creation.</p>
         <ul>
            <li>
               <p>CREATING – The volume creation is in progress.</p>
            </li>
            <li>
               <p>CREATE_FAILED – The volume creation has failed.</p>
            </li>
            <li>
               <p>ACTIVE – The volume is active.</p>
            </li>
            <li>
               <p>UPDATING – The volume is in the process of being updated.</p>
            </li>
            <li>
               <p>UPDATE_FAILED – The update action failed.</p>
            </li>
            <li>
               <p>UPDATED – The volume is successfully updated.</p>
            </li>
            <li>
               <p>DELETING – The volume is in the process of being deleted.</p>
            </li>
            <li>
               <p>DELETE_FAILED – The system failed to delete the volume.</p>
            </li>
            <li>
               <p>DELETED – The volume is successfully deleted.</p>
            </li>
         </ul>

            attached_clusters_output?: [str]  # <p>
A list of cluster identifiers that a volume is attached to. 
</p>

            volume_arn_output?: str  # <p>
The ARN identifier of the volume.
</p>

            last_modified_timestamp_output?: str  # <p>The last time that the volume was updated in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.</p>

            environment_id_output?: str  # <p>A unique identifier for the kdb environment, whose clusters can attach to the volume. </p>

            volume_name_output?: str  # <p>
A unique identifier for the volume.</p>

            nas1_configuration_output?: str  # <p> Specifies the configuration for the Network attached storage (NAS_1) file system volume.</p>

            created_timestamp_output?: str  # <p>
The timestamp at which the volume was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.
</p>

            description_output?: str  # <p>
A description of the volume.
</p>




        schema Kx_environment_network:
