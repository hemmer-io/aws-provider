            domain_name: str  # 



            # Outputs

            scaling_parameters_output?: str  # 




        schema Suggester:
            """
            Suggester resource
            """




        schema Analysis_schemes:
            """
            AnalysisSchemes resource
            """



            # Outputs

            analysis_schemes_output?: [str]  # <p>The analysis scheme descriptions.</p>




        schema Suggesters:
            """
            Suggesters resource
            """



            # Outputs

            suggesters_output?: [str]  # <p>The suggesters configured for the domain specified in the request.</p>




        schema Analysis_scheme:
            """
            AnalysisScheme resource
            """




        schema Expression:
            """
